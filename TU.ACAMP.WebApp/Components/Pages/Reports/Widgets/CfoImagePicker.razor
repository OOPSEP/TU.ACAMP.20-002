@* [2026-09-24][Claude] กรอบรูปที่ใช้ร่วมกันในหน้า Setup Report (Fr-01 / Fr-02 / Fr-03.1)
   - แสดงรูปที่ผู้ใช้เลือกของรายงาน ถ้ายังไม่เลือกแสดงรูป default ของระบบ (ไฟล์เดียวกับที่ Export ใช้)
   - คลิกที่รูป = เลือกไฟล์ใหม่ / ปุ่ม "Use Default Image" = กลับไปใช้ default (ค่า null)
   - ตรวจชนิดไฟล์ PNG/JPG/WEBP และขนาดไม่เกิน 5 MB *@
@inject NotificationService NotificationService

<div class="d-flex flex-column align-items-center justify-content-center gap-2 flex-grow-1">
    <label class="cfo-image-picker" for="@InputId" title="Click to choose a new image" style="width: @(Width)px; height: @(Height)px;">
        <img src="@DisplayImageSrc" alt="@AltText" />
        <span class="cfo-image-picker-overlay">
            <RadzenIcon Icon="photo_camera" /> Click to change
        </span>
    </label>
    <InputFile @key="_fileInputKey" id="@InputId" OnChange="@OnFileSelectedAsync" accept="image/png,image/jpeg,image/jpg,image/webp" class="d-none" />

    <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
        @if (HasCustomImage)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Success" IsPill="true" Text="Report image" />
            <RadzenButton Text="Use Default Image" Icon="restart_alt" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small"
                          Click="@ResetToDefaultAsync" Style="border-radius: 6px;" />
        }
        else
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Light" IsPill="true" Text="System default" />
            <span class="text-muted small">No image selected — the default image will be exported.</span>
        }
    </div>
</div>

@code {
    /// <summary>รูปของรายงานในรูปแบบ data URL (null/ว่าง = ใช้ default)</summary>
    [Parameter] public string? ImageBase64 { get; set; }
    [Parameter] public EventCallback<string?> ImageBase64Changed { get; set; }

    /// <summary>URL รูป default ใน wwwroot เช่น images/default_org_facility.jpg</summary>
    [Parameter, EditorRequired] public string DefaultImageUrl { get; set; } = string.Empty;

    /// <summary>id ของ input ต้องไม่ซ้ำกันในหน้าเดียวกัน</summary>
    [Parameter, EditorRequired] public string InputId { get; set; } = string.Empty;

    [Parameter] public string AltText { get; set; } = "Image";
    [Parameter] public int Width { get; set; } = 260;
    [Parameter] public int Height { get; set; } = 220;

    private const long MaxImageBytes = 5 * 1024 * 1024;
    private static readonly string[] AllowedImageTypes = { "image/png", "image/jpeg", "image/jpg", "image/webp" };

    private bool HasCustomImage => !string.IsNullOrWhiteSpace(ImageBase64);
    private string DisplayImageSrc => HasCustomImage ? ImageBase64! : DefaultImageUrl;

    // เปลี่ยน key หลังอ่านไฟล์เสร็จ เพื่อ reset InputFile ให้เลือกไฟล์เดิมซ้ำได้
    private int _fileInputKey;

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        try
        {
            if (!AllowedImageTypes.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase))
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Unsupported file type",
                    $"{file.Name} is not a PNG, JPG or WEBP image.", 5000);
                return;
            }

            if (file.Size > MaxImageBytes)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "File too large",
                    $"{file.Name} is {file.Size / 1024d / 1024d:N1} MB. The maximum size is 5 MB.", 5000);
                return;
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: MaxImageBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            await ImageBase64Changed.InvokeAsync(base64);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Upload failed",
                $"Could not read {file.Name}: {ex.Message}", 6000);
        }
        finally
        {
            // reset หลังจบการอ่านไฟล์เท่านั้น (ถ้า reset ก่อน element จะถูกสร้างใหม่ระหว่างอ่าน stream)
            _fileInputKey++;
        }
    }

    private async Task ResetToDefaultAsync()
    {
        await ImageBase64Changed.InvokeAsync(null);
    }
}
