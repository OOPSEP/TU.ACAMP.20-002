    #region Snapshot Generation
    private async Task GenerateSnapshotAsync()
    {
        #region hide [2026-09-16]
        // [2026-09-16][Antigravity] Validate CfoSetupWidget inputs only for isolated widget testing
        if (!ValidateCurrentStep())
        {
            StateHasChanged();
            return;
        }

        try
        {
            _isSaving = true;
            _errorMessage = null;

            var overrides = new CfoReportService.CfoReportOverridesDto
            {
                OrganizationTitle = string.IsNullOrWhiteSpace(_fr01OrgTitle) ? GetSelectedTargetTitle() : _fr01OrgTitle,
                GhgTeamName = string.IsNullOrWhiteSpace(_fr01GhgTeam) ? $"{_level} GHG Team" : _fr01GhgTeam,
                CertifierOrgTitle = string.IsNullOrWhiteSpace(_fr01CertifierOrg) ? GetSelectedTargetTitle() : _fr01CertifierOrg
            };

            var inScopeIds = _selectedInScopeChildIds?.ToList();

            // [2026-09-16][Antigravity] Bypass snapshot storage pipeline and directly export AR5 Excel workbook for verification
            if (_calcReport == null)
            {
                _calcReport = await CfoReportService.GenerateReportAsync(
                    _level,
                    _targetId,
                    _selectedCalculateYear,
                    _allowedSubscriptionIds,
                    thresholdPercent: _materialityThreshold,
                    _acknowledgmentReason,
                    inScopeChildIds: inScopeIds);
            }

            if (_selectedBaseYear > 0 && _baseReport == null)
            {
                _baseReport = await CfoReportService.GenerateReportAsync(
                    _level,
                    _targetId,
                    _selectedBaseYear,
                    _allowedSubscriptionIds,
                    thresholdPercent: _materialityThreshold,
                    _acknowledgmentReason,
                    inScopeChildIds: inScopeIds);
            }

            var excelBytes = CfoReportService.ExportToExcel(
                _calcReport,
                _baseReport,
                _selectedBaseYear,
                overrides);

            // [2026-09-21][Gemini] Standard Export Filename: cfo_report_{name}_{date}_{time}.xlsx
            var contextName = $"{_selectedCalculateYear}_{GetSelectedTargetTitle()}";
            var fileName = ExportFileNameHelper.Generate("cfo_report", contextName, fallback: "report");
            var base64 = Convert.ToBase64String(excelBytes);

            await JSRuntime.InvokeVoidAsync("downloadFile", base64, fileName, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            NotificationService.Notify(NotificationSeverity.Success, "AR5 Excel Exported",
                $"Successfully generated and downloaded '{fileName}'.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting CFO AR5 Excel report.");
            _errorMessage = $"Failed to export Excel report: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
        #endregion
    }
    #endregion

