                </Steps>
            </RadzenSteps>
        </RadzenCard>

        <!-- ===================== WIZARD NAVIGATION BAR ===================== -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                          Click="@NavigateToBack" Disabled="@(_isSaving || _isPreflighting)" Style="border-radius: 6px;" />

            <div class="d-flex gap-2">
                <RadzenButton Text="Back" Icon="chevron_left" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                              Click="@GoPreviousStep" Disabled="@(_activeStep == 0 || _isSaving || _isPreflighting)" Style="border-radius: 6px;" />

                @if (_activeStep < LastStepIndex)
                {
                    <RadzenButton Text="Next" Icon="chevron_right" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat"
                                  Click="@GoNextStepAsync" Disabled="@(_isSaving || _isPreflighting)" Style="border-radius: 6px; font-weight: 600;" />
                }
                else
                {
                    <RadzenButton Text="@(_isSaving ? "Generating Snapshot..." : "Generate &amp; Lock Snapshot")"
                                  Icon="@(_isSaving ? "" : "verified")"
                                  ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                  Click="@GenerateSnapshotAsync" Disabled="@(_isSaving || _isPreflighting)" IsBusy="@_isSaving"
                                  Style="border-radius: 6px; font-weight: 600;" />
                }
            </div>
        </div>
    }
</div>

@code {
    // [2026-09-15][Antigravity] Sequential 7-step Wizard (Next/Back) mirroring TGO AR5 workbook sheets
    //                           State persistence via encrypted query param 'tab', silent replaceState, and multi-step validation

    #region Route & Query Parameters
    [Parameter] public string? SecureId { get; set; }

    [SupplyParameterFromQuery(Name = "id")]
    public string? SecureTargetId { get; set; }

    [SupplyParameterFromQuery(Name = "level")]
    public int LevelValue { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "sid")]
    public string? SecureSubscriptionId { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public string? SecureTab { get; set; }

    [SupplyParameterFromQuery(Name = "cy")]
    public string? SecureCalculateYear { get; set; }

    [SupplyParameterFromQuery(Name = "by")]
    public string? SecureBaseYear { get; set; }

    [SupplyParameterFromQuery(Name = "ret")]
    public string? SecureRet { get; set; }
    #endregion

    #region Constants & Fields
    private const int LastStepIndex = 6; // 7 steps total: 0..6

    private const int Fr04Scope1Capacity = 14;   // rows 10..23
    private const int Fr04SeparateCapacity = 5;  // rows 25..29
    private const int Fr04Scope2Capacity = 4;    // rows 31..34
    private const int Fr04Scope3Capacity = 7;    // rows 36..42

    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _isPreflighting = false;
    private bool _isViewMode = false;
    private int _activeStep = 0;
    private string? _errorMessage;
    private string? _returnUrl;

    private eTopicLevel _level = eTopicLevel.Corporate;
    private int _targetId = 0;
    private int? _selectedSubscriptionId;
    private HashSet<int> _allowedSubscriptionIds = new();

    // Step 1: Setup fields
    private string _title = string.Empty;
    private string _createdBy = "Corporate GHG Team";
    private int _selectedCalculateYear = AppTimeZone.LocalNow.Year;
    private int _selectedBaseYear = 0;
    private string _consolidationApproach = "Operational Control";
    private decimal _materialityThreshold = 5.0m;
    private string _acknowledgmentReason = string.Empty;

    // Step 2: Fr-01 Overrides
    private string _fr01OrgTitle = string.Empty;
    private string _fr01GhgTeam = string.Empty;
    private string _fr01CertifierOrg = string.Empty;
    private string _fr01Scope1Summary = "-";
    private string _fr01Scope2Summary = "-";
    private string _fr01Scope3Summary = "-";

    // Pre-flight & Verification Data
    private CfoReportService.CfoAuditReportDto? _calcReport;
    private CfoReportService.CfoAuditReportDto? _baseReport;
    private MultiYearComparisonDto? _comparisonDto;
    private List<CfoReportService.ActivityAuditLineDto> _expiredEfList = new();
    private List<string> _calcOverflowWarnings = new();
    private bool _hasEfSourceMismatch = false;

    // Quota counts
    private int _calcScope1Count = 0;
    private int _calcSepCount = 0;
    private int _calcScope2Count = 0;
    private int _calcScope3Count = 0;

    private int _baseScope1Count = 0;
    private int _baseSepCount = 0;
    private int _baseScope2Count = 0;
    private int _baseScope3Count = 0;

    private CfoReportDocument? _loadedDoc;

    private List<OptionItem> _levelOptions = new();
    private List<OptionItem> _targetOptions = new();
    private List<int> _calculateYearOptions = new();
    private List<OptionItem> _baseYearOptions = new();
    private List<string> _consolidationOptions = new() { "Operational Control", "Financial Control", "Equity Share" };
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        #region hide [2026-09-15]
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var isAdmin = user.IsInRole(SystemRoles.Administrator);
            var email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                     ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                     ?? user.Identity?.Name;

            if (!string.IsNullOrEmpty(email))
            {
                var userSubs = await SubscriptionService.GetSubscriptionsForUserAsync(email, isAdmin);
                _allowedSubscriptionIds = userSubs.Select(s => s.Id).ToHashSet();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing user subscriptions for AddEditCfoReport.");
        }

        BuildStaticOptions();
        #endregion
    }

    protected override async Task OnParametersSetAsync()
    {
        #region hide [2026-09-15]
        try
        {
            _isLoading = true;
            ResolveParameters();

            _isViewMode = !string.IsNullOrWhiteSpace(SecureId);
            if (_isViewMode)
            {
                await LoadSnapshotAsync();
            }
            else
            {
                await LoadTargetOptionsAsync();
                if (string.IsNullOrWhiteSpace(_title))
                {
                    _title = $"GHG Emissions Report Year {_selectedCalculateYear}";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error preparing AddEditCfoReport page.");
            _errorMessage = "Failed to load report parameters.";
        }
        finally
        {
            _isLoading = false;
        }
        #endregion
    }

    private void ResolveParameters()
    {
        #region hide [2026-09-15]
        _level = LevelValue switch
        {
            2 => eTopicLevel.Company,
            3 => eTopicLevel.Facility,
            _ => eTopicLevel.Corporate
        };

        var decryptedTarget = DataProtection.UnprotectInt(SecureTargetId);
        if (decryptedTarget.HasValue && decryptedTarget.Value > 0) _targetId = decryptedTarget.Value;

        var decryptedSid = DataProtection.UnprotectInt(SecureSubscriptionId);
        if (decryptedSid.HasValue && decryptedSid.Value > 0) _selectedSubscriptionId = decryptedSid.Value;

        var decryptedTab = DataProtection.UnprotectInt(SecureTab);
        if (decryptedTab.HasValue && decryptedTab.Value >= 0 && decryptedTab.Value <= LastStepIndex)
        {
            _activeStep = decryptedTab.Value;
        }

        var decryptedCy = DataProtection.UnprotectInt(SecureCalculateYear);
        if (decryptedCy.HasValue && decryptedCy.Value > 0) _selectedCalculateYear = decryptedCy.Value;

        var decryptedBy = DataProtection.UnprotectInt(SecureBaseYear);
        if (decryptedBy.HasValue && decryptedBy.Value >= 0) _selectedBaseYear = decryptedBy.Value;

        var decryptedRet = DataProtection.Unprotect(SecureRet);
        if (!string.IsNullOrWhiteSpace(decryptedRet)) _returnUrl = decryptedRet;
        #endregion
    }
    #endregion

    #region Data Loading & Calculations
    private void BuildStaticOptions()
    {
        #region hide [2026-09-15]
        _levelOptions = new List<OptionItem>
        {
            new OptionItem { Value = 1, Text = "Corporate" },
            new OptionItem { Value = 2, Text = "Company" },
            new OptionItem { Value = 3, Text = "Facility" }
        };

        int currentYear = AppTimeZone.LocalNow.Year;
        _calculateYearOptions = Enumerable.Range(currentYear - 5, 7).Reverse().ToList();

        _baseYearOptions = new List<OptionItem>
        {
            new OptionItem { Value = 0, Text = "(None / Standalone Year)" }
        };
        _baseYearOptions.AddRange(Enumerable.Range(currentYear - 10, 11).Reverse()
            .Select(y => new OptionItem { Value = y, Text = $"Base Year {y}" }));
        #endregion
    }

    private async Task LoadTargetOptionsAsync()
    {
        #region hide [2026-09-15]
        try
        {
            _targetOptions = new List<OptionItem>();

            if (_level == eTopicLevel.Corporate)
            {
                var corporates = await CorporateService.GetBySubscriptionIdAsync(_selectedSubscriptionId);
                _targetOptions = corporates
                    .Select(c => new OptionItem { Value = c.Id, Text = string.IsNullOrWhiteSpace(c.Code) ? c.Title : $"{c.Code} — {c.Title}" })
                    .ToList();
            }
            else if (_level == eTopicLevel.Company)
            {
                var companies = await CompanyService.GetByCorporateIdsAsync(null, _selectedSubscriptionId);
                _targetOptions = companies
                    .Select(c => new OptionItem { Value = c.Id, Text = string.IsNullOrWhiteSpace(c.Code) ? c.Title : $"{c.Code} — {c.Title}" })
                    .ToList();
            }
            else
            {
                var facilities = await FacilityService.GetByContextAsync(_selectedSubscriptionId);
                _targetOptions = facilities
                    .Select(f => new OptionItem { Value = f.Id, Text = string.IsNullOrWhiteSpace(f.Code) ? f.Title : $"{f.Code} — {f.Title}" })
                    .ToList();
            }

            if (_targetId == 0 || !_targetOptions.Any(o => o.Value == _targetId))
            {
                _targetId = _targetOptions.FirstOrDefault()?.Value ?? 0;
            }

            // Sync Fr-01 title default
            if (string.IsNullOrWhiteSpace(_fr01OrgTitle))
            {
                _fr01OrgTitle = GetSelectedTargetTitle();
            }
            if (string.IsNullOrWhiteSpace(_fr01GhgTeam))
            {
                _fr01GhgTeam = $"{_level} GHG Team";
            }
            if (string.IsNullOrWhiteSpace(_fr01CertifierOrg))
            {
                _fr01CertifierOrg = _fr01OrgTitle;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading target organization options.");
            _errorMessage = "Failed to load target organization list.";
        }
        #endregion
    }

    private async Task LoadSnapshotAsync()
    {
        #region hide [2026-09-15]
        try
        {
            var reportKey = DataProtection.Unprotect(SecureId);
            if (string.IsNullOrWhiteSpace(reportKey)) return;

            _loadedDoc = await ReportStorageService.GetReportAsync(reportKey, _level, _targetId);
            if (_loadedDoc != null)
            {
                _title = _loadedDoc.Title;
                _createdBy = _loadedDoc.CreatedBy;
                _selectedCalculateYear = _loadedDoc.CalculateYear;
                _selectedBaseYear = _loadedDoc.BaseYear;
                _calcReport = _loadedDoc.CalculateYearReport;
                _baseReport = _loadedDoc.BaseYearReport;
                _comparisonDto = _loadedDoc.Comparison;

                _fr01OrgTitle = _loadedDoc.OrganizationTitle;
                _fr01GhgTeam = _loadedDoc.GhgTeamName;
                _fr01CertifierOrg = _loadedDoc.CertifierOrgTitle;

                PopulateQuotaCounts();
                RecalculateFr01Summaries();
                CheckEfIntegrity();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading report snapshot for view mode.");
            _errorMessage = "Failed to load locked report snapshot.";
        }
        #endregion
    }

    private async Task RunPreflightAsync()
    {
        #region hide [2026-09-15]
        if (_targetId <= 0) return;

        try
        {
            _isPreflighting = true;
            _errorMessage = null;

            _calcReport = await CfoReportService.GenerateReportAsync(
                _level, _targetId, _selectedCalculateYear, _allowedSubscriptionIds, _materialityThreshold, _acknowledgmentReason);

            if (_selectedBaseYear > 0)
            {
                _baseReport = await CfoReportService.GenerateReportAsync(
                    _level, _targetId, _selectedBaseYear, _allowedSubscriptionIds, _materialityThreshold);
            }
            else
            {
                _baseReport = null;
            }

            if (string.IsNullOrWhiteSpace(_fr01OrgTitle)) _fr01OrgTitle = _calcReport.OrganizationTitle;
            if (string.IsNullOrWhiteSpace(_fr01GhgTeam)) _fr01GhgTeam = $"{_level} GHG Team";
            if (string.IsNullOrWhiteSpace(_fr01CertifierOrg)) _fr01CertifierOrg = _fr01OrgTitle;

            PopulateQuotaCounts();
            RecalculateFr01Summaries();
            BuildMultiYearComparison();
            CheckEfIntegrity();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error running CFO report pre-flight.");
            _errorMessage = $"Pre-flight failed: {ex.Message}";
        }
        finally
        {
            _isPreflighting = false;
        }
        #endregion
    }

    private void PopulateQuotaCounts()
    {
        #region hide [2026-09-15]
        if (_calcReport != null)
        {
            _calcScope1Count = _calcReport.AuditLines.Count(l => l.ScopeNo == eTgoScopeNo.Scope1);
            _calcSepCount = _calcReport.AuditLines.Count(l => (int)l.ScopeNo == 4);
            _calcScope2Count = _calcReport.AuditLines.Count(l => l.ScopeNo == eTgoScopeNo.Scope2);
            _calcScope3Count = _calcReport.AuditLines.Count(l => l.ScopeNo == eTgoScopeNo.Scope3);

            _calcOverflowWarnings = new List<string>();
            void Check(string label, int count, int cap)
            {
                if (count > cap)
                {
                    _calcOverflowWarnings.Add($"{label}: {count} items exceed template quota ({cap} rows). The extra {count - cap + 1} items will be consolidated into row {cap} in Fr-04.1.");
                }
            }
            Check("Scope 1", _calcScope1Count, Fr04Scope1Capacity);
            Check("Separate report (Biogenic)", _calcSepCount, Fr04SeparateCapacity);
            Check("Scope 2", _calcScope2Count, Fr04Scope2Capacity);
            Check("Scope 3", _calcScope3Count, Fr04Scope3Capacity);
        }

        if (_baseReport != null)
        {
            _baseScope1Count = _baseReport.AuditLines.Count(l => l.ScopeNo == eTgoScopeNo.Scope1);
            _baseSepCount = _baseReport.AuditLines.Count(l => (int)l.ScopeNo == 4);
            _baseScope2Count = _baseReport.AuditLines.Count(l => l.ScopeNo == eTgoScopeNo.Scope2);
            _baseScope3Count = _baseReport.AuditLines.Count(l => l.ScopeNo == eTgoScopeNo.Scope3);
        }
        #endregion
    }

    private void RecalculateFr01Summaries()
    {
        #region hide [2026-09-15]
        if (_calcReport == null) return;

        // [2026-09-16][Antigravity] Format Scope summaries with TGO Category (Option A) sorted ascending by code
        string BuildSummary(eTgoScopeNo scope)
        {
            var grp = _calcReport.Scopes.FirstOrDefault(s => s.ScopeNo == scope);
            if (grp == null || !grp.ActivityGroups.Any()) return "-";
            var titles = grp.ActivityGroups
                .OrderBy(ag => CfoReportService.GetSortableCodeKey(ag.Code))
                .Select(ag => CfoReportService.FormatTgoCategory(ag.Code, ag.Title, scope))
                .Where(t => !string.IsNullOrWhiteSpace(t))
                .ToList();
            return titles.Any() ? string.Join(Environment.NewLine, titles) : "-";
        }

        _fr01Scope1Summary = BuildSummary(eTgoScopeNo.Scope1);
        _fr01Scope2Summary = BuildSummary(eTgoScopeNo.Scope2);
        _fr01Scope3Summary = BuildSummary(eTgoScopeNo.Scope3);
        #endregion
    }

    private void BuildMultiYearComparison()
    {
        #region hide [2026-09-15]
        if (_calcReport != null && _baseReport != null && _baseReport.TotalGrossEmissions_tCO2e > 0)
        {
            var baseGross = _baseReport.TotalGrossEmissions_tCO2e;
            var calcGross = _calcReport.TotalGrossEmissions_tCO2e;
            var grossDelta = calcGross - baseGross;

            var baseS1 = _baseReport.TotalScope1_tCO2e;
            var calcS1 = _calcReport.TotalScope1_tCO2e;
            var s1Delta = calcS1 - baseS1;

            var baseS2 = _baseReport.TotalScope2_tCO2e;
            var calcS2 = _calcReport.TotalScope2_tCO2e;
            var s2Delta = calcS2 - baseS2;

            var baseS3 = _baseReport.TotalScope3_tCO2e;
            var calcS3 = _calcReport.TotalScope3_tCO2e;
            var s3Delta = calcS3 - baseS3;

            var baseSep = _baseReport.TotalSeparate_tCO2e;
            var calcSep = _calcReport.TotalSeparate_tCO2e;
            var sepDelta = calcSep - baseSep;

            _comparisonDto = new MultiYearComparisonDto
            {
                Scope1Delta_tCO2e = s1Delta,
                Scope1PercentChange = baseS1 > 0 ? (s1Delta * 100m / baseS1) : 0m,
                Scope2Delta_tCO2e = s2Delta,
                Scope2PercentChange = baseS2 > 0 ? (s2Delta * 100m / baseS2) : 0m,
                Scope3Delta_tCO2e = s3Delta,
                Scope3PercentChange = baseS3 > 0 ? (s3Delta * 100m / baseS3) : 0m,
                GrossDelta_tCO2e = grossDelta,
                GrossPercentChange = baseGross > 0 ? (grossDelta * 100m / baseGross) : 0m,
                SeparateDelta_tCO2e = sepDelta,
                SeparatePercentChange = baseSep > 0 ? (sepDelta * 100m / baseSep) : 0m
            };
        }
        else
        {
            _comparisonDto = null;
        }
        #endregion
    }

    private void CheckEfIntegrity()
    {
        #region hide [2026-09-15]
        if (_calcReport == null) return;

        // [2026-09-15][Antigravity] Evaluate EF expiration using current active status (EfValidityStatus == "Expired")
        _expiredEfList = _calcReport.AuditLines
            .Where(l => l.EfValidityStatus == "Expired")
            .ToList();

        // Check if base year and calculate year share the same EF sources
        if (_baseReport != null && _baseReport.AuditLines.Any())
        {
            var calcSources = _calcReport.AuditLines.Select(l => l.SourceId).Where(id => id > 0).ToHashSet();
            var baseSources = _baseReport.AuditLines.Select(l => l.SourceId).Where(id => id > 0).ToHashSet();
            _hasEfSourceMismatch = !calcSources.SetEquals(baseSources);
        }
        else
        {
            _hasEfSourceMismatch = false;
        }
        #endregion
    }

    private void ResetDownstreamData()
    {
        #region hide [2026-09-15]
        _calcReport = null;
        _baseReport = null;
        _comparisonDto = null;
        _expiredEfList = new();
        _calcOverflowWarnings = new();
        _hasEfSourceMismatch = false;
        #endregion
    }
    #endregion

    #region Wizard Navigation & Step Validation
    private async Task GoNextStepAsync()
    {
        #region hide [2026-09-15]
        if (!ValidateCurrentStep()) return;

        _errorMessage = null;
        _activeStep = Math.Min(_activeStep + 1, LastStepIndex);

        // Auto-run pre-flight on reaching Step 3 (index 2)
        if (_activeStep == 2 && _calcReport == null)
        {
            await RunPreflightAsync();
        }

        await SyncStepToUrlAsync();
        #endregion
    }

    private async Task GoPreviousStep()
    {
        #region hide [2026-09-15]
        _errorMessage = null;
        _activeStep = Math.Max(_activeStep - 1, 0);
        await SyncStepToUrlAsync();
        #endregion
    }

    private bool ValidateCurrentStep()
    {
        #region hide [2026-09-15]
        switch (_activeStep)
        {
            case 0: // Step 1: Setup
                if (_targetId <= 0)
                {
                    _errorMessage = "Please select a target organization.";
                    return false;
                }
                if (string.IsNullOrWhiteSpace(_title))
                {
                    _errorMessage = "Please specify a report title.";
                    return false;
                }
                if (_selectedCalculateYear <= 0)
                {
                    _errorMessage = "Please select a calculate / reporting year.";
                    return false;
                }
                if (_selectedBaseYear > 0 && _selectedBaseYear >= _selectedCalculateYear)
                {
                    _errorMessage = "The base year must be earlier than the calculate year.";
                    return false;
                }
                return true;

            case 1: // Step 2: Fr-01 Organization Details
                if (string.IsNullOrWhiteSpace(_fr01OrgTitle))
                {
                    _errorMessage = "Please specify the organization name (Cell B6).";
                    return false;
                }
                if (string.IsNullOrWhiteSpace(_fr01GhgTeam))
                {
                    _errorMessage = "Please specify the GHG working team name (Cell G4).";
                    return false;
                }
                if (string.IsNullOrWhiteSpace(_fr01CertifierOrg))
                {
                    _errorMessage = "Please specify the organization for certification (Cell I32).";
                    return false;
                }
                return true;

            case 2: // Step 3: Data Pre-flight
                if (_calcReport == null)
                {
                    _errorMessage = "Please run the data pre-flight analysis before proceeding.";
                    return false;
                }
                if (_expiredEfList.Any() && string.IsNullOrWhiteSpace(_acknowledgmentReason))
                {
                    _errorMessage = "Please provide an audit acknowledgment reason for the expired emission factors.";
                    return false;
                }
                return true;

            default:
                return true;
        }
        #endregion
    }

    private async Task SyncStepToUrlAsync()
    {
        #region hide [2026-09-15]
        try
        {
            var queryParams = new Dictionary<string, object?>
            {
                ["tab"] = DataProtection.Protect(_activeStep)
            };
            var url = NavigationManager.GetUriWithQueryParameters(queryParams);
            await JSRuntime.InvokeVoidAsync("history.replaceState", null, "", url);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to sync wizard step to URL address bar.");
        }
        #endregion
    }

    private async Task OnLevelChangedAsync(int value)
    {
        #region hide [2026-09-15]
        _level = value switch
        {
            2 => eTopicLevel.Company,
            3 => eTopicLevel.Facility,
            _ => eTopicLevel.Corporate
        };
        _targetId = 0;
        _fr01OrgTitle = string.Empty;
        _fr01CertifierOrg = string.Empty;
        _fr01GhgTeam = $"{_level} GHG Team";
        ResetDownstreamData();
        await LoadTargetOptionsAsync();
        #endregion
    }

    private void OnTargetChanged(int value)
    {
        #region hide [2026-09-15]
        _targetId = value;
        _fr01OrgTitle = GetSelectedTargetTitle();
        _fr01CertifierOrg = _fr01OrgTitle;
        ResetDownstreamData();
        #endregion
    }

    private void OnCalculateYearChanged(int value)
    {
        #region hide [2026-09-15]
        _selectedCalculateYear = value;
        if (_title.StartsWith("GHG Emissions Report Year", StringComparison.OrdinalIgnoreCase))
        {
            _title = $"GHG Emissions Report Year {_selectedCalculateYear}";
        }
        ResetDownstreamData();
        #endregion
    }

    private void OnBaseYearChanged(int value)
    {
        #region hide [2026-09-15]
        _selectedBaseYear = value;
        ResetDownstreamData();
        #endregion
    }
    #endregion

    #region Snapshot Generation
    private async Task GenerateSnapshotAsync()
    {
        #region hide [2026-09-15]
        // Re-validate all prior steps before generating
        var originalStep = _activeStep;
        for (int i = 0; i <= 2; i++)
        {
            _activeStep = i;
            if (!ValidateCurrentStep())
            {
                StateHasChanged();
                await SyncStepToUrlAsync();
                return;
            }
        }
        _activeStep = originalStep;

        try
        {
            _isSaving = true;
            _errorMessage = null;

            var overrides = new CfoReportService.CfoReportOverridesDto
            {
                OrganizationTitle = _fr01OrgTitle,
                GhgTeamName = _fr01GhgTeam,
                CertifierOrgTitle = _fr01CertifierOrg
            };

            var doc = await ReportStorageService.CreateReportSnapshotAsync(
                _level,
                _targetId,
                _title,
                _selectedBaseYear,
                _selectedCalculateYear,
                _createdBy,
                _allowedSubscriptionIds,
                _acknowledgmentReason,
                overrides);

            NotificationService.Notify(NotificationSeverity.Success, "Snapshot Verified & Locked",
                $"Successfully generated and locked audit report snapshot '{doc.Title}'.");

            NavigateToBack();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating CFO report snapshot.");
            _errorMessage = $"Failed to create report snapshot: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
        #endregion
    }
    #endregion

    #region Helper Formatting
    private string GetSelectedTargetTitle()
    {
        return _targetOptions.FirstOrDefault(o => o.Value == _targetId)?.Text ?? "-";
    }

    private string GetCalculatePeriodText()
    {
        return _selectedCalculateYear > 0 ? $"1 Jan {_selectedCalculateYear} - 31 Dec {_selectedCalculateYear}" : "Historical";
    }

    private string GetBasePeriodText()
    {
        return _selectedBaseYear > 0 ? $"1 Jan {_selectedBaseYear} - 31 Dec {_selectedBaseYear}" : "-";
    }

    private string GetQuotaCardClass(int count, int quota)
    {
        bool isOverflow = count > quota;
        return isOverflow
            ? "shadow-sm border rounded-3 p-3 h-100 border-start border-4 border-warning bg-warning-subtle"
            : "shadow-sm border rounded-3 p-3 h-100 border-start border-4 border-success bg-white";
    }

    private string GetScopeBadgeClass(eTgoScopeNo scope)
    {
        return scope switch
        {
            eTgoScopeNo.Scope1 => "bg-danger-subtle text-danger border",
            eTgoScopeNo.Scope2 => "bg-primary-subtle text-primary border",
            eTgoScopeNo.Scope3 => "bg-info-subtle text-info border",
            _ => "bg-secondary-subtle text-secondary border"
        };
    }

    private bool IsLineOverflow(CfoReportService.ActivityAuditLineDto item, List<CfoReportService.ActivityAuditLineDto> allLines)
    {
        var scopeLines = allLines.Where(l => l.ScopeNo == item.ScopeNo).ToList();
        int capacity = item.ScopeNo switch
        {
            eTgoScopeNo.Scope1 => Fr04Scope1Capacity,
            eTgoScopeNo.Scope2 => Fr04Scope2Capacity,
            eTgoScopeNo.Scope3 => Fr04Scope3Capacity,
            _ => Fr04SeparateCapacity
        };
        int indexInScope = scopeLines.IndexOf(item);
        return scopeLines.Count > capacity && indexInScope >= (capacity - 1);
    }

    private string GetDeltaColorClass(decimal value)
    {
        if (value > 0) return "text-danger fw-bold";
        if (value < 0) return "text-success fw-bold";
        return "text-secondary";
    }
    #endregion

    #region Navigation
    private void NavigateToBack()
    {
        #region hide [2026-09-15]
        try
        {
            if (!string.IsNullOrWhiteSpace(_returnUrl))
            {
                NavigationManager.NavigateTo(_returnUrl, replace: true);
                return;
            }

            var queryParams = new Dictionary<string, object?>
            {
                ["level"] = (int)_level
            };

            if (_targetId > 0)
                queryParams["id"] = DataProtection.Protect(_targetId);

            var url = NavigationManager.GetUriWithQueryParameters("/reports/cfo-reports", queryParams);
            NavigationManager.NavigateTo(url, replace: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error navigating back from AddEditCfoReport.");
            NavigationManager.NavigateTo("/reports/cfo-reports");
        }
        #endregion
    }

    private void NavigateToRevision()
    {
        #region hide [2026-09-15]
        var queryParams = new Dictionary<string, object?>
        {
            ["level"] = (int)_level,
            ["cy"] = DataProtection.Protect(_selectedCalculateYear),
            ["by"] = DataProtection.Protect(_selectedBaseYear)
        };

        if (_targetId > 0)
            queryParams["id"] = DataProtection.Protect(_targetId);

        if (_selectedSubscriptionId.HasValue)
            queryParams["sid"] = DataProtection.Protect(_selectedSubscriptionId.Value);

        var url = NavigationManager.GetUriWithQueryParameters("/reports/cfo-report/add", queryParams);
        NavigationManager.NavigateTo(url);
        #endregion
    }

    private void NavigateToTopics()
    {
        #region hide [2026-09-15]
        var queryParams = new Dictionary<string, object?>
        {
            ["level"] = (int)_level
        };
        if (_targetId > 0) queryParams["id"] = DataProtection.Protect(_targetId);
        var url = NavigationManager.GetUriWithQueryParameters("/library/activity-topics", queryParams);
        NavigationManager.NavigateTo(url);
        #endregion
    }
    #endregion

