@page "/reports/cfo-report/add"
@page "/reports/cfo-report/view/{SecureId}"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.DataProtection
@using TU.ACAMP.Domain.Enums
@using TU.ACAMP.Domain.Identity
@using TU.ACAMP.Domain.Models.Organization
@using TU.ACAMP.Domain.Tools
@using TU.ACAMP.WebApp.Components.Pages.Reports.Widgets
@using TU.ACAMP.WebApp.Services.Common
@using TU.ACAMP.WebApp.Services.Identity
@using TU.ACAMP.WebApp.Services.Organization
@using TU.ACAMP.WebApp.Services.Reports

@attribute [Authorize]
@implements IDisposable

@inject CfoReportService CfoReportService
@inject CfoReportStorageService ReportStorageService
@inject CorporateService CorporateService
@inject CompanyService CompanyService
@inject FacilityService FacilityService
@inject SubscriptionService SubscriptionService
@inject NavigationManager NavigationManager
@inject IDataProtectionProvider DataProtection
@inject NotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<AddEditCfoReport3> Logger

<PageTitle>@(_isViewMode ? "View CFO Report" : "New CFO Report") - ACAMP</PageTitle>
<style>
    /* [2026-09-15][Antigravity] Disable pointer clicks on step header items so navigation occurs strictly via Next/Back */
    .cfo-wizard-steps .rz-steps-items {
        pointer-events: none !important;
    }

    /* [2026-09-17][Claude] Overlay ของ Progress Bar — ลอยเหนือทุกอย่าง เห็นได้ไม่ว่าจะ scroll อยู่ตรงไหน */
    .cfo-progress-overlay {
        position: fixed;
        inset: 0;
        z-index: 2000;
        background: rgba(15, 23, 42, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

    /* [2026-09-18][Claude] ให้แถบเลื่อนแบบมีทรานซิชัน ไม่กระโดดเป็นช่วง ๆ */
    .cfo-progress-panel .rz-progressbar-value,
    .cfo-progress-panel .rz-progressbar .rz-progressbar-value {
        transition: width 0.28s ease-out;
    }

    .cfo-progress-panel {
        width: 100%;
        max-width: 480px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        padding: 1.25rem 1.5rem;
    }
</style>
<RadzenStack Orientation="Orientation.Vertical"
             Style="width: 100%;"
             Class="rz-p-3 rz-px-4">
    <!-- Child content -->
    <!-- ===================== TOP HEADER ===================== -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center mb-1">
                <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                              Size="ButtonSize.Small" Click="@NavigateToBack" Class="me-2" Style="border-radius: 6px;"
                              Title="Back to Report Ledger" />
                <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" Class="m-0 fw-bold" Style="color: var(--rz-text-title-color);">
                    @(_isViewMode ? "View Verification Report" : "New Verification Report")
                </RadzenText>
            </div>
            <div class="d-flex align-items-center gap-2 ms-5 flex-wrap">
                <RadzenText TextStyle="TextStyle.Body2" Class="text-muted m-0">
                    TGO CFO (AR5) verification wizard — sequential step-by-step audit inspection.
                </RadzenText>
                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="TCFO_R_01 v07 (AR5)" IsPill="true" Class="px-2" Style="font-size: 0.72rem; font-weight: 600;" />
                @if (_isViewMode && _loadedDoc != null)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Locked Snapshot" IsPill="true" Class="px-2" Style="font-size: 0.72rem; font-weight: 600;" />
                }
            </div>
        </div>

        @if (_isViewMode && _loadedDoc != null)
        {
            @* [2026-09-24][Claude] ตัดปุ่ม Create Revision (BOSS สั่ง) — แก้รายงานไม่ได้ ต้องสร้างรายงานใหม่จากหน้า Ledger เท่านั้น *@
            <div class="d-flex gap-2">
                <RadzenButton Text="Back to Ledger" Icon="list" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined"
                              Click="@NavigateToBack" Style="border-radius: 6px;" />
            </div>
        }
    </div>
    @if (_isLoading)
    {
        <div class="d-flex flex-column justify-content-center align-items-center w-100" style="min-height: 60vh;">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <RadzenText Text="Loading report form..." TextStyle="TextStyle.Body2" Class="text-muted mt-3" />
        </div>
    }
    else if (_isViewMode)
    {
        <!-- ===================== VIEW MODE (LOCKED SNAPSHOT) ===================== -->
        @* [2026-09-18][Claude] เดิมบล็อกนี้ว่าง ทำให้ route view/{SecureId} เรนเดอร์หน้าเปล่า *@
        <CfoSnapshotViewWidget Doc="@_loadedDoc" OnBack="@NavigateToBack" />
    }
    else
    {
        <!-- ===================== WIZARD (ADD / EDIT MODE) ===================== -->
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" Size="AlertSize.Small" Class="mb-3">
                @_errorMessage
            </RadzenAlert>
        }
        @* [2026-09-17][Claude] Progress bar ระหว่างคำนวณ/สร้างไฟล์รายงาน (overlay กลางจอ ไม่หายไปตามการ scroll) *@
        @if (_showProgress)
        {
            <div class="cfo-progress-overlay">
                <div class="cfo-progress-panel">
                    <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Class="fw-bold mb-0">
                            <RadzenIcon Icon="hourglass_top" Class="me-1" />@_progressLabel
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" Class="text-muted mb-0">@_progressPercent%</RadzenText>
                    </div>
                    <RadzenProgressBar Value="@_progressPercent" Max="100" Mode="ProgressBarMode.Determinate" ShowValue="false"
                                       Unit="%" Style="width: 100%;" />
                    <RadzenText TextStyle="TextStyle.Caption" Class="text-muted mb-0 mt-2 d-block">
                        Please keep this page open until the report is ready.
                    </RadzenText>
                </div>
            </div>
        }
        <RadzenCard Class="shadow-sm border rounded-3 bg-white p-4 mb-3">
            <RadzenSteps @bind-SelectedIndex="@_activeStep" Change="@OnStepChangedAsync" ShowStepsButtons="false" Class="cfo-wizard-steps">
                <Steps>
                    <!-- STEP 1 (Index 0): SETUP WIDGET -->
                    <RadzenStepsItem Text="1. Setup">
                        <CfoSetupWidget Level="@_level" LevelChanged="@OnLevelChangedAsync"
                                        TargetId="@_targetId" TargetIdChanged="@OnTargetChanged"
                                        Title="@_title" TitleChanged="@((string val) => _title = val)"
                                        CreatedBy="@_createdBy" CreatedByChanged="@((string val) => _createdBy = val)"
                                        SelectedCalculateYear="@_selectedCalculateYear"
                                        SelectedCalculateYearChanged="@OnCalculateYearChanged"
                                        SelectedBaseYear="@_selectedBaseYear"
                                        SelectedBaseYearChanged="@OnBaseYearChanged"
                                        ConsolidationApproach="@_consolidationApproach"
                                        ConsolidationApproachChanged="@((string val) => _consolidationApproach = val)"
                                        MaterialityThreshold="@_materialityThreshold"
                                        MaterialityThresholdChanged="@((decimal val) => _materialityThreshold = val)"
                                        LevelOptions="@_levelOptions"
                                        TargetOptions="@_targetOptions"
                                        InScopeChildOptions="@_inScopeChildOptions"
                                        SelectedInScopeChildIds="@_selectedInScopeChildIds"
                                        SelectedInScopeChildIdsChanged="@OnInScopeChildIdsChanged"
                                        CalculateYearOptions="@_calculateYearOptions"
                                        BaseYearOptions="@_baseYearOptions"
                                        ConsolidationOptions="@_consolidationOptions" />
                    </RadzenStepsItem>
                    <!-- STEP 2 (Index 1): FR-01 DETAILS WIDGET -->
                    <RadzenStepsItem Text="2. Fr-01 Organization">
                        <CfoFr01DetailsWidget OrgTitle="@_fr01OrgTitle" OrgTitleChanged="@((string val) => _fr01OrgTitle = val)"
                                              GhgTeam="@_fr01GhgTeam" GhgTeamChanged="@((string val) => _fr01GhgTeam = val)"
                                              PreparationDate="@_fr01PreparationDate" PreparationDateChanged="@((DateTime? val) => _fr01PreparationDate = val)"
                                              OrgImageBase64="@_fr01ImageBase64" OrgImageBase64Changed="@((string? val) => _fr01ImageBase64 = val)"
                                              CalculatePeriodText="@GetCalculatePeriodText()" CalculatePeriodTextChanged="@((string val) => _fr01CalculatePeriodText = val)"
                                              CalcProductItems="@_fr01CalcProductItems" CalcProductItemsChanged="@((List<CfoReportService.CfoProductItemDto> val) => _fr01CalcProductItems = val)"
                                              BasePeriodText="@GetBasePeriodText()" BasePeriodTextChanged="@((string val) => _fr01BasePeriodText = val)"
                                              BaseProductItems="@_fr01BaseProductItems" BaseProductItemsChanged="@((List<CfoReportService.CfoProductItemDto> val) => _fr01BaseProductItems = val)"
                                              OrgInfoMultiLine="@_fr01OrgInfoMultiLine" OrgInfoMultiLineChanged="@((string val) => _fr01OrgInfoMultiLine = val)"
                                              ContactAddress="@_fr01ContactAddress" ContactAddressChanged="@((string val) => _fr01ContactAddress = val)"
                                              RegistrationDate="@_fr01RegistrationDate" RegistrationDateChanged="@((DateTime? val) => _fr01RegistrationDate = val)"
                                              Scope1Summary="@_fr01Scope1Summary"
                                              Scope2Summary="@_fr01Scope2Summary"
                                              Scope3Summary="@_fr01Scope3Summary" />
                    </RadzenStepsItem>
                    <!-- STEP 3 (Index 2): FR-02 ORGANIZATION DIAGRAM WIDGET -->
                    <RadzenStepsItem Text="3. Fr-02 Diagram">
                        <CfoFr02ChartWidget DiagramImageBase64="@_fr02ImageBase64" DiagramImageBase64Changed="@((string? val) => _fr02ImageBase64 = val)"
                                            DiagramDate="@_fr02DiagramDate" DiagramDateChanged="@((DateTime? val) => _fr02DiagramDate = val)" />
                    </RadzenStepsItem>
                    <!-- STEP 4 (Index 3): FR-03.1 ORGANIZATIONAL STRUCTURE WIDGET -->
                    <RadzenStepsItem Text="4. Fr-03.1 Structure">
                        <CfoFr031StructureWidget StructureImageBase64="@_fr031ImageBase64" StructureImageBase64Changed="@((string? val) => _fr031ImageBase64 = val)"
                                                 DiagramDate="@_fr031DiagramDate" DiagramDateChanged="@((DateTime? val) => _fr031DiagramDate = val)"
                                                 CompletionDate="@_fr031CompletionDate" CompletionDateChanged="@((DateTime? val) => _fr031CompletionDate = val)" />
                    </RadzenStepsItem>
                    <!-- STEP 5 (Index 4): FR-03.2 SCOPE 3 SIGNIFICANCE WIDGET -->
                    <RadzenStepsItem Text="5. Fr-03.2 Significance">
                        <CfoFr032SignificanceWidget Categories="@_fr032Categories" MaterialityThreshold="@_materialityThreshold" OrganizationTitle="@_fr01OrgTitle" />
                    </RadzenStepsItem>
                    <!-- STEP 6 (Index 5): FR-04.1 GHG INVENTORY (CALCULATE YEAR) WIDGET -->
                    <RadzenStepsItem Text="6. Fr-04.1 Inventory">
                        @* [2026-09-18][Claude] Pre-flight + ช่องกรอก Audit Acknowledgment Reason
                           ต้องอยู่ในสเต็ปนี้ เพราะ ValidateCurrentStep case 5 บังคับค่านี้เมื่อพบ EF หมดอายุ *@
                        <CfoPreflightWidget IsPreflighting="@_isPreflighting"
                                            CalcReport="@_calcReport"
                                            ExpiredEfList="@_expiredEfList"
                                            OverflowWarnings="@_calcOverflowWarnings"
                                            HasEfSourceMismatch="@_hasEfSourceMismatch"
                                            SelectedCalculateYear="@_selectedCalculateYear"
                                            SelectedBaseYear="@EffectiveBaseYear"
                                            AcknowledgmentReason="@_acknowledgmentReason"
                                            AcknowledgmentReasonChanged="@OnAcknowledgmentReasonChanged"
                                            OnRerunPreflight="@(EventCallback.Factory.Create(this, RunPreflightAsync))" />
                        <hr class="my-3" />
                        <CfoFr041InventoryWidget SelectedCalculateYear="@_selectedCalculateYear"
                                                 CalcReport="@_calcReport"
                                                 OnNavigateToTopics="@(EventCallback.Factory.Create(this, NavigateToTopics))" />
                    </RadzenStepsItem>
                    <!-- STEP 7 (Index 6): FR-04.2 GHG INVENTORY (BASE YEAR) WIDGET -->
                    <RadzenStepsItem Text="7. Fr-04.2 Base Year">
                        <CfoFr042InventoryWidget SelectedBaseYear="@EffectiveBaseYear"
                                                 IsAutoBaseYear="@(_selectedBaseYear <= 0)"
                                                 BaseReport="@_baseReport"
                                                 Scope1Count="@_baseScope1Count"
                                                 SepCount="@_baseSepCount"
                                                 Scope2Count="@_baseScope2Count"
                                                 Scope3Count="@_baseScope3Count" />
                    </RadzenStepsItem>
                </Steps>
            </RadzenSteps>
        </RadzenCard>

        <!-- ===================== WIZARD NAVIGATION BAR ===================== -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                          Click="@NavigateToBack" Disabled="@(_isSaving || _isPreflighting)" Style="border-radius: 6px;" />

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <RadzenButton Text="Back" Icon="chevron_left" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                              Click="@GoPreviousStep" Disabled="@(_activeStep == 0 || _isSaving || _isPreflighting)" Style="border-radius: 6px;" />

                @if (_activeStep < LastStepIndex)
                {
                    <RadzenButton Text="Next" Icon="chevron_right" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat"
                                  Click="@GoNextStepAsync" Disabled="@(_isSaving || _isPreflighting)" IsBusy="@_isPreflighting" Style="border-radius: 6px; font-weight: 600;" />
                }

                @* [2026-09-18][Claude] ทุกสเต็ปเติมค่าอัตโนมัติได้หมดแล้ว (Fr-01 defaults, Fr-03.2 auto source + auto score,
                   ปีฐาน auto fallback) จึงเปิดปุ่มสร้างรายงานตั้งแต่สเต็ปแรก ผู้ใช้ที่รับค่าอัตโนมัติทั้งหมดไม่ต้องเดินครบ 7 สเต็ป
                   ปุ่มนี้ยังตรวจทุกสเต็ปก่อนสร้าง และรัน Pre-flight ให้เองถ้ายังไม่เคยรัน *@
                <RadzenButton Text="@(_isSaving ? "Generating Report..." : "Generate Report")"
                              Icon="@(_isSaving ? "" : "task_alt")"
                              ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                              Click="@GenerateSnapshotAsync" Disabled="@(_isSaving || _isPreflighting)" IsBusy="@_isSaving"
                              Title="สร้างรายงานด้วยค่าอัตโนมัติทั้งหมด โดยไม่ต้องเดินครบทุกสเต็ป"
                              Style="border-radius: 6px; font-weight: 600;" />
            </div>
        </div>
    }
</RadzenStack>

@code {
    #region class field
    // [2026-09-17][Claude] จำนวนสเต็ปที่เรนเดอร์จริงตอนนี้คือ 6 สเต็ป (Setup, Fr-01, Fr-02, Fr-03.1, Fr-03.2, Fr-04.1)
    private const int LastStepIndex = 6;

    private const int Fr04Scope1Capacity = 14;   // rows 10..23
    private const int Fr04SeparateCapacity = 5;  // rows 25..29
    private const int Fr04Scope2Capacity = 4;    // rows 31..34
    private const int Fr04Scope3Capacity = 7;    // rows 36..42

    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _isPreflighting = false;
    private bool _isViewMode = false;
    private int _activeStep = 0;
    private string? _errorMessage;
    private string? _returnUrl;

    private eTopicLevel _level = eTopicLevel.Corporate;
    private int _targetId = 0;
    private int? _selectedSubscriptionId;
    private HashSet<int> _allowedSubscriptionIds = new();

    // Step 1: Setup fields
    private string _title = string.Empty;
    private string _createdBy = "Corporate GHG Team";
    private int _selectedCalculateYear = 0;
    private int _selectedBaseYear = 0;

    // [2026-09-17][Claude] ไม่บังคับให้เลือกปีฐาน: ถ้าผู้ใช้ไม่เลือก (0) ให้ใช้ปีคำนวณเป็นปีฐานอัตโนมัติ
    private int EffectiveBaseYear => _selectedBaseYear > 0 ? _selectedBaseYear : _selectedCalculateYear;
    private string _consolidationApproach = "Operational Control";
    private decimal _materialityThreshold = 5.0m;
    private string _acknowledgmentReason = string.Empty;

    // Step 2: Fr-01 Overrides
    private string _fr01OrgTitle = string.Empty;
    private string _fr01GhgTeam = string.Empty;
    // [2026-09-25][Gemini] กำหนดวันที่ปัจจุบัน (AppTimeZone.LocalNow.Date) เป็นค่า default อัตโนมัติ
    private DateTime? _fr01PreparationDate = AppTimeZone.LocalNow.Date;
    private string? _fr01ImageBase64;
    private string _fr01CalculatePeriodText = string.Empty;
    // [2026-09-16][Antigravity] Product amount items for Calculate Year and Base Year with ProductName
    private List<CfoReportService.CfoProductItemDto> _fr01CalcProductItems = new()
    {
        new() { Index = 1, ProductName = "Primary Product", Amount = 0m, Unit = "Tonnes" }
    };
    private string _fr01BasePeriodText = string.Empty;
    private List<CfoReportService.CfoProductItemDto> _fr01BaseProductItems = new()
    {
        new() { Index = 1, ProductName = "Primary Product", Amount = 0m, Unit = "Tonnes" }
    };
    // [2026-09-24][Claude] เดิมตั้งค่าเริ่มต้นเป็นข้อความตัวอย่าง (เช่น "ISO 14064-1:2018 verified", "2 shifts per day") ซึ่งไม่ใช่ข้อมูลจากระบบ
    // แต่หลุดลง Fr-01 G31-G35 ของรายงานจริง — ตามข้อตกลง ช่องที่ระบบไม่มีข้อมูลให้เว้นว่างตามฟอร์มเดิม
    private string _fr01OrgInfoMultiLine = string.Empty;
    private string _fr01ContactAddress = string.Empty;
    private DateTime? _fr01RegistrationDate = AppTimeZone.LocalNow.Date;
    private string _fr01CertifierOrg = string.Empty;
    // [2026-09-17][Claude] สถานะ Progress Bar ของการคำนวณ/ส่งออกรายงาน
    private bool _showProgress = false;
    private int _progressPercent = 0;
    private int _progressTarget = 0;
    private string _progressLabel = string.Empty;
    private CancellationTokenSource? _progressCreepCts;

    // [2026-09-17][Claude] Step 3: Fr-02 Organization Diagram Overrides
    private string? _fr02ImageBase64;
    private DateTime? _fr02DiagramDate = AppTimeZone.LocalNow.Date;

    // [2026-09-17][Claude] Step 4: Fr-03.1 Organizational Structure Overrides
    private string? _fr031ImageBase64;
    private DateTime? _fr031DiagramDate = AppTimeZone.LocalNow.Date;
    private DateTime? _fr031CompletionDate = AppTimeZone.LocalNow.Date;

    // [2026-09-17][Claude] Step 5: Fr-03.2 Scope 3 Significance (15 หมวดตามเทมเพลต แถว 19..33)
    private List<CfoReportService.CfoFr032CategoryDto> _fr032Categories = BuildDefaultFr032Categories();

    /// <summary>
    /// [2026-09-17][Claude] เติมค่า Magnitude (คอลัมน์ D ของ Fr-03.2) จากผลคำนวณจริง
    /// ใช้เมธอดเดียวกับตอน export เพื่อให้ตัวเลขบนหน้าจอกับในไฟล์ Excel ตรงกัน
    /// </summary>
    private void SyncFr032Magnitudes()
    {
        var magnitudes = _calcReport != null
            ? CfoReportService.GetFr032MagnitudePercents(_calcReport)
            : new Dictionary<int, decimal>();

        // [2026-09-18][Claude] เติม Magnitude แล้วติ๊ก "มีแหล่งปล่อย" อัตโนมัติให้หมวดที่มีการปล่อยจริง
        // (ตรรกะเดียวกับตอนเขียนไฟล์ Excel — Fr032Rubric.ApplyAutoSource)
        CfoReportService.Fr032Rubric.ApplyAutoSource(_fr032Categories, magnitudes);

        // [2026-09-18][Claude] เติมคะแนนเริ่มต้นให้เกณฑ์เชิงคุณภาพที่ยังไม่ได้เลือก (ค่าที่ผู้ใช้กรอกเองมาก่อนเสมอ)
        CfoReportService.Fr032Rubric.ApplyAutoScores(_fr032Categories, _materialityThreshold);
    }

    // [2026-09-25][Antigravity] ใช้ CreateDefaultCategories จาก Fr032Rubric เป็นจุดเดียว
    private static List<CfoReportService.CfoFr032CategoryDto> BuildDefaultFr032Categories()
        => CfoReportService.Fr032Rubric.CreateDefaultCategories();


    private string _fr01Scope1Summary = "-";
    private string _fr01Scope2Summary = "-";
    private string _fr01Scope3Summary = "-";

    // Pre-flight & Verification Data
    private CfoReportService.CfoAuditReportDto? _calcReport;
    private CfoReportService.CfoAuditReportDto? _baseReport;
    private MultiYearComparisonDto? _comparisonDto;
    private List<CfoReportService.ActivityAuditLineDto> _expiredEfList = new();
    private List<CfoPreflightWidget.QuotaOverflow> _calcOverflowWarnings = new();
    private bool _hasEfSourceMismatch = false;

    // Quota counts
    private int _calcScope1Count = 0;
    private int _calcSepCount = 0;
    private int _calcScope2Count = 0;
    private int _calcScope3Count = 0;

    private int _baseScope1Count = 0;
    private int _baseSepCount = 0;
    private int _baseScope2Count = 0;
    private int _baseScope3Count = 0;

    private CfoReportDocument? _loadedDoc;

    private List<CfoSetupWidget.OptionItemDto> _levelOptions = new();
    private List<CfoSetupWidget.OptionItemDto> _targetOptions = new();
    // [2026-09-16][Antigravity] In-Scope Organizational Boundary (Option 1)
    private List<CfoSetupWidget.OptionItemDto> _inScopeChildOptions = new();
    private IEnumerable<int> _selectedInScopeChildIds = Enumerable.Empty<int>();

    private List<int> _calculateYearOptions = new();
    private List<CfoSetupWidget.OptionItemDto> _baseYearOptions = new();
    private List<string> _consolidationOptions = new() { "Operational Control", "Financial Control", "Equity Share" };
    #endregion
    #region class properties
    [Parameter] public string? SecureId { get; set; }

    [SupplyParameterFromQuery(Name = "id")]
    public string? SecureTargetId { get; set; }

    [SupplyParameterFromQuery(Name = "level")]
    public int LevelValue { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "sid")]
    public string? SecureSubscriptionId { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    public string? SecureTab { get; set; }

    [SupplyParameterFromQuery(Name = "cy")]
    public string? SecureCalculateYear { get; set; }

    [SupplyParameterFromQuery(Name = "by")]
    public string? SecureBaseYear { get; set; }

    [SupplyParameterFromQuery(Name = "ret")]
    public string? SecureRet { get; set; }
    #endregion
    #region class method
    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        #region hide [2026-09-15]
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var isAdmin = user.IsInRole(SystemRoles.Administrator);
            var email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                     ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                     ?? user.Identity?.Name;

            if (!string.IsNullOrEmpty(email))
            {
                var userSubs = await SubscriptionService.GetSubscriptionsForUserAsync(email, isAdmin);
                _allowedSubscriptionIds = userSubs.Select(s => s.Id).ToHashSet();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing user subscriptions for AddEditCfoReport.");
        }

        BuildStaticOptions();
