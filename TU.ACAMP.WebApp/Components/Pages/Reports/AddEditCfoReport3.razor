    #region Snapshot Generation
    // [2026-09-18][Claude] เดิม (16 ก.ย.) เมธอดนี้ลัดขั้นตอน: เรียก ExportToExcel แล้วดาวน์โหลดไฟล์ตรง ๆ
    // ไม่ผ่าน storage pipeline จึงไม่มี report item ในทะเบียน และไม่มี snapshot.json
    // ตอนนี้กลับมาใช้ CreateReportSnapshotAsync เหมือนเดิม: สร้างรายการรายงาน + เก็บไฟล์ แล้วกลับไปหน้า Ledger
    private async Task GenerateSnapshotAsync()
    {
        if (_targetId <= 0)
        {
            _errorMessage = "Please select a target organization before generating the report.";
            _activeStep = 0;
            StateHasChanged();
            await SyncStepToUrlAsync();
            return;
        }
        if (_selectedCalculateYear <= 0)
        {
            _errorMessage = "Please select a calculate / reporting year before generating the report.";
            _activeStep = 0;
            StateHasChanged();
            await SyncStepToUrlAsync();
            return;
        }
        if (_selectedBaseYear > 0 && _selectedBaseYear >= _selectedCalculateYear)
        {
            _errorMessage = "The base year must be earlier than the calculate year.";
            _activeStep = 0;
            StateHasChanged();
            await SyncStepToUrlAsync();
            return;
        }

        // [2026-09-18][Claude] กดจากสเต็ปแรกได้ — ถ้ายังไม่เคยรัน Pre-flight ให้รันให้ก่อน
        // เพื่อให้ได้ผลเหมือนเดินครบทุกสเต็ป (เติมค่า Fr-01, Magnitude/คะแนน Fr-03.2, ตรวจ EF หมดอายุ)
        if (_calcReport == null)
        {
            await RunPreflightAsync();
            if (!string.IsNullOrWhiteSpace(_errorMessage)) return;
        }

        // ตรวจทุกสเต็ปอีกครั้งก่อนปิดงาน (พฤติกรรมเดิมของ AddEditCfoReport.razor)
        var originalStep = _activeStep;
        for (int i = 0; i <= LastStepIndex; i++)
        {
            _activeStep = i;
            if (!ValidateCurrentStep())
            {
                StateHasChanged();
                await SyncStepToUrlAsync();
                return;
            }
        }
        _activeStep = originalStep;

        try
        {
            _isSaving = true;
            _errorMessage = null;

            // [2026-09-18][Claude] เปิดตัวไต่ตัวเลขก่อน เพื่อให้แถบขยับต่อเนื่องระหว่างงานหนักแต่ละขั้น
            StartProgressCreep();
            await SetProgressAsync(5, "Preparing report settings...");

            var targetTitle = GetSelectedTargetTitle();
            var finalOrgTitle = string.IsNullOrWhiteSpace(_fr01OrgTitle) ? targetTitle : _fr01OrgTitle;
            var overrides = new CfoReportService.CfoReportOverridesDto
            {
                OrganizationTitle = finalOrgTitle,
                GhgTeamName = string.IsNullOrWhiteSpace(_fr01GhgTeam) ? $"{_level} GHG Team" : _fr01GhgTeam,
                CertifierOrgTitle = string.IsNullOrWhiteSpace(_fr01CertifierOrg) ? finalOrgTitle : _fr01CertifierOrg,
                PreparationDate = _fr01PreparationDate ?? AppTimeZone.LocalNow.Date,
                OrganizationImageBase64 = _fr01ImageBase64,
                CalculatePeriodText = GetCalculatePeriodText(),
                CalculateProductionAmount = _fr01CalcProductItems.Sum(x => x.Amount),
                CalculateProductionUnit = _fr01CalcProductItems.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.Unit))?.Unit ?? "Tonnes",
                CalcProductItems = _fr01CalcProductItems,
                BasePeriodText = GetBasePeriodText(),
                BaseProductionAmount = _fr01BaseProductItems.Sum(x => x.Amount),
                BaseProductionUnit = _fr01BaseProductItems.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.Unit))?.Unit ?? "Tonnes",
                BaseProductItems = _fr01BaseProductItems,
                OrgInfoMultiLine = _fr01OrgInfoMultiLine,
                ContactAddress = string.IsNullOrWhiteSpace(_fr01ContactAddress) ? finalOrgTitle : _fr01ContactAddress,
                RegistrationDate = _fr01RegistrationDate ?? AppTimeZone.LocalNow.Date,
                Fr02ImageBase64 = _fr02ImageBase64,
                Fr02DiagramDate = _fr02DiagramDate ?? _fr01PreparationDate ?? AppTimeZone.LocalNow.Date,
                Fr031ImageBase64 = _fr031ImageBase64,
                Fr031DiagramDate = _fr031DiagramDate ?? _fr01PreparationDate ?? AppTimeZone.LocalNow.Date,
                Fr031CompletionDate = _fr031CompletionDate ?? AppTimeZone.LocalNow.Date,
                Fr032Categories = _fr032Categories,
                FocusSheetName = "Fr-01",
                OnlyFr01Sheet = false
            };

            var inScopeIds = _selectedInScopeChildIds?.ToList();
            var inScopeTitles = inScopeIds == null
                ? null
                : _inScopeChildOptions.Where(o => inScopeIds.Contains(o.Value)).Select(o => o.Text).ToList();

            // ใช้ผลคำนวณที่ pre-flight ทำไว้แล้ว ถ้ายังไม่มี ปล่อยให้ storage service คำนวณเองพร้อมรายงานความคืบหน้า
            // ไม่เลือกปีฐาน = ใช้ผลปีคำนวณเป็นปีฐาน (auto fallback เดิม)
            if (_baseReport == null && _selectedBaseYear <= 0) _baseReport = _calcReport;

            await SetProgressAsync(8, "Verifying report data...");

            var reportTitle = string.IsNullOrWhiteSpace(_title)
                ? $"GHG Emissions Report Year {_selectedCalculateYear}"
                : _title;

            var doc = await ReportStorageService.CreateReportSnapshotAsync(
                _level,
                _targetId,
                reportTitle,
                EffectiveBaseYear,
                _selectedCalculateYear,
                _createdBy,
                _allowedSubscriptionIds,
                _acknowledgmentReason,
                overrides,
                inScopeIds,
                inScopeTitles,
                _materialityThreshold,
                _calcReport,
                _baseReport,
                // แต่ละขั้นในไปป์ไลน์ (คำนวณ → สร้าง workbook → เขียนไฟล์ → อัปเดตทะเบียน) รายงานกลับมาที่แถบนี้
                new Progress<(int Percent, string Label)>(p => SetProgressTarget(p.Percent, p.Label)));

            await SetProgressAsync(100, "Report generated.");
            await Task.Delay(500);

            NotificationService.Notify(NotificationSeverity.Success, "Snapshot Verified & Locked",
                $"Successfully generated and locked audit report snapshot '{doc.Title}'.");


            NavigateToBack();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating CFO report snapshot.");
            _errorMessage = $"Failed to create report snapshot: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
            await ClearProgressAsync();
        }
    }
    #endregion

    #region Helper Formatting
    private string GetSelectedTargetTitle()
    {
        return _targetOptions.FirstOrDefault(o => o.Value == _targetId)?.Text ?? "-";
    }

    private string GetCalculatePeriodText()
    {
        if (!string.IsNullOrWhiteSpace(_fr01CalculatePeriodText)) return _fr01CalculatePeriodText;
        return _selectedCalculateYear > 0 ? $"1 Jan {_selectedCalculateYear} - 31 Dec {_selectedCalculateYear}" : "Historical";
    }

    private string GetBasePeriodText()
    {
        if (!string.IsNullOrWhiteSpace(_fr01BasePeriodText)) return _fr01BasePeriodText;
        return EffectiveBaseYear > 0 ? $"1 Jan {EffectiveBaseYear} - 31 Dec {EffectiveBaseYear}" : "-";
    }

    private string GetQuotaCardClass(int count, int quota)
    {
        bool isOverflow = count > quota;
        return isOverflow
            ? "shadow-sm border rounded-3 p-3 h-100 border-start border-4 border-warning bg-warning-subtle"
            : "shadow-sm border rounded-3 p-3 h-100 border-start border-4 border-success bg-white";
    }

    private string GetScopeBadgeClass(eTgoScopeNo scope)
    {
        return scope switch
        {
            eTgoScopeNo.Scope1 => "bg-danger-subtle text-danger border",
            eTgoScopeNo.Scope2 => "bg-primary-subtle text-primary border",
            eTgoScopeNo.Scope3 => "bg-info-subtle text-info border",
            _ => "bg-secondary-subtle text-secondary border"
        };
    }

    private bool IsLineOverflow(CfoReportService.ActivityAuditLineDto item, List<CfoReportService.ActivityAuditLineDto> allLines)
    {
        var scopeLines = allLines.Where(l => l.ScopeNo == item.ScopeNo).ToList();
        int capacity = item.ScopeNo switch
        {
            eTgoScopeNo.Scope1 => Fr04Scope1Capacity,
            eTgoScopeNo.Scope2 => Fr04Scope2Capacity,
            eTgoScopeNo.Scope3 => Fr04Scope3Capacity,
            _ => Fr04SeparateCapacity
        };
        int indexInScope = scopeLines.IndexOf(item);
        return scopeLines.Count > capacity && indexInScope >= (capacity - 1);
    }

    private string GetDeltaColorClass(decimal value)
    {
        if (value > 0) return "text-danger fw-bold";
        if (value < 0) return "text-success fw-bold";
        return "text-secondary";
    }
