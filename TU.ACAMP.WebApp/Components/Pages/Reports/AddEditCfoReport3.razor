    /// <summary>
    /// [2026-09-18][Claude] ตัวเลือกปีฐาน = ปีที่มีข้อมูลกิจกรรมจริงเท่านั้น และต้องน้อยกว่าปีคำนวณ
    /// (ใช้รายการเดียวกับ _calculateYearOptions ที่ดึงจาก GetAvailableCalculateYearsAsync)
    /// ถ้าปีฐานที่เลือกไว้เดิมหลุดจากรายการ จะถูกรีเซ็ตเป็น 0 = ใช้ปีคำนวณเป็นปีฐาน
    /// </summary>
    private void RebuildBaseYearOptions()
    {
        var options = new List<CfoSetupWidget.OptionItemDto>
        {
            new CfoSetupWidget.OptionItemDto { Value = 0, Text = "(Auto — same as calculate year)" }
        };

        var selectableYears = _calculateYearOptions
            .Where(y => _selectedCalculateYear <= 0 || y < _selectedCalculateYear)
            .OrderByDescending(y => y)
            .ToList();

        options.AddRange(selectableYears.Select(y => new CfoSetupWidget.OptionItemDto
        {
            Value = y,
            Text = $"Base Year {y}"
        }));

        _baseYearOptions = options;

        if (_selectedBaseYear > 0 && !selectableYears.Contains(_selectedBaseYear))
        {
            _selectedBaseYear = 0;
        }
    }

