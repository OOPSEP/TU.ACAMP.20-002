@using System.Globalization
@using TU.ACAMP.WebApp.Services.Dashboard

<RadzenCard Class="shadow-sm border rounded-3 bg-white p-3 h-100">
    <h6 class="fw-bold text-dark mb-1">Emissions by Scope per Year</h6>
    <span class="small text-muted d-block mb-2">Which scope is driving the gap.</span>
    @if (!Data.YearlyItems.Any())
    {
        <div class="text-center text-muted py-5 small">No activity data.</div>
    }
    else
    {
        <RadzenChart Style="width: 100%; height: 340px;">
            <RadzenStackedColumnSeries Data="@Data.YearlyItems" CategoryProperty="YearLabel" ValueProperty="Scope1Value" Title="Scope 1" Fill="@Dashboard2Colors.Scope1" />
            <RadzenStackedColumnSeries Data="@Data.YearlyItems" CategoryProperty="YearLabel" ValueProperty="Scope2Value" Title="Scope 2" Fill="@Dashboard2Colors.Scope2" />
            <RadzenStackedColumnSeries Data="@Data.YearlyItems" CategoryProperty="YearLabel" ValueProperty="Scope3Value" Title="Scope 3" Fill="@Dashboard2Colors.Scope3" />
            <RadzenValueAxis Min="0" Formatter="@FormatTon">
                <RadzenGridLines Visible="true" />
                <RadzenAxisTitle Text="tCO₂e" />
            </RadzenValueAxis>
            <RadzenLegend Position="LegendPosition.Bottom" />
        </RadzenChart>
    }
</RadzenCard>

@code {
    [Parameter, EditorRequired] public NetZeroDashboardResult Data { get; set; } = new();

    private static string FormatTon(object value) => Convert.ToDouble(value, CultureInfo.InvariantCulture).ToString("N2");
}
