    private void NavigateToAnalytics(eTopicLevel? rowLevel = null, int? rowTargetId = null, string? searchKeyword = null)
    {
        var effLevel = rowLevel ?? EffectiveLevelAndTarget.Level;
        var effTargetId = rowTargetId ?? EffectiveLevelAndTarget.TargetId;

        var queryParams = new List<string> { $"yr={_selectedYear}" };

        if (effTargetId.HasValue && effTargetId.Value > 0)
        {
            var encId = DataProtection.Protect(effTargetId.Value);
            queryParams.Add($"id={Uri.EscapeDataString(encId)}");
            int lvlValue = effLevel == eTopicLevel.Facility ? 3 : (effLevel == eTopicLevel.Company ? 2 : 1);
            queryParams.Add($"level={lvlValue}");
        }

        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            queryParams.Add($"q={Uri.EscapeDataString(searchKeyword)}");
        }

        var retEnc = DataProtection.Protect("/dashboard");
        queryParams.Add($"ret={Uri.EscapeDataString(retEnc)}");

        NavigationManager.NavigateTo($"/organization/activity-analytics?{string.Join("&", queryParams)}");
    }
