    private async Task ExportToExcelAsync()
    {
        // [2026-09-19][Antigravity] Enforce edit permission check for exporting Executive Dashboard
        if (!CanExport)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Access Denied", "Only users with edit permissions can export data.");
            return;
        }

        try
        {
            _isExporting = true;
            StateHasChanged();

            var bytes = DashboardService.ExportToExcel(_result, _selectedYear, CurrentFilterBoundaryText, CurrentPeriodText);
            var base64 = Convert.ToBase64String(bytes);
            // [2026-09-21][Gemini] Standard Export Filename: executive_dashboard_{name}_{date}_{time}.xlsx
            var contextName = $"{_selectedYear}_{CurrentFilterBoundaryText}";
            var fileName = ExportFileNameHelper.Generate("executive_dashboard", contextName);

            await JSRuntime.InvokeVoidAsync("saveAsFile", fileName, base64);
            NotificationService.Notify(NotificationSeverity.Success, "Export Complete", $"Dashboard saved as {fileName}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting Executive Dashboard V2 to Excel.");
            NotificationService.Notify(NotificationSeverity.Error, "Export Failed", ex.Message);
        }
        finally
        {
            _isExporting = false;
            StateHasChanged();
        }
    }

