    #region data loading
    private async Task LoadNetZeroTargetsAsync()
    {
        if (_primarySubscriptionId > 0)
        {
            var target = await NetZeroService.GetAsync(_primarySubscriptionId, _selectedCorporateId);
            _baseYear = target.BaseYear;
            _targetYear = target.TargetYear;
            _targetReductionPercent = target.TargetReductionPercent;
            // [2026-09-25][Antigravity] Load automated GHG target alert settings
            _enableAlert = target.EnableAlert;
            _alertThresholdPercent = target.AlertThresholdPercent;
            _alertEmails = target.AlertEmails;
        }
    }

    private async Task LoadDashboardDataAsync(bool bypassCache = false)
    {
        var (effLevel, effTargetId) = EffectiveLevelAndTarget;

        _result = await DashboardService.GetDashboardDataAsync(
            _allowedSubscriptionIds,
            _selectedYear,
            effLevel,
            effTargetId,
            _baseYear,
            _targetYear,
            _targetReductionPercent,
            _carbonOffsets,
            _alertThresholdPercent,
            bypassCache,
            _fiscalStartMonth
        );

        // Fallback year logic (ensures selectedYear exists in AvailableYears and dropdown is not empty)
        if (_result.AvailableYears.Any())
        {
            if (!_result.AvailableYears.Contains(_selectedYear))
            {
                _selectedYear = _result.AvailableYears.First();
                // Reload with fallback year
                _result = await DashboardService.GetDashboardDataAsync(
                    _allowedSubscriptionIds,
                    _selectedYear,
                    effLevel,
                    effTargetId,
                    _baseYear,
                    _targetYear,
                    _targetReductionPercent,
                    _carbonOffsets,
                    _alertThresholdPercent,
                    bypassCache,
                    _fiscalStartMonth
                );
            }
        }
        else
        {
            var currentY = AppTimeZone.LocalNow.Year;
            _result.AvailableYears.Add(currentY);
            _selectedYear = currentY;
        }
    }
