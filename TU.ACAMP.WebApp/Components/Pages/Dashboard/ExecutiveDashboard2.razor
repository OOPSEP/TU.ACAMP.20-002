    // [2026-09-25][Antigravity] Generates SVG path coordinates for responsive 12-month KPI sparklines
    private static (string LinePath, string AreaPath) GenerateSparkline(IEnumerable<double>? values, int width = 90, int height = 22)
    {
        var list = values?.ToList() ?? new List<double>();
        if (!list.Any()) return (string.Empty, string.Empty);
        if (list.Count == 1) return ($"M 0 {height / 2} L {width} {height / 2}", string.Empty);

        double min = list.Min();
        double max = list.Max();
        double range = max - min;
        if (range < 0.0001) range = 1.0;

        var points = new List<(double X, double Y)>();
        double stepX = (double)width / (list.Count - 1);

        for (int i = 0; i < list.Count; i++)
        {
            double x = i * stepX;
            double normY = (list[i] - min) / range;
            double y = (height - 3) - (normY * (height - 6)) + 1;
            points.Add((x, y));
        }

        var lineD = $"M {points[0].X:F1} {points[0].Y:F1} " + string.Join(" ", points.Skip(1).Select(p => $"L {p.X:F1} {p.Y:F1}"));
        var areaD = $"{lineD} L {width} {height} L 0 {height} Z";

        return (lineD, areaD);
    }

