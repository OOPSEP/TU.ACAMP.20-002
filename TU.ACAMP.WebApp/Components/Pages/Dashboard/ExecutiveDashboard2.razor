    #region lifecycle methods
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            if (!string.IsNullOrWhiteSpace(SecureYr) && int.TryParse(SecureYr, out var yr) && yr > 0)
            {
                _selectedYear = yr;
            }

            if (!string.IsNullOrWhiteSpace(SecureCid) && int.TryParse(SecureCid, out var cid) && cid > 0)
            {
                _selectedCorporateId = cid;
            }

            if (!string.IsNullOrWhiteSpace(SecureCmp) && int.TryParse(SecureCmp, out var cmp) && cmp > 0)
            {
                _selectedCompanyId = cmp;
            }

            if (!string.IsNullOrWhiteSpace(SecureFac) && int.TryParse(SecureFac, out var fac) && fac > 0)
            {
                _selectedFacilityId = fac;
            }

            // [2026-09-26][Claude] คืนค่าเดือนเริ่มปีบัญชีจาก URL (widget จะกางแถบ Advanced เองถ้าไม่ใช่ปีปฏิทิน)
            if (!string.IsNullOrWhiteSpace(SecureFym) && int.TryParse(SecureFym, out var fym) && fym is >= 1 and <= 12)
            {
                _fiscalStartMonth = fym;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var isAdmin = user.IsInRole(SystemRoles.Administrator);
            var email = user.FindFirst(ClaimTypes.Email)?.Value
                     ?? user.FindFirst(ClaimTypes.Name)?.Value
                     ?? user.Identity?.Name;

            _isAdmin = isAdmin;
            if (!string.IsNullOrEmpty(email))
            {
                var userSubs = await SubscriptionService.GetSubscriptionsForUserAsync(email, isAdmin);
                _allowedSubscriptionIds = userSubs.Select(s => s.Id).ToHashSet();
                _editableSubscriptionIds = await SubscriptionService.GetEditableSubscriptionIdsAsync(email, isAdmin);
                if (_allowedSubscriptionIds.Any())
                {
                    _primarySubscriptionId = _allowedSubscriptionIds.First();
                }
            }

            if (_allowedSubscriptionIds.Any())
            {
                await LoadNetZeroTargetsAsync();
                await LoadDashboardDataAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing Executive Dashboard V2.");
            NotificationService.Notify(NotificationSeverity.Error, "Error Loading Dashboard", ex.Message);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

