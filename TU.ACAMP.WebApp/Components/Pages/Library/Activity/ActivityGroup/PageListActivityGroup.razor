@page "/library/activity-groups"
@page "/activity/groups"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.DataProtection
@using System.Security.Claims
@using TU.ACAMP.Domain.Enums
@using TU.ACAMP.Domain.Identity
@using TU.ACAMP.Domain.Models.Library
@using TU.ACAMP.WebApp.Constants
@using TU.ACAMP.WebApp.Services.Activity
@using TU.ACAMP.WebApp.Services.Common
@attribute [Authorize]
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject AuthenticationStateProvider AuthStateProvider
@inject ActivityGroupService ActivityGroupService
@inject NavigationManager NavigationManager
@inject IDataProtectionProvider DataProtection
@inject ILogger<PageListActivityGroup> Logger
@inject NotificationService NotificationService

<PageTitle>Activity Groups Library - ACAMP</PageTitle>

<div class="container-fluid py-3 px-4">
    <!-- Header Section -->
    <div class="row mb-4 align-items-center">
        <div class="col-12">
            <RadzenText Text="Activity Groups Library" TextStyle="TextStyle.H5" TagName="TagName.H1" class="fw-bold mb-1" Style="color: var(--rz-text-title-color);" />
            <RadzenText Text="View system standard operational activities, reporting scopes, and ISO category mappings." TextStyle="TextStyle.Body2" class="text-muted mb-0" />
        </div>
    </div>

    <!-- [2026-09-13][Antigravity] Filters & Search Toolbar with .acamp-filter-bar and spring search -->
    <RadzenCard Class="mb-4 p-3 shadow-sm" Style="border-radius: 12px; border: 1px solid var(--rz-border-color); background: var(--rz-card-background-color);">
        <div class="acamp-filter-bar justify-content-between">
            <div class="acamp-filter-search">
                <RadzenFormField Text="Search Activity Groups">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="SearchText" Placeholder="Search by code, title, or remark..." Style="width: 100%;" />
                    </ChildContent>
                    <Start>
                        <RadzenIcon Icon="search" />
                    </Start>
                </RadzenFormField>
            </div>
            <div class="d-flex align-items-center ms-auto text-muted small" style="height: 40px;">
                Showing <b>@_filteredItems.Count</b> records across all scopes
            </div>
        </div>
    </RadzenCard>

    <!-- DataGrid Container -->
    @if (_isLoading)
    {
        <div class="py-5 text-center">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <RadzenText Text="Loading activity groups..." TextStyle="TextStyle.Body2" class="text-muted mt-2" />
        </div>
    }
    else
    {
        <div class="shadow-sm rounded-3 p-3" style="background-color: var(--rz-card-background-color); border: 1px solid var(--rz-border-color); border-radius: 12px;">
            <RadzenTabs RenderMode="TabRenderMode.Client" Class="shadow-sm rounded-3" SelectedIndex="@_activeTabIndex" SelectedIndexChanged="@OnTabIndexChanged">
                <Tabs>
                    <RadzenTabsItem Text="Scope 1">
                        @RenderGridForScope(eTgoScopeNo.Scope1)
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Scope 2">
                        @RenderGridForScope(eTgoScopeNo.Scope2)
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Scope 3">
                        @RenderGridForScope(eTgoScopeNo.Scope3)
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Separate Report">
                        @RenderGridForScope(eTgoScopeNo.SeparateReport)
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </div>
    }
</div>

@code {
    #region class field
    private int _pageSize = 15;
    private readonly IEnumerable<int> _pageSizeOptions = new[] { 15, 25, 50, 100 };
    private readonly Dictionary<eTgoScopeNo, RadzenDataGrid<TbActivityGroup>> _grids = new();

    private bool _isLoading = true;
    private bool _isAdmin = false;
    private string _searchText = string.Empty;
    private int _activeTabIndex = 0;

    private List<TbActivityGroup> _allItems = new();
    private List<TbActivityGroup> _filteredItems = new();
    #endregion

    #region class properties
    private string SearchText
    {
        get => _searchText;
        set
        {
            if (_searchText != value)
            {
                _searchText = value;
                OnFilterChanged();
            }
        }
    }

    [SupplyParameterFromQuery(Name = "tab")]
    public string? SecureTab { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? SecureSearch { get; set; }
    #endregion

    #region class methods
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CheckUserRoleAsync();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Critical crash in PageListActivityGroup initialization.");
            NotificationService.Notify(NotificationSeverity.Error, "Initialization Error", "Failed to initialize activity groups page.");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var stateChanged = false;

        var decryptedSearch = DataProtection.Unprotect(SecureSearch) ?? string.Empty;
        if (!string.IsNullOrEmpty(decryptedSearch) && _searchText != decryptedSearch)
        {
            _searchText = decryptedSearch;
            stateChanged = true;
        }

        var decryptedTabIndex = DataProtection.UnprotectInt(SecureTab);
        if (decryptedTabIndex.HasValue && decryptedTabIndex.Value >= 0 && decryptedTabIndex.Value <= 3 && _activeTabIndex != decryptedTabIndex.Value)
        {
            _activeTabIndex = decryptedTabIndex.Value;
            stateChanged = true;
        }

        if (stateChanged && _allItems.Any())
        {
            OnFilterChanged();
        }

        await base.OnParametersSetAsync();
    }

    private async Task CheckUserRoleAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                _isAdmin = user.IsInRole(SystemRoles.Administrator);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to check user role in PageListActivityGroup.");
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _allItems = await ActivityGroupService.GetAllAsync();
            OnFilterChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load activity groups data.");
            NotificationService.Notify(NotificationSeverity.Error, "Data Error", "Failed to load activity groups library.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnFilterChanged()
    {
        var query = _allItems.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var q = _searchText.Trim();
            query = query.Where(x =>
                (!string.IsNullOrEmpty(x.Code) && x.Code.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Title) && x.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Remark) && x.Remark.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                x.IsoCategoryNo.ToString().Contains(q, StringComparison.OrdinalIgnoreCase));
        }

        _filteredItems = query.ToList();

        foreach (var grid in _grids.Values)
        {
            grid?.Reload();
        }
    }

    private void OnTabIndexChanged(int index)
    {
        if (_activeTabIndex != index)
        {
            _activeTabIndex = index;
            UpdateUrlState();
        }
    }

    private void UpdateUrlState()
    {
        try
        {
            var queryParams = new Dictionary<string, object?>();

            if (!string.IsNullOrWhiteSpace(_searchText))
                queryParams["q"] = DataProtection.Protect(_searchText);

            if (_activeTabIndex > 0)
                queryParams["tab"] = DataProtection.Protect(_activeTabIndex);

            var url = NavigationManager.GetUriWithQueryParameters("/library/activity-groups", queryParams);
            NavigationManager.NavigateTo(url, replace: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating URL state in PageListActivityGroup.");
        }
    }

    private RenderFragment RenderGridForScope(eTgoScopeNo scopeNo)
    {
        var scopeGroups = _filteredItems
            .Where(x => x.TgoScopeNo == scopeNo)
            .OrderBy(x => x.Code)
            .ToList();

        if (!scopeGroups.Any())
        {
            return @<div class="p-4 text-center text-muted">
                <RadzenIcon Icon="inbox" Style="font-size: 36px; opacity: 0.5;" class="mb-2" />
                <div>No activity groups documented for this specific reporting scope.</div>
            </div>;
        }

        return __builder =>
        {
            <RadzenDataGrid @ref="_grids[scopeNo]"
                            TItem="TbActivityGroup"
                            Data="@scopeGroups"
                            AllowColumnResize="true"
                            AllowPaging="true"
                            PageSize="@_pageSize"
                            PageSizeOptions="@_pageSizeOptions"
                            AllowSorting="true"
                            ColumnWidth="180px"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            ShowPagingSummary="true"
                            Style="@GridStyles.Default">
                <Columns>
                    @if (Env.IsDevelopment() || _isAdmin)
                    {
                        <RadzenDataGridColumn TItem="TbActivityGroup" Property="Id" Title="ID" Width="70px" TextAlign="TextAlign.Center" />
                    }
                    <RadzenDataGridColumn TItem="TbActivityGroup" Title="#" Width="55px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                        <Template Context="d">
                            @(scopeGroups.IndexOf(d) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Visible="false" TItem="TbActivityGroup" Property="Code" Title="Code" Width="100px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <span class="badge bg-light text-dark border fw-bold px-2 py-1">@item.Code</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TbActivityGroup" Property="Title" Title="Title" MinWidth="220px" TextAlign="TextAlign.Left">
                        <Template Context="item">
                            <RadzenBadge Text="System" BadgeStyle="BadgeStyle.Light" IsPill="false" Style="font-size: 10px; padding: 0.25em 0.5rem;" />
                            <span class="fw-bold text-dark">@item.Title</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TbActivityGroup" Title="ISO Category" Width="160px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <RadzenBadge Text="@item.IsoCategoryNo.ToString()" BadgeStyle="BadgeStyle.Info" IsPill="true" Style="font-size: 0.75rem;" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Visible="false" TItem="TbActivityGroup" Title="Source Type" Width="130px" TextAlign="TextAlign.Center" Sortable="true">
                        <Template Context="item">
                            <span class="badge bg-light text-secondary border px-2 py-1 rounded" style="font-size: 0.75rem; font-weight: 600;">
                                <RadzenIcon Icon="lock" Style="font-size: 0.8rem; vertical-align: middle;" class="me-1" />System
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TbActivityGroup" Property="Remark" Title="Remark" MinWidth="220px" TextAlign="TextAlign.Left">
                        <Template Context="item">
                            <span class="text-muted small">@(string.IsNullOrEmpty(item.Remark) ? "-" : item.Remark)</span>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        };
    }
    #endregion
}
