    private void ApplyInMemoryFilters()
    {
        #region hide [2026-08-18]
        var items = (IEnumerable<TbActivityTopic>)_allItems;

        // 1. Search Text
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim().ToLowerInvariant();
            items = items.Where(t =>
                t.Title.ToLowerInvariant().Contains(term) ||
                t.Remark.ToLowerInvariant().Contains(term) ||
                t.Childs.Any(c => (c.Source != null && c.Source.Title.ToLowerInvariant().Contains(term)) ||
                                  (c.ActivityGroup != null && c.ActivityGroup.Title.ToLowerInvariant().Contains(term))));
        }

        // 2. Status Filter
        // [2026-09-13: Antigravity] กรองตาม IsActive ของ Topic
        if (_statusFilter == "active")
        {
            items = items.Where(t => t.IsActive);
        }
        else if (_statusFilter == "inactive")
        {
            items = items.Where(t => !t.IsActive);
        }

        // 3. Data Completeness (Events) Filter
        // [2026-09-13: Antigravity] กรองตามการมีอยู่ของ Events ในช่วงเวลาที่เลือก
        if (_dataEventFilter == "has_events")
        {
            items = items.Where(t => t.Events.Any(e => !e.IsDeleted && IsEventInReportingPeriod(e)));
        }
        else if (_dataEventFilter == "no_events")
        {
            items = items.Where(t => !t.Events.Any(e => !e.IsDeleted && IsEventInReportingPeriod(e)));
        }

        // 4. Source Mapping Filter
        // [2026-09-13: Antigravity] กรองตามสถานะการผูก Emission Source (Mapped vs Unmapped/Unknown)
        if (_sourceMappingFilter == "mapped")
        {
            items = items.Where(t => t.Childs.Any(c => c.IsActive && !c.IsDeleted && c.Source != null && c.Source.Id > 0 && c.Source.Title != "Unknown"));
        }
        else if (_sourceMappingFilter == "unmapped")
        {
            items = items.Where(t => !t.Childs.Any(c => c.IsActive && !c.IsDeleted && c.Source != null && c.Source.Id > 0 && c.Source.Title != "Unknown"));
        }

        _filteredItems = items.ToList();
        #endregion
    }

    /// <summary>
    /// [2026-09-13: Antigravity] ตรวจสอบว่า Event อยู่ใน Reporting Period (ตามปีและ StartMonth ที่เลือก) หรือไม่
    /// </summary>
    private bool IsEventInReportingPeriod(TbActivityEvent ev)
    {
        if (ev.IsDeleted) return false;
        if (!_selectedYear.HasValue) return true;

        if (_startMonth == 1)
        {
            return ev.TimeStamp.Year == _selectedYear.Value;
        }

        var start = new DateTime(_selectedYear.Value, _startMonth, 1, 0, 0, 0, DateTimeKind.Utc);
        var end = start.AddMonths(12);
        return ev.TimeStamp >= start && ev.TimeStamp < end;
    }

