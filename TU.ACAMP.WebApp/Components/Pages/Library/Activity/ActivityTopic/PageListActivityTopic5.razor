    private bool CanExport => CanEditCurrentContext();

    private bool CanEditCurrentContext()
    {
        if (_isAdmin) return true;
        if (_selectedFacilityId.HasValue && _selectedFacilityId.Value > 0)
            return _editableFacilityIds.Contains(_selectedFacilityId.Value);
        if (_selectedCompanyId.HasValue && _selectedCompanyId.Value > 0)
            return _editableCompanyIds.Contains(_selectedCompanyId.Value);
        if (_selectedCorporateId.HasValue && _selectedCorporateId.Value > 0)
            return _editableCorporateIds.Contains(_selectedCorporateId.Value);
        if (_selectedSubscriptionId.HasValue && _selectedSubscriptionId.Value > 0)
            return _editableSubscriptionIds.Contains(_selectedSubscriptionId.Value);

        return _editableSubscriptionIds.Count > 0 || _editableCorporateIds.Count > 0 || _editableCompanyIds.Count > 0 || _editableFacilityIds.Count > 0;
    }

    private async Task ExportToExcelAsync()
    {
        #region hide [2026-08-28]
        // [2026-09-19][Antigravity] Enforce edit permission check for exporting activity topics
        if (!CanExport)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Access Denied", "Only users with edit permissions can export data.");
            return;
        }

        try
        {
            // [2026-09-21][Gemini] V2: Export only Master Topics without [Topic Type] column (1 row = 1 Topic in App)
            var bytes = await ExcelService.ExportTopicsToExcelV2Async(_filteredItems, _selectedYear, _parentContextName);
