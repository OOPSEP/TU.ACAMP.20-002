@page "/library/activity-topics"
@page "/activities/topics"
@page "/organization/facility/topics"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.DataProtection
@using System.Security.Claims
@using System.Text.Json.Nodes
@using TU.ACAMP.Domain.Enums
@using TU.ACAMP.Domain.Identity
@using TU.ACAMP.Domain.Models.Library
@using TU.ACAMP.Domain.Models.Organization
@using TU.ACAMP.Domain.Common
@using TU.ACAMP.Domain.Tools
@using TU.ACAMP.WebApp.Components.Common
@using TU.ACAMP.WebApp.Services.Activity
@using TU.ACAMP.WebApp.Services.Common
@using TU.ACAMP.WebApp.Services.Emissions
@using TU.ACAMP.WebApp.Services.Identity
@using TU.ACAMP.WebApp.Services.Organization

@attribute [Authorize]
@implements IAsyncDisposable

@using TU.ACAMP.WebApp.Components.Pages.Library.Activity.ActivityTopic.Dialogs

@inject ActivityTopicService ActivityTopicService
@inject ActivityTopicExcelService ExcelService
@inject ActivityGroupService ActivityGroupService
@inject EmissionSourceService EmissionSourceService
@inject FacilityService FacilityService
@inject CompanyService CompanyService
@inject CorporateService CorporateService
@inject SubscriptionService SubscriptionService
@inject NavigationManager NavigationManager
@inject IDataProtectionProvider DataProtection
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject GhgEventBusService GhgEventBus
@inject IJSRuntime JSRuntime
@inject ILogger<PageListActivityTopic5> Logger

@*
    ============================================================================
    PageListActivityTopic5.razor  (v5 - 2026-09-13)
    [2026-09-13: Antigravity]
    เวอร์ชัน 5: ต่อยอดจาก v4 โดยเพิ่ม Advanced Filter:
    - Month Start Dropdown (1-12) รองรับรอบปีปฏิทินและปีงบประมาณ (Fiscal Year Window)
    - Toggle เปิด/ปิด การมองเห็น Child Topics (WTT Scope 3 & Biogenic CO2)
    - Data Completeness Filter (All / Has Events / No Events)
    - Status Filter (All / Active / Inactive)
    - Emission Source Mapping Filter (All / Mapped / Unmapped & Unknown)
    ============================================================================
*@

<PageTitle>@($"{GetParentTypeDisplayName()} Topics - ACAMP")</PageTitle>

<style>
    .acc-has-topics,
    .acc-has-topics > .rz-accordion-header,
    .acc-has-topics > .rz-accordion-header > a,
    .acc-has-topics > .rz-accordion-content {
        background-color: var(--rz-card-background-color) !important;
        background-color: color-mix(in srgb, var(--rz-success, #4caf50) 14%, var(--rz-card-background-color, #fff)) !important;
    }

    /* Drag & Drop row reorder (v4) */
    .topic-drop-target > td {
        border-top: 2px solid var(--rz-primary, #0d6efd) !important;
        background-color: color-mix(in srgb, var(--rz-primary, #0d6efd) 10%, transparent) !important;
    }

    /* [2026-09-13][Antigravity] Replaced local .topic-filter-bar style with global .acamp-filter-bar in site.css */

    /* [2026-09-14] Header sub-row: คำอธิบาย + ชื่อ Parent (ซ้าย) และปุ่มคำสั่ง (ขวา) ต้องอยู่แถวเดียวกันเสมอ */
    .topic-header-subrow {
        flex-wrap: nowrap !important;
    }

    .topic-header-caption {
        flex: 1 1 auto;
        min-width: 0;
    }

    .topic-header-actions {
        flex: 0 0 auto;
        white-space: nowrap;
    }

    /* จอแคบ: ย่อปุ่มลงเล็กน้อยแทนการดันตกบรรทัด */
    @@media (max-width: 991.98px) {
        .topic-header-actions .rz-button {
            padding-left: 0.55rem;
            padding-right: 0.55rem;
            font-size: 0.8rem;
        }
    }
</style>

<div class="container-fluid py-2 px-4">
    <!-- Header Section -->
    @* [2026-09-14] Header layout: ชื่อ Parent ย้ายลงมาอยู่ใต้บรรทัดคำอธิบาย
       และกลุ่มปุ่ม (Export/Import/Add Topic) ถูกล็อกให้อยู่แถวเดียวกับบรรทัดคำอธิบายเสมอ
       (ใช้ flex-nowrap + flex-shrink-0 ฝั่งปุ่ม / min-width:0 ฝั่งข้อความ) *@
    <div class="mb-4">
        <div class="d-flex align-items-center mb-1">
            <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                          Size="ButtonSize.Small" Click="@GoBack" Class="me-2" Style="border-radius: 6px;" />
            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" Class="m-0 fw-bold" Style="color: var(--rz-text-title-color);">
                @($"{GetParentTypeDisplayName()} Topics")
            </RadzenText>
        </div>

        <div class="topic-header-subrow d-flex align-items-start justify-content-between flex-nowrap gap-3 mt-1 ms-5">
            <div class="topic-header-caption" style="min-width: 0;">
                <RadzenText TextStyle="TextStyle.Body2" Class="text-muted m-0">
                    Manage @GetParentTypeDisplayName().ToLower()-level activity calculations, greenhouse gas scopes, and emission sources.
                </RadzenText>
                @if (!string.IsNullOrWhiteSpace(_parentContextName))
                {
                    <div class="mt-2">
                        <span style="display:inline-flex; align-items:center; gap:6px; background:var(--rz-primary-lighter,#e8f0fe); color:var(--rz-primary,#3d6af8); border-radius:999px; padding:3px 14px; font-size:0.78rem; font-weight:600; white-space:nowrap; max-width:100%; overflow:hidden; text-overflow:ellipsis;">
                            <span class="rzi" style="font-size:0.9rem;">business</span>
                            @_parentContextName
                        </span>
                    </div>
                }
            </div>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                         Class="topic-header-actions flex-wrap justify-content-end flex-shrink-0">
                <RadzenButton Text="Export Excel" Icon="download" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                              Click="@ExportToExcelAsync" Style="border-radius: 8px; font-weight: 600;"
                              Disabled="@(!CanExport)" Title="@(CanExport ? "Export topics to Excel" : "Export is restricted to users with edit permissions.")" />
                <RadzenButton Text="Import Excel" Icon="file_upload" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined"
                              Click="@OpenImportDialogAsync" Style="border-radius: 8px; font-weight: 600;" Disabled="@_isAddDisabled" />
                <RadzenButton Text="Add Topic" Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                              Click="@NavigateToCreate" Style="border-radius: 8px; font-weight: 600;" Disabled="@_isAddDisabled" />
            </RadzenStack>
        </div>
    </div>

    <!-- Filters Card -->
    <RadzenCard Class="mb-3 p-3 shadow-sm rounded-3" Style="background: var(--rz-card-background-color); border: 1px solid var(--rz-border-color);">
        <!-- [2026-09-13][Antigravity] Flex toolbar: search ยืดอัตโนมัติ (spring) ด้วย acamp-filter-bar และทุกคอนโทรลสูง 40px ชิดเส้นล่างเดียวกัน -->
        <div class="acamp-filter-bar justify-content-between">
            <div class="acamp-filter-search">
                <RadzenFormField Text="Search Topics">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="@SearchText"
                                       Placeholder="Search by Title, Code, Remark, or Source..."
                                       Style="width: 100%;" />
                    </ChildContent>
                    <Start>
                        <RadzenIcon Icon="search" Style="font-size: 1.15rem; color: var(--rz-text-secondary-color);" />
                    </Start>
                </RadzenFormField>
            </div>

            <div class="d-flex align-items-end gap-2 flex-wrap ms-auto flex-shrink-0">
                @if (_isAdmin || _subscriptionsList.Count > 1)
                {
                    <RadzenFormField Text="Subscription Workspace" Style="width: 220px;">
                        <RadzenDropDown TValue="int?" Value="@_selectedSubscriptionId" Data="@_subscriptionsList"
                                        TextProperty="Title" ValueProperty="Id" Placeholder="All Subscriptions"
                                        AllowClear="true" Change="@OnSubscriptionChanged"
                                        Style="width: 100%;" />
                    </RadzenFormField>
                }

                <RadzenFormField Text="Reporting Year" Style="width: 160px;">
                    <RadzenDropDown @bind-Value="@_selectedYear"
                                    Data="@_yearOptions"
                                    TextProperty="Text"
                                    ValueProperty="Value"
                                    Change="@(async _ => { ApplyInMemoryFilters(); await SyncBrowserUrlAsync(); })"
                                    Style="width: 100%;" />
                </RadzenFormField>

                <!-- [2026-09-13][Antigravity] ปุ่ม Advanced/Less สูง 40px เท่ากับ input ด้วย .acamp-filter-bar -->
                <div class="d-flex align-items-end position-relative">
                    @* [2026-09-26][Claude] ใช้ปุ่มมาตรฐาน AdvancedFilterToggle *@
                    <AdvancedFilterToggle IsExpanded="@_isAdvancedExpanded"
                                          HasActive="@HasActiveAdvancedFilters"
                                          OnToggle="@ToggleAdvancedFilter" />
                </div>
            </div>
        </div>

        <!-- Advanced Filter Expanded Section -->
        @if (_isAdvancedExpanded)
        {
            <div class="row g-3 align-items-center mt-2 pt-3 border-top" style="border-color: var(--rz-border-color) !important;">
                <!-- 1. Month Start (Fiscal Year Period) -->
                <div class="col-12 col-md-3">
                    <RadzenFormField Text="Month Start (Fiscal Cycle)" Style="width: 100%;">
                        <RadzenDropDown TValue="int"
                                        Value="@_startMonth"
                                        ValueChanged="@OnStartMonthChanged"
                                        Data="@_monthsList"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        Style="width: 100%;">
                            <Template Context="month">
                                @if (month is MonthOption m)
                                {
                                    <div class="d-flex align-items-center justify-content-between" style="width: 100%;">
                                        <span>@m.Text</span>
                                        @if (!string.IsNullOrEmpty(m.Tag))
                                        {
                                            <span class="badge rounded-pill ms-2 px-2 py-1" style="font-size: 0.7rem; font-weight: 600; background-color: #E8F5E9; color: #2E7D32; border: 1px solid #A5D6A7;">
                                                @m.Tag
                                            </span>
                                        }
                                    </div>
                                }
                            </Template>
                        </RadzenDropDown>
                    </RadzenFormField>
                </div>

                <!-- 2. Show Child Topics Switch -->
                <div class="col-12 col-md-3 d-flex align-items-center gap-2">
                    <RadzenSwitch @bind-Value="@_showChildTopics" Change="@(async _ => { ApplyInMemoryFilters(); await SyncBrowserUrlAsync(); })" Style="--rz-switch-height: 22px;" />
                    <RadzenLabel Text="Show Child Topics (WTT / Bio)" Class="fw-semibold text-dark mb-0 small" />
                </div>

                <!-- 3. Status Filter (All / Active / Inactive) -->
                <div class="col-12 col-md-2">
                    <RadzenFormField Text="Status" Style="width: 100%;">
                        <RadzenDropDown TValue="string"
                                        Value="@_statusFilter"
                                        ValueChanged="@OnStatusFilterChanged"
                                        Data="@_statusOptions"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        Style="width: 100%;" />
                    </RadzenFormField>
                </div>

                <!-- 4. Data Completeness (Events) -->
                <div class="col-12 col-md-2">
                    <RadzenFormField Text="Data Records" Style="width: 100%;">
                        <RadzenDropDown TValue="string"
                                        Value="@_dataEventFilter"
                                        ValueChanged="@OnDataEventFilterChanged"
                                        Data="@_dataEventOptions"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        Style="width: 100%;" />
                    </RadzenFormField>
                </div>

                <!-- 5. Source Mapping Filter -->
                <div class="col-12 col-md-2">
                    <RadzenFormField Text="Source Mapping" Style="width: 100%;">
                        <RadzenDropDown TValue="string"
                                        Value="@_sourceMappingFilter"
                                        ValueChanged="@OnSourceMappingFilterChanged"
                                        Data="@_sourceMappingOptions"
                                        TextProperty="Text"
                                        ValueProperty="Value"
                                        Style="width: 100%;" />
                    </RadzenFormField>
                </div>

                <!-- Reset Advanced Filter Row -->
                @if (HasActiveAdvancedFilters)
                {
                    <div class="col-12 d-flex justify-content-end pt-1">
                        <RadzenButton Text="Reset Advanced Filters"
                                      Icon="restart_alt"
                                      ButtonStyle="ButtonStyle.Light"
                                      Variant="Variant.Text"
                                      Size="ButtonSize.Small"
                                      Click="@ResetAdvancedFilters"
                                      Style="font-size: 0.82rem;" />
                    </div>
                }
            </div>
        }
    </RadzenCard>

    <!-- Scope Tabs & Main Content -->
    @if (_isLoading)
    {
        <div class="py-5 text-center">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <RadzenText Text="Loading topics..." TextStyle="TextStyle.Body2" class="text-muted mt-2" />
        </div>
    }
    else
    {
        <RadzenTabs RenderMode="TabRenderMode.Client" SelectedIndex="@_activeTabIndex" Change="@OnTabChanged"
                    Class="shadow-sm rounded-3 mb-4" Style="background: var(--rz-card-background-color); border: 1px solid var(--rz-border-color);">
            <Tabs>
                <RadzenTabsItem Text="Scope 1 (Direct GHG)">
                    <div class="p-3 bg-light rounded-3 mt-2">
                        @RenderAccordionForScope(eTgoScopeNo.Scope1)
                    </div>
                </RadzenTabsItem>
                <RadzenTabsItem Text="Scope 2 (Indirect Energy)">
                    <div class="p-3 bg-light rounded-3 mt-2">
                        @RenderAccordionForScope(eTgoScopeNo.Scope2)
                    </div>
                </RadzenTabsItem>
                <RadzenTabsItem Text="Scope 3 (Other Indirect)">
                    <div class="p-3 bg-light rounded-3 mt-2">
                        @RenderAccordionForScope(eTgoScopeNo.Scope3)
                    </div>
                </RadzenTabsItem>
                <RadzenTabsItem Text="Separate Report (Biogenic CO₂)">
                    <div class="p-3 bg-light rounded-3 mt-2">
                        @RenderAccordionForScope(eTgoScopeNo.SeparateReport)
                    </div>
                </RadzenTabsItem>
                <RadzenTabsItem Text="All Scopes">
                    <div class="p-3 bg-light rounded-3 mt-2">
                        @{
                            var allRows = GetAllTopicRows();
                            var scopeMap = GetGroupScopeMap();
                            var ungroupedRows = FilterUngroupedRows(allRows, scopeMap);

                            // [2026-09-13: Antigravity] คำนวณยอด GHG รวมกระทบยอดแยกตาม Scope ให้ครบถ้วน 100% เสมอ ไม่ว่าสวิตช์ Child จะเปิดหรือปิด
                            var allActiveChildItems = _filteredItems
                                .SelectMany(t => t.Childs.Where(c => c.IsActive && !c.IsDeleted)
                                    .Select(c => new TopicRowDisplayItem { Topic = t, Child = c, IsMaster = (c.Id == t.Childs.Where(x => x.IsActive && !x.IsDeleted).OrderBy(x => x.Id).First().Id), GroupCode = GetGroupCodeForChild(c) }))
                                .ToList();

                            var totalAllKg = allActiveChildItems.Sum(r => GetRowKgCO2e(r, false));
                            var kgScope1 = allActiveChildItems.Where(r => TryGetScopeForChild(r.Child) == eTgoScopeNo.Scope1).Sum(r => GetRowKgCO2e(r, false));
                            var kgScope2 = allActiveChildItems.Where(r => TryGetScopeForChild(r.Child) == eTgoScopeNo.Scope2).Sum(r => GetRowKgCO2e(r, false));
                            var kgScope3 = allActiveChildItems.Where(r => TryGetScopeForChild(r.Child) == eTgoScopeNo.Scope3).Sum(r => GetRowKgCO2e(r, false));
                            var kgSeparate = allActiveChildItems.Where(r => TryGetScopeForChild(r.Child) == eTgoScopeNo.SeparateReport).Sum(r => GetRowKgCO2e(r, false));
                        }
                        @if (!allRows.Any())
                        {
                            <div class="p-4 text-center text-muted border rounded bg-white">
                                <RadzenIcon Icon="info" Style="font-size: 36px; opacity: 0.5;" Class="mb-2" />
                                <div>No activity topics found for this reporting scope.</div>
                            </div>
                        }
                        else
                        {
                            <!-- [2026-09-13: Antigravity] แถบกระทบยอด GHG รวม: แสดงยอดการปล่อยจริงครบถ้วนทุก Scope เสมอ -->
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-3 p-2 bg-white border rounded-3 small">
                                <span class="fw-bold me-1">Total GHG Reconciliation:</span>
                                <span class="badge bg-dark text-white px-2 py-1">Total @($"{totalAllKg:N2} kg")</span>
                                <span class="text-muted">=</span>
                                <span class="badge bg-primary text-white px-2 py-1">Scope 1: @($"{kgScope1:N2} kg")</span>
                                <span class="text-muted">+</span>
                                <span class="badge bg-success text-white px-2 py-1">Scope 2: @($"{kgScope2:N2} kg")</span>
                                <span class="text-muted">+</span>
                                <span class="badge bg-info text-white px-2 py-1">Scope 3: @($"{kgScope3:N2} kg")</span>
                                <span class="text-muted">+</span>
                                <span class="badge bg-secondary text-white px-2 py-1">Separate: @($"{kgSeparate:N2} kg")</span>
                            </div>

                            @if (ungroupedRows.Any())
                            {
                                <div class="alert alert-warning py-2 px-3 small mb-3" role="alert">
                                    <RadzenIcon Icon="warning" Style="font-size: 16px;" Class="me-1" />
                                    There are @ungroupedRows.Count topics not associated with a valid Activity Group.
                                    They do not appear in Scopes 1-4 tabs until properly assigned.
                                </div>
                            }

                            <RadzenCard Class="p-2 shadow-sm rounded-3 bg-white">
                                @RenderGridForTopicRows(allRows, showScopeColumn: true)
                            </RadzenCard>
                        }
                    </div>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    }
</div>

@code {
    #region class field
    private bool _isLoading = true;
    private bool _isAdmin = false;
    private bool _isAddDisabled = false;
    private string _searchText = string.Empty;
    private int _activeTabIndex = 0;
    private readonly Dictionary<int, int> _tabAccordionIndices = new() { [0] = 0, [1] = 0, [2] = 0, [3] = 0 };

    #region helper records
    public record MonthOption(string Text, int Value, string Tag);
    public record FilterOption(string Text, string Value);
    #endregion

    private class YearOption
    {
        public int? Value { get; set; }
        public string Text { get; set; } = string.Empty;
    }

    private int? _selectedYear = null;
    private List<YearOption> _yearOptions = new();

    // Advanced Filter State
    // [2026-09-13: Antigravity] Support fiscal start month, child visibility, status, event data, and mapping filters
    private bool _isAdvancedExpanded = false;
    private int _startMonth = 1;
    private bool _showChildTopics = false;
    private string _statusFilter = "all";
    private string _dataEventFilter = "all";
    private string _sourceMappingFilter = "all";

    private bool HasActiveAdvancedFilters =>
        _startMonth != 1 ||
        _showChildTopics ||
        _statusFilter != "all" ||
        _dataEventFilter != "all" ||
        _sourceMappingFilter != "all";

    private readonly List<MonthOption> _monthsList = new()
    {
        new("January (01)", 1, "Calendar Default"),
        new("February (02)", 2, ""),
        new("March (03)", 3, ""),
        new("April (04)", 4, "Japan FY"),
        new("May (05)", 5, "Japan FY (Alt)"),
        new("June (06)", 6, ""),
        new("July (07)", 7, ""),
        new("August (08)", 8, ""),
        new("September (09)", 9, ""),
        new("October (10)", 10, "Thai Gov FY"),
        new("November (11)", 11, ""),
        new("December (12)", 12, "")
    };

    private readonly List<FilterOption> _statusOptions = new()
    {
        new("All Status", "all"),
        new("Active Only", "active"),
        new("Inactive Only", "inactive")
    };

    private readonly List<FilterOption> _dataEventOptions = new()
    {
        new("All Records", "all"),
        new("Has Events", "has_events"),
        new("No Events", "no_events")
    };

    private readonly List<FilterOption> _sourceMappingOptions = new()
    {
        new("All Sources", "all"),
        new("Mapped Only", "mapped"),
        new("Unmapped / Unknown", "unmapped")
    };

    /// <summary>
    /// แถวที่กำลังถูกลาก (Drag & Drop Reorder) — ใช้ชั่วคราวระหว่างการลาก-วางเท่านั้น
    /// </summary>
    private TopicRowDisplayItem? _draggedRow = null;

    private int ScopeToTabIndex(eTgoScopeNo scope) => scope switch
    {
        eTgoScopeNo.Scope1 => 0,
        eTgoScopeNo.Scope2 => 1,
        eTgoScopeNo.Scope3 => 2,
        eTgoScopeNo.SeparateReport => 3,
        _ => 0
    };

    private int GetAccordionIndexForScope(eTgoScopeNo scope)
    {
        var tab = ScopeToTabIndex(scope);
        return _tabAccordionIndices.TryGetValue(tab, out var idx) ? idx : 0;
    }

    private int GetAccordionIndexForTab(int tab)
    {
        return _tabAccordionIndices.TryGetValue(tab, out var idx) ? idx : 0;
    }

    private void SetAccordionIndexForTab(int tab, int index)
    {
        _tabAccordionIndices[tab] = index;
    }

    private int? _selectedCorporateId;
    private int? _selectedCompanyId;
    private int? _selectedFacilityId;
    private int? _selectedSubscriptionId;
    private string _parentContextName = string.Empty;

    private List<TbSubscription> _subscriptionsList = new();
    private List<TbActivityTopic> _allItems = new();
    private List<TbActivityTopic> _filteredItems = new();
    private List<TbActivityGroup> _allGroups = new();

    private string _currentUserEmail = string.Empty;
    private HashSet<int> _editableSubscriptionIds = new();
    private HashSet<int> _editableCorporateIds = new();
    private HashSet<int> _editableCompanyIds = new();
    private HashSet<int> _editableFacilityIds = new();
    #endregion

    #region class properties
    [SupplyParameterFromQuery(Name = "ptype")] public string? RawParentType { get; set; }
    [SupplyParameterFromQuery(Name = "lvl")] public string? RawLevel { get; set; }
    [SupplyParameterFromQuery(Name = "pid")] public string? SecurePid { get; set; }
    [SupplyParameterFromQuery(Name = "sid")] public string? SecureSid { get; set; }
    [SupplyParameterFromQuery(Name = "cid")] public string? SecureCid { get; set; }
    [SupplyParameterFromQuery(Name = "comid")] public string? SecureComId { get; set; }
    [SupplyParameterFromQuery(Name = "facid")] public string? SecureFacId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? SecureTab { get; set; }
    [SupplyParameterFromQuery(Name = "sac")] public string? SecureSac { get; set; }
    [SupplyParameterFromQuery(Name = "yr")] public string? SecureYr { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? SecureSearchText { get; set; }
    [SupplyParameterFromQuery(Name = "sm")] public int? QueryStartMonth { get; set; }
    [SupplyParameterFromQuery(Name = "ch")] public bool? QueryShowChild { get; set; }
    [SupplyParameterFromQuery(Name = "st")] public string? QueryStatus { get; set; }
    [SupplyParameterFromQuery(Name = "ev")] public string? QueryDataEvent { get; set; }
    [SupplyParameterFromQuery(Name = "mp")] public string? QuerySourceMapping { get; set; }

    public eTopicLevel ParentLevel
    {
        get
        {
            var pType = !string.IsNullOrWhiteSpace(RawParentType) ? RawParentType : RawLevel;
            if (string.Equals(pType, "Corporate", StringComparison.OrdinalIgnoreCase)) return eTopicLevel.Corporate;
            if (string.Equals(pType, "Company", StringComparison.OrdinalIgnoreCase)) return eTopicLevel.Company;
            if (string.Equals(pType, "Facility", StringComparison.OrdinalIgnoreCase)) return eTopicLevel.Facility;

            if (_selectedFacilityId.HasValue && _selectedFacilityId.Value > 0) return eTopicLevel.Facility;
            if (_selectedCompanyId.HasValue && _selectedCompanyId.Value > 0) return eTopicLevel.Company;
