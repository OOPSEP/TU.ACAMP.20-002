    public class TopicRowDisplayItem
    {
        public TbActivityTopic Topic { get; set; } = null!;
        public TbActivityTopicChild Child { get; set; } = null!;
        public bool IsMaster { get; set; }
        public string GroupCode { get; set; } = string.Empty;
    }

    private eTgoScopeNo GetScopeForChild(TbActivityTopic topic, TbActivityTopicChild child)
    {
        return child.ActivityGroup?.TgoScopeNo
            ?? _allGroups.FirstOrDefault(g => g.Id == child.ActivityGroupId)?.TgoScopeNo
            ?? child.Source?.Group?.TgoScopeNo
            ?? topic.EmissionGroup?.TgoScopeNo
            ?? eTgoScopeNo.Scope1;
    }

    private string GetGroupCodeForChild(TbActivityTopicChild child)
    {
        return child.ActivityGroup?.Code
            ?? _allGroups.FirstOrDefault(g => g.Id == child.ActivityGroupId)?.Code
            ?? string.Empty;
    }

    private string GetChildDisplayTitle(TbActivityTopic topic, TbActivityTopicChild child, bool isMaster)
    {
        if (isMaster) return topic.Title;
        var scope = GetScopeForChild(topic, child);
        if (scope == eTgoScopeNo.SeparateReport)
        {
            return $"[Biogenic] {topic.Title}";
        }
        if (scope == eTgoScopeNo.Scope3)
        {
            return $"[การได้มา] {topic.Title}";
        }
        return topic.Title;
    }

    // =====================================================================
    // [2026-09-13][Antigravity] GHG Calculation & Row Population Logic
    // 1. GetRowKgCO2e: คำนวณยอด kgCO2e ตามบริบท
    //    - ใน Scope Tabs หรือ All Scopes เมื่อ _showChildTopics = true: คำนวณเฉพาะ Child ในแถวนั้น
    //    - ใน All Scopes เมื่อ _showChildTopics = false: รวมยอด Child ทั้งหมดของ Topic นั้น (Master + Child WTT/Bio)
    // 2. GetGroupTopicRows: ทุก Scope Tab จะต้องแสดงรายการ Emission ทั้งหมดของ Group นั้นเสมอ
    //    ไม่ถูกตัดหรือทำให้ Scope 3 / Bio ว่างเปล่าเพียงเพราะผู้ใช้ปิดการขยาย Child ใน All Scopes
    // 3. Invariant: ผลรวม GHG ทั้งระบบจะต้องสมบูรณ์ ครบถ้วน 100% เสมอในทุกโหมด
    // =====================================================================

    /// <summary>
    /// [2026-09-13][Antigravity] คำนวณ kgCO2e สำหรับแถวที่กำหนด
    /// ถ้า isAllScopesTab = true และ _showChildTopics = false จะรวมยอดการปล่อยของทุก Active Child ใน Topic นั้น
    /// </summary>
    private decimal GetRowKgCO2e(TopicRowDisplayItem item, bool isAllScopesTab = false)
    {
        if (item.Topic == null) return 0m;

        if (isAllScopesTab && !_showChildTopics)
        {
            // Rollup ยอด Active Child ทุกตัวของ Topic นี้
            return item.Topic.Childs
                .Where(c => c.IsActive && !c.IsDeleted && c.Source != null)
                .Sum(c =>
                {
                    var qty = item.Topic.Events.Where(e => IsEventInReportingPeriod(e)).Sum(e => e.Quantity);
                    return EmissionCalculator.CalculateKgCO2e(qty, c);
                });
        }

        if (item.Child?.Source == null) return 0m;
        var q = item.Topic.Events.Where(e => IsEventInReportingPeriod(e)).Sum(e => e.Quantity);
        return EmissionCalculator.CalculateKgCO2e(q, item.Child);
    }

    /// <summary>
    /// [2026-09-13][Antigravity] ดึง Active Children ทั้งหมดของ Topic ที่ผ่านตัวกรอง
    /// </summary>
    private List<TopicRowDisplayItem> BuildAllActiveDisplayRows()
    {
        var rows = new List<TopicRowDisplayItem>();

        foreach (var t in _filteredItems)
        {
            var activeChildren = t.Childs
                .Where(c => c.IsActive && !c.IsDeleted)
                .OrderBy(c => c.Id)
                .ToList();

            if (activeChildren.Count == 0)
            {
                rows.Add(new TopicRowDisplayItem
                {
                    Topic = t,
                    Child = new TbActivityTopicChild { Topic = t, TopicId = t.Id },
                    IsMaster = true,
                    GroupCode = string.Empty
                });
                continue;
            }

            var masterChild = activeChildren[0];
            foreach (var c in activeChildren)
            {
                rows.Add(new TopicRowDisplayItem
                {
                    Topic = t,
                    Child = c,
                    IsMaster = (c.Id == masterChild.Id),
                    GroupCode = GetGroupCodeForChild(c)
                });
            }
        }

        return rows;
    }

    /// <summary>
    /// [2026-09-13][Antigravity] สร้างแถวสำหรับแท็บ All Scopes
    /// เมื่อ _showChildTopics = false จะแสดง 1 แถวต่อ Topic (Master row)
    /// </summary>
    private List<TopicRowDisplayItem> BuildAllScopesDisplayRows()
    {
        var rows = new List<TopicRowDisplayItem>();

        foreach (var t in _filteredItems)
        {
            var activeChildren = t.Childs
                .Where(c => c.IsActive && !c.IsDeleted)
                .OrderBy(c => c.Id)
                .ToList();

            if (activeChildren.Count == 0)
            {
                rows.Add(new TopicRowDisplayItem
                {
                    Topic = t,
                    Child = new TbActivityTopicChild { Topic = t, TopicId = t.Id },
                    IsMaster = true,
                    GroupCode = string.Empty
                });
                continue;
            }

            var masterChild = activeChildren[0];
            var visibleChildren = _showChildTopics
                ? activeChildren
                : new List<TbActivityTopicChild> { masterChild };

            foreach (var c in visibleChildren)
            {
                rows.Add(new TopicRowDisplayItem
                {
                    Topic = t,
                    Child = c,
                    IsMaster = (c.Id == masterChild.Id),
                    GroupCode = GetGroupCodeForChild(c)
                });
            }
        }

        return rows;
    }

    /// <summary>ลำดับการแสดงผลมาตรฐานของแถว (ใช้ร่วมกันทุก Tab)</summary>
    private static List<TopicRowDisplayItem> SortDisplayRows(IEnumerable<TopicRowDisplayItem> rows)
    {
        return rows
            .OrderBy(r => string.IsNullOrWhiteSpace(r.GroupCode) ? 1 : 0)
            .ThenBy(r => r.GroupCode)
            .ThenBy(r => r.Topic.OrderId)
            .ThenBy(r => r.Topic.Id)
            .ToList();
    }

    /// <summary>แผนที่ ActivityGroupId -> Scope เฉพาะ Group ที่มีอยู่จริงใน _allGroups</summary>
    private Dictionary<int, eTgoScopeNo> GetGroupScopeMap()
    {
        return _allGroups
            .GroupBy(g => g.Id)
            .ToDictionary(g => g.Key, g => g.First().TgoScopeNo);
    }

    /// <summary>นับจำนวนแถวที่ตกอยู่ใน Scope ที่ระบุ (รวมทุก Group ใน Scope นั้น)</summary>
    private static int CountRowsInScope(List<TopicRowDisplayItem> rows, Dictionary<int, eTgoScopeNo> scopeMap, eTgoScopeNo scope)
    {
        return rows.Count(r => scopeMap.TryGetValue(r.Child.ActivityGroupId, out var s) && s == scope);
    }

    /// <summary>
    /// แถวที่ไม่ผูกกับ Group ที่มีอยู่จริง (Group ถูกลบ/ปิด หรือ Topic ไม่มี Active Child)
    /// แถวกลุ่มนี้จะไม่ปรากฏใน Scope Tab ใดเลย จึงต้องแสดงให้เห็นชัดใน All Scopes
    /// </summary>
    private static List<TopicRowDisplayItem> FilterUngroupedRows(List<TopicRowDisplayItem> rows, Dictionary<int, eTgoScopeNo> scopeMap)
    {
        return rows.Where(r => !scopeMap.ContainsKey(r.Child.ActivityGroupId)).ToList();
    }

    /// <summary>
    /// คืน Scope จาก Group ที่ผูกอยู่จริงเท่านั้น ถ้าไม่พบจะคืน null
    /// (ไม่ fallback เป็น Scope1 เพราะทำให้ badge ไม่ตรงกับ Tab ที่แถวนั้นอยู่จริง)
    /// </summary>
    private eTgoScopeNo? TryGetScopeForChild(TbActivityTopicChild child)
    {
        return _allGroups.FirstOrDefault(g => g.Id == child.ActivityGroupId)?.TgoScopeNo;
    }

    /// <summary>
    /// [2026-09-13][Antigravity] แถวของ Tab "All Scopes" — ยึดตามการตั้งค่าการกาง/พับ _showChildTopics
    /// </summary>
    private List<TopicRowDisplayItem> GetAllTopicRows()
    {
        return SortDisplayRows(BuildAllScopesDisplayRows());
    }

    /// <summary>
    /// [2026-09-13][Antigravity] แถวของ Group หนึ่ง ๆ ใน Scope Tab
    /// ต้องแสดง Active Children ทั้งหมดของ Group นั้นเสมอ โดยไม่สูญหายเมื่อพับ Child ใน All Scopes
    /// </summary>
    private List<TopicRowDisplayItem> GetGroupTopicRows(int groupId)
    {
        return SortDisplayRows(BuildAllActiveDisplayRows().Where(r => r.Child.ActivityGroupId == groupId));
    }

    private RenderFragment RenderAccordionForScope(eTgoScopeNo scope) => @<text>
        @{
            var groupsInScope = _allGroups.Where(g => g.TgoScopeNo == scope).OrderBy(g => g.Code).ToList();
            var activeAccIdx = GetAccordionIndexForScope(scope);
        }
        @if (!groupsInScope.Any())
        {
            <div class="p-4 text-center text-muted bg-white rounded-3 border">
                No activity groups configured under this scope.
            </div>
        }
        else
        {
            <RadzenAccordion Multiple="false">
                <Items>
                    @foreach (var group in groupsInScope)
                    {
                        var currentGroup = group;
                        var groupId = currentGroup.Id;
                        var currentGroupIdx = groupsInScope.IndexOf(currentGroup);
                        var isSelected = (currentGroupIdx == activeAccIdx);
                        var groupRows = GetGroupTopicRows(groupId);
                        var hasTopics = groupRows.Any();
                        var totalKg = groupRows.Sum(r => GetRowKgCO2e(r, false));

                        <RadzenAccordionItem Text="@($"{currentGroup.Code} - {currentGroup.Title}")" Icon="folder"
                                             Class="@(hasTopics ? "acc-has-topics shadow-sm mb-2" : "shadow-sm mb-2")"
                                             Selected="@isSelected"
                                             SelectedChanged="@(val => OnAccordionItemSelectChanged(scope, currentGroupIdx, val))">
                            <Template>
                                <div class="d-flex justify-content-between align-items-center w-100 pe-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold">@($"{currentGroup.Code} - {currentGroup.Title}")</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (hasTopics)
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis border fw-bold px-2 py-1">
                                                @($"{groupRows.Count} Items")
                                            </span>
                                            <span class="badge bg-light text-dark border px-2 py-1">
                                                @($"{totalKg:N2} kgCO2e")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                                Empty
                                            </span>
                                        }
                                    </div>
                                </div>
                            </Template>
                            <ChildContent>
                                <div class="p-2 bg-white rounded-bottom">
                                    @RenderGridForTopicRows(groupRows, showScopeColumn: false)
                                </div>
                            </ChildContent>
                        </RadzenAccordionItem>
                    }
                </Items>
            </RadzenAccordion>
        }
    </text>;

    private RenderFragment RenderGridForTopicRows(List<TopicRowDisplayItem> rows, bool showScopeColumn) => @<text>
        @if (!rows.Any())
        {
            <div class="p-3 text-center text-muted">
                No activity topics in this group.
            </div>
        }
        else
        {
            // [2026-09-24][Claude] ช่วงค่า kgCO2e ของแถวในตารางนี้ คำนวณครั้งเดียวต่อการ render ใช้ไล่สีคอลัมน์ kgCO2e
            var kgRange = GhgHeatScale.GetRange(rows.Select(r => GetRowKgCO2e(r, showScopeColumn)));
            <RadzenDataGrid Data="@rows" TItem="TopicRowDisplayItem" AllowPaging="false" AllowSorting="true"
                            AllowColumnResize="true" Density="Density.Compact" Style="@GridStyles.Default"
                            RowRender="@OnTopicRowRender">
                <Columns>
                    <RadzenDataGridColumn TItem="TopicRowDisplayItem" Title="#" Width="45px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            @(rows.IndexOf(item) + 1)
                        </Template>
                    </RadzenDataGridColumn>

                    @if (showScopeColumn)
                    {
                        <RadzenDataGridColumn TItem="TopicRowDisplayItem" Property="GroupCode" Title="Scope & Group" MinWidth="180px">
                            <Template Context="item">
                                @{
                                    // [2026-09-13][Claude] ใช้ Scope จาก Group ที่มีอยู่จริงเท่านั้น
                                    // ถ้าหา Group ไม่เจอให้แสดง "Unassigned" แทนการ fallback เป็น Scope 1
                                    // (ของเดิม badge บอก Scope 1 แต่กดเข้า Tab Scope 1 ไม่เจอแถวนั้น)
                                    var rowScope = TryGetScopeForChild(item.Child);
                                    var badgeColor = rowScope switch
                                    {
                                        eTgoScopeNo.Scope1 => "bg-primary text-white",
                                        eTgoScopeNo.Scope2 => "bg-success text-white",
                                        eTgoScopeNo.Scope3 => "bg-info text-white",
                                        eTgoScopeNo.SeparateReport => "bg-secondary text-white",
                                        _ => "bg-danger text-white"
                                    };
                                    var scopeText = rowScope switch
                                    {
                                        eTgoScopeNo.Scope1 => "Scope 1",
                                        eTgoScopeNo.Scope2 => "Scope 2",
                                        eTgoScopeNo.Scope3 => "Scope 3",
                                        eTgoScopeNo.SeparateReport => "Separate Report",
                                        _ => "Unassigned"
                                    };
                                    var groupTitle = _allGroups.FirstOrDefault(g => g.Id == item.Child.ActivityGroupId)?.Title 
                                                  ?? item.Child.ActivityGroup?.Title 
                                                  ?? "-";
                                }
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge @badgeColor" style="font-size: 0.72rem; font-weight: 600; border-radius: 4px; padding: 2px 6px;">
                                        @scopeText
                                    </span>
                                    <span class="small fw-semibold text-secondary">
                                        @groupTitle
                                    </span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    }

                    @* [2026-09-21][Gemini] ขยาย Width=450px และ MinWidth=360px ให้คอลัมน์ Title กว้างพอรองรับชื่อ Topic ยาวๆ พร้อมปรับ word-break และ line-height *@
                    <RadzenDataGridColumn TItem="TopicRowDisplayItem" Property="Topic.Title" Title="Title / Topic Name" Width="450px" MinWidth="360px">
                        <Template Context="item">
                            <div style="word-break: break-word; line-height: 1.45;">
                                @if (!item.IsMaster)
                                {
                                    <span class="badge bg-warning text-dark me-1" style="font-size: 0.7rem; font-weight: bold; border-radius: 4px; padding: 2px 5px; vertical-align: middle;">Child</span>
                                }
                                <a href="javascript:void(0)" class="fw-bold text-decoration-none" style="vertical-align: middle;"
                                   @onclick="@(() => NavigateToEdit(item.Topic))" title="Edit Topic">
                                    @GetChildDisplayTitle(item.Topic, item.Child, item.IsMaster)
                                </a>
                                @if (showScopeColumn && !_showChildTopics)
                                {
                                    var activeChildCount = item.Topic.Childs.Count(c => c.IsActive && !c.IsDeleted);
                                    if (activeChildCount > 1)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle ms-1"
                                              style="font-size: 0.72rem; font-weight: 600; border-radius: 4px; padding: 2px 6px; vertical-align: middle;"
                                              title="@($"Includes {activeChildCount - 1} child emission source(s) (WTT / Biogenic) rolled up")">
                                            +@(activeChildCount - 1) Child
                                        </span>
                                    }
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.Topic.Remark))
                            {
                                <div class="text-muted small text-truncate mt-1" title="@item.Topic.Remark">@item.Topic.Remark</div>
                            }
                        </Template>
                        <FooterTemplate>
                            <div class="fw-bold text-dark">
                                Total (@(_selectedYear.HasValue ? $"Year {_selectedYear.Value}" : "All Years"))
                            </div>
                        </FooterTemplate>
                    </RadzenDataGridColumn>

                    @* [2026-09-24][Claude] ปรับความกว้างคอลัมน์ให้พอดีกับเนื้อหาจริง (ตัวเลขหลักล้าน, ปุ่มไม่ชิดขอบเซลล์) *@
                    <RadzenDataGridColumn TItem="TopicRowDisplayItem" Title="Source" Width="260px" MinWidth="200px">
                        <Template Context="item">
                            @if (item.Child.Source != null)
                            {
                                var isUnknownSource = item.Child.Source.Id == -1;
                                <a href="javascript:void(0)" class="@(isUnknownSource ? "fw-bold text-decoration-none text-warning" : "fw-bold text-decoration-none")"
                                   @onclick="@(() => NavigateToEmissionSource(item.Child.Source, item.Topic))"
                                   title="@(isUnknownSource ? "Emission Source is not identified" : (CanEditEmissionSource(item.Child.Source) ? "Edit Emission Source" : "View Emission Source"))">
                                    @item.Child.Source.Title
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TopicRowDisplayItem" Title="Quantity" Width="145px" TextAlign="TextAlign.Right">
                        <Template Context="item">
                            @{
                                var qty = item.Topic.Events.Where(e => IsEventInReportingPeriod(e)).Sum(e => e.Quantity);
                            }
                            <span class="fw-bold text-dark font-monospace pe-2">@($"{qty:N2}")</span>
                        </Template>
              
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TopicRowDisplayItem" Title="Unit" Width="90px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            @{
                                var unitTitle = item.Child.ActivityUnit?.Title ?? item.Child.Source?.Unit?.Title ?? "Unit";
                            }
                            <span class="text-secondary fw-medium">@unitTitle</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TopicRowDisplayItem" Title="EF" Width="115px" TextAlign="TextAlign.Right">
                        <Template Context="item">
                            @{
                                var rawEf = item.Child.Source?.EF ?? 0m;
                                var ratio = item.Child.UnitConversionRatio ?? 1m;
                                var ef = rawEf * ratio;
                            }
                            <span class="fw-semibold text-dark font-monospace">@($"{ef:N4}")</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TopicRowDisplayItem" Title="kgCO2e" Width="160px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            @{
                                var kg = GetRowKgCO2e(item, showScopeColumn);
                                var hasRolledUpChildren = showScopeColumn && !_showChildTopics && item.Topic.Childs.Count(c => c.IsActive && !c.IsDeleted) > 1;
                                // [2026-09-24][Claude] ปุ่มกว้างเท่ากัน + สีตามความหนักเบาเทียบกับแถวอื่นในตารางเดียวกัน (เบาสุด = เขียว, หนักสุด = แดง, ไม่มีข้อมูล = เทา)
                                var kgIntensity = GhgHeatScale.GetIntensity(kg, kgRange);
                                var kgLevelText = GhgHeatScale.Describe(kgIntensity, "rows");
                            }
                            <RadzenButton Text="@($"{kg:N2}")"
                                          ButtonStyle="@(kg > 0 ? ButtonStyle.Success : ButtonStyle.Light)"
                                          Variant="Variant.Flat" Size="ButtonSize.Small"
                                          Click="@(_ => NavigateToLciBreakdown(item.Topic))"
                                          Style="@(GhgHeatScale.BuildStyle("width: 135px; justify-content: center; border-radius: 6px; font-weight: 600; height: 32px; font-variant-numeric: tabular-nums;", kgIntensity))"
                                          Title="@(hasRolledUpChildren
                                              ? $"Total {kg:N2} kgCO2e for {item.Topic.Title} including all child sources ({(_selectedYear.HasValue ? $"Year {_selectedYear.Value}" : "All Years")}) - {kgLevelText}"
                                              : $"View LCI & GHG breakdown calculations for {item.Topic.Title} ({(_selectedYear.HasValue ? $"Year {_selectedYear.Value}" : "All Years")}) - {kgLevelText}")" />
                        </Template>
                        <FooterTemplate>
                            @{
                                var totalKg = rows.Sum(r => GetRowKgCO2e(r, showScopeColumn));
                            }
                            <div class="fw-bold text-center text-success font-monospace" style="font-size: 0.88rem;">
                                @($"{totalKg:N2} kg")
                            </div>
                        </FooterTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TopicRowDisplayItem" Title="Events" Width="130px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            @{
                                var count = item.Topic.Events.Count(e => IsEventInReportingPeriod(e));
                            }
                            <RadzenButton Icon="calendar_month" Text="@($"{count} Events")"
                                          ButtonStyle="@(count > 0 ? ButtonStyle.Primary : ButtonStyle.Light)"
                                          Variant="Variant.Flat" Size="ButtonSize.Small"
                                          Click="@(_ => NavigateToEvents(item.Topic))"
                                          Style="border-radius: 6px; font-weight: 600; min-width: 90px; height: 32px;"
                                          Title="@($"Manage Monthly Events ({count} events logged)")" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TopicRowDisplayItem" Title="Files" Width="120px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            @{
                                var fileCount = TbFileEntity.DeserializeListFromJson(item.Topic.JsonDataFiles?.ToJsonString(null) ?? "[]")?.Count ?? 0;
                            }
                            <RadzenButton Icon="attach_file" Text="@($"{fileCount} Files")"
                                          ButtonStyle="@(fileCount > 0 ? ButtonStyle.Info : ButtonStyle.Light)"
                                          Variant="Variant.Flat" Size="ButtonSize.Small"
                                          Click="@(_ => NavigateToFiles(item.Topic))"
                                          Style="border-radius: 6px; font-weight: 600; min-width: 90px; height: 32px;"
                                          Title="Manage Attached Files & References" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TopicRowDisplayItem" Title="API Spec" Width="125px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <RadzenButton Text="API Spec" Icon="code" Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                                          Style="border-radius: 6px; font-weight: 600; min-width: 90px; height: 32px;"
                                          Click="@(_ => NavigateToApiSpec(item.Topic))" Title="View API Specification" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TopicRowDisplayItem" Title="Actions" Width="130px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <RadzenSplitButton Icon="edit" Text="Edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                               Style="border-radius: 6px; font-weight: 600; min-width: 90px; height: 32px;"
                                               Click="@(args => OnSplitActionClick(args, item))">
                                <ChildContent>
                                    <RadzenSplitButtonItem Text="API Specification" Value="apispec" Icon="code" />
                                    <RadzenSplitButtonItem Text="Manage Events" Value="events" Icon="calendar_month" />
                                    <RadzenSplitButtonItem Text="LCI & GHG Detailing" Value="detailing" Icon="analytics" />
                                    <RadzenSplitButtonItem Text="Attach Files" Value="attachments" Icon="attach_file" />
                                    <RadzenSplitButtonItem Visible="false" Text="Move Up" Value="moveup" Icon="arrow_upward" />
                                    <RadzenSplitButtonItem Visible="false" Text="Move Down" Value="movedown" Icon="arrow_downward" />
                                    <RadzenSplitButtonItem Text="Duplicate" Value="duplicate" Icon="content_copy" />
                                    <RadzenSplitButtonItem Text="Clear Events" Value="clearevents" Icon="delete_sweep" />
                                    <RadzenSplitButtonItem Text="Delete" Value="delete" Icon="delete" />
                                </ChildContent>
                            </RadzenSplitButton>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </text>;

    private string GetParentTypeDisplayName()
    {
        return ParentLevel switch
        {
            eTopicLevel.Corporate => "Corporate",
            eTopicLevel.Company => "Company",
            _ => "Facility"
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SyncBrowserUrlAsync();
        }
    }

    private async Task SyncBrowserUrlAsync()
    {
        try
        {
            var parentId = ParentLevel switch
            {
                eTopicLevel.Corporate => _selectedCorporateId ?? 0,
                eTopicLevel.Company => _selectedCompanyId ?? 0,
                _ => _selectedFacilityId ?? 0
            };

            var curAcc = GetAccordionIndexForTab(_activeTabIndex);
            var queryParams = new Dictionary<string, object?>
            {
                ["ptype"] = ParentLevel.ToString(),
                ["pid"] = parentId > 0 ? DataProtection.Protect(parentId) : null,
                ["sid"] = _selectedSubscriptionId.HasValue ? DataProtection.Protect(_selectedSubscriptionId.Value) : null,
                ["tab"] = _activeTabIndex.ToString(),
                ["sac"] = curAcc >= 0 ? curAcc.ToString() : null,
                ["yr"] = _selectedYear.HasValue ? _selectedYear.Value.ToString() : null,
                ["q"] = !string.IsNullOrWhiteSpace(_searchText) ? _searchText : null,
                ["sm"] = _startMonth != 1 ? _startMonth.ToString() : null,
                ["ch"] = _showChildTopics ? "true" : null,
                ["st"] = _statusFilter != "all" ? _statusFilter : null,
                ["ev"] = _dataEventFilter != "all" ? _dataEventFilter : null,
                ["mp"] = _sourceMappingFilter != "all" ? _sourceMappingFilter : null
            };

            var uri = NavigationManager.GetUriWithQueryParameters("/library/activity-topics", queryParams);
            await JSRuntime.InvokeVoidAsync("history.replaceState", null, "", uri);
        }
        catch
        {
            // Ignore during prerender or if JS interop is not yet connected
        }
    }

    private void OnTabChanged(int index)
    {
        _activeTabIndex = Math.Clamp(index, 0, 4);
        _ = SyncBrowserUrlAsync();
    }

    private void OnAccordionItemSelectChanged(eTgoScopeNo scope, int groupIndex, bool isSelected)
    {
        var tab = ScopeToTabIndex(scope);
        SetAccordionIndexForTab(tab, isSelected ? groupIndex : -1);
        _ = SyncBrowserUrlAsync();
    }

    private async Task OnSubscriptionChanged(object? value)
    {
        #region hide [2026-08-18]
        if (value is int sid)
        {
            _selectedSubscriptionId = sid;
        }
        else
        {
            _selectedSubscriptionId = null;
        }
        await ResolveParentContextNameAsync();
        await LoadDataAsync();
        await SyncBrowserUrlAsync();
        #endregion
    }

    private string SyncTopicStateAndGetReturnUrl(TbActivityTopic? item = null)
    {
        #region hide [2026-08-28]
        if (item != null && _activeTabIndex != 4)
        {
            // [2026-09-13][Claude] ใช้กฎ master เดียวกับ BuildDisplayRows() (นับเฉพาะ Child ที่ Active)
            // ของเดิมหยิบ Child ที่ถูกปิด/ลบมาเป็น master ทำให้เด้งไป Tab ผิด Scope
            var masterChild = item.Childs.Where(c => c.IsActive && !c.IsDeleted).OrderBy(c => c.Id).FirstOrDefault();
            if (masterChild != null)
            {
                var scope = GetScopeForChild(item, masterChild);
                _activeTabIndex = ScopeToTabIndex(scope);

                var groupsInScope = _allGroups.Where(g => g.TgoScopeNo == scope).OrderBy(g => g.Code).ToList();
                var groupIdx = groupsInScope.FindIndex(g => g.Id == masterChild.ActivityGroupId);
                if (groupIdx >= 0)
                {
                    SetAccordionIndexForTab(_activeTabIndex, groupIdx);
                }
            }
        }

        var parentId = ParentLevel switch
        {
            eTopicLevel.Corporate => _selectedCorporateId ?? 0,
            eTopicLevel.Company => _selectedCompanyId ?? 0,
            _ => _selectedFacilityId ?? 0
        };

        var curAcc = GetAccordionIndexForTab(_activeTabIndex);
        var queryParams = new Dictionary<string, object?>
        {
            ["ptype"] = ParentLevel.ToString(),
            ["pid"] = parentId > 0 ? DataProtection.Protect(parentId) : null,
            ["sid"] = _selectedSubscriptionId.HasValue ? DataProtection.Protect(_selectedSubscriptionId.Value) : null,
            ["tab"] = _activeTabIndex.ToString(),
            ["sac"] = curAcc >= 0 ? curAcc.ToString() : null,
            ["yr"] = _selectedYear.HasValue ? _selectedYear.Value.ToString() : null,
            ["q"] = !string.IsNullOrWhiteSpace(_searchText) ? _searchText : null
        };

        var uri = NavigationManager.GetUriWithQueryParameters("/library/activity-topics", queryParams);
        return "/" + NavigationManager.ToBaseRelativePath(NavigationManager.ToAbsoluteUri(uri).AbsoluteUri);
        #endregion
    }

