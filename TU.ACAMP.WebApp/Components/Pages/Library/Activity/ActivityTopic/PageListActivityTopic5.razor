    private bool CanEditEmissionSource(TbEmissionSource? item)
    {
        if (item == null) return false;
        bool isSystem = item.SourceType == eSourceType.Default;
        return _isAdmin || (!isSystem && !item.IsReadOnly && item.SubscriptionId.HasValue && _editableSubscriptionIds.Contains(item.SubscriptionId.Value));
    }

    private void NavigateToEmissionSource(TbEmissionSource item, TbActivityTopic? topic = null)
    {
        #region hide [2026-08-30]
        if (item == null) return;
        var secureId = DataProtection.Protect(item.Id);
        var returnUrl = SyncTopicStateAndGetReturnUrl(topic);

        var queryParams = new Dictionary<string, object?>
        {
            ["sid"] = item.SubscriptionId.HasValue ? DataProtection.Protect(item.SubscriptionId.Value) : (_selectedSubscriptionId.HasValue ? DataProtection.Protect(_selectedSubscriptionId.Value) : null),
            ["ret"] = DataProtection.Protect(returnUrl)
        };

        var actionPath = CanEditEmissionSource(item) ? "edit" : "view";
        var url = NavigationManager.GetUriWithQueryParameters($"/library/emission-sources/{actionPath}/{Uri.EscapeDataString(secureId)}", queryParams);
        NavigationManager.NavigateTo(url);
        #endregion
    }

    private async Task OnSplitActionClick(RadzenSplitButtonItem? args, TopicRowDisplayItem row)
    {
        #region hide [2026-08-18]
        var item = row.Topic;
        if (args == null || string.IsNullOrWhiteSpace(args.Value?.ToString()))
        {
            NavigateToEdit(item);
            return;
        }

        var action = args.Value.ToString();
        if (action == "apispec")
        {
            await NavigateToApiSpec(item);
        }
        else if (action == "events")
        {
            NavigateToEvents(item);
        }
        else if (action == "detailing" || action == "lci-breakdown")
        {
            NavigateToLciBreakdown(item);
        }
        else if (action == "attachments")
        {
            NavigateToFiles(item);
        }
        else if (action == "moveup")
        {
            await MoveTopicUpAsync(row);
        }
        else if (action == "movedown")
        {
            await MoveTopicDownAsync(row);
        }
        else if (action == "duplicate")
        {
            await DuplicateTopic(item);
        }
        else if (action == "clearevents")
        {
            await ClearEventsFromTopic(item);
        }
        else if (action == "delete")
        {
            await DeleteTopic(item);
        }
        #endregion
    }

