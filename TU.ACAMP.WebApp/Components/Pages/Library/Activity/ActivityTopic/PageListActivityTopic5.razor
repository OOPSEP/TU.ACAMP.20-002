    private async Task ClearEventsFromTopic(TbActivityTopic item)
    {
        #region hide [2026-09-11]
        var eventCount = item.Events.Count(e => !e.IsDeleted);
        if (eventCount == 0)
        {
            NotificationService.Notify(NotificationSeverity.Info, "No Events", "There are no events to clear for this topic.");
            return;
        }

        var confirm = await DialogService.Confirm(
            "Are you sure you want to clear events from this topic?",
            "Clear Events",
            new ConfirmOptions { OkButtonText = "Clear Events", CancelButtonText = "Cancel" });

        if (confirm == true)
        {
            try
            {
                var count = await ActivityTopicService.ClearEventsAsync(item.Id);
                NotificationService.Notify(NotificationSeverity.Success, "Events Cleared", $"{count} event(s) cleared successfully.");
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error clearing events for topic ID: {Id}", item.Id);
                NotificationService.Notify(NotificationSeverity.Error, "Clear Error", ex.Message);
            }
        }
        #endregion
    }

