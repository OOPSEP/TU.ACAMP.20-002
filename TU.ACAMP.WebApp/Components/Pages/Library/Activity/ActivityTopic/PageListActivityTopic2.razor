    private async Task OnSplitActionClick(RadzenSplitButtonItem? args, TbActivityTopic item)
    {
        #region hide [2026-08-18]
        if (args == null || string.IsNullOrWhiteSpace(args.Value?.ToString()))
        {
            NavigateToEdit(item);
            return;
        }

        var action = args.Value.ToString();
        if (action == "apispec")
        {
            await NavigateToApiSpec(item);
        }
        else if (action == "events")
        {
            NavigateToEvents(item);
        }
        else if (action == "attachments")
        {
            NavigateToEdit(item);
        }
        else if (action == "duplicate")
        {
            await DuplicateTopic(item);
        }
        else if (action == "delete")
        {
            await DeleteTopic(item);
        }
        #endregion
    }

    private async Task DuplicateTopic(TbActivityTopic item)
    {
        #region hide [2026-08-18]
        try
        {
            var dup = await ActivityTopicService.DuplicateAsync(item.Id);
            NotificationService.Notify(NotificationSeverity.Success, "Duplicated", $"Topic duplicated as '{dup.Title}'.");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error duplicating topic ID: {Id}", item.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Duplicate Error", ex.Message);
        }
        #endregion
    }

    private async Task DeleteTopic(TbActivityTopic item)
    {
        #region hide [2026-08-18]
        var confirm = await DialogService.Confirm($"Delete activity topic '{item.Title}'?", "Delete Topic",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirm == true)
        {
            try
            {
                await ActivityTopicService.DeleteAsync(item.Id);
                NotificationService.Notify(NotificationSeverity.Success, "Deleted", "Topic deleted successfully.");
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting topic ID: {Id}", item.Id);
                NotificationService.Notify(NotificationSeverity.Error, "Delete Error", ex.Message);
            }
        }
        #endregion
    }

    private async Task ExportToExcelAsync()
    {
        try
        {
            var bytes = await ExcelService.ExportTopicsToExcelAsync(_filteredItems, _selectedYear, _parentContextName);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"Activity_Topics_{TU.ACAMP.Domain.Tools.AppTimeZone.LocalNow:yyyyMMdd_HHmmss}.xlsx";
            await JSRuntime.InvokeVoidAsync("saveAsFile", fileName, base64);
            NotificationService.Notify(NotificationSeverity.Success, "Export Successful", $"Exported {_filteredItems.Count} topics to Excel.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export activity topics to Excel.");
            NotificationService.Notify(NotificationSeverity.Error, "Export Failed", "Failed to generate Excel file.");
        }
    }

    private async Task OpenImportDialogAsync()
    {
        int targetId = 0;
        eTopicLevel level = eTopicLevel.Corporate;

        if (_selectedFacilityId.HasValue && _selectedFacilityId.Value > 0)
        {
            level = eTopicLevel.Facility;
            targetId = _selectedFacilityId.Value;
        }
        else if (_selectedCompanyId.HasValue && _selectedCompanyId.Value > 0)
        {
            level = eTopicLevel.Company;
            targetId = _selectedCompanyId.Value;
        }
        else if (_selectedCorporateId.HasValue && _selectedCorporateId.Value > 0)
        {
            level = eTopicLevel.Corporate;
            targetId = _selectedCorporateId.Value;
        }

        var parameters = new Dictionary<string, object>
        {
            { "SubscriptionId", _selectedSubscriptionId ?? 0 },
            { "Level", level },
            { "TargetId", targetId }
        };

        var options = new DialogOptions
        {
            Width = "1200px",
            Height = "auto",
            Resizable = true,
            Draggable = true
        };

        var result = await DialogService.OpenAsync<ImportActivityTopicDialogV3>("Import Activity Topics", parameters, options);
        if (result == true)
        {
            await LoadDataAsync();
        }
    }

    private async Task NavigateToApiSpec(TbActivityTopic item)
    {
        #region hide [2026-08-24]
        var secureId = DataProtection.Protect(item.Id);
        var returnUrl = SyncTopicStateAndGetReturnUrl(item);

        var queryParams = new Dictionary<string, object?>
        {
            ["id"] = secureId,
            ["tkey"] = PublicKeyCodec.Encode(PublicKeyCodec.TopicPrefix, item.Id),
            ["ptype"] = item.Level.ToString(),
            ["pid"] = item.TargetId > 0 ? DataProtection.Protect(item.TargetId) : null,
            ["sid"] = DataProtection.Protect(item.SubscriptionId),
            ["tab"] = _activeTabIndex.ToString(),
            ["ret"] = DataProtection.Protect(returnUrl)
        };

        var url = NavigationManager.GetUriWithQueryParameters("/library/activity-topics/api-spec", queryParams);
        await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        #endregion
    }
    #endregion
}
