        };

        var url = NavigationManager.GetUriWithQueryParameters("/library/activity-topics/add", queryParams);
        NavigationManager.NavigateTo(url);
        #endregion
    }

    private void NavigateToEdit(TbActivityTopic item)
    {
        #region hide [2026-08-18]
        var secureId = DataProtection.Protect(item.Id);
        var returnUrl = SyncTopicStateAndGetReturnUrl(item);

        var queryParams = new Dictionary<string, object?>
        {
            ["id"] = secureId,
            ["ptype"] = item.Level.ToString(),
            ["pid"] = item.TargetId > 0 ? DataProtection.Protect(item.TargetId) : null,
            ["sid"] = DataProtection.Protect(item.SubscriptionId),
            ["tab"] = _activeTabIndex.ToString(),
            ["ret"] = DataProtection.Protect(returnUrl)
        };

        var url = NavigationManager.GetUriWithQueryParameters("/library/activity-topics/edit", queryParams);
        NavigationManager.NavigateTo(url);
        #endregion
    }

    private void NavigateToEvents(TbActivityTopic item)
    {
        #region hide [2026-08-20]
        var secureId = DataProtection.Protect(item.Id);
        var returnUrl = SyncTopicStateAndGetReturnUrl(item);

        var queryParams = new Dictionary<string, object?>
        {
            ["id"] = secureId,
            ["sid"] = DataProtection.Protect(item.SubscriptionId),
            ["ret"] = DataProtection.Protect(returnUrl)
        };

        var url = NavigationManager.GetUriWithQueryParameters("/library/activity-topics/events", queryParams);
