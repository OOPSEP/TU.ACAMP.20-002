                                             Class="@(hasTopics ? "acc-has-topics shadow-sm mb-2" : "shadow-sm mb-2")"
                                             Selected="@isSelected"
                                             SelectedChanged="@(val => OnAccordionItemSelectChanged(scope, currentGroupIdx, val))">
