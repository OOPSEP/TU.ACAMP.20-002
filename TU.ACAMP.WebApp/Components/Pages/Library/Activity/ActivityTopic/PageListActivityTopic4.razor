    private async Task OnSplitActionClick(RadzenSplitButtonItem? args, TopicRowDisplayItem row)
    {
        #region hide [2026-08-18]
        var item = row.Topic;
        if (args == null || string.IsNullOrWhiteSpace(args.Value?.ToString()))
        {
            NavigateToEdit(item);
            return;
        }

        var action = args.Value.ToString();
        if (action == "apispec")
        {
            await NavigateToApiSpec(item);
        }
        else if (action == "events")
        {
            NavigateToEvents(item);
        }
        else if (action == "detailing" || action == "lci-breakdown")
        {
            NavigateToLciBreakdown(item);
        }
        else if (action == "attachments")
        {
            NavigateToFiles(item);
        }
        else if (action == "moveup")
        {
            await MoveTopicUpAsync(row);
        }
        else if (action == "movedown")
        {
            await MoveTopicDownAsync(row);
        }
        else if (action == "duplicate")
        {
            await DuplicateTopic(item);
        }
        else if (action == "clearevents")
        {
            await ClearEventsFromTopic(item);
        }
        else if (action == "delete")
        {
            await DeleteTopic(item);
        }
        #endregion
    }

