@*
@page "/library/activity-topics"
@page "/activities/topics"
@page "/organization/facility/topics"
*@

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.DataProtection
@using System.Security.Claims
@using System.Text.Json.Nodes
@using TU.ACAMP.Domain.Enums
@using TU.ACAMP.Domain.Identity
@using TU.ACAMP.Domain.Models.Library
@using TU.ACAMP.Domain.Models.Organization
@using TU.ACAMP.Domain.Common
@using TU.ACAMP.Domain.Tools
@using TU.ACAMP.WebApp.Components.Common
@using TU.ACAMP.WebApp.Services.Activity
@using TU.ACAMP.WebApp.Services.Common
@using TU.ACAMP.WebApp.Services.Emissions
@using TU.ACAMP.WebApp.Services.Identity
@using TU.ACAMP.WebApp.Services.Organization

@attribute [Authorize]
@implements IAsyncDisposable

@using TU.ACAMP.WebApp.Components.Pages.Library.Activity.ActivityTopic.Dialogs

@inject ActivityTopicService ActivityTopicService
@inject ActivityTopicExcelService ExcelService
@inject ActivityGroupService ActivityGroupService
@inject EmissionSourceService EmissionSourceService
@inject FacilityService FacilityService
@inject CompanyService CompanyService
@inject CorporateService CorporateService
@inject SubscriptionService SubscriptionService
@inject NavigationManager NavigationManager
@inject IDataProtectionProvider DataProtection
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject GhgEventBusService GhgEventBus
@inject IJSRuntime JSRuntime
@inject ILogger<PageListActivityTopic4> Logger

@*
    ============================================================================
    PageListActivityTopic4.razor  (v4 - 2026-09-11)

    เวอร์ชัน 4: ต่อยอดจาก v3 โดยเพิ่มการจัดลำดับรายการด้วยการลาก-วาง (Drag & Drop)
    บนตาราง โดยจำกัดขอบเขตการเรียงลำดับไว้เฉพาะภายใน Group Code เดียวกันเท่านั้น
    (ห้ามลากข้าม Group Code) และยังคงปุ่ม Move Up / Move Down ไว้ใช้งานคู่กัน
    - ลากได้เฉพาะแถวหลัก (Master Row) เพราะ OrderId ผูกอยู่ที่ระดับ Topic
    - เมื่อวางเสร็จจะเขียน OrderId ใหม่ทั้งกลุ่ม (1..N) ผ่าน ReorderTopicsInGroupAsync
    ============================================================================
*@

<PageTitle>@($"{GetParentTypeDisplayName()} Topics - ACAMP")</PageTitle>

<style>
    .acc-has-topics,
    .acc-has-topics > .rz-accordion-header,
    .acc-has-topics > .rz-accordion-header > a,
    .acc-has-topics > .rz-accordion-content {
        background-color: var(--rz-card-background-color) !important;
        background-color: color-mix(in srgb, var(--rz-success, #4caf50) 14%, var(--rz-card-background-color, #fff)) !important;
    }

    /* Drag & Drop row reorder (v4) */
    .topic-drop-target > td {
        border-top: 2px solid var(--rz-primary, #0d6efd) !important;
        background-color: color-mix(in srgb, var(--rz-primary, #0d6efd) 10%, transparent) !important;
    }
</style>

<div class="container-fluid py-2 px-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center mb-1">
                <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                              Size="ButtonSize.Small" Click="@GoBack" Class="me-2" Style="border-radius: 6px;" />
                <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" Class="m-0 fw-bold" Style="color: var(--rz-text-title-color);">
                    @($"{GetParentTypeDisplayName()} Topics")
                </RadzenText>
            </div>
            <div class="d-flex align-items-center gap-2 mt-1 ms-5 flex-wrap">
                <RadzenText TextStyle="TextStyle.Body2" Class="text-muted m-0">
                    Manage @GetParentTypeDisplayName().ToLower()-level activity calculations, greenhouse gas scopes, and emission sources.
                </RadzenText>
                @if (!string.IsNullOrWhiteSpace(_parentContextName))
                {
                    <span style="display:inline-flex; align-items:center; gap:6px; background:var(--rz-primary-lighter,#e8f0fe); color:var(--rz-primary,#3d6af8); border-radius:999px; padding:3px 14px; font-size:0.78rem; font-weight:600; white-space:nowrap;">
                        <span class="rzi" style="font-size:0.9rem;">business</span>
                        @_parentContextName
                    </span>
                }
            </div>
        </div>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Class="flex-wrap">
            <RadzenButton Text="Export Excel" Icon="download" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                          Click="@ExportToExcelAsync" Style="border-radius: 8px; font-weight: 600;" />
            <RadzenButton Text="Import Excel" Icon="file_upload" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined"
                          Click="@OpenImportDialogAsync" Style="border-radius: 8px; font-weight: 600;" Disabled="@_isAddDisabled" />
            <RadzenButton Text="Add Topic" Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                          Click="@NavigateToCreate" Style="border-radius: 8px; font-weight: 600;" Disabled="@_isAddDisabled" />
        </RadzenStack>
    </div>

    <!-- Filters Card -->
    <RadzenCard Class="mb-3 p-3 shadow-sm rounded-3" Style="background: var(--rz-card-background-color); border: 1px solid var(--rz-border-color);">
        <RadzenRow Class="g-3 align-items-center">
            <RadzenColumn Size="12" SizeMD="5">
                <RadzenFormField Text="Search Topics" Style="width: 100%;">
                    <RadzenTextBox @bind-Value="@SearchText"
                                   Placeholder="Search by Title, Code, Remark, or Source..."
                                   Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>

            @if (_isAdmin || _subscriptionsList.Count > 1)
            {
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Subscription Workspace" Style="width: 100%;">
                        <RadzenDropDown TValue="int?" Value="@_selectedSubscriptionId" Data="@_subscriptionsList"
                                        TextProperty="Title" ValueProperty="Id" Placeholder="All Subscriptions"
                                        AllowClear="true" Change="@OnSubscriptionChanged"
                                        Style="width: 100%;" />
                    </RadzenFormField>
                </RadzenColumn>
            }

            <RadzenColumn Size="12" SizeMD="@((_isAdmin || _subscriptionsList.Count > 1) ? 3 : 7)" Class="d-flex align-items-center justify-content-end gap-2">
                <RadzenFormField Text="Reporting Year" Style="width: 150px;">
                    <RadzenDropDown @bind-Value="@_selectedYear"
                                    Data="@_yearOptions"
                                    TextProperty="Text"
                                    ValueProperty="Value"
                                    Change="@(async _ => { ApplyInMemoryFilters(); await SyncBrowserUrlAsync(); })"
                                    Style="width: 100%;" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
    </RadzenCard>

    <!-- Scope Tabs & Main Content -->
    @if (_isLoading)
    {
        <div class="py-5 text-center">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <RadzenText Text="Loading topics..." TextStyle="TextStyle.Body2" class="text-muted mt-2" />
        </div>
    }
    else
    {
        <RadzenTabs RenderMode="TabRenderMode.Client" SelectedIndex="@_activeTabIndex" Change="@OnTabChanged"
                    Class="shadow-sm rounded-3 mb-4" Style="background: var(--rz-card-background-color); border: 1px solid var(--rz-border-color);">
            <Tabs>
                <RadzenTabsItem Text="Scope 1 (Direct GHG)">
                    <div class="p-3 bg-light rounded-3 mt-2">
                        @RenderAccordionForScope(eTgoScopeNo.Scope1)
                    </div>
                </RadzenTabsItem>
                <RadzenTabsItem Text="Scope 2 (Indirect Energy)">
                    <div class="p-3 bg-light rounded-3 mt-2">
                        @RenderAccordionForScope(eTgoScopeNo.Scope2)
                    </div>
                </RadzenTabsItem>
                <RadzenTabsItem Text="Scope 3 (Other Indirect)">
                    <div class="p-3 bg-light rounded-3 mt-2">
                        @RenderAccordionForScope(eTgoScopeNo.Scope3)
                    </div>
                </RadzenTabsItem>
                <RadzenTabsItem Text="Separate Report (Biogenic CO₂)">
                    <div class="p-3 bg-light rounded-3 mt-2">
                        @RenderAccordionForScope(eTgoScopeNo.SeparateReport)
                    </div>
                </RadzenTabsItem>
                <RadzenTabsItem Text="All Scopes">
                    <div class="p-3 bg-light rounded-3 mt-2">
                        @{
                            var allRows = GetAllTopicRows();
                            var scopeMap = GetGroupScopeMap();
                            var ungroupedRows = FilterUngroupedRows(allRows, scopeMap);
                            var cScope1 = CountRowsInScope(allRows, scopeMap, eTgoScopeNo.Scope1);
                            var cScope2 = CountRowsInScope(allRows, scopeMap, eTgoScopeNo.Scope2);
                            var cScope3 = CountRowsInScope(allRows, scopeMap, eTgoScopeNo.Scope3);
                            var cSeparate = CountRowsInScope(allRows, scopeMap, eTgoScopeNo.SeparateReport);
                        }
                        @if (!allRows.Any())
                        {
                            <div class="p-4 text-center text-muted border rounded bg-white">
                                <RadzenIcon Icon="info" Style="font-size: 36px; opacity: 0.5;" Class="mb-2" />
                                <div>No activity topics found for this reporting scope.</div>
                            </div>
                        }
                        else
                        {
                            <!-- [2026-09-13][Claude] แถบกระทบยอด: All Scopes ต้องเท่ากับผลรวม Scope 1-4 + Unassigned เสมอ -->
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-3 p-2 bg-white border rounded-3 small">
                                <span class="fw-bold me-1">Reconciliation:</span>
                                <span class="badge bg-dark text-white px-2 py-1">All @allRows.Count</span>
                                <span class="text-muted">=</span>
                                <span class="badge bg-primary text-white px-2 py-1">Scope 1 @cScope1</span>
                                <span class="text-muted">+</span>
                                <span class="badge bg-success text-white px-2 py-1">Scope 2 @cScope2</span>
                                <span class="text-muted">+</span>
                                <span class="badge bg-info text-white px-2 py-1">Scope 3 @cScope3</span>
                                <span class="text-muted">+</span>
                                <span class="badge bg-secondary text-white px-2 py-1">Separate @cSeparate</span>
                                @if (ungroupedRows.Any())
                                {
                                    <span class="text-muted">+</span>
                                    <span class="badge bg-danger text-white px-2 py-1">Unassigned @ungroupedRows.Count</span>
                                }
                            </div>

                            @if (ungroupedRows.Any())
                            {
                                <div class="alert alert-warning py-2 px-3 small mb-3" role="alert">
                                    <RadzenIcon Icon="warning" Style="font-size: 16px;" Class="me-1" />
                                    มี @ungroupedRows.Count รายการที่ไม่ได้ผูกกับ Activity Group ที่มีอยู่จริง
                                    จึงไม่ปรากฏใน Tab Scope 1-4 (ต้องแก้ Activity Group ของ Topic เหล่านี้)
                                </div>
                            }

                            <RadzenCard Class="p-2 shadow-sm rounded-3 bg-white">
                                @RenderGridForTopicRows(allRows, showScopeColumn: true)
                            </RadzenCard>
                        }
                    </div>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    }
</div>

@code {
    #region class field
    private bool _isLoading = true;
    private bool _isAdmin = false;
    private bool _isAddDisabled = false;
    private string _searchText = string.Empty;
    private int _activeTabIndex = 0;
    private readonly Dictionary<int, int> _tabAccordionIndices = new() { [0] = 0, [1] = 0, [2] = 0, [3] = 0 };

    private class YearOption
    {
        public int? Value { get; set; }
        public string Text { get; set; } = string.Empty;
    }

    private int? _selectedYear = null;
    private List<YearOption> _yearOptions = new();

    /// <summary>
    /// ตัวแปรกำหนดการมองเห็นของ Child Topic ใน Grid (true = แสดงทุกรายการรวม Child, false = ซ่อน Child Topics / Invisible)
    /// กำหนดค่าแบบ Hardcode (ไม่มี UI)
    /// </summary>
    private bool _showChildTopics = false;

    /// <summary>
    /// แถวที่กำลังถูกลาก (Drag & Drop Reorder) — ใช้ชั่วคราวระหว่างการลาก-วางเท่านั้น
    /// </summary>
    private TopicRowDisplayItem? _draggedRow = null;

    private int ScopeToTabIndex(eTgoScopeNo scope) => scope switch
    {
        eTgoScopeNo.Scope1 => 0,
        eTgoScopeNo.Scope2 => 1,
        eTgoScopeNo.Scope3 => 2,
        eTgoScopeNo.SeparateReport => 3,
        _ => 0
    };

    private int GetAccordionIndexForScope(eTgoScopeNo scope)
    {
        var tab = ScopeToTabIndex(scope);
        return _tabAccordionIndices.TryGetValue(tab, out var idx) ? idx : 0;
    }

    private int GetAccordionIndexForTab(int tab)
    {
        return _tabAccordionIndices.TryGetValue(tab, out var idx) ? idx : 0;
    }

    private void SetAccordionIndexForTab(int tab, int index)
    {
        _tabAccordionIndices[tab] = index;
    }

    private int? _selectedCorporateId;
    private int? _selectedCompanyId;
    private int? _selectedFacilityId;
    private int? _selectedSubscriptionId;
    private string _parentContextName = string.Empty;

    private List<TbSubscription> _subscriptionsList = new();
    private List<TbActivityTopic> _allItems = new();
    private List<TbActivityTopic> _filteredItems = new();
    private List<TbActivityGroup> _allGroups = new();

    private string _currentUserEmail = string.Empty;
    private HashSet<int> _editableSubscriptionIds = new();
    private HashSet<int> _editableCorporateIds = new();
    private HashSet<int> _editableCompanyIds = new();
    private HashSet<int> _editableFacilityIds = new();
    #endregion

    #region class properties
    [SupplyParameterFromQuery(Name = "ptype")] public string? RawParentType { get; set; }
    [SupplyParameterFromQuery(Name = "lvl")] public string? RawLevel { get; set; }
    [SupplyParameterFromQuery(Name = "pid")] public string? SecurePid { get; set; }
    [SupplyParameterFromQuery(Name = "sid")] public string? SecureSid { get; set; }
    [SupplyParameterFromQuery(Name = "cid")] public string? SecureCid { get; set; }
    [SupplyParameterFromQuery(Name = "comid")] public string? SecureComId { get; set; }
    [SupplyParameterFromQuery(Name = "facid")] public string? SecureFacId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? SecureTab { get; set; }
    [SupplyParameterFromQuery(Name = "sac")] public string? SecureSac { get; set; }
    [SupplyParameterFromQuery(Name = "yr")] public string? SecureYr { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? SecureSearchText { get; set; }

    public eTopicLevel ParentLevel
    {
        get
        {
            var pType = !string.IsNullOrWhiteSpace(RawParentType) ? RawParentType : RawLevel;
            if (string.Equals(pType, "Corporate", StringComparison.OrdinalIgnoreCase)) return eTopicLevel.Corporate;
            if (string.Equals(pType, "Company", StringComparison.OrdinalIgnoreCase)) return eTopicLevel.Company;
            if (string.Equals(pType, "Facility", StringComparison.OrdinalIgnoreCase)) return eTopicLevel.Facility;

            if (_selectedFacilityId.HasValue && _selectedFacilityId.Value > 0) return eTopicLevel.Facility;
            if (_selectedCompanyId.HasValue && _selectedCompanyId.Value > 0) return eTopicLevel.Company;
            if (_selectedCorporateId.HasValue && _selectedCorporateId.Value > 0) return eTopicLevel.Corporate;
            return eTopicLevel.Facility;
        }
    }

    private string SearchText
    {
        get => _searchText;
        set
        {
            if (_searchText != value)
            {
                _searchText = value;
                ApplyInMemoryFilters();
            }
        }
    }

    private int ActiveTabIndex
    {
        get => _activeTabIndex;
        set => _activeTabIndex = value;
    }
    #endregion

    #region class methods
    protected override async Task OnInitializedAsync()
    {
        #region hide [2026-08-18]
        _isLoading = true;
        try
        {
            GhgEventBus.OnEventIngested += HandleGhgEventIngestedAsync;
            await InitializeUserSessionAsync();
            RestoreStateParameters();
            await ResolveParentContextNameAsync();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing PageListActivityTopic.");
            NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to load activity topics.");
        }
        finally
        {
            _isLoading = false;
        }
        #endregion
    }

    private async Task HandleGhgEventIngestedAsync(GhgEventIngestedNotification notif)
    {
        if (_selectedSubscriptionId.HasValue && notif.SubscriptionId != _selectedSubscriptionId.Value) return;

        await InvokeAsync(async () =>
        {
            await LoadDataAsync();
            NotificationService.Notify(NotificationSeverity.Info, "Live Event Ingested", $"Activity topic quantities updated in real-time ({notif.Quantity:N2}).");
            StateHasChanged();
        });
    }

    private async Task InitializeUserSessionAsync()
    {
        #region hide [2026-08-18]
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            _currentUserEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? (user.Identity.Name ?? string.Empty);
            _isAdmin = user.IsInRole(SystemRoles.Administrator);
        }

        _editableSubscriptionIds = await SubscriptionService.GetEditableSubscriptionIdsAsync(_currentUserEmail, _isAdmin);
        _subscriptionsList = await SubscriptionService.GetSubscriptionsForUserAsync(_currentUserEmail, _isAdmin, includeInactive: false);
        _editableCorporateIds = await CorporateService.GetEditableCorporateIdsAsync(_currentUserEmail, _isAdmin);
        _editableCompanyIds = await CompanyService.GetEditableCompanyIdsAsync(_currentUserEmail, _isAdmin);
        _editableFacilityIds = await FacilityService.GetEditableFacilityIdsAsync(_currentUserEmail, _isAdmin);

        if (_subscriptionsList.Any() && !_selectedSubscriptionId.HasValue)
        {
            _selectedSubscriptionId = _subscriptionsList.First().Id;
        }
        #endregion
    }

    protected override void OnParametersSet()
    {
        RestoreStateParameters();
    }

    private void RestoreStateParameters()
    {
        #region hide [2026-08-18]
        if (!string.IsNullOrWhiteSpace(SecureSid))
            _selectedSubscriptionId = DataProtection.UnprotectInt(SecureSid);

        if (!string.IsNullOrWhiteSpace(SecureCid))
            _selectedCorporateId = DataProtection.UnprotectInt(SecureCid);

        if (!string.IsNullOrWhiteSpace(SecureComId))
            _selectedCompanyId = DataProtection.UnprotectInt(SecureComId);

        if (!string.IsNullOrWhiteSpace(SecureFacId))
            _selectedFacilityId = DataProtection.UnprotectInt(SecureFacId);

        if (!string.IsNullOrWhiteSpace(SecurePid))
        {
            var pId = DataProtection.UnprotectInt(SecurePid);
            if (pId.HasValue)
            {
                if (ParentLevel == eTopicLevel.Corporate) _selectedCorporateId = pId.Value;
                else if (ParentLevel == eTopicLevel.Company) _selectedCompanyId = pId.Value;
                else if (ParentLevel == eTopicLevel.Facility) _selectedFacilityId = pId.Value;
            }
        }

        if (!string.IsNullOrWhiteSpace(SecureTab))
        {
            var tabVal = DataProtection.UnprotectInt(SecureTab) ?? (int.TryParse(SecureTab, out var t) ? t : 0);
            _activeTabIndex = Math.Clamp(tabVal, 0, 4);
        }

        if (!string.IsNullOrWhiteSpace(SecureSac))
        {
            var sacVal = DataProtection.UnprotectInt(SecureSac) ?? (int.TryParse(SecureSac, out var s) ? s : -1);
            SetAccordionIndexForTab(_activeTabIndex, sacVal);
        }

        if (!string.IsNullOrWhiteSpace(SecureYr))
        {
            if (int.TryParse(SecureYr, out var yr) && yr > 0)
            {
                _selectedYear = yr;
            }
            else if (SecureYr.Equals("all", StringComparison.OrdinalIgnoreCase) || SecureYr == "0")
            {
                _selectedYear = null;
            }
        }

        if (!string.IsNullOrWhiteSpace(SecureSearchText))
            _searchText = SecureSearchText;
        #endregion
    }

    private async Task ResolveParentContextNameAsync()
    {
        #region hide [2026-08-18]
        if (_selectedFacilityId.HasValue && _selectedFacilityId.Value > 0)
        {
            var fac = await FacilityService.GetByIdAsync(_selectedFacilityId.Value);
            if (fac != null)
            {
                _parentContextName = $"Facility: {fac.Title}";
                if (!_selectedSubscriptionId.HasValue && fac.Company?.Corporate != null)
                {
                    _selectedSubscriptionId = fac.Company.Corporate.SubscriptionId;
                }
            }
        }
        else if (_selectedCompanyId.HasValue && _selectedCompanyId.Value > 0)
        {
            var com = await CompanyService.GetByIdAsync(_selectedCompanyId.Value);
            if (com != null)
            {
                _parentContextName = $"Company: {com.Title}";
                if (!_selectedSubscriptionId.HasValue && com.Corporate != null)
                {
                    _selectedSubscriptionId = com.Corporate.SubscriptionId;
                }
            }
        }
        else if (_selectedCorporateId.HasValue && _selectedCorporateId.Value > 0)
        {
            var corp = await CorporateService.GetByIdAsync(_selectedCorporateId.Value);
            if (corp != null)
            {
                _parentContextName = $"Corporate: {corp.Title}";
                if (!_selectedSubscriptionId.HasValue)
                {
                    _selectedSubscriptionId = corp.SubscriptionId;
                }
            }
        }
        else if (_selectedSubscriptionId.HasValue)
        {
            // Default context fallback when navigating directly without query parameters
            var facilities = await FacilityService.GetByContextAsync(subscriptionId: _selectedSubscriptionId.Value);
            var firstFac = facilities.FirstOrDefault();
            if (firstFac != null)
            {
                _selectedFacilityId = firstFac.Id;
                _parentContextName = $"Facility: {firstFac.Title}";
            }
            else
            {
                var corporates = await CorporateService.GetBySubscriptionIdAsync(subscriptionId: _selectedSubscriptionId.Value);
                var firstCorp = corporates.FirstOrDefault();
                if (firstCorp != null)
                {
                    _selectedCorporateId = firstCorp.Id;
                    _parentContextName = $"Corporate: {firstCorp.Title}";
                }
            }
        }
        #endregion
    }

    private async Task LoadDataAsync()
    {
        #region hide [2026-08-18]
        _allGroups = await ActivityGroupService.GetAllAsync();

        eTopicLevel? level = null;
        int? targetId = null;

        if (_selectedFacilityId.HasValue && _selectedFacilityId.Value > 0)
        {
            level = eTopicLevel.Facility;
            targetId = _selectedFacilityId.Value;
        }
        else if (_selectedCompanyId.HasValue && _selectedCompanyId.Value > 0)
        {
            level = eTopicLevel.Company;
            targetId = _selectedCompanyId.Value;
        }
        else if (_selectedCorporateId.HasValue && _selectedCorporateId.Value > 0)
        {
            level = eTopicLevel.Corporate;
            targetId = _selectedCorporateId.Value;
        }

        _allItems = await ActivityTopicService.GetByContextAsync(
            subscriptionId: _selectedSubscriptionId,
            level: level,
            targetId: targetId,
            includeRelations: true,
            includeInactive: true);

        UpdateYearOptions();
        ApplyInMemoryFilters();
        #endregion
    }

    private void UpdateYearOptions()
    {
        var yearsSet = new HashSet<int>();
        var currentYear = DateTime.UtcNow.Year;
        yearsSet.Add(currentYear);
        yearsSet.Add(currentYear - 1);
        yearsSet.Add(currentYear - 2);

        if (_allItems != null)
        {
            foreach (var t in _allItems)
            {
                foreach (var ev in t.Events)
                {
                    if (!ev.IsDeleted && ev.TimeStamp.Year > 2000)
                    {
                        yearsSet.Add(ev.TimeStamp.Year);
                    }
                }
            }
        }

        _yearOptions = new List<YearOption>
        {
            new YearOption { Value = null, Text = "All Years" }
        };

        foreach (var y in yearsSet.OrderByDescending(y => y))
        {
            _yearOptions.Add(new YearOption { Value = y, Text = $"Year {y}" });
        }
    }

    public ValueTask DisposeAsync()
    {
        #region hide [2026-08-24]
        GhgEventBus.OnEventIngested -= HandleGhgEventIngestedAsync;
        return ValueTask.CompletedTask;
        #endregion
    }

    private void ApplyInMemoryFilters()
    {
        #region hide [2026-08-18]
        if (string.IsNullOrWhiteSpace(_searchText))
        {
            _filteredItems = new List<TbActivityTopic>(_allItems);
        }
        else
        {
            var term = _searchText.Trim().ToLowerInvariant();
            _filteredItems = _allItems.Where(t =>
                t.Title.ToLowerInvariant().Contains(term) ||
                t.Remark.ToLowerInvariant().Contains(term) ||
                t.Childs.Any(c => (c.Source != null && c.Source.Title.ToLowerInvariant().Contains(term)) ||
                                  (c.ActivityGroup != null && c.ActivityGroup.Title.ToLowerInvariant().Contains(term)))
            ).ToList();
        }
        #endregion
    }

    public class TopicRowDisplayItem
    {
        public TbActivityTopic Topic { get; set; } = null!;
        public TbActivityTopicChild Child { get; set; } = null!;
        public bool IsMaster { get; set; }
        public string GroupCode { get; set; } = string.Empty;
    }

    private eTgoScopeNo GetScopeForChild(TbActivityTopic topic, TbActivityTopicChild child)
    {
        return child.ActivityGroup?.TgoScopeNo
            ?? _allGroups.FirstOrDefault(g => g.Id == child.ActivityGroupId)?.TgoScopeNo
            ?? child.Source?.Group?.TgoScopeNo
            ?? topic.EmissionGroup?.TgoScopeNo
            ?? eTgoScopeNo.Scope1;
    }

    private string GetGroupCodeForChild(TbActivityTopicChild child)
    {
        return child.ActivityGroup?.Code
            ?? _allGroups.FirstOrDefault(g => g.Id == child.ActivityGroupId)?.Code
            ?? string.Empty;
    }

    private string GetChildDisplayTitle(TbActivityTopic topic, TbActivityTopicChild child, bool isMaster)
    {
        if (isMaster) return topic.Title;
        var scope = GetScopeForChild(topic, child);
        if (scope == eTgoScopeNo.SeparateReport)
        {
            return $"[Biogenic] {topic.Title}";
        }
        if (scope == eTgoScopeNo.Scope3)
        {
            return $"[การได้มา] {topic.Title}";
        }
        return topic.Title;
    }

    // =====================================================================
    // [2026-09-13][Claude] Single source of truth ของการสร้างแถวที่แสดงผล
    // เดิม Tab "All Scopes" กับ Tab "Scope 1-4" สร้างแถวคนละ logic
    // (All Scopes กรองด้วย _showChildTopics + ใส่ placeholder, ส่วน Scope Tab ไม่กรอง)
    // ทำให้ยอดทั้งสองฝั่งไม่ตรงกัน ตอนนี้ทุก Tab ดึงจาก BuildDisplayRows() ชุดเดียวกัน
    // แล้วค่อยแบ่งตาม ActivityGroupId
    // Invariant: All Scopes = Σ(Scope 1..4) + Unassigned  เสมอ
    // =====================================================================

    /// <summary>
    /// สร้างแถวที่แสดงผลทั้งหมดจาก _filteredItems ด้วยกฎเดียวกันสำหรับทุก Tab
    /// - master = Child ที่ IsActive && !IsDeleted และมี Id ต่ำสุด (ไม่นับ Child ที่ปิด/ลบแล้ว)
    /// - ถ้า _showChildTopics = false จะเหลือเฉพาะแถว master (1 แถว/Topic)
    /// - Topic ที่ไม่มี Active Child จะได้ placeholder 1 แถว (ถือเป็น Unassigned)
    /// </summary>
    private List<TopicRowDisplayItem> BuildDisplayRows()
    {
        var rows = new List<TopicRowDisplayItem>();

        foreach (var t in _filteredItems)
        {
            var activeChildren = t.Childs
                .Where(c => c.IsActive && !c.IsDeleted)
                .OrderBy(c => c.Id)
                .ToList();

            if (activeChildren.Count == 0)
            {
                rows.Add(new TopicRowDisplayItem
                {
                    Topic = t,
                    Child = new TbActivityTopicChild { Topic = t, TopicId = t.Id },
                    IsMaster = true,
                    GroupCode = string.Empty
                });
                continue;
            }

            var masterChild = activeChildren[0];
            var visibleChildren = _showChildTopics
                ? activeChildren
                : new List<TbActivityTopicChild> { masterChild };

            foreach (var c in visibleChildren)
            {
                rows.Add(new TopicRowDisplayItem
                {
                    Topic = t,
                    Child = c,
                    IsMaster = (c.Id == masterChild.Id),
                    GroupCode = GetGroupCodeForChild(c)
                });
            }
        }

        return rows;
    }

    /// <summary>ลำดับการแสดงผลมาตรฐานของแถว (ใช้ร่วมกันทุก Tab)</summary>
    private static List<TopicRowDisplayItem> SortDisplayRows(IEnumerable<TopicRowDisplayItem> rows)
    {
        return rows
            .OrderBy(r => string.IsNullOrWhiteSpace(r.GroupCode) ? 1 : 0)
            .ThenBy(r => r.GroupCode)
            .ThenBy(r => r.Topic.OrderId)
            .ThenBy(r => r.Topic.Id)
            .ToList();
    }

    /// <summary>แผนที่ ActivityGroupId -> Scope เฉพาะ Group ที่มีอยู่จริงใน _allGroups</summary>
    private Dictionary<int, eTgoScopeNo> GetGroupScopeMap()
    {
        return _allGroups
            .GroupBy(g => g.Id)
            .ToDictionary(g => g.Key, g => g.First().TgoScopeNo);
    }

    /// <summary>นับจำนวนแถวที่ตกอยู่ใน Scope ที่ระบุ (รวมทุก Group ใน Scope นั้น)</summary>
    private static int CountRowsInScope(List<TopicRowDisplayItem> rows, Dictionary<int, eTgoScopeNo> scopeMap, eTgoScopeNo scope)
    {
        return rows.Count(r => scopeMap.TryGetValue(r.Child.ActivityGroupId, out var s) && s == scope);
    }

    /// <summary>
    /// แถวที่ไม่ผูกกับ Group ที่มีอยู่จริง (Group ถูกลบ/ปิด หรือ Topic ไม่มี Active Child)
    /// แถวกลุ่มนี้จะไม่ปรากฏใน Scope Tab ใดเลย จึงต้องแสดงให้เห็นชัดใน All Scopes
    /// </summary>
    private static List<TopicRowDisplayItem> FilterUngroupedRows(List<TopicRowDisplayItem> rows, Dictionary<int, eTgoScopeNo> scopeMap)
    {
        return rows.Where(r => !scopeMap.ContainsKey(r.Child.ActivityGroupId)).ToList();
    }

    /// <summary>
    /// คืน Scope จาก Group ที่ผูกอยู่จริงเท่านั้น ถ้าไม่พบจะคืน null
    /// (ไม่ fallback เป็น Scope1 เพราะทำให้ badge ไม่ตรงกับ Tab ที่แถวนั้นอยู่จริง)
    /// </summary>
    private eTgoScopeNo? TryGetScopeForChild(TbActivityTopicChild child)
    {
        return _allGroups.FirstOrDefault(g => g.Id == child.ActivityGroupId)?.TgoScopeNo;
    }

    /// <summary>แถวของ Tab "All Scopes" — ชุดเดียวกับที่ Scope Tab ทุกอันใช้</summary>
    private List<TopicRowDisplayItem> GetAllTopicRows()
    {
        return SortDisplayRows(BuildDisplayRows());
    }

    /// <summary>แถวของ Group หนึ่ง ๆ ใน Scope Tab — กรองจากชุดเดียวกันด้วย ActivityGroupId</summary>
    private List<TopicRowDisplayItem> GetGroupTopicRows(int groupId)
    {
        return SortDisplayRows(BuildDisplayRows().Where(r => r.Child.ActivityGroupId == groupId));
    }

    private RenderFragment RenderAccordionForScope(eTgoScopeNo scope) => @<text>
        @{
            var groupsInScope = _allGroups.Where(g => g.TgoScopeNo == scope).OrderBy(g => g.Code).ToList();
            var activeAccIdx = GetAccordionIndexForScope(scope);
        }
        @if (!groupsInScope.Any())
        {
            <div class="p-4 text-center text-muted bg-white rounded-3 border">
                No activity groups configured under this scope.
            </div>
        }
        else
        {
            <RadzenAccordion Multiple="false">
                <Items>
                    @foreach (var group in groupsInScope)
                    {
                        var currentGroup = group;
                        var groupId = currentGroup.Id;
                        var currentGroupIdx = groupsInScope.IndexOf(currentGroup);
                        var isSelected = (currentGroupIdx == activeAccIdx);
                        var groupRows = GetGroupTopicRows(groupId);
                        var hasTopics = groupRows.Any();
                        var totalKg = groupRows.Sum(r =>
                        {
                            if (r.Child.Source == null) return 0m;
                            var qty = r.Topic.Events.Where(e => !e.IsDeleted && (!_selectedYear.HasValue || e.TimeStamp.Year == _selectedYear.Value)).Sum(e => e.Quantity);
                            return EmissionCalculator.CalculateKgCO2e(qty, r.Child);
