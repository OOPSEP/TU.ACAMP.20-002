    private string GetParentTypeDisplayName()
    {
        return ParentLevel switch
        {
            eTopicLevel.Corporate => "Corporate",
            eTopicLevel.Company => "Company",
            _ => "Facility"
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SyncBrowserUrlAsync();
        }
    }

    private async Task SyncBrowserUrlAsync()
    {
        try
        {
            var parentId = ParentLevel switch
            {
                eTopicLevel.Corporate => _selectedCorporateId ?? 0,
                eTopicLevel.Company => _selectedCompanyId ?? 0,
                _ => _selectedFacilityId ?? 0
            };

            var curAcc = GetAccordionIndexForTab(_activeTabIndex);
            var queryParams = new Dictionary<string, object?>
            {
                ["ptype"] = ParentLevel.ToString(),
                ["pid"] = parentId > 0 ? DataProtection.Protect(parentId) : null,
                ["sid"] = _selectedSubscriptionId.HasValue ? DataProtection.Protect(_selectedSubscriptionId.Value) : null,
                ["tab"] = _activeTabIndex.ToString(),
                ["sac"] = curAcc >= 0 ? curAcc.ToString() : null,
                ["yr"] = _selectedYear.HasValue ? _selectedYear.Value.ToString() : null,
                ["q"] = !string.IsNullOrWhiteSpace(_searchText) ? _searchText : null
            };

            var uri = NavigationManager.GetUriWithQueryParameters("/library/activity-topics", queryParams);
            await JSRuntime.InvokeVoidAsync("history.replaceState", null, "", uri);
        }
        catch
        {
            // Ignore during prerender or if JS interop is not yet connected
        }
    }

    private void OnTabChanged(int index)
    {
        _activeTabIndex = Math.Clamp(index, 0, 4);
        _ = SyncBrowserUrlAsync();
    }

    private void OnAccordionItemSelectChanged(eTgoScopeNo scope, int groupIndex, bool isSelected)
    {
        var tab = ScopeToTabIndex(scope);
        SetAccordionIndexForTab(tab, isSelected ? groupIndex : -1);
        _ = SyncBrowserUrlAsync();
    }

    private async Task OnSubscriptionChanged(object? value)
    {
        #region hide [2026-08-18]
        if (value is int sid)
        {
            _selectedSubscriptionId = sid;
        }
        else
        {
            _selectedSubscriptionId = null;
        }
        await ResolveParentContextNameAsync();
        await LoadDataAsync();
        await SyncBrowserUrlAsync();
        #endregion
    }

    private string SyncTopicStateAndGetReturnUrl(TbActivityTopic? item = null)
    {
        #region hide [2026-08-28]
        if (item != null && _activeTabIndex != 4)
        {
            // [2026-09-13][Claude] ใช้กฎ master เดียวกับ BuildDisplayRows() (นับเฉพาะ Child ที่ Active)
            // ของเดิมหยิบ Child ที่ถูกปิด/ลบมาเป็น master ทำให้เด้งไป Tab ผิด Scope
            var masterChild = item.Childs.Where(c => c.IsActive && !c.IsDeleted).OrderBy(c => c.Id).FirstOrDefault();
            if (masterChild != null)
            {
                var scope = GetScopeForChild(item, masterChild);
                _activeTabIndex = ScopeToTabIndex(scope);

                var groupsInScope = _allGroups.Where(g => g.TgoScopeNo == scope).OrderBy(g => g.Code).ToList();
                var groupIdx = groupsInScope.FindIndex(g => g.Id == masterChild.ActivityGroupId);
                if (groupIdx >= 0)
                {
                    SetAccordionIndexForTab(_activeTabIndex, groupIdx);
                }
            }
        }

        var parentId = ParentLevel switch
        {
            eTopicLevel.Corporate => _selectedCorporateId ?? 0,
            eTopicLevel.Company => _selectedCompanyId ?? 0,
            _ => _selectedFacilityId ?? 0
        };

        var curAcc = GetAccordionIndexForTab(_activeTabIndex);
        var queryParams = new Dictionary<string, object?>
        {
            ["ptype"] = ParentLevel.ToString(),
            ["pid"] = parentId > 0 ? DataProtection.Protect(parentId) : null,
            ["sid"] = _selectedSubscriptionId.HasValue ? DataProtection.Protect(_selectedSubscriptionId.Value) : null,
            ["tab"] = _activeTabIndex.ToString(),
            ["sac"] = curAcc >= 0 ? curAcc.ToString() : null,
            ["yr"] = _selectedYear.HasValue ? _selectedYear.Value.ToString() : null,
            ["q"] = !string.IsNullOrWhiteSpace(_searchText) ? _searchText : null
        };

        var uri = NavigationManager.GetUriWithQueryParameters("/library/activity-topics", queryParams);
        return "/" + NavigationManager.ToBaseRelativePath(NavigationManager.ToAbsoluteUri(uri).AbsoluteUri);
        #endregion
    }

