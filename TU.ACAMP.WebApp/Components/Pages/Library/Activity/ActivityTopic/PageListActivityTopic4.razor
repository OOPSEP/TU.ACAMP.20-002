    /// <summary>
    /// คืนค่า Group Code ของแถวที่แสดงผล (ใช้เป็นขอบเขตการจัดลำดับ)
    /// </summary>
    private string GetRowGroupCode(TopicRowDisplayItem row)
    {
        return string.IsNullOrWhiteSpace(row.GroupCode)
            ? GetGroupCodeForChild(row.Child)
            : row.GroupCode;
    }

    /// <summary>
    /// คืนรายการ Topic ที่อยู่ใน Group Code เดียวกัน เรียงตามลำดับที่แสดงผลจริง
    /// (ใช้เป็นขอบเขตของการ Move Up/Down เพื่อไม่ให้สลับข้าม Group Code)
    /// </summary>
    private List<TbActivityTopic> GetTopicPeersInGroup(string groupCode)
    {
        #region hide [2026-09-11]
        var peers = _filteredItems.Where(t =>
        {
            var codes = t.Childs
                .Where(c => c.IsActive && !c.IsDeleted)
                .Select(c => GetGroupCodeForChild(c))
                .ToList();

            if (string.IsNullOrWhiteSpace(groupCode))
            {
                // กลุ่ม "ไม่ระบุ Group" = Topic ที่ไม่มี Child ที่ผูก Group ใดเลย
                return !codes.Any(c => !string.IsNullOrWhiteSpace(c));
            }

            return codes.Any(c => string.Equals(c, groupCode, StringComparison.OrdinalIgnoreCase));
        });

        return peers
            .OrderBy(t => t.OrderId)
            .ThenBy(t => t.Id)
            .ToList();
        #endregion
    }

    private async Task MoveTopicUpAsync(TopicRowDisplayItem row)
    {
        #region hide [2026-09-11]
        try
        {
            var groupCode = GetRowGroupCode(row);
            var peers = GetTopicPeersInGroup(groupCode);
            var idx = peers.FindIndex(t => t.Id == row.Topic.Id);
            if (idx < 0) return;
            if (idx == 0)
            {
                NotificationService.Notify(NotificationSeverity.Info, "Information", "Topic is already at the top of this group.");
                return;
            }

            var prevItem = peers[idx - 1];
            await ActivityTopicService.SwapTopicOrderAsync(row.Topic.Id, prevItem.Id, _currentUserEmail);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to move topic up: ID {Id}", row.Topic.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Reorder Error", "Failed to move item up.");
        }
        #endregion
    }

    private async Task MoveTopicDownAsync(TopicRowDisplayItem row)
    {
        #region hide [2026-09-11]
        try
        {
            var groupCode = GetRowGroupCode(row);
            var peers = GetTopicPeersInGroup(groupCode);
            var idx = peers.FindIndex(t => t.Id == row.Topic.Id);
            if (idx < 0) return;
            if (idx >= peers.Count - 1)
            {
                NotificationService.Notify(NotificationSeverity.Info, "Information", "Topic is already at the bottom of this group.");
                return;
            }

            var nextItem = peers[idx + 1];
            await ActivityTopicService.SwapTopicOrderAsync(row.Topic.Id, nextItem.Id, _currentUserEmail);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to move topic down: ID {Id}", row.Topic.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Reorder Error", "Failed to move item down.");
        }
        #endregion
    }

    /// <summary>
    /// ผูก HTML5 Drag Events ให้กับแถวของตาราง (ลากได้เฉพาะแถวหลัก)
    /// </summary>
    private void OnTopicRowRender(RowRenderEventArgs<TopicRowDisplayItem> args)
    {
        #region hide [2026-09-11]
        var row = args.Data;
        if (row == null || row.Topic == null) return;

        // OrderId ผูกที่ระดับ Topic จึงอนุญาตให้ลากเฉพาะแถวหลักเท่านั้น
        if (!row.IsMaster)
        {
            args.Attributes.Add("title", "Child rows always follow their parent topic.");
            return;
        }

        args.Attributes.Add("draggable", "true");
        args.Attributes.Add("style", "cursor: grab;");
        args.Attributes.Add("title", "Drag to reorder within this group code.");

        args.Attributes.Add("ondragstart", EventCallback.Factory.Create<DragEventArgs>(this, () => _draggedRow = row));

        args.Attributes.Add("ondragover",
            "event.preventDefault();var r=event.target.closest('.rz-data-row');if(r){document.querySelectorAll('.topic-drop-target').forEach(function(e){e.classList.remove('topic-drop-target');});r.classList.add('topic-drop-target');}");

        args.Attributes.Add("ondragleave",
            "var r=event.target.closest('.rz-data-row');if(r){r.classList.remove('topic-drop-target');}");

        args.Attributes.Add("ondragend",
            "document.querySelectorAll('.topic-drop-target').forEach(function(e){e.classList.remove('topic-drop-target');});");

        args.Attributes.Add("ondrop", EventCallback.Factory.Create<DragEventArgs>(this, async () => await OnTopicRowDropAsync(row)));
        #endregion
    }

    /// <summary>
    /// จัดลำดับใหม่เมื่อวางแถว โดยอนุญาตเฉพาะการวางภายใน Group Code เดียวกัน
    /// </summary>
    private async Task OnTopicRowDropAsync(TopicRowDisplayItem targetRow)
    {
        #region hide [2026-09-11]
        var sourceRow = _draggedRow;
        _draggedRow = null;

        try
        {
            await ClearDropHighlightAsync();

            if (sourceRow == null || targetRow == null) return;
            if (sourceRow.Topic.Id == targetRow.Topic.Id) return;

            var sourceGroup = GetRowGroupCode(sourceRow);
            var targetGroup = GetRowGroupCode(targetRow);
            if (!string.Equals(sourceGroup, targetGroup, StringComparison.OrdinalIgnoreCase))
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Reorder Blocked",
                    "Topics can be reordered only within the same group code.");
                return;
            }

            var peers = GetTopicPeersInGroup(sourceGroup);
            var fromIdx = peers.FindIndex(t => t.Id == sourceRow.Topic.Id);
            var toIdx = peers.FindIndex(t => t.Id == targetRow.Topic.Id);
            if (fromIdx < 0 || toIdx < 0 || fromIdx == toIdx) return;

            var moving = peers[fromIdx];
            peers.RemoveAt(fromIdx);

            var insertAt = peers.FindIndex(t => t.Id == targetRow.Topic.Id);
            if (insertAt < 0) return;
            if (fromIdx < toIdx) insertAt += 1; // ลากลง = วางต่อท้ายแถวเป้าหมาย
            peers.Insert(insertAt, moving);

            await ActivityTopicService.ReorderTopicsInGroupAsync(peers.Select(t => t.Id).ToList(), _currentUserEmail);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reorder topics by drag and drop");
            NotificationService.Notify(NotificationSeverity.Error, "Reorder Error", "Failed to reorder items.");
        }
        #endregion
    }

    private async Task ClearDropHighlightAsync()
    {
        #region hide [2026-09-11]
        try
        {
            await JSRuntime.InvokeVoidAsync("eval",
                "document.querySelectorAll('.topic-drop-target').forEach(function(e){e.classList.remove('topic-drop-target');});");
        }
        catch
        {
            // ไม่ถือเป็นข้อผิดพลาดร้ายแรง หากล้าง Highlight ไม่สำเร็จ
        }
        #endregion
    }
    #endregion
