@page "/library/emission-sources"
@page "/emissions/sources"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.DataProtection
@using System.Security.Claims
@using TU.ACAMP.Domain.Enums
@using TU.ACAMP.Domain.Identity
@using TU.ACAMP.Domain.Models.Library
@using TU.ACAMP.WebApp.Constants
@using TU.ACAMP.WebApp.Services.Common
@using TU.ACAMP.WebApp.Services.Emissions
@using TU.ACAMP.WebApp.Components.Pages.Library.Emission.EmissionSource.Dialogs
@using TU.ACAMP.WebApp.Services.Identity

@attribute [Authorize]

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject AuthenticationStateProvider AuthStateProvider
@inject EmissionSourceService EmissionSourceService
@inject EmissionSourceExcelService ExcelService
@inject EmissionGroupService EmissionGroupService
@inject SubscriptionService SubscriptionService
@inject NavigationManager NavigationManager
@inject IDataProtectionProvider DataProtection
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject ILogger<PageListEmissionSource> Logger

<PageTitle>Emission Sources Library - ACAMP</PageTitle>

<div class="container-fluid py-3 px-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <RadzenText Text="Emission Sources Library" TextStyle="TextStyle.H5" TagName="TagName.H1" class="fw-bold mb-1" Style="color: var(--rz-text-title-color);" />
            <RadzenText Text="Manage emission factors, GWP calculations, references, and classifications aligned with TGO templates." TextStyle="TextStyle.Body2" class="text-muted mb-0" />
        </div>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Class="flex-wrap">
            <RadzenButton Text="Export Excel" Icon="download" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                          Click="@ExportToExcelAsync" Style="border-radius: 8px; font-weight: 600;"
                          Disabled="@(!CanExport)" Title="@(CanExport ? "Export emission sources to Excel" : "Export is restricted to users with edit permissions.")" />
            <RadzenButton Text="Import Excel" Icon="file_upload" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined"
                          Click="@OpenImportDialogAsync" Style="border-radius: 8px; font-weight: 600;" Disabled="@_isAddDisabled" />
            <RadzenButton Text="Add Emission Source" Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                          Click="@NavigateToCreate" Style="border-radius: 8px; font-weight: 600;" Disabled="@_isAddDisabled" />
        </RadzenStack>
    </div>

    <!-- [2026-09-13][Antigravity] Filters & Search Toolbar with .acamp-filter-bar and spring search -->
    <RadzenCard Class="mb-4 p-3 shadow-sm" Style="border-radius: 12px; border: 1px solid var(--rz-border-color); background: var(--rz-card-background-color);">
        <div class="acamp-filter-bar justify-content-between">
            <div class="acamp-filter-search">
                <RadzenFormField Text="Search Emission Sources">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="SearchText" Placeholder="Search by title, group, code, or remark..." Style="width: 100%;" />
                    </ChildContent>
                    <Start>
                        <RadzenIcon Icon="search" />
                    </Start>
                </RadzenFormField>
            </div>
            <div class="d-flex align-items-end gap-2 flex-wrap ms-auto flex-shrink-0">
                <RadzenFormField Text="Subscription Workspace" Style="width: 220px;">
                    <RadzenDropDown TValue="int?"
                                    Value="@_selectedSubscriptionId"
                                    Data="@_subscriptionsList"
                                    TextProperty="Title"
                                    ValueProperty="Id"
                                    Placeholder="All Subscriptions"
                                    AllowClear="true"
                                    Change="@(args => OnSubscriptionChanged(args))"
                                    Style="width: 100%;" />
                </RadzenFormField>
                <div class="d-flex align-items-center text-muted small" style="height: 40px;">
                    Showing <b>@_filteredItems.Count</b> records
                </div>
            </div>
        </div>
    </RadzenCard>

    <!-- Data Container -->
    @if (_isLoading)
    {
        <div class="py-5 text-center">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <RadzenText Text="Loading emission sources..." TextStyle="TextStyle.Body2" class="text-muted mt-2" />
        </div>
    }
    else
    {
        <div class="shadow-sm rounded-3 p-3" style="background-color: var(--rz-card-background-color); border: 1px solid var(--rz-border-color); border-radius: 12px;">
            <RadzenTabs RenderMode="TabRenderMode.Client" Class="shadow-sm rounded-3"
                        SelectedIndex="@ActiveTabIndex" Change="@OnTabChanged">
                <Tabs>
                    <RadzenTabsItem Text="Scope 1 (Direct GHG)">
                        <div class="pt-3">
                            @RenderAccordionForScope(eTgoScopeNo.Scope1)
                        </div>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Scope 2 (Indirect Energy)">
                        <div class="pt-3">
                            @RenderAccordionForScope(eTgoScopeNo.Scope2)
                        </div>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Scope 3 (Other Indirect)">
                        <div class="pt-3">
                            @RenderAccordionForScope(eTgoScopeNo.Scope3)
                        </div>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Separate Report (Biogenic CO₂)">
                        <div class="pt-3">
                            @RenderAccordionForScope(eTgoScopeNo.SeparateReport)
                        </div>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </div>
    }
</div>

@code {
    #region class field
    private int _pageSize = 15;
    private readonly IEnumerable<int> _pageSizeOptions = new int[] { 15, 25, 50, 100 };
    private Dictionary<int, RadzenDataGrid<TbEmissionSource>> _grids = new();

    private bool _isLoading = true;
    private bool _isAdmin = false;
    private bool _isAddDisabled = true;
    private string _searchText = string.Empty;
    private int _activeTabIndex = 0;
    private int _activeGridPageIndex = 0;
    private int _activeAccordionIndex = 0;
    private HashSet<int> _expandedGroupIds = new();

    private List<TbEmissionSource> _allItems = new();
    private List<TbEmissionSource> _filteredItems = new();
    private List<TbEmissionGroup> _allGroups = new();
    private string _currentUserEmail = string.Empty;
    private HashSet<int> _editableSubscriptionIds = new();
    private List<TbSubscription> _subscriptionsList = new();
    private int? _selectedSubscriptionId;

    private IEnumerable<int> _chkValues = new List<int> { 1 };

    // System placeholder record ("Unknown" - used for data migration only). Must never be shown/selectable by users.
    private const int SystemUnknownSourceId = -1;
    #endregion

    #region class properties
    private string SearchText
    {
        get => _searchText;
        set
        {
            if (_searchText != value)
            {
                _searchText = value;
                OnFilterChanged();
                _ = SyncBrowserUrlAsync();
            }
        }
    }

    private int ActiveTabIndex
    {
        get => _activeTabIndex;
        set
        {
            if (_activeTabIndex != value)
            {
                _activeTabIndex = value;
                _activeGridPageIndex = 0;
                _ = SyncBrowserUrlAsync();
            }
        }
    }

    [SupplyParameterFromQuery(Name = "sid")]
    public string SecureSid { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "tab")]
    public string SecureTab { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "gpage")]
    public string SecureGpage { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "sac")]
    public string SecureSac { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "q")]
    public string SecureSearchText { get; set; } = string.Empty;
    #endregion

    #region class methods
    protected override async Task OnInitializedAsync()
    {
        #region hide [2026-08-17]
        _isLoading = true;
        try
        {
            await InitializeUserSessionAsync();
            RestoreStateParameters();

            if (!_selectedSubscriptionId.HasValue && !_isAdmin && _subscriptionsList.Count == 1)
            {
                _selectedSubscriptionId = _subscriptionsList[0].Id;
            }

            UpdateCreatePermission();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Critical error initializing PageListEmissionSource.");
            NotificationService.Notify(NotificationSeverity.Error, "Initialization Error", "Failed to load emission sources library.");
        }
        finally
        {
            _isLoading = false;
        }
        #endregion
    }

    private async Task InitializeUserSessionAsync()
    {
        #region hide [2026-08-17]
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            _currentUserEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? (user.Identity.Name ?? string.Empty);
            _isAdmin = user.IsInRole(SystemRoles.Administrator);
        }

        _editableSubscriptionIds = await SubscriptionService.GetEditableSubscriptionIdsAsync(_currentUserEmail, _isAdmin);
        _subscriptionsList = await SubscriptionService.GetSubscriptionsForUserAsync(_currentUserEmail, _isAdmin, includeInactive: false);
        #endregion
    }

    private void RestoreStateParameters()
    {
        #region hide [2026-08-17]
        var decryptedSid = DataProtection.UnprotectInt(SecureSid);
        if (decryptedSid.HasValue)
        {
            _selectedSubscriptionId = decryptedSid.Value;
        }

        var decryptedTab = DataProtection.UnprotectInt(SecureTab);
        if (decryptedTab.HasValue && decryptedTab.Value >= 0 && decryptedTab.Value <= 3)
        {
            _activeTabIndex = decryptedTab.Value;
        }

        var decryptedGpage = DataProtection.UnprotectInt(SecureGpage);
        if (decryptedGpage.HasValue && decryptedGpage.Value >= 0)
        {
            _activeGridPageIndex = decryptedGpage.Value;
        }

        var decryptedSac = DataProtection.UnprotectInt(SecureSac);
        if (decryptedSac.HasValue && decryptedSac.Value >= 0)
        {
            _activeAccordionIndex = decryptedSac.Value;
        }

        var decryptedQ = DataProtection.Unprotect(SecureSearchText);
        if (!string.IsNullOrEmpty(decryptedQ))
        {
            _searchText = decryptedQ;
        }
        #endregion
    }

    private void UpdateCreatePermission()
    {
        #region hide [2026-08-17]
        _isAddDisabled = !(_selectedSubscriptionId.HasValue &&
            (_isAdmin || _editableSubscriptionIds.Contains(_selectedSubscriptionId.Value)));
        #endregion
    }

    private bool CanExport => _isAdmin || (_selectedSubscriptionId.HasValue ? _editableSubscriptionIds.Contains(_selectedSubscriptionId.Value) : _editableSubscriptionIds.Count > 0);

    private async Task ExportToExcelAsync()
    {
        #region hide [2026-09-06]
        // [2026-09-19][Antigravity] Enforce edit permission check for exporting emission sources
        if (!CanExport)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Access Denied", "Only users with edit permissions can export data.");
            return;
        }

        try
        {
            var contextName = _selectedSubscriptionId.HasValue
                ? (_subscriptionsList.FirstOrDefault(x => x.Id == _selectedSubscriptionId.Value)?.Title ?? string.Empty)
                : "All Subscriptions";

            var bytes = await ExcelService.ExportSourcesToExcelAsync(_filteredItems, contextName);
            var base64 = Convert.ToBase64String(bytes);
            // [2026-09-21][Gemini] Standard Export Filename: emission_sources_{context}_{date}_{time}.xlsx
            var fileName = ExportFileNameHelper.Generate("emission_sources", contextName);
            await JSRuntime.InvokeVoidAsync("saveAsFile", fileName, base64);
            NotificationService.Notify(NotificationSeverity.Success, "Export Successful", $"Exported {_filteredItems.Count} emission sources to Excel.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export emission sources to Excel.");
            NotificationService.Notify(NotificationSeverity.Error, "Export Failed", "Failed to generate Excel file.");
        }
        #endregion
    }

    private async Task OpenImportDialogAsync()
    {
        #region hide [2026-09-06]
        if (_isAddDisabled || !_selectedSubscriptionId.HasValue)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Subscription Required", "Please select a subscription workspace before importing.");
            return;
        }

        var parameters = new Dictionary<string, object>
        {
            { "SubscriptionId", _selectedSubscriptionId.Value }
        };

        var options = new DialogOptions
        {
            Width = "1100px",
            Height = "auto",
            Resizable = true,
            Draggable = true
        };

        var result = await DialogService.OpenAsync<ImportEmissionSourceDialog>("Import Emission Sources", parameters, options);
        if (result == true)
        {
            await LoadDataAsync();
            StateHasChanged();
        }
        #endregion
    }

    private async Task LoadDataAsync()
    {
        #region hide [2026-08-17]
        _isLoading = true;
        try
        {
            // [2026-09-23][Claude] Admin + "All Subscriptions" -> แสดง Default + Custom ของทุก Subscription (ทั้ง Source และ Group ที่ใช้จัดกลุ่ม) — แบบเดียวกับ PageListEmissionUnit/Group
            bool showAllSubscriptions = _isAdmin && !_selectedSubscriptionId.HasValue;
            _allItems = (showAllSubscriptions
                    ? await EmissionSourceService.GetAllAsync()
                    : await EmissionSourceService.GetBySubscriptionIdAsync(_selectedSubscriptionId, includeDefault: true))
                .Where(x => x.Id != SystemUnknownSourceId)
                .ToList();
            _allGroups = showAllSubscriptions
                ? await EmissionGroupService.GetAllAsync()
                : await EmissionGroupService.GetBySubscriptionIdAsync(_selectedSubscriptionId, includeDefault: true);

            OnFilterChanged();

            if (_expandedGroupIds.Count == 0 && _allGroups.Any())
            {
                var activeScope = (eTgoScopeNo)(_activeTabIndex + 1);
                var groupsInScope = _allGroups
                    .Where(g => g.TgoScopeNo == activeScope)
                    .OrderBy(g => g.Code)
                    .ToList();

                if (_activeAccordionIndex >= 0 && _activeAccordionIndex < groupsInScope.Count)
                {
                    _expandedGroupIds.Add(groupsInScope[_activeAccordionIndex].Id);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load emission source data.");
            NotificationService.Notify(NotificationSeverity.Error, "Data Error", "Failed to load emission sources library.");
        }
        finally
        {
            _isLoading = false;
        }
        #endregion
    }

    private void OnFilterChanged()
    {
        #region hide [2026-08-17]
        var query = _allItems.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var q = _searchText.Trim();
            query = query.Where(x =>
                (!string.IsNullOrEmpty(x.Title) && x.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (x.Group != null && !string.IsNullOrEmpty(x.Group.Code) && x.Group.Code.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (x.Group != null && !string.IsNullOrEmpty(x.Group.Title) && x.Group.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Remark) && x.Remark.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Ref) && x.Ref.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }

        _filteredItems = query.ToList();

        foreach (var grid in _grids.Values)
        {
            grid?.Reload();
        }
        #endregion
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SyncBrowserUrlAsync();
        }
    }

    private async Task OnTabChanged(int index)
    {
        #region hide [2026-08-17]
        ActiveTabIndex = index;
        await SyncBrowserUrlAsync();
        #endregion
    }

    private async Task OnGridPageChanged(int groupId, PagerEventArgs args)
    {
        #region hide [2026-08-17]
        _activeGridPageIndex = args.PageIndex;
        await SyncBrowserUrlAsync();
        #endregion
    }

    private async Task OnSubscriptionChanged(object value)
    {
        #region hide [2026-08-17]
        _selectedSubscriptionId = value as int?;
        _activeGridPageIndex = 0;
        UpdateCreatePermission();
        await LoadDataAsync();
        await SyncBrowserUrlAsync();
        #endregion
    }

    private async Task OnAccordionItemSelectChanged(int groupId, bool isSelected)
    {
        #region hide [2026-08-17]
        if (isSelected)
        {
            _expandedGroupIds.Add(groupId);
        }
        else
        {
            _expandedGroupIds.Remove(groupId);
        }

        var scopeNo = (eTgoScopeNo)(_activeTabIndex + 1);
        var groupsInScope = _allGroups.Where(g => g.TgoScopeNo == scopeNo).OrderBy(g => g.Code).ToList();
        var idx = groupsInScope.FindIndex(g => g.Id == groupId);
        if (idx >= 0)
        {
            _activeAccordionIndex = isSelected ? idx : -1;
        }

        await SyncBrowserUrlAsync();
        #endregion
    }

    private async Task SyncBrowserUrlAsync()
    {
        #region hide [2026-08-17]
        try
        {
            var queryParams = new Dictionary<string, object?>();

            if (_selectedSubscriptionId.HasValue)
                queryParams["sid"] = DataProtection.Protect(_selectedSubscriptionId.Value);

            if (_activeTabIndex > 0)
                queryParams["tab"] = DataProtection.Protect(_activeTabIndex);

            if (_activeGridPageIndex > 0)
                queryParams["gpage"] = DataProtection.Protect(_activeGridPageIndex);

            if (_activeAccordionIndex >= 0)
                queryParams["sac"] = DataProtection.Protect(_activeAccordionIndex);

            if (!string.IsNullOrWhiteSpace(_searchText))
                queryParams["q"] = DataProtection.Protect(_searchText);

            var url = NavigationManager.GetUriWithQueryParameters("/library/emission-sources", queryParams);
            await JSRuntime.InvokeVoidAsync("history.replaceState", null, "", url);
        }
        catch
        {
            // Ignore during prerender or if JS interop not ready
        }
        #endregion
    }

    private void NavigateToCreate()
    {
        #region hide [2026-08-17]
        var queryParams = new Dictionary<string, object?>();
        if (_selectedSubscriptionId.HasValue)
            queryParams["sid"] = DataProtection.Protect(_selectedSubscriptionId.Value);

        if (_activeTabIndex > 0)
            queryParams["tab"] = DataProtection.Protect(_activeTabIndex);

        if (_activeAccordionIndex >= 0)
            queryParams["sac"] = DataProtection.Protect(_activeAccordionIndex);

        var url = NavigationManager.GetUriWithQueryParameters("/library/emission-sources/add", queryParams);
        NavigationManager.NavigateTo(url);
        #endregion
    }

    private async Task OnDuplicate(TbEmissionSource item)
    {
        #region hide [2026-08-17]
        try
        {
            if (item == null) return;

            if (!_selectedSubscriptionId.HasValue)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Duplication Restricted", "Please select a subscription first.");
                return;
            }

            var dup = TbEmissionSource.Duplicate(item, _selectedSubscriptionId.Value);
            await EmissionSourceService.CreateAsync(dup);
            NotificationService.Notify(NotificationSeverity.Success, "Duplication Successful", $"Emission source cloned as '{dup.Title}'.");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error duplicating emission source ID: {Id}", item.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Duplicate Error", ex.Message);
        }
        #endregion
    }

    private async Task ConfirmDelete(TbEmissionSource item)
    {
        #region hide [2026-08-17]
        try
        {
            // [2026-09-24] Delete Protection: ตรวจสอบว่า Source ถูกอ้างอิงโดย Topic หรือ Emission Mapping อยู่หรือไม่ (แสดงชื่อแรก + and others)
            var blockMessage = await EmissionSourceService.GetDeleteBlockMessageAsync(item.Id);
            if (blockMessage != null)
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Cannot Delete Source",
                    blockMessage,
                    duration: 8000);
                return;
            }

            var confirmed = await DialogService.Confirm(
                "Are you sure you want to delete this emission source?",
                "Delete Emission Source",
                new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

            if (confirmed == true)
            {
                var success = await EmissionSourceService.DeleteAsync(item.Id);
                if (success)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Deleted", $"Emission source '{item.Title}' deleted successfully.");
                    await LoadDataAsync();
                }
                else
                {
                    NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Emission source could not be deleted.");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting emission source ID: {Id}", item.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Delete Failed", ex.Message);
        }
        #endregion
    }

    private void OnRowDoubleClick(TbEmissionSource item)
    {
        #region hide [2026-08-17]
        if (item == null) return;
        bool isSystem = item.SourceType == eSourceType.Default;
        bool canEditItem = _isAdmin || (!isSystem && item.SubscriptionId.HasValue && _editableSubscriptionIds.Contains(item.SubscriptionId.Value));
        var secureId = DataProtection.Protect(item.Id);
        var queryParams = new Dictionary<string, object?>();

        if (_selectedSubscriptionId.HasValue)
            queryParams["sid"] = DataProtection.Protect(_selectedSubscriptionId.Value);

        if (_activeTabIndex > 0)
            queryParams["tab"] = DataProtection.Protect(_activeTabIndex);

        if (_activeGridPageIndex > 0)
            queryParams["gpage"] = DataProtection.Protect(_activeGridPageIndex);

        if (_activeAccordionIndex >= 0)
            queryParams["sac"] = DataProtection.Protect(_activeAccordionIndex);

        if (!string.IsNullOrWhiteSpace(_searchText))
            queryParams["q"] = DataProtection.Protect(_searchText);

        var actionPath = canEditItem ? "edit" : "view";
        var url = NavigationManager.GetUriWithQueryParameters($"/library/emission-sources/{actionPath}/{Uri.EscapeDataString(secureId)}", queryParams);
        NavigationManager.NavigateTo(url);
        #endregion
    }

    private async Task OnSplitButtonClick(RadzenSplitButtonItem args, TbEmissionSource item)
    {
        #region hide [2026-08-17]
        if (args == null || args.Value == null)
        {
            OnRowDoubleClick(item);
            return;
        }

        switch (args.Value.ToString())
        {
            case "1":
                await OnDuplicate(item);
                break;
            case "2":
                await ConfirmDelete(item);
                break;
        }
        #endregion
    }

    private RenderFragment RenderAccordionForScope(eTgoScopeNo scopeNo)
    {
        #region hide [2026-08-17]
        var scopeSources = _filteredItems
            .Where(x => x.Group != null && x.Group.TgoScopeNo == scopeNo)
            .OrderBy(g => g.Id)
            .ToList();

        var groupsInScope = _allGroups
            .Where(g => g.TgoScopeNo == scopeNo)
            .OrderBy(g => g.Code)
            .ToList();

        if (!groupsInScope.Any())
        {
            return @<div class="p-4 text-center text-muted">
                <RadzenIcon Icon="inbox" Style="font-size: 36px; opacity: 0.5;" class="mb-2" />
                <div>No emission groups documented for this specific reporting scope.</div>
            </div>;
        }

        return __builder =>
        {
            <div class="mb-3">
                <div class="d-flex justify-content-end mb-2">
                    <RadzenCheckBoxList @bind-Value=@_chkValues TValue="int" Change="@((args) => StateHasChanged())">
                        <Items>
                            <RadzenCheckBoxListItem Text="GHG Breakdown" Value="1" />
                            <RadzenCheckBoxListItem Text="GWP 100" Value="2" />
                            <RadzenCheckBoxListItem Text="Data Source" Value="3" />
                        </Items>
                    </RadzenCheckBoxList>
                </div>

                <RadzenAccordion Multiple="true" Class="w-100 border-0 bg-transparent">
                    <Items>
                        @{
                            int groupIndex = 1;
                            foreach (var group in groupsInScope)
                            {
                                var currentGroup = group;
                                var specificSources = scopeSources.Where(x => x.GroupId == currentGroup.Id).ToList();
                                var recordCount = specificSources.Count;
                                var displayIndex = groupIndex++;
                                bool isCustom = currentGroup.SourceType == eSourceType.Custom || (!currentGroup.IsReadOnly && currentGroup.SubscriptionId.HasValue);
                                string folderColor = isCustom ? "var(--rz-success, #10b981)" : "var(--rz-warning, #f59e0b)";

                                <RadzenAccordionItem Icon="folder" IconColor="@folderColor" Class="mb-2 shadow-sm border rounded-2"
                                                     Style="background-color: var(--rz-card-background-color); border-color: var(--rz-border-color);"
                                                     Selected="@_expandedGroupIds.Contains(currentGroup.Id)"
                                                     SelectedChanged="@(val => OnAccordionItemSelectChanged(currentGroup.Id, val))">
                                    <Template>
                                        <span class="d-flex align-items-center">
                                            <span hidden class="badge bg-light text-dark border me-2 fw-bold">@currentGroup.Code</span>
                                            @displayIndex. @currentGroup.Title
                                            @* [2026-09-23][Claude] มุมมองรวมทุก Subscription: บอกว่ากลุ่ม Custom นี้เป็นของ Subscription ไหน *@
                                            @if (!_selectedSubscriptionId.HasValue && isCustom && currentGroup.SubscriptionId.HasValue)
                                            {
                                                <span class="text-muted ms-1 small">(@(_subscriptionsList.FirstOrDefault(x => x.Id == currentGroup.SubscriptionId.Value)?.Title ?? $"Sub #{currentGroup.SubscriptionId.Value}"))</span>
                                            }
                                            @if (recordCount > 0)
                                            {
                                                <span class="text-muted ms-2 small">(<strong>@recordCount</strong> @(recordCount > 1 ? "records" : "record"))</span>
                                            }
                                        </span>
                                    </Template>
                                    <ChildContent>
                                        <div class="p-2">
                                            @if (_expandedGroupIds.Contains(currentGroup.Id) && recordCount > 0)
                                            {
                                                @RenderGridForGroupData(specificSources, currentGroup.Id)
                                            }
                                            else if (recordCount == 0)
                                            {
                                                <div class="p-3 text-center text-muted small">No emission factors inside this group.</div>
                                            }
                                        </div>
                                    </ChildContent>
                                </RadzenAccordionItem>
                            }
                        }
                    </Items>
                </RadzenAccordion>
            </div>
        };
        #endregion
    }

    private RenderFragment RenderGridForGroupData(List<TbEmissionSource> data, int groupId)
    {
        #region hide [2026-08-17]
        return __builder =>
        {
            <RadzenDataGrid @ref="_grids[groupId]"
                            Page="@(args => OnGridPageChanged(groupId, args))"
                            RowDoubleClick="@(args => OnRowDoubleClick(args.Data))"
                            Data="@data" TItem="TbEmissionSource" AllowColumnResize="true"
                            AllowPaging="true" PageSize="@_pageSize" PageSizeOptions="@_pageSizeOptions"
                            AllowSorting="true" ColumnWidth="180px" PagerHorizontalAlign="HorizontalAlign.Right"
                            ShowPagingSummary="true" Style="@GridStyles.Default">
                <Columns>
                    @if (Env.IsDevelopment() || _isAdmin)
                    {
                        <RadzenDataGridColumn TItem="TbEmissionSource" Property="Id" Title="ID" Width="60px" TextAlign="TextAlign.Center" />
                    }
                    <RadzenDataGridColumn TItem="TbEmissionSource" Title="#" Width="50px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                        <Template Context="d">
                            @(data.IndexOf(d) + 1)
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Visible="false" TItem="TbEmissionSource" Title="Type" Width="130px" Frozen="true" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <div class="d-flex align-items-center justify-content-center gap-1 text-nowrap">
                                @if (item.SourceType == eSourceType.Custom)
                                {
                                    <RadzenBadge Text="Custom" BadgeStyle="BadgeStyle.Success" IsPill="false" Style="font-size: 10px; padding: 0.25em 0.5rem;" />
                                }
                                else
                                {
                                    <RadzenBadge Text="System" BadgeStyle="BadgeStyle.Light" IsPill="false" Style="font-size: 10px; padding: 0.25em 0.5rem;" />
                                }
                                @if (item.IsExpire)
                                {
                                    <span class="badge bg-danger text-white fw-bold px-2 py-0.5 shadow-sm" style="font-size: 0.7rem; border-radius: 4px;">Expired</span>
                                }
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TbEmissionSource" Property="Title" Title="Title" Width="300px" Frozen="true">
                        <Template Context="item">
                            <div class="d-flex align-items-center gap-2 text-nowrap text-truncate" style="max-width: 280px;" title="@item.Title">
                                @if (item.SourceType == eSourceType.Custom)
                                {
                                    <span class="badge bg-success text-white fw-bold px-2 py-0.5 shadow-sm" style="font-size: 0.7rem; border-radius: 4px;">Custom</span>
                                }
                                else
                                {
                                    <RadzenBadge Text="System" BadgeStyle="BadgeStyle.Light" IsPill="false" Style="font-size: 10px; padding: 0.25em 0.5rem;" />
                                }
                                @if (item.IsExpire)
                                {
                                    <span class="badge bg-danger text-white fw-bold px-2 py-0.5 shadow-sm" style="font-size: 0.7rem; border-radius: 4px;">Expired</span>
                                }
                                <span class="fw-bold text-dark">@item.Title</span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Visible="false" TItem="TbEmissionSource" Title="ISO Category" Width="120px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            @if (item.Group != null)
                            {
                                <span class="badge bg-light text-secondary border fw-bold px-2 py-1 small shadow-sm">
                                    Cat @((int)item.Group.IsoCategoryNo)
                                </span>
                            }
                            else
                            {
                                <span class="text-muted font-monospace small">-</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TbEmissionSource" Title="Factor (kgCO2e)" Width="120px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <span class="fw-bold text-success">@item.EF.ToString("N6")</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TbEmissionSource" Title="Unit" Width="100px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <span>@(item.Unit?.Title ?? "-")</span>
                        </Template>
                    </RadzenDataGridColumn>

                    @* GHG Breakdown *@
                    <RadzenDataGridColumn TItem="TbEmissionSource" Title="GHG Breakdown" TextAlign="TextAlign.Center" Visible="@(_chkValues?.Contains(1) == true)" Width="720px">
                        <Columns>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="CO2" Property="CO2" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.CO2:F4}")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="Fossil CH4" Property="FossilCH4" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.FossilCH4:F4}")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="CH4" Property="CH4" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.CH4:F4}")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="N2O" Property="N2O" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.N2O:F4}")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="SF6" Property="SF6" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.SF6:F4}")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="NF3" Property="NF3" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.NF3:F4}")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="HFCs" Property="HFCs" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.HFCs:F4}")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="PFCs" Property="PFCs" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.PFCs:F4}")</Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGridColumn>

                    @* GWP 100 *@
                    <RadzenDataGridColumn TItem="TbEmissionSource" Title="GWP 100" TextAlign="TextAlign.Center" Visible="@(_chkValues?.Contains(2) == true)" Width="720px">
                        <Columns>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="GWP-CO2" Property="gwpCO2" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.gwpCO2:F2}")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="GWP-Fossil CH4" Property="gwpFossilCH4" Width="105px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.gwpFossilCH4:F4}")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="GWP-CH4" Property="gwpCH4" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.gwpCH4:F4}")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="GWP-N2O" Property="gwpN2O" Width="95px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.gwpN2O:F4}")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="GWP-SF6" Property="gwpSF6" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.gwpSF6:F4}")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="GWP-NF3" Property="gwpNF3" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.gwpNF3:F4}")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="GWP-HFCs" Property="gwpHFCs" Width="95px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.gwpHFCs:F4}")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="GWP-PFCs" Property="gwpPFCs" Width="95px" TextAlign="TextAlign.Center">
                                <Template Context="item">@($"{item.gwpPFCs:F4}")</Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGridColumn>

                    @* Data Source Origins *@
                    <RadzenDataGridColumn TItem="TbEmissionSource" Title="Data Source" TextAlign="TextAlign.Center" Visible="@(_chkValues?.Contains(3) == true)" Width="750px">
                        <Columns>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="Self Collect" Property="SelfCollect" Width="95px" TextAlign="TextAlign.Center">
                                <Template Context="item"><RadzenCheckBox @bind-Value="@item.SelfCollect" Disabled="true" /></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="Supplier" Property="Supplier" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item"><RadzenCheckBox @bind-Value="@item.Supplier" Disabled="true" /></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="TH LCI DB" Property="THLCIDB" Width="95px" TextAlign="TextAlign.Center">
                                <Template Context="item"><RadzenCheckBox @bind-Value="@item.THLCIDB" Disabled="true" /></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="TGO EF" Property="TGOEF" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item"><RadzenCheckBox @bind-Value="@item.TGOEF" Disabled="true" /></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="Thai Res." Property="ThaiRes" Width="95px" TextAlign="TextAlign.Center">
                                <Template Context="item"><RadzenCheckBox @bind-Value="@item.ThaiRes" Disabled="true" /></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="Int. DB" Property="IntDB" Width="90px" TextAlign="TextAlign.Center">
                                <Template Context="item"><RadzenCheckBox @bind-Value="@item.IntDB" Disabled="true" /></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="Other" Property="Other" Width="85px" TextAlign="TextAlign.Center">
                                <Template Context="item"><RadzenCheckBox @bind-Value="@item.Other" Disabled="true" /></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TbEmissionSource" Title="Substitute" Property="Substitute" Width="95px" TextAlign="TextAlign.Center">
                                <Template Context="item"><RadzenCheckBox @bind-Value="@item.Substitute" Disabled="true" /></Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TbEmissionSource" Property="Ref" Title="Reference Code" Width="140px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="TbEmissionSource" Property="Remark" Title="Remark" MinWidth="150px" />
                    <RadzenDataGridColumn TItem="TbEmissionSource" Title="Date Approved" Width="130px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <span class="small @(item.IsExpire ? "text-danger fw-bold" : "text-muted")">
                                @item.DateApproved?.ToString("yyyy-MM-dd")
                            </span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TbEmissionSource" Title="Actions" Width="130px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="item">
                            @{
                                bool isSystem = item.SourceType == eSourceType.Default;
                                bool canEditItem = _isAdmin || (!isSystem && item.SubscriptionId.HasValue && _editableSubscriptionIds.Contains(item.SubscriptionId.Value));
                                bool canDuplicate = _isAdmin || (_selectedSubscriptionId.HasValue && _editableSubscriptionIds.Contains(_selectedSubscriptionId.Value));
                                bool canDelete = canEditItem && !isSystem;
                                string btnText = canEditItem ? "Edit" : "View";
                                string btnIcon = canEditItem ? "edit" : "visibility";
                                var btnStyle = canEditItem ? ButtonStyle.Secondary : ButtonStyle.Light;
                            }
                            <RadzenSplitButton Text="@btnText" Icon="@btnIcon" Size="ButtonSize.Small" ButtonStyle="@btnStyle"
                                               Click="@(args => OnSplitButtonClick(args, item))"
                                               Style="border-radius: 6px; font-weight: 600; min-width: 90px; height: 32px;">
                                <ChildContent>
                                    <RadzenSplitButtonItem Text="Duplicate" Value="1" Icon="content_copy" Disabled="@(!canDuplicate)" />
                                    <RadzenSplitButtonItem Text="Delete" Value="2" Icon="delete" Style="color: var(--rz-danger);" Disabled="@(!canDelete)" />
                                </ChildContent>
                            </RadzenSplitButton>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        };
        #endregion
    }
    #endregion
}
