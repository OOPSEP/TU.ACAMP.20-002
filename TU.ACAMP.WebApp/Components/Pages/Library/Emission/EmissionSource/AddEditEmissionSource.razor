            JsonDataFiles = model.JsonDataFiles?.ToJsonString(null) ?? "[]"
        });
        #endregion
    }

    private void NavigateToBack()
    {
        #region hide [2026-08-17]
        try
        {
            if (!string.IsNullOrWhiteSpace(SecureRet))
            {
                var returnUrl = DataProtection.Unprotect(SecureRet);
                if (!string.IsNullOrWhiteSpace(returnUrl))
                {
                    NavigationManager.NavigateTo(returnUrl);
                    return;
                }
            }

            var queryParams = new Dictionary<string, object?>();

            if (_selectedSubscriptionId.HasValue)
                queryParams["sid"] = DataProtection.Protect(_selectedSubscriptionId.Value);

            if (_activeTabIndex > 0)
                queryParams["tab"] = DataProtection.Protect(_activeTabIndex);

            if (_activeGridPageIndex > 0)
                queryParams["gpage"] = DataProtection.Protect(_activeGridPageIndex);

            if (_activeAccordionIndex > 0)
                queryParams["sac"] = DataProtection.Protect(_activeAccordionIndex);

            if (!string.IsNullOrWhiteSpace(_searchText))
                queryParams["q"] = DataProtection.Protect(_searchText);

            var url = NavigationManager.GetUriWithQueryParameters("/library/emission-sources", queryParams);
            NavigationManager.NavigateTo(url, replace: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error navigating back from AddEditEmissionSource.");
            NavigationManager.NavigateTo("/library/emission-sources");
        }
        #endregion
    }

    private async Task OnSubmit(TbEmissionSource model)
    {
        #region hide [2026-08-17]
        if (_isReadOnlyForm)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Denied", "You do not have write access to submit this form.");
            return;
        }

        _isSaving = true;
        try
        {
            if (model.Id == 0)
            {
                if (!_canCreate && !_isAdmin)
                {
                    NotificationService.Notify(NotificationSeverity.Error, "Denied", "You do not have permission to create records.");
                    return;
                }

                if (!_selectedSubscriptionId.HasValue)
                {
                    NotificationService.Notify(NotificationSeverity.Warning, "Incomplete Data", "Please select a Subscription context.");
                    return;
                }

                model.SubscriptionId = _selectedSubscriptionId.Value;
                model.SourceType = eSourceType.Custom;
                model.IsReadOnly = false;

                await EmissionSourceService.CreateAsync(model);
                NotificationService.Notify(NotificationSeverity.Success, "Created", "Emission source created successfully.");
            }
            else
            {
                await EmissionSourceService.UpdateAsync(model);
                NotificationService.Notify(NotificationSeverity.Success, "Updated", "Emission source updated successfully.");
            }

            NavigateToBack();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving emission source ID: {Id}", model.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Save Error", ex.Message);
        }
        finally
        {
            _isSaving = false;
        }
        #endregion
    }
    #endregion
}
