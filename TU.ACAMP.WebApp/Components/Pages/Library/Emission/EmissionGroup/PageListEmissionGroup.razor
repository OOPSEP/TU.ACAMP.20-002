@page "/library/emission-groups"
@page "/emissions/groups"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.DataProtection
@using System.Security.Claims
@using TU.ACAMP.Domain.Enums
@using TU.ACAMP.Domain.Identity
@using TU.ACAMP.Domain.Models.Library
@using TU.ACAMP.WebApp.Services.Common
@using TU.ACAMP.WebApp.Services.Emissions
@using TU.ACAMP.WebApp.Components.Pages.Library.Emission.EmissionGroup.Dialogs
@using TU.ACAMP.WebApp.Services.Identity

@attribute [Authorize]

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject AuthenticationStateProvider AuthStateProvider
@inject EmissionGroupService EmissionGroupService
@inject EmissionGroupExcelService ExcelService
@inject SubscriptionService SubscriptionService
@inject NavigationManager NavigationManager
@inject IDataProtectionProvider DataProtection
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject ILogger<PageListEmissionGroup> Logger

<PageTitle>Emission Groups Library - ACAMP</PageTitle>

<div class="container-fluid py-3 px-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <RadzenText Text="Emission Groups Library" TextStyle="TextStyle.H5" TagName="TagName.H1" class="fw-bold mb-1" Style="color: var(--rz-text-title-color);" />
            <RadzenText Text="Manage system standard and custom emission groups by reporting scope." TextStyle="TextStyle.Body2" class="text-muted mb-0" />
        </div>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Class="flex-wrap">
            <RadzenButton Text="Export Excel" Icon="download" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                          Click="@ExportToExcelAsync" Style="border-radius: 8px; font-weight: 600;"
                          Disabled="@(!CanExport)" Title="@(CanExport ? "Export emission groups to Excel" : "Export is restricted to users with edit permissions.")" />
            <RadzenButton Text="Import Excel" Icon="file_upload" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined"
                          Click="@OpenImportDialogAsync" Style="border-radius: 8px; font-weight: 600;" Disabled="@_isAddDisabled" />
            <RadzenButton Text="Add Emission Group" Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                          Click="@InsertRow" Style="border-radius: 8px; font-weight: 600;" Disabled="@_isAddDisabled" />
        </RadzenStack>
    </div>

    <!-- [2026-09-13][Antigravity] Filters & Search Toolbar with .acamp-filter-bar and spring search -->
    <RadzenCard Class="mb-4 p-3 shadow-sm" Style="border-radius: 12px; border: 1px solid var(--rz-border-color); background: var(--rz-card-background-color);">
        <div class="acamp-filter-bar justify-content-between">
            <div class="acamp-filter-search">
                <RadzenFormField Text="Search Emission Groups">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="SearchText" Placeholder="Search by code, title, or remark..." Style="width: 100%;" />
                    </ChildContent>
                    <Start>
                        <RadzenIcon Icon="search" />
                    </Start>
                </RadzenFormField>
            </div>
            <div class="d-flex align-items-end gap-2 flex-wrap ms-auto flex-shrink-0">
                <RadzenFormField Text="Subscription Workspace" Style="width: 220px;">
                    <RadzenDropDown TValue="int?"
                                    Value="@_selectedSubscriptionId"
                                    Data="@_subscriptionsList"
                                    TextProperty="Title"
                                    ValueProperty="Id"
                                    Placeholder="All Subscriptions"
                                    AllowClear="true"
                                    Change="@(args => OnSubscriptionChanged(args))"
                                    Style="width: 100%;" />
                </RadzenFormField>
                <div class="d-flex align-items-center text-muted small" style="height: 40px;">
                    Showing <b>@_filteredItems.Count</b> records
                </div>
            </div>
        </div>
    </RadzenCard>

    <!-- DataGrid Container -->
    @if (_isLoading)
    {
        <div class="py-5 text-center">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <RadzenText Text="Loading emission groups..." TextStyle="TextStyle.Body2" class="text-muted mt-2" />
        </div>
    }
    else
    {
        <div class="shadow-sm rounded-3 p-3" style="background-color: var(--rz-card-background-color); border: 1px solid var(--rz-border-color); border-radius: 12px;">
            <RadzenTabs RenderMode="TabRenderMode.Client" Class="shadow-sm rounded-3"
                        SelectedIndex="@ActiveTabIndex" Change="@OnTabChanged">
                <Tabs>
                    <RadzenTabsItem Text="Scope 1 (Direct GHG)">
                        <div class="pt-3">
                            @RenderGrid(GetGroupsForScope(eTgoScopeNo.Scope1), eTgoScopeNo.Scope1)
                        </div>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Scope 2 (Indirect Energy)">
                        <div class="pt-3">
                            @RenderGrid(GetGroupsForScope(eTgoScopeNo.Scope2), eTgoScopeNo.Scope2)
                        </div>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Scope 3 (Other Indirect)">
                        <div class="pt-3">
                            @RenderGrid(GetGroupsForScope(eTgoScopeNo.Scope3), eTgoScopeNo.Scope3)
                        </div>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Separate Report (Biogenic CO₂)">
                        <div class="pt-3">
                            @RenderGrid(GetGroupsForScope(eTgoScopeNo.SeparateReport), eTgoScopeNo.SeparateReport)
                        </div>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </div>
    }
</div>

@code {
    #region class field
    private int _pageSize = 15;
    private readonly IEnumerable<int> _pageSizeOptions = new int[] { 15, 25, 50, 100 };
    private Dictionary<eTgoScopeNo, RadzenDataGrid<TbEmissionGroup>> _grids = new()
    {
        { eTgoScopeNo.Scope1, null! },
        { eTgoScopeNo.Scope2, null! },
        { eTgoScopeNo.Scope3, null! },
        { eTgoScopeNo.SeparateReport, null! }
    };

    private bool _isLoading = true;
    private bool _isAdmin = false;
    private bool _isAddDisabled = true;
    private string _searchText = string.Empty;
    private int _activeTabIndex = 0;
    private int _activeGridPageIndex = 0;

    private List<TbEmissionGroup> _allItems = new();
    private List<TbEmissionGroup> _filteredItems = new();
    private string _currentUserEmail = string.Empty;
    private HashSet<int> _editableSubscriptionIds = new();
    private List<TbSubscription> _subscriptionsList = new();
    private int? _selectedSubscriptionId;
    private TbEmissionGroup? _editingItemBackup = null;
    private bool _isNewRow = false;
    #endregion

    #region class properties
    private string SearchText
    {
        get => _searchText;
        set
        {
            if (_searchText != value)
            {
                _searchText = value;
                OnFilterChanged();
                NavigateToSelfState();
            }
        }
    }

    private int ActiveTabIndex
    {
        get => _activeTabIndex;
        set
        {
            if (_activeTabIndex != value)
            {
                _activeTabIndex = value;
                _activeGridPageIndex = 0;
            }
        }
    }

    [SupplyParameterFromQuery(Name = "sid")]
    public string SecureSid { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "tab")]
    public string SecureTab { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "gpage")]
    public string SecureGpage { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "q")]
    public string SecureSearchText { get; set; } = string.Empty;
    #endregion

    #region class methods
    protected override async Task OnInitializedAsync()
    {
        #region hide [2026-08-17]
        _isLoading = true;
        try
        {
            await InitializeUserSessionAsync();
            RestoreStateParameters();

            if (!_selectedSubscriptionId.HasValue && !_isAdmin && _subscriptionsList.Count == 1)
            {
                _selectedSubscriptionId = _subscriptionsList[0].Id;
            }

            UpdateCreatePermission();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Critical error initializing PageListEmissionGroup.");
            NotificationService.Notify(NotificationSeverity.Error, "Initialization Error", "Failed to load emission groups library.");
        }
        finally
        {
            _isLoading = false;
        }
        #endregion
    }

    private async Task InitializeUserSessionAsync()
    {
        #region hide [2026-08-17]
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            _currentUserEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? (user.Identity.Name ?? string.Empty);
            _isAdmin = user.IsInRole(SystemRoles.Administrator);
        }

        _editableSubscriptionIds = await SubscriptionService.GetEditableSubscriptionIdsAsync(_currentUserEmail, _isAdmin);
        _subscriptionsList = await SubscriptionService.GetSubscriptionsForUserAsync(_currentUserEmail, _isAdmin, includeInactive: false);
        #endregion
    }

    private void RestoreStateParameters()
    {
        #region hide [2026-08-17]
        var decryptedSid = DataProtection.UnprotectInt(SecureSid);
        if (decryptedSid.HasValue)
        {
            _selectedSubscriptionId = decryptedSid.Value;
        }

        var decryptedTab = DataProtection.UnprotectInt(SecureTab);
        if (decryptedTab.HasValue && decryptedTab.Value >= 0 && decryptedTab.Value <= 3)
        {
            _activeTabIndex = decryptedTab.Value;
        }

        var decryptedGpage = DataProtection.UnprotectInt(SecureGpage);
        if (decryptedGpage.HasValue && decryptedGpage.Value >= 0)
        {
            _activeGridPageIndex = decryptedGpage.Value;
        }

        var decryptedQ = DataProtection.Unprotect(SecureSearchText);
        if (!string.IsNullOrEmpty(decryptedQ))
        {
            _searchText = decryptedQ;
        }
        #endregion
    }

    private void UpdateCreatePermission()
    {
        #region hide [2026-08-17]
        if (_isAdmin)
        {
            _isAddDisabled = false;
        }
        else
        {
            _isAddDisabled = !(_selectedSubscriptionId.HasValue && _editableSubscriptionIds.Contains(_selectedSubscriptionId.Value));
        }
        #endregion
    }

    private async Task LoadDataAsync()
    {
        #region hide [2026-08-17]
        _isLoading = true;
        try
        {
            // [2026-09-23][Claude] Admin + "All Subscriptions" -> แสดง Default + Custom ของทุก Subscription (เดิมเห็นแค่ Default) — แบบเดียวกับ PageListEmissionUnit
            _allItems = _isAdmin && !_selectedSubscriptionId.HasValue
                ? await EmissionGroupService.GetAllAsync()
                : await EmissionGroupService.GetBySubscriptionIdAsync(_selectedSubscriptionId, includeDefault: true);
            OnFilterChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load emission groups data.");
            NotificationService.Notify(NotificationSeverity.Error, "Data Error", "Failed to load emission groups library.");
        }
        finally
        {
            _isLoading = false;
        }
        #endregion
    }

    private void OnFilterChanged()
    {
        #region hide [2026-08-17]
        var query = _allItems.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var q = _searchText.Trim();
            query = query.Where(x =>
                (!string.IsNullOrEmpty(x.Code) && x.Code.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Title) && x.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.TitleTh) && x.TitleTh.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Remark) && x.Remark.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }

        _filteredItems = query.ToList();

        foreach (var grid in _grids.Values)
        {
            grid?.Reload();
        }
        #endregion
    }

    private List<TbEmissionGroup> GetGroupsForScope(eTgoScopeNo scopeType)
    {
        #region hide [2026-08-17]
        return _filteredItems.Where(x => x.TgoScopeNo == scopeType).OrderBy(x => x.Code).ToList();
        #endregion
    }

    private void OnTabChanged(int index)
    {
        #region hide [2026-08-17]
        ActiveTabIndex = index;
        NavigateToSelfState();
        #endregion
    }

    private void OnGridPageChanged(PagerEventArgs args)
    {
        #region hide [2026-08-17]
        _activeGridPageIndex = args.PageIndex;
        NavigateToSelfState();
        #endregion
    }

    private async Task OnSubscriptionChanged(object value)
    {
        #region hide [2026-08-17]
        _selectedSubscriptionId = value as int?;
        _activeGridPageIndex = 0;
        UpdateCreatePermission();
        NavigateToSelfState();
        await LoadDataAsync();
        #endregion
    }

    private void NavigateToSelfState()
    {
        #region hide [2026-08-17]
        try
        {
            var queryParams = new Dictionary<string, object?>();

            if (_selectedSubscriptionId.HasValue)
                queryParams["sid"] = DataProtection.Protect(_selectedSubscriptionId.Value);

            if (_activeTabIndex > 0)
                queryParams["tab"] = DataProtection.Protect(_activeTabIndex);

            if (_activeGridPageIndex > 0)
                queryParams["gpage"] = DataProtection.Protect(_activeGridPageIndex);

            if (!string.IsNullOrWhiteSpace(_searchText))
                queryParams["q"] = DataProtection.Protect(_searchText);

            var url = NavigationManager.GetUriWithQueryParameters("/library/emission-groups", queryParams);
            NavigationManager.NavigateTo(url, replace: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating URL state in PageListEmissionGroup.");
        }
        #endregion
    }

    private bool CanExport => _isAdmin || (_selectedSubscriptionId.HasValue ? _editableSubscriptionIds.Contains(_selectedSubscriptionId.Value) : _editableSubscriptionIds.Count > 0);

    private async Task ExportToExcelAsync()
    {
        #region hide [2026-09-06]
        // [2026-09-19][Antigravity] Enforce edit permission check for exporting emission groups
        if (!CanExport)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Access Denied", "Only users with edit permissions can export data.");
            return;
        }

        try
        {
            var contextName = _selectedSubscriptionId.HasValue
                ? (_subscriptionsList.FirstOrDefault(x => x.Id == _selectedSubscriptionId.Value)?.Title ?? string.Empty)
                : "All Subscriptions";

            var bytes = await ExcelService.ExportGroupsToExcelAsync(_filteredItems, contextName);
            var base64 = Convert.ToBase64String(bytes);
            // [2026-09-21][Gemini] Standard Export Filename: emission_groups_{context}_{date}_{time}.xlsx
            var fileName = ExportFileNameHelper.Generate("emission_groups", contextName);
            await JSRuntime.InvokeVoidAsync("saveAsFile", fileName, base64);
            NotificationService.Notify(NotificationSeverity.Success, "Export Successful", $"Exported {_filteredItems.Count} emission groups to Excel.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export emission groups to Excel.");
            NotificationService.Notify(NotificationSeverity.Error, "Export Failed", "Failed to generate Excel file.");
        }
        #endregion
    }

    private async Task OpenImportDialogAsync()
    {
        #region hide [2026-09-06]
        if (_isAddDisabled || !_selectedSubscriptionId.HasValue)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Subscription Required", "Please select a subscription workspace before importing.");
            return;
        }

        var parameters = new Dictionary<string, object>
        {
            { "SubscriptionId", _selectedSubscriptionId.Value }
        };

        var options = new DialogOptions
        {
            Width = "850px",
            Height = "auto",
            Resizable = true,
            Draggable = true
        };

        var result = await DialogService.OpenAsync<ImportEmissionGroupDialog>("Import Emission Groups", parameters, options);
        if (result == true)
        {
            await LoadDataAsync();
            StateHasChanged();
        }
        #endregion
    }

    private async Task InsertRow()
    {
        #region hide [2026-08-17]
        if (_isAddDisabled) return;
        if (!_isAdmin && !_selectedSubscriptionId.HasValue) return;

        var currentScope = _activeTabIndex switch
        {
            0 => eTgoScopeNo.Scope1,
            1 => eTgoScopeNo.Scope2,
            2 => eTgoScopeNo.Scope3,
            3 => eTgoScopeNo.SeparateReport,
            _ => eTgoScopeNo.Scope1
        };

        _isNewRow = true;
        _editingItemBackup = null;

        string nextCode;
        try
        {
            nextCode = await GenerateNextCodeAsync(currentScope, _selectedSubscriptionId.HasValue);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to generate next emission group code for scope: {Scope}", currentScope);
            NotificationService.Notify(NotificationSeverity.Warning, "Code Limit Reached", ex.Message);
            _isNewRow = false;
            return;
        }

        var newItem = new TbEmissionGroup
        {
            Code = nextCode,
            Title = string.Empty,
            TitleTh = string.Empty,
            TgoScopeNo = currentScope,
            IsoCategoryNo = eIsoCategoryNo.Category1,
            Remark = string.Empty,
            SubscriptionId = _selectedSubscriptionId,
            SourceType = _selectedSubscriptionId.HasValue ? eSourceType.Custom : eSourceType.Default,
            IsReadOnly = false
        };

        _allItems.Add(newItem);
        _filteredItems.Add(newItem);

        if (_grids.TryGetValue(currentScope, out var grid) && grid != null)
        {
            var scopeItems = GetGroupsForScope(currentScope);
            int pageSize = grid.PageSize > 0 ? grid.PageSize : _pageSize;
            int lastPageIndex = Math.Max(0, (int)Math.Ceiling(scopeItems.Count / (double)pageSize) - 1);

            _activeGridPageIndex = lastPageIndex;
            await grid.GoToPage(lastPageIndex);
            await grid.InsertRow(newItem);
        }
        else
        {
            StateHasChanged();
            await Task.Yield();
            if (_grids.TryGetValue(currentScope, out grid) && grid != null)
            {
                _activeGridPageIndex = 0;
                await grid.InsertRow(newItem);
            }
        }
        #endregion
    }

    private async Task EditRow(TbEmissionGroup item)
    {
        #region hide [2026-08-17]
        _isNewRow = false;
        _editingItemBackup = new TbEmissionGroup
        {
            Code = item.Code,
            Title = item.Title,
            TitleTh = item.TitleTh,
            Remark = item.Remark,
            TgoScopeNo = item.TgoScopeNo,
            IsoCategoryNo = item.IsoCategoryNo
        };

        if (_grids.TryGetValue(item.TgoScopeNo, out var grid) && grid != null)
        {
            await grid.EditRow(item);
        }
        #endregion
    }

    private async Task SaveRow(TbEmissionGroup item)
    {
        #region hide [2026-08-17]
        if (string.IsNullOrWhiteSpace(item.Title))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validation", "Title is required.");
            return;
        }

        if (_grids.TryGetValue(item.TgoScopeNo, out var grid) && grid != null)
        {
            await grid.UpdateRow(item);
        }
        #endregion
    }

    private async Task CancelEdit(TbEmissionGroup item)
    {
        #region hide [2026-08-17]
        if (_isNewRow)
        {
            _allItems.Remove(item);
            _filteredItems.Remove(item);
        }
        else if (_editingItemBackup != null)
        {
            item.Code = _editingItemBackup.Code;
            item.Title = _editingItemBackup.Title;
            item.TitleTh = _editingItemBackup.TitleTh;
            item.Remark = _editingItemBackup.Remark;
            item.TgoScopeNo = _editingItemBackup.TgoScopeNo;
            item.IsoCategoryNo = _editingItemBackup.IsoCategoryNo;
        }

        _isNewRow = false;
        _editingItemBackup = null;

        if (_grids.TryGetValue(item.TgoScopeNo, out var grid) && grid != null)
        {
            grid.CancelEditRow(item);
            await grid.Reload();
        }
        #endregion
    }

    private async Task OnCreateRow(TbEmissionGroup item)
    {
        #region hide [2026-08-17]
        try
        {
            await EmissionGroupService.CreateAsync(item);
            NotificationService.Notify(NotificationSeverity.Success, "Created", $"Emission group '{item.Code}' created successfully.");
            _isNewRow = false;
            _editingItemBackup = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating emission group: {Code}", item.Code);
            NotificationService.Notify(NotificationSeverity.Error, "Create Error", ex.Message);
            _isNewRow = false;
            _allItems.Remove(item);
            _filteredItems.Remove(item);
            await LoadDataAsync();
        }
        #endregion
    }

    private async Task OnUpdateRow(TbEmissionGroup item)
    {
        #region hide [2026-08-17]
        try
        {
            var updated = await EmissionGroupService.UpdateAsync(item);
            NotificationService.Notify(NotificationSeverity.Success, "Updated", $"Emission group '{updated.Code}' updated successfully.");
            _editingItemBackup = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating emission group ID: {Id}", item.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Update Error", ex.Message);

            if (_editingItemBackup != null)
            {
                item.Code = _editingItemBackup.Code;
                item.Title = _editingItemBackup.Title;
                item.Remark = _editingItemBackup.Remark;
                item.TgoScopeNo = _editingItemBackup.TgoScopeNo;
                item.IsoCategoryNo = _editingItemBackup.IsoCategoryNo;
            }
            _editingItemBackup = null;

            if (_grids.TryGetValue(item.TgoScopeNo, out var grid) && grid != null)
            {
                grid.CancelEditRow(item);
                await grid.Reload();
            }
        }
        #endregion
    }

    private async Task OnDuplicate(TbEmissionGroup item)
    {
        #region hide [2026-08-17]
        try
        {
            if (item == null) return;

            if (!_selectedSubscriptionId.HasValue)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Duplication Restricted", "Please select a subscription first.");
                return;
            }

            var dup = TbEmissionGroup.Duplicate(item, _selectedSubscriptionId.Value);
            dup.Code = await GenerateNextCodeAsync(item.TgoScopeNo, isCustom: true);
            dup.Title = $"{item.Title} (Copy)";

            await EmissionGroupService.CreateAsync(dup);
            NotificationService.Notify(NotificationSeverity.Success, "Duplication Successful", $"Emission group cloned as '{dup.Code}'.");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error duplicating emission group ID: {Id}", item.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Duplicate Error", ex.Message);
        }
        #endregion
    }

    private async Task ConfirmDelete(TbEmissionGroup item)
    {
        #region hide [2026-08-17]
        // [2026-09-24] Delete Protection: ตรวจสอบว่า Group ถูกอ้างอิงโดย Emission Source หรือ Topic อยู่หรือไม่ (แสดงชื่อแรก + and others)
        try
        {
            var blockMessage = await EmissionGroupService.GetDeleteBlockMessageAsync(item.Id);
            if (blockMessage != null)
            {
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Cannot Delete Group",
                    blockMessage,
                    duration: 8000);
                return;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error checking references of emission group ID: {Id}", item.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Delete Failed", ex.Message);
            return;
        }

        var confirmed = await DialogService.Confirm(
            "Are you sure you want to delete this emission group?",
            "Delete Emission Group",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                var success = await EmissionGroupService.DeleteAsync(item.Id);
                if (success)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Deleted", $"Emission group '{item.Code}' deleted successfully.");
                    await LoadDataAsync();
                }
                else
                {
                    NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Emission group could not be deleted.");
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting emission group ID: {Id}", item.Id);
                NotificationService.Notify(NotificationSeverity.Error, "Delete Failed", ex.Message);
            }
        }
        #endregion
    }

    private async Task OnSplitButtonClick(RadzenSplitButtonItem args, TbEmissionGroup item)
    {
        #region hide [2026-08-17]
        if (args == null || args.Value == null)
        {
            bool isSystem = item.SourceType == eSourceType.Default;
            bool canEditItem = _isAdmin || (!isSystem && item.SubscriptionId.HasValue && _editableSubscriptionIds.Contains(item.SubscriptionId.Value));
            if (canEditItem)
            {
                await EditRow(item);
            }
            return;
        }

        switch (args.Value.ToString())
        {
            case "1":
                await OnDuplicate(item);
                break;
            case "2":
                await ConfirmDelete(item);
                break;
        }
        #endregion
    }

    private async Task<string> GenerateNextCodeAsync(eTgoScopeNo scope, bool isCustom)
    {
        #region hide [2026-09-06]
        // กลุ่มที่ผู้ใช้สร้างเองใช้ namespace แยก (03C01) และจองลำดับที่ว่างต่ำสุด
        // เพื่อไม่ให้รหัสวิ่งขึ้นเรื่อย ๆ และไม่ชนกับกลุ่มมาตรฐานที่ระบบอาจเพิ่มภายหลัง
        var usedNumbers = EmissionGroupExcelService.GetUsedCodeNumbers(_allItems.Select(x => x.Code), scope, isCustom);
        var slot = EmissionGroupExcelService.TakeNextFreeSlot(usedNumbers);

        if (slot <= 0)
        {
            throw new InvalidOperationException($"No available group code left for this scope (limit 99).");
        }

        return await Task.FromResult(EmissionGroupExcelService.BuildCode(scope, slot, isCustom));
        #endregion
    }

    private RenderFragment RenderGrid(List<TbEmissionGroup> data, eTgoScopeNo scopeType)
    {
        #region hide [2026-08-17]
        if (!data.Any())
        {
            return @<div class="p-4 text-center text-muted">
                <RadzenIcon Icon="inbox" Style="font-size: 36px; opacity: 0.5;" class="mb-2" />
                <div>No emission groups documented for this specific reporting scope.</div>
            </div>;
        }

        return __builder =>
        {
            <RadzenDataGrid @ref="@_grids[scopeType]" Data="@data" TItem="TbEmissionGroup"
                            AllowColumnResize="true" AllowPaging="true" PageSize="@_pageSize"
                            PageSizeOptions="@_pageSizeOptions" AllowSorting="true" ColumnWidth="180px"
                            PagerHorizontalAlign="HorizontalAlign.Right" ShowPagingSummary="true"
                            EditMode="DataGridEditMode.Single" RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow"
                            Style="@GridStyles.Default" Page="@OnGridPageChanged">
                <Columns>
                    @if (Env.IsDevelopment() || _isAdmin)
                    {
                        <RadzenDataGridColumn TItem="TbEmissionGroup" Property="Id" Title="ID" Width="70px" TextAlign="TextAlign.Center" />
                    }

                    <RadzenDataGridColumn TItem="TbEmissionGroup" Title="#" Width="55px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                        <Template Context="item">
                            @(data.IndexOf(item) + 1)
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Visible="false" TItem="TbEmissionGroup" Property="Code" Title="Code" Width="110px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <span class="badge bg-light text-dark border fw-bold px-2 py-1">@item.Code</span>
                        </Template>
                        <EditTemplate Context="item">
                            <RadzenTextBox @bind-Value="item.Code" Style="width:100%" ReadOnly="@(item.SourceType == eSourceType.Default)" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TbEmissionGroup" Property="Title" Title="Emission Group Name / Title" MinWidth="260px">
                        <Template Context="item">
                            <div class="d-flex align-items-center gap-2">
                                @if (item.SourceType == eSourceType.Default)
                                {
                                    <RadzenBadge Text="System" BadgeStyle="BadgeStyle.Light" IsPill="false" Style="font-size: 10px; padding: 0.25em 0.5rem;" />
                                    <span class="fw-bold text-dark">@item.Title</span>
                                }
                                else
                                {
                                    <RadzenBadge Text="Custom" BadgeStyle="BadgeStyle.Success" IsPill="false" Style="font-size: 10px; padding: 0.25em 0.5rem;" />
                                    <span class="text-primary fw-bold">@item.Title</span>
                                    @* [2026-09-23][Claude] มุมมองรวมทุก Subscription: บอกว่า Custom นี้เป็นของ Subscription ไหน *@
                                    @if (!_selectedSubscriptionId.HasValue && item.SubscriptionId.HasValue)
                                    {
                                        <span class="text-muted small">(@(_subscriptionsList.FirstOrDefault(x => x.Id == item.SubscriptionId.Value)?.Title ?? $"Sub #{item.SubscriptionId.Value}"))</span>
                                    }
                                }
                            </div>
                        </Template>
                        <EditTemplate Context="item">
                            <RadzenTextBox @bind-Value="item.Title" Style="width:100%" Name="Title" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TbEmissionGroup" Property="TitleTh" Title="Thai Name" MinWidth="240px">
                        <Template Context="item">
                            <span class="fw-semibold text-secondary">@(string.IsNullOrWhiteSpace(item.TitleTh) ? "-" : item.TitleTh)</span>
                        </Template>
                        <EditTemplate Context="item">
                            <RadzenTextBox @bind-Value="item.TitleTh" MaxLength="250" Style="width:100%" Name="TitleTh" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TbEmissionGroup" Property="Remark" Title="Remark" MinWidth="250px">
                        <Template Context="item">
                            <span class="text-muted small">@(string.IsNullOrEmpty(item.Remark) ? "-" : item.Remark)</span>
                        </Template>
                        <EditTemplate Context="item">
                            <RadzenTextBox @bind-Value="item.Remark" MaxLength="250" Style="width:100%" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TbEmissionGroup" Title="Actions" Width="130px" TextAlign="TextAlign.Center" Sortable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="item">
                            @{
                                bool isSystem = item.SourceType == eSourceType.Default;
                                bool canEditItem = _isAdmin || (!isSystem && item.SubscriptionId.HasValue && _editableSubscriptionIds.Contains(item.SubscriptionId.Value));
                                bool canDuplicate = _isAdmin || (_selectedSubscriptionId.HasValue && _editableSubscriptionIds.Contains(_selectedSubscriptionId.Value));
                                bool canDelete = canEditItem && !isSystem;
                                string btnText = canEditItem ? "Edit" : "View";
                                string btnIcon = canEditItem ? "edit" : "visibility";
                                var btnStyle = canEditItem ? ButtonStyle.Secondary : ButtonStyle.Light;
                            }
                            <RadzenSplitButton Text="@btnText" Icon="@btnIcon" Size="ButtonSize.Small"
                                               ButtonStyle="@btnStyle" Click="@(args => OnSplitButtonClick(args, item))"
                                               Style="border-radius: 6px; font-weight: 600; min-width: 90px; height: 32px;">
                                <ChildContent>
                                    <RadzenSplitButtonItem Text="Duplicate" Value="1" Icon="content_copy" Disabled="@(!canDuplicate)" />
                                    <RadzenSplitButtonItem Text="Delete" Value="2" Icon="delete" Style="color: var(--rz-danger);" Disabled="@(!canDelete)" />
                                </ChildContent>
                            </RadzenSplitButton>
                        </Template>
                        <EditTemplate Context="item">
                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small" Class="me-1" Click="@(args => SaveRow(item))" />
                            <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(args => CancelEdit(item))" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        };
        #endregion
    }
    #endregion
}
