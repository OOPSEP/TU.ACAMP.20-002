@page "/library/emission-units"
@page "/emissions/units"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.DataProtection
@using System.Security.Claims
@using TU.ACAMP.Domain.Enums
@using TU.ACAMP.Domain.Identity
@using TU.ACAMP.Domain.Models.Library
@using TU.ACAMP.WebApp.Constants
@using TU.ACAMP.WebApp.Services.Common
@using TU.ACAMP.WebApp.Services.Emissions
@using TU.ACAMP.WebApp.Components.Pages.Library.Emission.EmissionUnit.Dialogs
@using TU.ACAMP.WebApp.Services.Identity

@attribute [Authorize]

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject AuthenticationStateProvider AuthStateProvider
@inject EmissionUnitService EmissionUnitService
@inject EmissionUnitExcelService ExcelService
@inject SubscriptionService SubscriptionService
@inject NavigationManager NavigationManager
@inject IDataProtectionProvider DataProtection
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IJSRuntime JSRuntime
@inject ILogger<PageListEmissionUnit> Logger

<PageTitle>Emission Units Library - ACAMP</PageTitle>

<div class="container-fluid py-3 px-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <RadzenText Text="Emission Units Library" TextStyle="TextStyle.H5" TagName="TagName.H1" class="fw-bold mb-1" Style="color: var(--rz-text-title-color);" />
            <RadzenText Text="Manage physical units of measure and data classifications for carbon footprint modeling based on GHG Protocol and ISO 14064-1." TextStyle="TextStyle.Body2" class="text-muted mb-0" />
        </div>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Class="flex-wrap">
            <RadzenButton Text="Export Excel" Icon="download" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                          Click="@ExportToExcelAsync" Style="border-radius: 8px; font-weight: 600;"
                          Disabled="@(!CanExport)" Title="@(CanExport ? "Export emission units to Excel" : "Export is restricted to users with edit permissions.")" />
            <RadzenButton Text="Import Excel" Icon="file_upload" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined"
                          Click="@OpenImportDialogAsync" Style="border-radius: 8px; font-weight: 600;" Disabled="@_isAddDisabled" />
            <RadzenButton Text="Add Emission Unit" Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                          Click="@InsertRow" Style="border-radius: 8px; font-weight: 600;" Disabled="@_isAddDisabled" />
        </RadzenStack>
    </div>

    <!-- [2026-09-13][Antigravity] Filters & Search Toolbar with .acamp-filter-bar and spring search -->
    <RadzenCard Class="mb-4 p-3 shadow-sm" Style="border-radius: 12px; border: 1px solid var(--rz-border-color); background: var(--rz-card-background-color);">
        <div class="acamp-filter-bar justify-content-between">
            <div class="acamp-filter-search">
                <RadzenFormField Text="Search Emission Units">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="SearchText" Placeholder="Search by unit title or remark..." Style="width: 100%;" />
                    </ChildContent>
                    <Start>
                        <RadzenIcon Icon="search" />
                    </Start>
                </RadzenFormField>
            </div>
            <div class="d-flex align-items-end gap-2 flex-wrap ms-auto flex-shrink-0">
                <RadzenFormField Text="Subscription Workspace" Style="width: 220px;">
                    <RadzenDropDown TValue="int?"
                                    Value="@_selectedSubscriptionId"
                                    Data="@_subscriptionsList"
                                    TextProperty="Title"
                                    ValueProperty="Id"
                                    Placeholder="All Subscriptions"
                                    AllowClear="true"
                                    Change="@(args => OnSubscriptionChanged(args))"
                                    Style="width: 100%;" />
                </RadzenFormField>
                <div class="d-flex align-items-center text-muted small" style="height: 40px;">
                    Showing <b>@_filteredItems.Count</b> records
                </div>
            </div>
        </div>
    </RadzenCard>

    <!-- DataGrid Container -->
    @if (_isLoading)
    {
        <div class="py-5 text-center">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <RadzenText Text="Loading emission units..." TextStyle="TextStyle.Body2" class="text-muted mt-2" />
        </div>
    }
    else
    {
        <div class="shadow-sm rounded-3 p-3" style="background-color: var(--rz-card-background-color); border: 1px solid var(--rz-border-color); border-radius: 12px;">
            <RadzenDataGrid @ref="_grid" Data="@_filteredItems" TItem="TbEmissionUnit"
                            AllowColumnResize="true" AllowPaging="true" PageSize="@_pageSize"
                            PageSizeOptions="@_pageSizeOptions" AllowSorting="true" ColumnWidth="180px"
                            PagerHorizontalAlign="HorizontalAlign.Right" ShowPagingSummary="true"
                            EditMode="DataGridEditMode.Single" RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow"
                            Style="@GridStyles.Default" Page="@OnGridPageChanged">
                <Columns>
                    @if (Env.IsDevelopment() || _isAdmin)
                    {
                        <RadzenDataGridColumn TItem="TbEmissionUnit" Property="Id" Title="ID" Width="70px" TextAlign="TextAlign.Center" />
                    }

                    <RadzenDataGridColumn TItem="TbEmissionUnit" Title="#" Width="55px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                        <Template Context="item">
                            @(_filteredItems.IndexOf(item) + 1)
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TbEmissionUnit" Property="Title" Title="Unit Symbol / Title" MinWidth="220px">
                        <Template Context="item">
                            <div class="d-flex align-items-center gap-2">
                                @if (item.SourceType == eSourceType.Default)
                                {
                                    <RadzenBadge Text="System" BadgeStyle="BadgeStyle.Light" IsPill="false" Style="font-size: 10px; padding: 0.25em 0.5rem;" />
                                    <span class="fw-bold text-dark" style="letter-spacing: 0.5px;">@item.Title</span>
                                }
                                else
                                {
                                    <RadzenBadge Text="Custom" BadgeStyle="BadgeStyle.Success" IsPill="false" Style="font-size: 10px; padding: 0.25em 0.5rem;" />
                                    <span class="text-primary fw-bold" style="letter-spacing: 0.5px;">@item.Title</span>
                                    @* [2026-09-23][Claude] มุมมองรวมทุก Subscription: บอกว่า Custom นี้เป็นของ Subscription ไหน *@
                                    @if (!_selectedSubscriptionId.HasValue && item.SubscriptionId.HasValue)
                                    {
                                        <span class="text-muted small">(@(_subscriptionsList.FirstOrDefault(x => x.Id == item.SubscriptionId.Value)?.Title ?? $"Sub #{item.SubscriptionId.Value}"))</span>
                                    }
                                }
                            </div>
                        </Template>
                        <EditTemplate Context="item">
                            <RadzenTextBox @bind-Value="item.Title" Style="width:100%" Name="Title" ReadOnly="@(item.SourceType == eSourceType.Default)" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Visible="false" TItem="TbEmissionUnit" Property="SourceType" Title="Source Type" Width="130px" TextAlign="TextAlign.Center" Sortable="true">
                        <Template Context="item">
                            @if (item.SourceType == eSourceType.Default)
                            {
                                <span class="badge bg-light text-secondary border px-2 py-1 rounded" style="font-size: 0.75rem; font-weight: 600;">
                                    <span class="rzi me-1" style="font-size: 0.8rem; vertical-align: middle;">lock</span>System
                                </span>
                            }
                            else
                            {
                                <span class="badge px-2 py-1 rounded" style="background-color: #e6fcf5; color: #0c8599; border: 1px solid #63e6be !important; font-size: 0.75rem; font-weight: 600;">
                                    <span class="rzi me-1" style="font-size: 0.8rem; vertical-align: middle;">layers</span>Custom
                                </span>
                            }
                        </Template>
                        <EditTemplate Context="item">
                            @if (item.SourceType == eSourceType.Default)
                            {
                                <span class="text-muted small">System</span>
                            }
                            else
                            {
                                <span class="text-info small">Custom</span>
                            }
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TbEmissionUnit" Property="Remark" Title="Remark / Description" MinWidth="250px">
                        <Template Context="item">
                            <span class="text-muted small">@(string.IsNullOrEmpty(item.Remark) ? "-" : item.Remark)</span>
                        </Template>
                        <EditTemplate Context="item">
                            <RadzenTextBox @bind-Value="item.Remark" MaxLength="500" Style="width:100%" />
                        </EditTemplate>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="TbEmissionUnit" Title="Actions" Width="130px" TextAlign="TextAlign.Center" Sortable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="item">
                            @{
                                bool isSystem = item.SourceType == eSourceType.Default;
                                bool canEditItem = _isAdmin || (!isSystem && item.SubscriptionId.HasValue && _editableSubscriptionIds.Contains(item.SubscriptionId.Value));
                                bool canDuplicate = _isAdmin || (_selectedSubscriptionId.HasValue && _editableSubscriptionIds.Contains(_selectedSubscriptionId.Value));
                                bool canDelete = canEditItem && !isSystem;
                                string btnText = canEditItem ? "Edit" : "View";
                                string btnIcon = canEditItem ? "edit" : "visibility";
                                var btnStyle = canEditItem ? ButtonStyle.Secondary : ButtonStyle.Light;
                            }
                            <RadzenSplitButton Text="@btnText" Icon="@btnIcon" Size="ButtonSize.Small"
                                               ButtonStyle="@btnStyle" Click="@(args => OnSplitButtonClick(args, item))"
                                               Style="border-radius: 6px; font-weight: 600; min-width: 90px; height: 32px;">
                                <ChildContent>
                                    <RadzenSplitButtonItem Text="Duplicate" Value="1" Icon="content_copy" Disabled="@(!canDuplicate)" />
                                    <RadzenSplitButtonItem Text="Delete" Value="2" Icon="delete" Style="color: var(--rz-danger);" Disabled="@(!canDelete)" />
                                </ChildContent>
                            </RadzenSplitButton>
                        </Template>
                        <EditTemplate Context="item">
                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small" Class="me-1" Click="@(args => SaveRow(item))" />
                            <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small" Click="@(args => CancelEdit(item))" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    }
</div>

@code {
    #region class field
    private int _pageSize = 15;
    private readonly IEnumerable<int> _pageSizeOptions = new int[] { 15, 25, 50, 100 };
    private RadzenDataGrid<TbEmissionUnit> _grid = default!;

    private bool _isLoading = true;
    private bool _isAdmin = false;
    private bool _isAddDisabled = true;
    private string _searchText = string.Empty;
    private int _activeGridPageIndex = 0;

    private List<TbEmissionUnit> _allItems = new();
    private List<TbEmissionUnit> _filteredItems = new();
    private string _currentUserEmail = string.Empty;
    private HashSet<int> _editableSubscriptionIds = new();
    private List<TbSubscription> _subscriptionsList = new();
    private int? _selectedSubscriptionId;
    private TbEmissionUnit? _editingItemBackup = null;
    private bool _isNewRow = false;
    private int? _targetUnitId = null;
    private int? _pendingGoToPageIndex = null;
    #endregion

    #region class properties
    private string SearchText
    {
        get => _searchText;
        set
        {
            if (_searchText != value)
            {
                _searchText = value;
                OnFilterChanged();
                NavigateToSelfState();
            }
        }
    }

    [SupplyParameterFromQuery(Name = "sid")]
    public string SecureSid { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "gpage")]
    public string SecureGpage { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "q")]
    public string SecureSearchText { get; set; } = string.Empty;
    #endregion

    #region class methods
    protected override async Task OnInitializedAsync()
    {
        #region hide [2026-08-17]
        _isLoading = true;
        try
        {
            await InitializeUserSessionAsync();
            RestoreStateParameters();

            if (!_selectedSubscriptionId.HasValue && !_isAdmin && _subscriptionsList.Count == 1)
            {
                _selectedSubscriptionId = _subscriptionsList[0].Id;
            }

            UpdateCreatePermission();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Critical error initializing PageListEmissionUnit.");
            NotificationService.Notify(NotificationSeverity.Error, "Initialization Error", "Failed to load emission units library.");
        }
        finally
        {
            _isLoading = false;
        }
        #endregion
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isLoading && _grid != null && _pendingGoToPageIndex.HasValue)
        {
            var targetPage = _pendingGoToPageIndex.Value;
            _pendingGoToPageIndex = null;
            if (_grid.CurrentPage != targetPage)
            {
                try
                {
                    await _grid.GoToPage(targetPage);
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error navigating grid to page index {PageIndex}.", targetPage);
                }
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task InitializeUserSessionAsync()
    {
        #region hide [2026-08-17]
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            _currentUserEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? (user.Identity.Name ?? string.Empty);
            _isAdmin = user.IsInRole(SystemRoles.Administrator);
        }

        _editableSubscriptionIds = await SubscriptionService.GetEditableSubscriptionIdsAsync(_currentUserEmail, _isAdmin);
        _subscriptionsList = await SubscriptionService.GetSubscriptionsForUserAsync(_currentUserEmail, _isAdmin, includeInactive: false);
        #endregion
    }

    private void RestoreStateParameters()
    {
        #region hide [2026-08-17]
        var decryptedSid = DataProtection.UnprotectInt(SecureSid);
        if (decryptedSid.HasValue)
        {
            _selectedSubscriptionId = decryptedSid.Value;
        }

        var decryptedGpage = DataProtection.UnprotectInt(SecureGpage);
        if (decryptedGpage.HasValue && decryptedGpage.Value >= 0)
        {
            _activeGridPageIndex = decryptedGpage.Value;
        }

        var decryptedQ = DataProtection.Unprotect(SecureSearchText);
        if (!string.IsNullOrEmpty(decryptedQ))
        {
            _searchText = decryptedQ;
        }
        #endregion
    }

    private void UpdateCreatePermission()
    {
        #region hide [2026-08-17]
        _isAddDisabled = !(_selectedSubscriptionId.HasValue &&
            (_isAdmin || _editableSubscriptionIds.Contains(_selectedSubscriptionId.Value)));
        #endregion
    }

    private async Task LoadDataAsync()
    {
        #region hide [2026-08-17]
        _isLoading = true;
        try
        {
            // [2026-09-23][Claude] Admin + "All Subscriptions" -> แสดง Default + Custom ของทุก Subscription (เดิมเห็นแค่ Default)
            _allItems = _isAdmin && !_selectedSubscriptionId.HasValue
                ? await EmissionUnitService.GetAllAsync()
                : await EmissionUnitService.GetBySubscriptionIdAsync(_selectedSubscriptionId, includeDefault: true);
            OnFilterChanged();

            if (_targetUnitId.HasValue)
            {
                var targetId = _targetUnitId.Value;
                var targetIndex = _filteredItems.FindIndex(x => x.Id == targetId);
                if (targetIndex >= 0)
                {
                    int effectivePageSize = (_grid != null && _grid.PageSize > 0) ? _grid.PageSize : _pageSize;
                    _activeGridPageIndex = targetIndex / effectivePageSize;
                    _pendingGoToPageIndex = _activeGridPageIndex;
                    NavigateToSelfState();
                }
                _targetUnitId = null;
            }
            else if (_activeGridPageIndex > 0)
            {
                _pendingGoToPageIndex = _activeGridPageIndex;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load emission units data.");
            NotificationService.Notify(NotificationSeverity.Error, "Data Error", "Failed to load emission units library.");
        }
        finally
        {
            _isLoading = false;
        }
        #endregion
    }

    private void OnFilterChanged()
    {
        #region hide [2026-08-17]
        var query = _allItems.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var q = _searchText.Trim();
            query = query.Where(x =>
                (!string.IsNullOrEmpty(x.Title) && x.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(x.Remark) && x.Remark.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }

        _filteredItems = query.ToList();
        _grid?.Reload();
        #endregion
    }

    private void OnGridPageChanged(PagerEventArgs args)
    {
        #region hide [2026-08-17]
        _activeGridPageIndex = args.PageIndex;
        NavigateToSelfState();
        #endregion
    }

    private async Task OnSubscriptionChanged(object value)
    {
        #region hide [2026-08-17]
        _selectedSubscriptionId = value as int?;
        _activeGridPageIndex = 0;
        UpdateCreatePermission();
        NavigateToSelfState();
        await LoadDataAsync();
        #endregion
    }

    private void NavigateToSelfState()
    {
        #region hide [2026-08-17]
        try
        {
            var queryParams = new Dictionary<string, object?>();

            if (_selectedSubscriptionId.HasValue)
                queryParams["sid"] = DataProtection.Protect(_selectedSubscriptionId.Value);

            if (_activeGridPageIndex > 0)
                queryParams["gpage"] = DataProtection.Protect(_activeGridPageIndex);

            if (!string.IsNullOrWhiteSpace(_searchText))
                queryParams["q"] = DataProtection.Protect(_searchText);

            var url = NavigationManager.GetUriWithQueryParameters("/library/emission-units", queryParams);
            NavigationManager.NavigateTo(url, replace: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating URL state in PageListEmissionUnit.");
        }
        #endregion
    }

    private async Task InsertRow()
    {
        #region hide [2026-08-17]
        if (_isAddDisabled || !_selectedSubscriptionId.HasValue) return;

        _isNewRow = true;
        _editingItemBackup = null;

        var newItem = new TbEmissionUnit
        {
            Title = string.Empty,
            Remark = string.Empty,
            SubscriptionId = _selectedSubscriptionId.Value,
            SourceType = eSourceType.Custom
        };

        _allItems.Add(newItem);
        _filteredItems.Add(newItem);

        if (_grid != null)
        {
            int effectivePageSize = _grid.PageSize > 0 ? _grid.PageSize : _pageSize;
            int lastPageIndex = Math.Max(0, (int)Math.Ceiling(_filteredItems.Count / (double)effectivePageSize) - 1);

            _activeGridPageIndex = lastPageIndex;
            NavigateToSelfState();

            if (_grid.CurrentPage != lastPageIndex)
            {
                await _grid.GoToPage(lastPageIndex);
            }

            await _grid.InsertRow(newItem);
        }
        #endregion
    }

    private async Task EditRow(TbEmissionUnit item)
    {
        #region hide [2026-08-17]
        _isNewRow = false;
        _editingItemBackup = new TbEmissionUnit
        {
            Title = item.Title,
            Remark = item.Remark
        };

        if (_grid != null)
        {
            await _grid.EditRow(item);
        }
        #endregion
    }

    private async Task SaveRow(TbEmissionUnit item)
    {
        #region hide [2026-08-17]
        if (string.IsNullOrWhiteSpace(item.Title))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Validation", "Unit title/symbol is required.");
            return;
        }

        if (_grid != null)
        {
            await _grid.UpdateRow(item);
        }
        #endregion
    }

    private async Task CancelEdit(TbEmissionUnit item)
    {
        #region hide [2026-08-17]
        if (_isNewRow)
        {
            _allItems.Remove(item);
            _filteredItems.Remove(item);
        }
        else if (_editingItemBackup != null)
        {
            item.Title = _editingItemBackup.Title;
            item.Remark = _editingItemBackup.Remark;
        }

        _isNewRow = false;
        _editingItemBackup = null;

        if (_grid != null)
        {
            _grid.CancelEditRow(item);
            await _grid.Reload();
        }
        #endregion
    }

    private async Task OnCreateRow(TbEmissionUnit item)
    {
        #region hide [2026-08-17]
        try
        {
            var created = await EmissionUnitService.CreateAsync(item);
            NotificationService.Notify(NotificationSeverity.Success, "Created", $"Emission unit '{item.Title}' created successfully.");
            _isNewRow = false;
            _editingItemBackup = null;
            _targetUnitId = created.Id;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating emission unit: {Title}", item.Title);
            NotificationService.Notify(NotificationSeverity.Error, "Create Error", ex.Message);
            _isNewRow = false;
            _allItems.Remove(item);
            _filteredItems.Remove(item);
            await LoadDataAsync();
        }
        #endregion
    }

    private async Task OnUpdateRow(TbEmissionUnit item)
    {
        #region hide [2026-08-17]
        try
        {
            var updated = await EmissionUnitService.UpdateAsync(item);
            NotificationService.Notify(NotificationSeverity.Success, "Updated", $"Emission unit '{updated.Title}' updated successfully.");
            _editingItemBackup = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating emission unit ID: {Id}", item.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Update Error", ex.Message);

            if (_editingItemBackup != null)
            {
                item.Title = _editingItemBackup.Title;
                item.Remark = _editingItemBackup.Remark;
            }
            _editingItemBackup = null;

            if (_grid != null)
            {
                _grid.CancelEditRow(item);
                await _grid.Reload();
            }
        }
        #endregion
    }

    private async Task OnDuplicate(TbEmissionUnit item)
    {
        #region hide [2026-08-17]
        try
        {
            if (item == null) return;

            if (!_selectedSubscriptionId.HasValue)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Duplication Restricted", "Please select a subscription first.");
                return;
            }

            var dup = TbEmissionUnit.Duplicate(item, _selectedSubscriptionId.Value);
            dup.Title = $"{item.Title}_Copy";

            var created = await EmissionUnitService.CreateAsync(dup);
            NotificationService.Notify(NotificationSeverity.Success, "Duplication Successful", $"Emission unit cloned as '{dup.Title}'.");
            _targetUnitId = created.Id;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error duplicating emission unit ID: {Id}", item.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Duplicate Error", ex.Message);
        }
        #endregion
    }

    private async Task ConfirmDelete(TbEmissionUnit item)
    {
        #region hide [2026-08-17]
        // [2026-09-24] Delete Protection: ตรวจสอบว่า Unit ถูกอ้างอิงโดย Emission Source หรือ Topic อยู่หรือไม่ (แสดงชื่อแรก + and others)
        var blockMessage = await EmissionUnitService.GetDeleteBlockMessageAsync(item.Id);
        if (blockMessage != null)
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Cannot Delete Unit",
                blockMessage,
                8000);
            return;
        }

        var confirmed = await DialogService.Confirm(
            "Are you sure you want to delete this emission unit?",
            "Delete Emission Unit",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                var success = await EmissionUnitService.DeleteAsync(item.Id);
                if (success)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Deleted", $"Emission unit '{item.Title}' deleted successfully.");
                    await LoadDataAsync();
                }
                else
                {
                    NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Emission unit could not be deleted.");
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting emission unit ID: {Id}", item.Id);
                NotificationService.Notify(NotificationSeverity.Error, "Delete Failed", ex.Message);
            }
        }
        #endregion
    }

    private bool CanExport => _isAdmin || (_selectedSubscriptionId.HasValue ? _editableSubscriptionIds.Contains(_selectedSubscriptionId.Value) : _editableSubscriptionIds.Count > 0);

    private async Task ExportToExcelAsync()
    {
        #region hide [2026-09-06]
        // [2026-09-19][Antigravity] Enforce edit permission check for exporting emission units
        if (!CanExport)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Access Denied", "Only users with edit permissions can export data.");
            return;
        }

        try
        {
            var contextName = _selectedSubscriptionId.HasValue
                ? (_subscriptionsList.FirstOrDefault(x => x.Id == _selectedSubscriptionId.Value)?.Title ?? string.Empty)
                : "All Subscriptions";

            var bytes = await ExcelService.ExportUnitsToExcelAsync(_filteredItems, contextName);
            var base64 = Convert.ToBase64String(bytes);
            // [2026-09-21][Gemini] Standard Export Filename: emission_units_{context}_{date}_{time}.xlsx
            var fileName = ExportFileNameHelper.Generate("emission_units", contextName);
            await JSRuntime.InvokeVoidAsync("saveAsFile", fileName, base64);
            NotificationService.Notify(NotificationSeverity.Success, "Export Successful", $"Exported {_filteredItems.Count} emission units to Excel.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export emission units to Excel.");
            NotificationService.Notify(NotificationSeverity.Error, "Export Failed", "Failed to generate Excel file.");
        }
        #endregion
    }

    private async Task OpenImportDialogAsync()
    {
        #region hide [2026-09-06]
        if (_isAddDisabled || !_selectedSubscriptionId.HasValue)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Subscription Required", "Please select a subscription workspace before importing.");
            return;
        }

        var parameters = new Dictionary<string, object>
        {
            { "SubscriptionId", _selectedSubscriptionId.Value }
        };

        var options = new DialogOptions
        {
            Width = "850px",
            Height = "auto",
            Resizable = true,
            Draggable = true
        };

        var result = await DialogService.OpenAsync<ImportEmissionUnitDialog>("Import Emission Units", parameters, options);
        if (result == true)
        {
            await LoadDataAsync();
            StateHasChanged();
        }
        #endregion
    }

    private async Task OnSplitButtonClick(RadzenSplitButtonItem args, TbEmissionUnit item)
    {
        #region hide [2026-08-17]
        if (args == null || args.Value == null)
        {
            bool isSystem = item.SourceType == eSourceType.Default;
            bool canEditItem = _isAdmin || (!isSystem && item.SubscriptionId.HasValue && _editableSubscriptionIds.Contains(item.SubscriptionId.Value));
            if (canEditItem)
            {
                await EditRow(item);
            }
            return;
        }

        switch (args.Value.ToString())
        {
            case "1":
                await OnDuplicate(item);
                break;
            case "2":
                await ConfirmDelete(item);
                break;
        }
        #endregion
    }
    #endregion
}
