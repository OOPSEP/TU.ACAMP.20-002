    private async Task ConfirmDeleteAsync(TbSubscription item)
    {
        #region hide [2026-08-15]
        if (item == null) return;

        var confirmed = await DialogService.Confirm(
            "Are you sure you want to delete this subscription?",
            "Delete Subscription",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                var success = await SubscriptionService.DeleteAsync(item.Id);
                if (success)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Deleted", $"Subscription '{item.Title}' deleted successfully.");
                    await LoadDataAsync();
                }
                else
                {
                    NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Subscription could not be deleted.");
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting subscription Id {Id}", item.Id);
                NotificationService.Notify(NotificationSeverity.Error, "Delete Failed", ex.Message);
            }
        }
        #endregion
    }
