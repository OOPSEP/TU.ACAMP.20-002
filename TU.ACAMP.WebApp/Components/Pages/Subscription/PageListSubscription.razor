@page "/subscriptions"
@page "/subscriptions/list"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.DataProtection
@using System.Security.Claims
@using TU.ACAMP.Domain.Enums
@using TU.ACAMP.Domain.Identity
@using TU.ACAMP.WebApp.Services.Common
@using TU.ACAMP.WebApp.Services.Identity
@using TU.ACAMP.WebApp.Components.Pages.Subscription.Widgets

@attribute [Authorize]
@inject SubscriptionService SubscriptionService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDataProtectionProvider DataProtection
@inject ILogger<PageListSubscription> Logger
@inject IWebHostEnvironment Env

<PageTitle>Subscription Management - ACAMP</PageTitle>

<div class="container-fluid py-3 px-4">
    <!-- Header Section -->
    <div class="row mb-4 align-items-center">
        <div class="col-12 col-md-7">
            <RadzenText Text="Subscription Management" TextStyle="TextStyle.H5" TagName="TagName.H1" class="fw-bold mb-1" Style="color: var(--rz-text-title-color);" />
            <RadzenText Text="Manage multi-tenant tenant accounts, active plans, resource quotas, and billing details." TextStyle="TextStyle.Body2" class="text-muted mb-0" />
        </div>
        @if (_isAdmin || _isSubscriptionManager)
        {
            <div class="col-12 col-md-5 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end gap-2 flex-wrap">
                @if (_isAdmin)
                {
                    <RadzenButton Text="Audit Trail" Icon="history" ButtonStyle="ButtonStyle.Info" Variant="Variant.Outlined" Size="ButtonSize.Medium" Click="@OpenAuditTrailDialogAsync" Style="border-radius: 8px;" Title="View subscription audit trail logs" />
                }
                <RadzenButton Text="Create Subscription" Icon="add_circle" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium" Click="@NavigateToAdd" Style="border-radius: 8px; font-weight: 600;" />
            </div>
        }
    </div>

    <!-- [2026-09-13][Antigravity] Filters & Search Toolbar with .acamp-filter-bar and spring search -->
    <RadzenCard Class="mb-4 p-3 shadow-sm" Style="border-radius: 12px; border: 1px solid var(--rz-border-color); background: var(--rz-card-background-color);">
        <div class="acamp-filter-bar justify-content-between">
            <div class="acamp-filter-search">
                <RadzenFormField Text="Search Subscriptions">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="@_searchQuery" @bind-Value:after="@FilterSubscriptions" Placeholder="Search by title, tax ID, owner/user email, contact..." Style="width: 100%;" />
                    </ChildContent>
                    <Start>
                        <RadzenIcon Icon="search" />
                    </Start>
                </RadzenFormField>
            </div>
            <div class="d-flex align-items-end gap-2 flex-wrap ms-auto flex-shrink-0">
                <RadzenFormField Text="Status Filter" Style="width: 170px;">
                    <RadzenDropDown TValue="string"
                                    Data="@_statusFilterOptions"
                                    @bind-Value="@_selectedStatusFilter"
                                    @bind-Value:after="@FilterSubscriptions" />
                </RadzenFormField>
                <RadzenFormField Text="Plan Filter" Style="width: 170px;">
                    <RadzenDropDown TValue="string"
                                    Data="@_planFilterOptions"
                                    @bind-Value="@_selectedPlanFilter"
                                    @bind-Value:after="@FilterSubscriptions" />
                </RadzenFormField>
                @* [2026-09-28][Claude] แสดง Subscription ที่ถูกลบ (Soft Delete) ร่วมด้วย — เฉพาะ Admin / Subscription Manager *@
                @if (_isAdmin || _isSubscriptionManager)
                {
                    <div class="d-flex align-items-center gap-2 pb-2">
                        <RadzenSwitch @bind-Value="@_showDeleted" @bind-Value:after="@OnShowDeletedChangedAsync" Name="showDeletedSwitch" />
                        <RadzenLabel Text="Show Deleted" Component="showDeletedSwitch" class="text-muted small mb-0" />
                    </div>
                }
            </div>
        </div>
    </RadzenCard>

    <!-- DataGrid Container -->
    @if (_isLoading)
    {
        <div class="py-5 text-center">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <RadzenText Text="Loading subscriptions..." TextStyle="TextStyle.Body2" class="text-muted mt-2" />
        </div>
    }
    else
    {
        <div class="shadow-sm rounded-3 p-3" style="background-color: var(--rz-card-background-color); border: 1px solid var(--rz-border-color); border-radius: 12px;">
            @if (!_filteredItems.Any())
            {
                <div class="p-5 text-center text-muted">
                    <RadzenIcon Icon="inbox" Style="font-size: 48px; opacity: 0.5;" class="mb-2" />
                    <RadzenText Text="No subscriptions found matching the selected filters." TextStyle="TextStyle.Body1" class="text-muted mb-0" />
                </div>
            }
            else
            {
                <RadzenDataGrid @ref="_grid" Data="@_filteredItems" TItem="TbSubscription"
                                AllowColumnResize="true"
                                AllowPaging="true" PageSize="@_pageSize" PageSizeOptions="@_pageSizeOptions"
                                AllowSorting="true" ColumnWidth="180px" PagerHorizontalAlign="HorizontalAlign.Right" ShowPagingSummary="true"
                                Style="@GridStyles.Default"
                                Page="@OnPageChanged"
                                RowRender="@OnRowRender"
                                RowDoubleClick="@((DataGridRowMouseEventArgs<TbSubscription> args) => OnRowDoubleClick(args.Data))">
                    <Columns>
                        @if (Env.IsDevelopment() || _isAdmin)
                        {
                            <RadzenDataGridColumn TItem="TbSubscription" Property="Id" Title="ID" Width="60px" TextAlign="TextAlign.Center" />
                        }

                        <RadzenDataGridColumn TItem="TbSubscription" Title="#" Width="55px" TextAlign="TextAlign.Center" Sortable="false">
                            <Template Context="item">
                                @(_filteredItems.IndexOf(item) + 1)
                            </Template>
                        </RadzenDataGridColumn>

                        <!-- Subscription Title & Tax ID -->
                        <RadzenDataGridColumn TItem="TbSubscription" Title="Subscription / Tenant" Property="Title" MinWidth="240px">
                            <Template Context="item">
                                <div>
                                    @if (item.IsDeleted)
                                    {
                                        <RadzenText Text="@item.Title" TextStyle="TextStyle.Subtitle1" class="fw-bold text-muted mb-0 text-decoration-line-through" />
                                    }
                                    else
                                    {
                                        <RadzenText Text="@item.Title" TextStyle="TextStyle.Subtitle1" class="fw-bold text-primary mb-0 cursor-pointer" @onclick="@(() => NavigateToView(item))" />
                                    }
                                    <div class="d-flex align-items-center gap-2 mt-1">
                                        <span class="text-muted small">Tax ID: <b>@(string.IsNullOrEmpty(item.TaxId) ? "-" : item.TaxId)</b></span>
                                        <RadzenBadge Text="@item.OwnerType.ToString()" BadgeStyle="BadgeStyle.Light" IsPill="true" Style="font-size: 0.7rem;" />
                                    </div>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <!-- Plan Tier -->
                        <RadzenDataGridColumn TItem="TbSubscription" Title="Plan Tier" Width="140px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <RadzenBadge Text="@item.SubscriptionPlan.ToString()" BadgeStyle="@GetPlanBadgeStyle(item.SubscriptionPlan)" IsPill="true" Style="font-weight: 700; padding: 6px 12px;" />
                            </Template>
                        </RadzenDataGridColumn>

                        <!-- Contact & Owner Email -->
                        <RadzenDataGridColumn TItem="TbSubscription" Title="Owner & Contact" MinWidth="220px">
                            <Template Context="item">
                                <div class="d-flex flex-column gap-1 small">
                                    @if (!string.IsNullOrEmpty(item.OwnerName))
                                    {
                                        <span class="text-dark fw-medium">
                                            <RadzenIcon Icon="person" Style="font-size: 0.9rem;" class="me-1 text-muted" />@item.OwnerName
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.OwnerEmail))
                                    {
                                        <span class="text-muted">
                                            <RadzenIcon Icon="email" Style="font-size: 0.9rem;" class="me-1 text-muted" />@item.OwnerEmail
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.OwnerPhone))
                                    {
                                        <span class="text-muted">
                                            <RadzenIcon Icon="phone" Style="font-size: 0.9rem;" class="me-1 text-muted" />@item.OwnerPhone
                                        </span>
                                    }
                                    @if (item.Users != null && item.Users.Any())
                                    {
                                        var subUserEmails = item.Users.Where(u => !u.IsDeleted && u.Email != item.OwnerEmail && !string.IsNullOrEmpty(u.Email)).Select(u => u.Email).ToList();
                                        if (subUserEmails.Any())
                                        {
                                            <div class="text-muted mt-1 pt-1 border-top" style="font-size: 0.75rem;">
                                                <RadzenIcon Icon="group" Style="font-size: 0.8rem;" class="me-1 text-secondary" />
                                                <span>Users: @string.Join(", ", subUserEmails.Take(2))@(subUserEmails.Count > 2 ? $" (+{subUserEmails.Count - 2})" : "")</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <!-- Quota Summary -->
                        <RadzenDataGridColumn TItem="TbSubscription" Title="Resource Quotas" MinWidth="220px" Sortable="false">
                            <Template Context="item">
                                <div class="d-flex flex-column gap-1 small">
                                    <div class="d-flex justify-content-between text-muted">
                                        <span><RadzenIcon Icon="corporate_fare" Style="font-size: 0.9rem;" class="me-1 text-primary" />Corporates:</span>
                                        <b>@(item.Corporates?.Count ?? 0) / @item.AllowCorporateCount</b>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted">
                                        <span><RadzenIcon Icon="domain" Style="font-size: 0.9rem;" class="me-1 text-info" />Companies:</span>
                                        <b>@item.AllowCompanyCount max</b>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted">
                                        <span><RadzenIcon Icon="factory" Style="font-size: 0.9rem;" class="me-1 text-success" />Facilities:</span>
                                        <b>@item.AllowFacilityCount max</b>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted">
                                        <span><RadzenIcon Icon="people" Style="font-size: 0.9rem;" class="me-1 text-warning" />Users:</span>
                                        <b>@(item.Users?.Count ?? 0) / @item.AllowUserCount</b>
                                    </div>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <!-- Validity & Status -->
                        <RadzenDataGridColumn TItem="TbSubscription" Title="Status & Validity" Width="170px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <div>
                                    @if (item.IsDeleted)
                                    {
                                        <RadzenBadge Text="Deleted" BadgeStyle="BadgeStyle.Dark" IsPill="true" class="mb-1" />
                                        @if (item.DeletedAt.HasValue)
                                        {
                                            <div class="small text-muted mt-1">
                                                Deleted: @item.DeletedAt.Value.ToString("dd/MM/yyyy")
                                            </div>
                                        }
                                    }
                                    else if (!item.IsActive)
                                    {
                                        <RadzenBadge Text="Inactive" BadgeStyle="BadgeStyle.Secondary" IsPill="true" class="mb-1" />
                                    }
                                    else if (item.IsExpired)
                                    {
                                        <RadzenBadge Text="Expired" BadgeStyle="BadgeStyle.Danger" IsPill="true" class="mb-1" />
                                    }
                                    else
                                    {
                                        <RadzenBadge Text="Active" BadgeStyle="BadgeStyle.Success" IsPill="true" class="mb-1" />
                                    }

                                    @if (!item.IsDeleted)
                                    {
                                        <div class="small text-muted mt-1">
                                            Expires: @item.ExpiryDate.ToString("dd/MM/yyyy")
                                        </div>
                                    }
                                    @if (!item.IsDeleted && item.IsActive && !item.IsExpired)
                                    {
                                        var daysLeft = (int)item.GetRemainingDays();
                                        <span class="badge bg-light text-primary border mt-1 small" style="font-size: 0.7rem;">
                                            @daysLeft days left
                                        </span>
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <!-- Action Buttons -->
                        <RadzenDataGridColumn TItem="TbSubscription" Title="Actions" Width="145px" TextAlign="TextAlign.Center" Sortable="false">
                            <Template Context="item">
                                @* [2026-09-28][Claude] รายการที่ถูกลบแล้วไม่มีปุ่ม View / Edit / Delete (GetByIdAsync ไม่คืน Subscription ที่ถูกลบ) *@
                                @if (item.IsDeleted)
                                {
                                    <span class="text-muted small">-</span>
                                }
                                else
                                {
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.25rem">
                                    <RadzenButton Icon="visibility"
                                                  ButtonStyle="ButtonStyle.Info"
                                                  Variant="Variant.Outlined"
                                                  Size="ButtonSize.Small"
                                                  Click="@(() => NavigateToView(item))"
                                                  title="View Subscription"
                                                  Style="border-radius: 6px;" />
                                    @if (_isAdmin || _editableSubscriptionIds.Contains(item.Id))
                                    {
                                        <RadzenButton Icon="edit"
                                                      ButtonStyle="ButtonStyle.Primary"
                                                      Variant="Variant.Outlined"
                                                      Size="ButtonSize.Small"
                                                      Click="@(() => NavigateToEdit(item))"
                                                      title="Edit Subscription"
                                                      Style="border-radius: 6px;" />
                                    }
                                    @if (_isAdmin)
                                    {
                                        <RadzenButton Icon="delete"
                                                      ButtonStyle="ButtonStyle.Danger"
                                                      Variant="Variant.Outlined"
                                                      Size="ButtonSize.Small"
                                                      Click="@(() => ConfirmDeleteAsync(item))"
                                                      title="Delete Subscription"
                                                      Style="border-radius: 6px;" />
                                    }
                                </RadzenStack>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </div>
    }
</div>

@code {
    #region class field
    private RadzenDataGrid<TbSubscription>? _grid;
    private List<TbSubscription> _allItems = new();
    private List<TbSubscription> _filteredItems = new();

    private string _searchQuery = string.Empty;
    private string _selectedStatusFilter = "All Statuses";
    private string _selectedPlanFilter = "All Plans";
    private bool _isLoading = true;
    private bool _showDeleted = false;
    private bool _isAdmin = false;
    private bool _isSubscriptionManager = false;
    private string _currentUserEmail = string.Empty;
    private HashSet<int> _editableSubscriptionIds = new();
    private int _currentPageIndex = 0;

    private int _pageSize = 10;
    private IEnumerable<int> _pageSizeOptions = new[] { 10, 25, 50 };

    private readonly List<string> _statusFilterOptions = new() { "All Statuses", "Active Only", "Inactive / Expired" };
    private readonly List<string> _planFilterOptions = new() { "All Plans", "Basic", "Pro", "Premium", "Enterprise" };
    #endregion

    #region class properties
    [SupplyParameterFromQuery(Name = "q")]
    public string? SecureQuerySearch { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? SecureQueryStatus { get; set; }

    [SupplyParameterFromQuery(Name = "plan")]
    public string? SecureQueryPlan { get; set; }

    [SupplyParameterFromQuery(Name = "deleted")]
    public string? SecureQueryShowDeleted { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public string? SecureQueryPageIndex { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public string? SecureQueryPageSize { get; set; }

    [SupplyParameterFromQuery(Name = "ret")]
    public string? SecureQueryReturnUrl { get; set; }
    #endregion

    #region class methods
    protected override async Task OnInitializedAsync()
    {
        #region hide [2026-08-15]
        await CheckUserRoleAsync();
        // [2026-09-28][Claude] อ่านสถานะ Show Deleted จาก query ก่อนโหลดข้อมูล เพื่อไม่ต้องโหลดซ้ำ
        _showDeleted = DataProtection.UnprotectInt(SecureQueryShowDeleted) == 1;
        await LoadDataAsync();
        #endregion
    }

    protected override async Task OnParametersSetAsync()
    {
        #region hide [2026-08-15]
        var stateChanged = false;

        var decryptedSearch = DataProtection.Unprotect(SecureQuerySearch) ?? string.Empty;
        if (!string.IsNullOrEmpty(decryptedSearch) && _searchQuery != decryptedSearch)
        {
            _searchQuery = decryptedSearch;
            stateChanged = true;
        }

        var decryptedStatus = DataProtection.Unprotect(SecureQueryStatus) ?? "All Statuses";
        if (!string.IsNullOrEmpty(decryptedStatus) && _selectedStatusFilter != decryptedStatus)
        {
            _selectedStatusFilter = decryptedStatus;
            stateChanged = true;
        }

        var decryptedPlan = DataProtection.Unprotect(SecureQueryPlan) ?? "All Plans";
        if (!string.IsNullOrEmpty(decryptedPlan) && _selectedPlanFilter != decryptedPlan)
        {
            _selectedPlanFilter = decryptedPlan;
            stateChanged = true;
        }

        var decryptedPageSize = DataProtection.UnprotectInt(SecureQueryPageSize);
        if (decryptedPageSize.HasValue && decryptedPageSize.Value > 0 && _pageSize != decryptedPageSize.Value)
        {
            _pageSize = decryptedPageSize.Value;
            stateChanged = true;
        }

        var decryptedPageIndex = DataProtection.UnprotectInt(SecureQueryPageIndex);
        if (decryptedPageIndex.HasValue && decryptedPageIndex.Value >= 0)
        {
            _currentPageIndex = decryptedPageIndex.Value;
        }

        // [2026-09-28][Claude] Show Deleted เปลี่ยนต้องโหลดข้อมูลจาก DB ใหม่ (ไม่ใช่แค่กรองในหน่วยความจำ)
        var decryptedShowDeleted = DataProtection.UnprotectInt(SecureQueryShowDeleted) == 1;
        if (_showDeleted != decryptedShowDeleted)
        {
            _showDeleted = decryptedShowDeleted;
            await LoadDataAsync();
        }
        else if (stateChanged && _allItems.Any())
        {
            FilterSubscriptions();
        }

        await base.OnParametersSetAsync();
        #endregion
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        #region hide [2026-08-15]
        if (firstRender && _currentPageIndex > 0 && _grid != null)
        {
            try
            {
                await _grid.GoToPage(_currentPageIndex);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error restoring grid page index to {PageIndex} in PageListSubscription.", _currentPageIndex);
            }
        }
        await base.OnAfterRenderAsync(firstRender);
        #endregion
    }

    private void OnPageChanged(PagerEventArgs args)
    {
        #region hide [2026-08-15]
        _currentPageIndex = args.PageIndex;
        #endregion
    }

    private void OnRowDoubleClick(TbSubscription item)
    {
        #region hide [2026-08-15]
        if (item == null || item.IsDeleted) return;
        if (_isAdmin || _editableSubscriptionIds.Contains(item.Id))
        {
            NavigateToEdit(item);
        }
        else
        {
            NavigateToView(item);
        }
        #endregion
    }

    private async Task CheckUserRoleAsync()
    {
        #region hide [2026-08-15]
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                _currentUserEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? (user.Identity.Name ?? string.Empty);
                _isAdmin = user.IsInRole(SystemRoles.Administrator);
                _isSubscriptionManager = user.IsInRole(SystemRoles.SubscriptionManager);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to check user role in PageListSubscription.");
        }
        #endregion
    }

    private async Task LoadDataAsync()
    {
        #region hide [2026-08-15]
        _isLoading = true;
        try
        {
            _allItems = await SubscriptionService.GetSubscriptionsForUserAsync(
                _currentUserEmail,
                isAdmin: _isAdmin,
                isSubscriptionManager: _isSubscriptionManager,
                includeUsers: true,
                includeCorporates: true,
                includeInactive: true,
                includeDeleted: _showDeleted && (_isAdmin || _isSubscriptionManager));

            _editableSubscriptionIds = await SubscriptionService.GetEditableSubscriptionIdsAsync(_currentUserEmail, _isAdmin, _isSubscriptionManager);

            FilterSubscriptions();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load subscriptions in PageListSubscription.");
            NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to load subscription list.");
        }
        finally
        {
            _isLoading = false;
        }
        #endregion
    }

    private void FilterSubscriptions()
    {
        #region hide [2026-08-15]
        var result = _allItems.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var q = _searchQuery.Trim();
            result = result.Where(s =>
                (!string.IsNullOrEmpty(s.Title) && s.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(s.TaxId) && s.TaxId.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(s.OwnerEmail) && s.OwnerEmail.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(s.OwnerName) && s.OwnerName.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(s.ContactPerson) && s.ContactPerson.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (s.Users != null && s.Users.Any(u => !u.IsDeleted && !string.IsNullOrEmpty(u.Email) && u.Email.Contains(q, StringComparison.OrdinalIgnoreCase))));
        }

        if (_selectedStatusFilter == "Active Only")
        {
            result = result.Where(s => s.IsActive && !s.IsExpired);
        }
        else if (_selectedStatusFilter == "Inactive / Expired")
        {
            result = result.Where(s => !s.IsActive || s.IsExpired);
        }

        if (!string.IsNullOrEmpty(_selectedPlanFilter) && _selectedPlanFilter != "All Plans")
        {
            result = result.Where(s => s.SubscriptionPlan.ToString().Equals(_selectedPlanFilter, StringComparison.OrdinalIgnoreCase));
        }

        _filteredItems = result.ToList();
        #endregion
    }

    /// <summary>
    /// [2026-09-28][Claude] เปิด/ปิดการแสดง Subscription ที่ถูกลบ — โหลดข้อมูลใหม่จาก DB และกลับไปหน้าแรกของ Grid
    /// </summary>
    private async Task OnShowDeletedChangedAsync()
    {
        #region hide [2026-09-28]
        _currentPageIndex = 0;
        await LoadDataAsync();
        #endregion
    }

    /// <summary>
    /// [2026-09-28][Claude] แถวที่ถูกลบแสดงแบบจางเพื่อแยกจากรายการปกติ
    /// </summary>
    private void OnRowRender(RowRenderEventArgs<TbSubscription> args)
    {
        #region hide [2026-09-28]
        if (args.Data != null && args.Data.IsDeleted)
        {
            args.Attributes["style"] = "opacity: 0.6;";
        }
        #endregion
    }

    private BadgeStyle GetPlanBadgeStyle(eSubscriptionPlan plan)
    {
        #region hide [2026-08-15]
        return plan switch
        {
            eSubscriptionPlan.Basic => BadgeStyle.Secondary,
            eSubscriptionPlan.Pro => BadgeStyle.Primary,
            eSubscriptionPlan.Premium => BadgeStyle.Warning,
            eSubscriptionPlan.Enterprise => BadgeStyle.Danger,
            _ => BadgeStyle.Light
        };
        #endregion
    }

    private string GetCurrentPageStateUrl()
    {
        #region hide [2026-08-15]
        var queryParams = new Dictionary<string, object?>();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
            queryParams["q"] = DataProtection.Protect(_searchQuery);

        if (!string.IsNullOrWhiteSpace(_selectedStatusFilter) && _selectedStatusFilter != "All Statuses")
            queryParams["status"] = DataProtection.Protect(_selectedStatusFilter);

        if (!string.IsNullOrWhiteSpace(_selectedPlanFilter) && _selectedPlanFilter != "All Plans")
            queryParams["plan"] = DataProtection.Protect(_selectedPlanFilter);

        if (_showDeleted)
            queryParams["deleted"] = DataProtection.Protect(1);

        if (_currentPageIndex > 0)
            queryParams["page"] = DataProtection.Protect(_currentPageIndex);

        if (_pageSize != 10)
            queryParams["pageSize"] = DataProtection.Protect(_pageSize);

        return NavigationManager.GetUriWithQueryParameters("/subscriptions/list", queryParams);
        #endregion
    }

    private void NavigateToAdd()
    {
        #region hide [2026-08-15]
        if (!_isAdmin && !_isSubscriptionManager)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Access Denied", "Only system administrators and subscription managers can create subscriptions.");
            return;
        }
        var returnUrl = GetCurrentPageStateUrl();
        var secureRet = DataProtection.Protect(returnUrl);
