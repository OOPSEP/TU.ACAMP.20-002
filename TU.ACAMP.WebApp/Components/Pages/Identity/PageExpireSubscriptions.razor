@page "/admin/expire-subscriptions"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.DataProtection
@using TU.ACAMP.Domain.Enums
@using TU.ACAMP.Domain.Identity
@using TU.ACAMP.WebApp.Constants
@using TU.ACAMP.WebApp.Services.Common
@using TU.ACAMP.WebApp.Services.Identity
@using TU.ACAMP.WebApp.Components.Pages.Identity.Widgets

@attribute [Authorize(Roles = SystemRoles.Administrator)]
@inject SubscriptionService SubscriptionService
@inject EmailSender EmailSender
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject IDataProtectionProvider DataProtection
@inject ILogger<PageExpireSubscriptions> Logger
@inject IWebHostEnvironment Env
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Expire Subscriptions - ACAMP</PageTitle>

<div class="container-fluid py-3 px-4">
    <!-- Header Section -->
    <div class="row mb-4 align-items-center">
        <div class="col-12 col-md-7">
            <RadzenText Text="Expire Subscriptions" TextStyle="TextStyle.H5" TagName="TagName.H1" class="fw-bold mb-1" Style="color: var(--rz-text-title-color);" />
            <RadzenText Text="Monitor expiring and expired tenant subscriptions, send notification reminders, and extend validity periods." TextStyle="TextStyle.Body2" class="text-muted mb-0" />
        </div>
        <div class="col-12 col-md-5 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end gap-2 flex-wrap">
            <RadzenButton Text="Reload" 
                          Icon="refresh" 
                          ButtonStyle="ButtonStyle.Light" 
                          Size="ButtonSize.Medium" 
                          Click="@LoadDataAsync" 
                          IsBusy="@_isLoading" 
                          Disabled="@_isBatchProcessing"
                          Style="border-radius: 8px;" 
                          Title="Reload subscription records" />
            <RadzenButton Text="Send Reminders (Filtered)" 
                          Icon="forward_to_inbox" 
                          ButtonStyle="ButtonStyle.Warning" 
                          Size="ButtonSize.Medium" 
                          Click="@BatchSendRemindersHandlerAsync" 
                          IsBusy="@_isBatchProcessing" 
                          Disabled="@(_isBatchProcessing || _isLoading || !_filteredItems.Any(s => s.ExpiryDate <= DateTime.UtcNow.AddDays(30)))" 
                          Style="border-radius: 8px; font-weight: 600;" 
                          Title="Send expiration reminder emails to all expiring or expired subscriptions in current filter" />
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <RadzenCard Class="p-3 shadow-sm" Style="border-radius: 12px; border: 1px solid var(--rz-border-color); background: var(--rz-card-background-color);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <RadzenText TextStyle="TextStyle.Caption" class="text-muted fw-bold">TOTAL SUBSCRIPTIONS</RadzenText>
                        <RadzenText TextStyle="TextStyle.H4" class="fw-bold mb-0 text-dark">@_allItems.Count</RadzenText>
                    </div>
                    <RadzenIcon Icon="card_membership" Style="font-size: 2.2rem;" class="text-primary opacity-75" />
                </div>
            </RadzenCard>
        </div>

        <div class="col-md-3 col-sm-6">
            <RadzenCard Class="p-3 shadow-sm" Style="border-radius: 12px; border: 1px solid var(--rz-border-color); background: var(--rz-card-background-color);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <RadzenText TextStyle="TextStyle.Caption" class="text-muted fw-bold">ACTIVE & VALID</RadzenText>
                        <RadzenText TextStyle="TextStyle.H4" class="fw-bold mb-0 text-success">@_allItems.Count(s => s.IsActive && s.ExpiryDate > DateTime.UtcNow.AddDays(30))</RadzenText>
                    </div>
                    <RadzenIcon Icon="check_circle" Style="font-size: 2.2rem;" class="text-success opacity-75" />
                </div>
            </RadzenCard>
        </div>

        <div class="col-md-3 col-sm-6">
            <RadzenCard Class="p-3 shadow-sm" Style="border-radius: 12px; border: 1px solid var(--rz-border-color); background: var(--rz-card-background-color);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <RadzenText TextStyle="TextStyle.Caption" class="text-muted fw-bold">EXPIRING IN 30 DAYS</RadzenText>
                        <RadzenText TextStyle="TextStyle.H4" class="fw-bold mb-0 text-warning">@_allItems.Count(s => s.ExpiryDate > DateTime.UtcNow && s.ExpiryDate <= DateTime.UtcNow.AddDays(30))</RadzenText>
                    </div>
                    <RadzenIcon Icon="timelapse" Style="font-size: 2.2rem;" class="text-warning opacity-75" />
                </div>
            </RadzenCard>
        </div>

        <div class="col-md-3 col-sm-6">
            <RadzenCard Class="p-3 shadow-sm" Style="border-radius: 12px; border: 1px solid var(--rz-border-color); background: var(--rz-card-background-color);">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <RadzenText TextStyle="TextStyle.Caption" class="text-muted fw-bold">EXPIRED</RadzenText>
                        <RadzenText TextStyle="TextStyle.H4" class="fw-bold mb-0 text-danger">@_allItems.Count(s => s.ExpiryDate <= DateTime.UtcNow)</RadzenText>
                    </div>
                    <RadzenIcon Icon="event_busy" Style="font-size: 2.2rem;" class="text-danger opacity-75" />
                </div>
            </RadzenCard>
        </div>
    </div>

    <!-- Batch Progress Indicator -->
    @if (_isBatchProcessing)
    {
        <RadzenCard Class="mb-4 p-3 shadow-sm" Style="border-radius: 12px; border-left: 5px solid var(--rz-warning); background: var(--rz-card-background-color);">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex align-items-center gap-2">
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" />
                    <span class="fw-bold text-warning">@_batchProgressMessage</span>
                </div>
                <span class="text-muted small">@_processedCount / @_totalToProcess (@Math.Round(_batchPercentage)% )</span>
            </div>
            <RadzenProgressBar Value="@_batchPercentage" Max="100" ShowValue="false" Style="height: 6px; border-radius: 3px;" />
        </RadzenCard>
    }

    <!-- [2026-09-13][Antigravity] Search & Filter Controls with .acamp-filter-bar and spring search -->
    <RadzenCard Class="mb-4 p-3 shadow-sm" Style="border-radius: 12px; border: 1px solid var(--rz-border-color); background: var(--rz-card-background-color);">
        <div class="acamp-filter-bar justify-content-between">
            <div class="acamp-filter-search">
                <RadzenFormField Text="Search Subscriptions">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="@_searchQuery" @bind-Value:after="@ApplyFilter" Placeholder="Search by title, Tax ID, owner name, email..." Style="width: 100%;" />
                    </ChildContent>
                    <Start>
                        <RadzenIcon Icon="search" />
                    </Start>
                </RadzenFormField>
            </div>
            <div class="d-flex align-items-end gap-2 flex-wrap ms-auto flex-shrink-0">
                <RadzenFormField Text="Expiry Status Filter" Style="width: 180px;">
                    <RadzenDropDown TValue="string"
                                    Data="@_expiryFilterOptions"
                                    @bind-Value="@_selectedExpiryFilter"
                                    @bind-Value:after="@ApplyFilter" />
                </RadzenFormField>
                <RadzenFormField Text="Plan Filter" Style="width: 170px;">
                    <RadzenDropDown TValue="string"
                                    Data="@_planFilterOptions"
                                    @bind-Value="@_selectedPlanFilter"
                                    @bind-Value:after="@ApplyFilter" />
                </RadzenFormField>
            </div>
        </div>
    </RadzenCard>

    <!-- DataGrid Section -->
    @if (_isLoading)
    {
        <div class="py-5 text-center">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <RadzenText Text="Loading subscriptions..." TextStyle="TextStyle.Body2" class="text-muted mt-2" />
        </div>
    }
    else
    {
        <div class="shadow-sm rounded-3 p-3" style="background-color: var(--rz-card-background-color); border: 1px solid var(--rz-border-color); border-radius: 12px;">
            @if (!_filteredItems.Any())
            {
                <div class="p-5 text-center text-muted">
                    <RadzenIcon Icon="inbox" Style="font-size: 48px; opacity: 0.5;" class="mb-2" />
                    <RadzenText Text="No subscriptions match the selected criteria." TextStyle="TextStyle.Body1" class="text-muted mb-0" />
                </div>
            }
            else
            {
                <RadzenDataGrid @ref="_grid" Data="@_filteredItems" TItem="TbSubscription"
                                AllowColumnResize="true"
                                AllowPaging="true" PageSize="@_pageSize" PageSizeOptions="@_pageSizeOptions"
                                AllowSorting="true" ColumnWidth="180px" PagerHorizontalAlign="HorizontalAlign.Right" ShowPagingSummary="true"
                                RowDoubleClick="@((DataGridRowMouseEventArgs<TbSubscription> args) => NavigateToExtend(args.Data.Id))"
                                Style="@GridStyles.Default">
                    <Columns>
                        @if (Env.IsDevelopment() || _isAdmin)
                        {
                            <RadzenDataGridColumn TItem="TbSubscription" Property="Id" Title="ID" Width="60px" TextAlign="TextAlign.Center" />
                        }

                        <RadzenDataGridColumn TItem="TbSubscription" Title="#" Width="50px" TextAlign="TextAlign.Center" Sortable="false">
                            <Template Context="item">
                                @(_filteredItems.IndexOf(item) + 1)
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="TbSubscription" Property="Title" Title="Subscription / Plan" Width="260px">
                            <Template Context="item">
                                <div class="d-flex flex-column">
                                    <span class="fw-bold" style="color: var(--rz-text-title-color);">@item.Title</span>
                                    <div class="mt-1 d-flex gap-1 align-items-center">
                                        <RadzenBadge Text="@item.SubscriptionPlan.ToString()" BadgeStyle="@GetPlanBadgeStyle(item.SubscriptionPlan)" Style="font-size: 0.7rem; border-radius: 4px;" />
                                        @if (item.OwnerType == eSubscriptionOwnerType.Juristic)
                                        {
                                            <span class="badge bg-light text-secondary border" style="font-size: 0.65rem;">Juristic</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border" style="font-size: 0.65rem;">Individual</span>
                                        }
                                    </div>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="TbSubscription" Property="TaxId" Title="Tax ID" Width="140px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <span class="font-monospace small">@(string.IsNullOrWhiteSpace(item.TaxId) ? "-" : item.TaxId)</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="TbSubscription" Property="OwnerEmail" Title="Contact / Owner" Width="220px">
                            <Template Context="item">
                                <div class="d-flex flex-column">
                                    <span class="fw-semibold small">@(!string.IsNullOrWhiteSpace(item.OwnerName) ? item.OwnerName : item.ContactPerson)</span>
                                    <span class="text-muted small">@item.OwnerEmail</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="TbSubscription" Property="StartDate" Title="Start Date" Width="110px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <span class="small">@item.StartDate.ToString("yyyy-MM-dd")</span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="TbSubscription" Property="ExpiryDate" Title="Expiry Date" Width="170px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                @{
                                    var remaining = Math.Ceiling(item.GetRemainingDays());
                                    var isExpired = item.ExpiryDate <= DateTime.UtcNow;
                                    var isExpiringSoon = !isExpired && remaining <= 30;
                                }
                                <div class="d-flex flex-column align-items-center">
                                    <span class="fw-bold small @(isExpired ? "text-danger" : (isExpiringSoon ? "text-warning" : "text-success"))">
                                        @item.ExpiryDate.ToString("yyyy-MM-dd")
                                    </span>
                                    @if (isExpired)
                                    {
                                        <RadzenBadge Text="Expired" BadgeStyle="BadgeStyle.Danger" Style="font-size: 0.65rem; border-radius: 4px;" />
                                    }
                                    else if (isExpiringSoon)
                                    {
                                        <RadzenBadge Text="@($"{remaining} days left")" BadgeStyle="BadgeStyle.Warning" Style="font-size: 0.65rem; border-radius: 4px;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 0.7rem;">@($"{remaining} days left")</span>
                                    }
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="TbSubscription" Property="IsActive" Title="Status" Width="100px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                @if (item.IsActive && item.ExpiryDate > DateTime.UtcNow)
                                {
                                    <RadzenBadge Text="Active" BadgeStyle="BadgeStyle.Success" Style="border-radius: 4px;" />
                                }
                                else if (item.IsActive && item.ExpiryDate <= DateTime.UtcNow)
                                {
                                    <RadzenBadge Text="Expired" BadgeStyle="BadgeStyle.Danger" Style="border-radius: 4px;" />
                                }
                                else
                                {
                                    <RadzenBadge Text="Inactive" BadgeStyle="BadgeStyle.Light" Style="border-radius: 4px;" />
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="TbSubscription" Title="Actions" Width="180px" TextAlign="TextAlign.Center" Sortable="false">
                            <Template Context="item">
                                <div class="d-flex justify-content-center gap-1">
                                    <RadzenButton Icon="update" 
                                                  ButtonStyle="ButtonStyle.Success" 
                                                  Shade="Shade.Lighter" 
                                                  Size="ButtonSize.Small" 
                                                  Click="@(() => NavigateToExtend(item.Id))" 
                                                  Title="Extend / Renew validity" />
                                    <RadzenButton Icon="mail" 
                                                  ButtonStyle="ButtonStyle.Warning" 
                                                  Shade="Shade.Lighter" 
                                                  Size="ButtonSize.Small" 
                                                  Click="@(() => SendSingleReminderAsync(item))" 
                                                  Title="Send expiration reminder email" />
                                    <RadzenButton Icon="@(item.IsActive ? "toggle_on" : "toggle_off")" 
                                                  ButtonStyle="@(item.IsActive ? ButtonStyle.Secondary : ButtonStyle.Light)" 
                                                  Shade="Shade.Lighter" 
                                                  Size="ButtonSize.Small" 
                                                  Click="@(() => ToggleStatusAsync(item))" 
                                                  Title="@(item.IsActive ? "Deactivate" : "Activate")" />
                                    <RadzenButton Icon="edit" 
                                                  ButtonStyle="ButtonStyle.Primary" 
                                                  Shade="Shade.Lighter" 
                                                  Size="ButtonSize.Small" 
                                                  Click="@(() => NavigateToEdit(item.Id))" 
                                                  Title="Edit Subscription details" />
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </div>
    }
</div>

@code {
    #region class field
    private List<TbSubscription> _allItems = new();
    private List<TbSubscription> _filteredItems = new();
    private RadzenDataGrid<TbSubscription>? _grid;
    private bool _isLoading = true;
    private bool _isAdmin = false;
    private bool _isBatchProcessing = false;
    private int _processedCount = 0;
    private int _totalToProcess = 0;
    private double _batchPercentage => _totalToProcess > 0 ? ((double)_processedCount / _totalToProcess) * 100 : 0;
    private string _batchProgressMessage = string.Empty;

    private string _searchQuery = string.Empty;
    private string _selectedExpiryFilter = "All";
    private string _selectedPlanFilter = "All";

    private readonly List<string> _expiryFilterOptions = new()
    {
        "All",
        "Expired",
        "Expiring in 7 Days",
        "Expiring in 30 Days",
        "Active & Valid"
    };

    private readonly List<string> _planFilterOptions = new()
    {
        "All",
        "Basic",
        "Pro",
        "Enterprise"
    };

    private int _pageSize = 15;
    private readonly List<int> _pageSizeOptions = new() { 10, 15, 25, 50 };
    #endregion

    #region class methods
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole(SystemRoles.Administrator);
        #region hide [2026-08-20]
        await LoadDataAsync();
        #endregion
    }

    private async Task LoadDataAsync()
    {
        #region hide [2026-08-20]
        try
        {
            _isLoading = true;
            _allItems = await SubscriptionService.GetAllAsync(includeUsers: true, includeCorporates: true, includeInactive: true);
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load subscriptions.");
            NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to load subscriptions.");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
        #endregion
    }

    private void ApplyFilter()
    {
        #region hide [2026-08-20]
        var query = _allItems.AsEnumerable();

        // 1. Filter by Search Query
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var q = _searchQuery.Trim().ToLowerInvariant();
            query = query.Where(s =>
                (s.Title != null && s.Title.ToLowerInvariant().Contains(q)) ||
                (s.TaxId != null && s.TaxId.ToLowerInvariant().Contains(q)) ||
                (s.OwnerName != null && s.OwnerName.ToLowerInvariant().Contains(q)) ||
                (s.OwnerEmail != null && s.OwnerEmail.ToLowerInvariant().Contains(q)) ||
                (s.ContactPerson != null && s.ContactPerson.ToLowerInvariant().Contains(q)));
        }

        // 2. Filter by Expiry Status
        var now = DateTime.UtcNow;
        query = _selectedExpiryFilter switch
        {
            "Expired" => query.Where(s => s.ExpiryDate <= now),
            "Expiring in 7 Days" => query.Where(s => s.ExpiryDate > now && s.ExpiryDate <= now.AddDays(7)),
            "Expiring in 30 Days" => query.Where(s => s.ExpiryDate > now && s.ExpiryDate <= now.AddDays(30)),
            "Active & Valid" => query.Where(s => s.IsActive && s.ExpiryDate > now.AddDays(30)),
            _ => query
        };

        // 3. Filter by Plan
        if (_selectedPlanFilter != "All")
        {
            if (Enum.TryParse<eSubscriptionPlan>(_selectedPlanFilter, out var plan))
            {
                query = query.Where(s => s.SubscriptionPlan == plan);
            }
        }

        _filteredItems = query.OrderBy(s => s.ExpiryDate).ToList();
        #endregion
    }

    private BadgeStyle GetPlanBadgeStyle(eSubscriptionPlan plan)
    {
        return plan switch
        {
            eSubscriptionPlan.Enterprise => BadgeStyle.Danger,
            eSubscriptionPlan.Pro => BadgeStyle.Primary,
            _ => BadgeStyle.Secondary
        };
    }

    private void NavigateToExtend(int id)
    {
        #region hide [2026-08-20]
        var protector = DataProtection.CreateProtector(nameof(LinkProtector));
        var encryptedId = protector.Protect(id.ToString());
        var encryptedRet = protector.Protect("/admin/expire-subscriptions");
        NavigationManager.NavigateTo($"/admin/expire-subscriptions/extend?id={Uri.EscapeDataString(encryptedId)}&ret={Uri.EscapeDataString(encryptedRet)}");
        #endregion
    }

    private async Task SendSingleReminderAsync(TbSubscription sub)
    {
        #region hide [2026-08-20]
        var confirm = await DialogService.Confirm(
            $"Are you sure you want to send an expiration reminder email to '{sub.OwnerEmail}'?",
            $"Send Reminder: {sub.Title}",
            new ConfirmOptions { OkButtonText = "Send Email", CancelButtonText = "Cancel" });

        if (confirm == true)
        {
            try
            {
                var sent = await SubscriptionService.SendExpirationReminderAsync(sub.Id);
                if (sent)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Email Sent", $"Expiration reminder sent to {sub.OwnerEmail}");
                }
                else
                {
                    NotificationService.Notify(NotificationSeverity.Warning, "Warning", $"Could not find a valid email address for {sub.Title}");
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to send reminder for subscription {Id}", sub.Id);
                NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to send email notification.");
            }
        }
        #endregion
    }

    private async Task BatchSendRemindersHandlerAsync()
    {
        #region hide [2026-08-20]
        var targetSubs = _filteredItems
            .Where(s => s.ExpiryDate <= DateTime.UtcNow.AddDays(30) && !string.IsNullOrWhiteSpace(s.OwnerEmail))
            .ToList();

        if (!targetSubs.Any())
        {
            NotificationService.Notify(NotificationSeverity.Info, "Information", "No subscriptions requiring expiration reminders in the current filter.");
            return;
        }

        var confirm = await DialogService.Confirm(
            $"This will send expiration reminder emails to {targetSubs.Count} subscriptions. Do you want to proceed?",
            "Batch Send Expiration Reminders",
            new ConfirmOptions { OkButtonText = "Start Sending", CancelButtonText = "Cancel" });

        if (confirm != true) return;

        _isBatchProcessing = true;
        _totalToProcess = targetSubs.Count;
        _processedCount = 0;
        _batchProgressMessage = "Sending expiration reminders...";
        StateHasChanged();

        var successCount = 0;
        var failCount = 0;

        foreach (var sub in targetSubs)
        {
            try
            {
                var sent = await SubscriptionService.SendExpirationReminderAsync(sub.Id);
                if (sent) successCount++;
                else failCount++;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to send reminder for subscription {Id} in batch.", sub.Id);
                failCount++;
            }

            _processedCount++;
            StateHasChanged();
            await Task.Delay(50); // slight throttle
        }

        _isBatchProcessing = false;
        NotificationService.Notify(
            failCount == 0 ? NotificationSeverity.Success : NotificationSeverity.Warning,
            "Batch Completed",
            $"Processed {_totalToProcess} reminders. Success: {successCount}, Failed: {failCount}");
        #endregion
    }

    private async Task ToggleStatusAsync(TbSubscription sub)
    {
        #region hide [2026-08-20]
        try
        {
            var toggled = await SubscriptionService.ToggleActiveStatusAsync(sub.Id);
            if (toggled)
            {
                NotificationService.Notify(NotificationSeverity.Info, "Status Updated", $"Subscription '{sub.Title}' status toggled.");
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to toggle status for subscription {Id}", sub.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to update subscription status.");
        }
        #endregion
    }

    private void NavigateToEdit(int id)
    {
        #region hide [2026-08-20]
        var protector = DataProtection.CreateProtector(nameof(LinkProtector));
        var encryptedId = protector.Protect(id.ToString());
        NavigationManager.NavigateTo($"/subscriptions/edit/{Uri.EscapeDataString(encryptedId)}");
        #endregion
    }
    #endregion
}
