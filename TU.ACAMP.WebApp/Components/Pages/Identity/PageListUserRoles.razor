@page "/admin/roles"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.DataProtection
@using TU.ACAMP.Domain.Identity
@using TU.ACAMP.WebApp.Data
@using TU.ACAMP.WebApp.Services.Common
@using TU.ACAMP.WebApp.Services.Identity

@attribute [Authorize(Roles = SystemRoles.Administrator)]
@inject IdentityAdminService IdentityAdminService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IDataProtectionProvider DataProtection
@inject ILogger<PageListUserRoles> Logger
@inject IWebHostEnvironment Env
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>User Role Management - ACAMP</PageTitle>

<div class="container-fluid py-3 px-4">
    <!-- Header Section -->
    <div class="row mb-4 align-items-center">
        <div class="col-12 col-md-8">
            <RadzenText Text="User Role Management" TextStyle="TextStyle.H5" TagName="TagName.H1" class="fw-bold mb-1" Style="color: var(--rz-text-title-color);" />
            <RadzenText Text="View system user accounts and assign the security roles that govern platform-wide access." TextStyle="TextStyle.Body2" class="text-muted mb-0" />
        </div>
        <div class="col-12 col-md-4 text-md-end mt-3 mt-md-0">
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium" Click="@LoadDataAsync" Style="border-radius: 8px;" />
        </div>
    </div>

    <!-- [2026-09-13][Antigravity] Filters & Search Toolbar with .acamp-filter-bar and spring search -->
    <RadzenCard Class="mb-4 p-3 shadow-sm" Style="border-radius: 12px; border: 1px solid var(--rz-border-color); background: var(--rz-card-background-color);">
        <div class="acamp-filter-bar justify-content-between">
            <div class="acamp-filter-search">
                <RadzenFormField Text="Search User / Email">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="@_searchQuery" @bind-Value:after="@FilterUsers" Placeholder="Search by email or username..." Style="width: 100%;" />
                    </ChildContent>
                    <Start>
                        <RadzenIcon Icon="search" />
                    </Start>
                </RadzenFormField>
            </div>
            <div class="d-flex align-items-end gap-2 flex-wrap ms-auto flex-shrink-0">
                <RadzenFormField Text="Role Filter" Style="width: 200px;">
                    <RadzenDropDown TValue="string"
                                    Data="@_roleFilterOptions"
                                    @bind-Value="@_selectedRoleFilter"
                                    @bind-Value:after="@FilterUsers" />
                </RadzenFormField>
            </div>
        </div>
    </RadzenCard>

    <!-- DataGrid Container -->
    @if (_isLoading)
    {
        <div class="py-5 text-center">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <RadzenText Text="Loading user accounts..." TextStyle="TextStyle.Body2" class="text-muted mt-2" />
        </div>
    }
    else
    {
        <div class="shadow-sm rounded-3 p-3" style="background-color: var(--rz-card-background-color); border: 1px solid var(--rz-border-color); border-radius: 12px;">
            @if (!_filteredUsers.Any())
            {
                <div class="p-5 text-center text-muted">
                    <RadzenIcon Icon="person_search" Style="font-size: 48px; opacity: 0.5;" class="mb-2" />
                    <RadzenText Text="No user accounts found matching the selected filters." TextStyle="TextStyle.Body1" class="text-muted mb-0" />
                </div>
            }
            else
            {
                <RadzenDataGrid @ref="_grid" Data="@_filteredUsers" TItem="ApplicationUser"
                                AllowColumnResize="true"
                                AllowPaging="true" PageSize="@_pageSize" PageSizeOptions="@_pageSizeOptions"
                                AllowSorting="true" ColumnWidth="180px" PagerHorizontalAlign="HorizontalAlign.Right" ShowPagingSummary="true"
                                Style="@GridStyles.Default"
                                Page="@OnPageChanged"
                                RowDoubleClick="@((DataGridRowMouseEventArgs<ApplicationUser> args) => NavigateToEdit(args.Data))">
                    <Columns>
                        @if (Env.IsDevelopment() || _isAdmin)
                        {
                            <RadzenDataGridColumn TItem="ApplicationUser" Property="Id" Title="ID" Width="60px" TextAlign="TextAlign.Center" />
                        }

                        <RadzenDataGridColumn TItem="ApplicationUser" Title="#" Width="55px" TextAlign="TextAlign.Center" Sortable="false">
                            <Template Context="user">
                                @(_filteredUsers.IndexOf(user) + 1)
                            </Template>
                        </RadzenDataGridColumn>

                        <!-- Account Identity -->
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="User Account" Property="Email" MinWidth="260px">
                            <Template Context="user">
                                <div class="d-flex align-items-center gap-2">
                                    <RadzenIcon Icon="account_circle" class="text-primary" Style="font-size: 1.75rem;" />
                                    <div>
                                        <RadzenText Text="@(user.Email ?? user.UserName)" TextStyle="TextStyle.Subtitle2" class="fw-bold text-primary mb-0 cursor-pointer" @onclick="@(() => NavigateToEdit(user))" />
                                        @if (!string.IsNullOrEmpty(user.UserName) && !string.Equals(user.UserName, user.Email, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="text-muted small d-block">Username: @user.UserName</span>
                                        }
                                    </div>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <!-- Assigned Roles -->
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="Assigned System Roles" MinWidth="260px" Sortable="false">
                            <Template Context="user">
                                @{
                                    var roles = GetUserRoles(user.Id);
                                }
                                @if (roles.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var role in roles)
                                        {
                                            <RadzenBadge Text="@role" BadgeStyle="@GetRoleBadgeStyle(role)" IsPill="true" />
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">No roles assigned</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <!-- Account Status -->
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="Email Status" Property="EmailConfirmed" Width="150px" TextAlign="TextAlign.Center">
                            <Template Context="user">
                                @if (user.EmailConfirmed)
                                {
                                    <RadzenBadge Text="Confirmed" BadgeStyle="BadgeStyle.Success" IsPill="true" />
                                }
                                else
                                {
                                    <RadzenBadge Text="Pending" BadgeStyle="BadgeStyle.Warning" IsPill="true" />
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <!-- Action Buttons -->
                        <RadzenDataGridColumn TItem="ApplicationUser" Title="Actions" Width="130px" TextAlign="TextAlign.Center" Sortable="false">
                            <Template Context="user">
                                <RadzenButton Icon="manage_accounts"
                                              Text="Roles"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Variant="Variant.Outlined"
                                              Size="ButtonSize.Small"
                                              Click="@(() => NavigateToEdit(user))"
                                              title="Edit system roles"
                                              Style="border-radius: 6px;" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </div>
    }
</div>

@code {
    #region class field
    private const string AllRolesOption = "All Roles";

    private RadzenDataGrid<ApplicationUser>? _grid;
    private List<ApplicationUser> _allUsers = new();
    private List<ApplicationUser> _filteredUsers = new();
    private Dictionary<string, List<string>> _userRolesMap = new();
    private List<string> _availableRoles = new();
    private List<string> _roleFilterOptions = new() { AllRolesOption };

    private string _searchQuery = string.Empty;
    private string _selectedRoleFilter = AllRolesOption;
    private bool _isLoading = true;
    private bool _isAdmin = false;
    private int _currentPageIndex = 0;

    private int _pageSize = 10;
    private IEnumerable<int> _pageSizeOptions = new[] { 10, 25, 50 };
    #endregion

    #region class properties
    [SupplyParameterFromQuery(Name = "q")]
    public string? SecureQuerySearch { get; set; }

    [SupplyParameterFromQuery(Name = "role")]
    public string? SecureQueryRole { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public string? SecureQueryPageIndex { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public string? SecureQueryPageSize { get; set; }
    #endregion

    #region class methods
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole(SystemRoles.Administrator);
        #region hide [2026-08-16]
        await LoadDataAsync();
        #endregion
    }

    protected override async Task OnParametersSetAsync()
    {
        #region hide [2026-08-16]
        var stateChanged = false;

        var decryptedSearch = DataProtection.Unprotect(SecureQuerySearch) ?? string.Empty;
        if (!string.IsNullOrEmpty(decryptedSearch) && _searchQuery != decryptedSearch)
        {
            _searchQuery = decryptedSearch;
            stateChanged = true;
        }

        var decryptedRole = DataProtection.Unprotect(SecureQueryRole) ?? AllRolesOption;
        if (!string.IsNullOrEmpty(decryptedRole) && _selectedRoleFilter != decryptedRole)
        {
            _selectedRoleFilter = decryptedRole;
            stateChanged = true;
        }

        var decryptedPageSize = DataProtection.UnprotectInt(SecureQueryPageSize);
        if (decryptedPageSize.HasValue && decryptedPageSize.Value > 0 && _pageSize != decryptedPageSize.Value)
        {
            _pageSize = decryptedPageSize.Value;
            stateChanged = true;
        }

        var decryptedPageIndex = DataProtection.UnprotectInt(SecureQueryPageIndex);
        if (decryptedPageIndex.HasValue && decryptedPageIndex.Value >= 0)
        {
            _currentPageIndex = decryptedPageIndex.Value;
        }

        if (stateChanged && _allUsers.Any())
        {
            FilterUsers();
        }

        await base.OnParametersSetAsync();
        #endregion
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        #region hide [2026-08-16]
        if (firstRender && _currentPageIndex > 0 && _grid != null)
        {
            try
            {
                await _grid.GoToPage(_currentPageIndex);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error restoring grid page index to {PageIndex} in PageListUserRoles.", _currentPageIndex);
            }
        }
        await base.OnAfterRenderAsync(firstRender);
        #endregion
    }

    private void OnPageChanged(PagerEventArgs args)
    {
        #region hide [2026-08-16]
        _currentPageIndex = args.PageIndex;
        #endregion
    }

    private async Task LoadDataAsync()
    {
        #region hide [2026-08-16]
        _isLoading = true;
        try
        {
            _allUsers = await IdentityAdminService.GetSystemUsersAsync();
            _availableRoles = await IdentityAdminService.GetAvailableSystemRolesAsync();
            _userRolesMap = await IdentityAdminService.GetAllUserRolesMapAsync();

            _roleFilterOptions = new List<string> { AllRolesOption };
            _roleFilterOptions.AddRange(_availableRoles);

            if (!_roleFilterOptions.Contains(_selectedRoleFilter))
            {
                _selectedRoleFilter = AllRolesOption;
            }

            FilterUsers();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load user role data in PageListUserRoles.");
            NotificationService.Notify(NotificationSeverity.Error, "Error", "Failed to load user role data.");
        }
        finally
        {
            _isLoading = false;
        }
        #endregion
    }

    private void FilterUsers()
    {
        #region hide [2026-08-16]
        var result = _allUsers.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var q = _searchQuery.Trim();
            result = result.Where(u =>
                (!string.IsNullOrEmpty(u.Email) && u.Email.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(u.UserName) && u.UserName.Contains(q, StringComparison.OrdinalIgnoreCase)));
        }

        if (_selectedRoleFilter != AllRolesOption)
        {
            result = result.Where(u => GetUserRoles(u.Id).Contains(_selectedRoleFilter, StringComparer.OrdinalIgnoreCase));
        }

        _filteredUsers = result.ToList();
        #endregion
    }

    private List<string> GetUserRoles(string? userId)
    {
        #region hide [2026-08-16]
        if (string.IsNullOrWhiteSpace(userId)) return new List<string>();
        return _userRolesMap.TryGetValue(userId, out var roles) ? roles : new List<string>();
        #endregion
    }

    private BadgeStyle GetRoleBadgeStyle(string roleName)
    {
        #region hide [2026-08-16]
        return roleName switch
        {
            SystemRoles.Administrator => BadgeStyle.Danger,
            SystemRoles.Staff => BadgeStyle.Warning,
            SystemRoles.SubscriptionManager => BadgeStyle.Primary,
            SystemRoles.User => BadgeStyle.Info,
            SystemRoles.Corporate => BadgeStyle.Success,
            _ => BadgeStyle.Secondary
        };
        #endregion
    }

    private string GetCurrentPageStateUrl()
    {
        #region hide [2026-08-16]
        var queryParams = new Dictionary<string, object?>();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
            queryParams["q"] = DataProtection.Protect(_searchQuery);

        if (!string.IsNullOrWhiteSpace(_selectedRoleFilter) && _selectedRoleFilter != AllRolesOption)
            queryParams["role"] = DataProtection.Protect(_selectedRoleFilter);

        if (_currentPageIndex > 0)
            queryParams["page"] = DataProtection.Protect(_currentPageIndex);

        if (_pageSize != 10)
            queryParams["pageSize"] = DataProtection.Protect(_pageSize);

        return NavigationManager.GetUriWithQueryParameters("/admin/roles", queryParams);
        #endregion
    }

    private void NavigateToEdit(ApplicationUser user)
    {
        #region hide [2026-08-16]
        if (user == null) return;

        var returnUrl = GetCurrentPageStateUrl();
        var secureRet = DataProtection.Protect(returnUrl);
        var secureId = DataProtection.Protect(user.Id);
        NavigationManager.NavigateTo($"/admin/roles/edit?id={Uri.EscapeDataString(secureId)}&ret={Uri.EscapeDataString(secureRet)}");
        #endregion
    }
    #endregion
}
