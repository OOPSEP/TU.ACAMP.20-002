    /// <summary>
    /// ผูก HTML5 Drag Events ให้กับแถวของตาราง (เฉพาะรายการที่มีสิทธิ์แก้ไข)
    /// </summary>
    private void OnRowRender(RowRenderEventArgs<TbCompany> args)
    {
        #region hide [2026-09-11]
        var item = args.Data;
        if (item == null) return;

        if (!CanEditCompany(item))
        {
            args.Attributes["title"] = "You do not have permission to reorder this company.";
            return;
        }

        args.Attributes["draggable"] = "true";
        args.Attributes["title"] = "Drag to reorder within the same corporate group.";

        var style = args.Attributes.TryGetValue("style", out var current) && current != null
            ? current.ToString()
            : string.Empty;
        args.Attributes["style"] = string.IsNullOrWhiteSpace(style) ? "cursor: grab;" : $"{style}; cursor: grab;";

        args.Attributes["ondragstart"] = EventCallback.Factory.Create<DragEventArgs>(this, () => _draggedCompany = item);

        args.Attributes["ondragover"] =
            "event.preventDefault();var r=event.target.closest('.rz-data-row');if(r){document.querySelectorAll('.company-drop-target').forEach(function(e){e.classList.remove('company-drop-target');});r.classList.add('company-drop-target');}";

        args.Attributes["ondragleave"] =
            "var r=event.target.closest('.rz-data-row');if(r){r.classList.remove('company-drop-target');}";

        args.Attributes["ondragend"] =
            "document.querySelectorAll('.company-drop-target').forEach(function(e){e.classList.remove('company-drop-target');});";

        args.Attributes["ondrop"] = EventCallback.Factory.Create<DragEventArgs>(this, async () => await OnCompanyRowDropAsync(item));
        #endregion
    }

    /// <summary>
    /// จัดลำดับใหม่เมื่อวางแถว โดยอนุญาตเฉพาะการวางภายใน Corporate เดียวกัน
    /// </summary>
    private async Task OnCompanyRowDropAsync(TbCompany targetItem)
    {
        #region hide [2026-09-11]
        var sourceItem = _draggedCompany;
        _draggedCompany = null;

        try
        {
            await ClearDropHighlightAsync();

            if (sourceItem == null || targetItem == null) return;
            if (sourceItem.Id == targetItem.Id) return;

            if (sourceItem.CorporateId != targetItem.CorporateId)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Reorder Blocked",
                    "Companies can be reordered only within the same corporate group.");
                return;
            }

            if (!CanEditCompany(sourceItem))
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Permission Denied",
                    "You do not have permission to reorder this company.");
                return;
            }

            var peers = GetCompanyPeers(sourceItem.CorporateId);
            var fromIdx = peers.FindIndex(c => c.Id == sourceItem.Id);
            var toIdx = peers.FindIndex(c => c.Id == targetItem.Id);
            if (fromIdx < 0 || toIdx < 0 || fromIdx == toIdx) return;

            var moving = peers[fromIdx];
            peers.RemoveAt(fromIdx);

            var insertAt = peers.FindIndex(c => c.Id == targetItem.Id);
            if (insertAt < 0) return;
            if (fromIdx < toIdx) insertAt += 1; // ลากลง = วางต่อท้ายแถวเป้าหมาย
            peers.Insert(insertAt, moving);

            await CompanyService.ReorderCompaniesInCorporateAsync(peers.Select(c => c.Id).ToList(), _currentUserEmail);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reorder companies by drag and drop");
            NotificationService.Notify(NotificationSeverity.Error, "Reorder Error", "Failed to reorder items.");
        }
        #endregion
    }

    private async Task ClearDropHighlightAsync()
    {
        #region hide [2026-09-11]
        try
        {
            await JSRuntime.InvokeVoidAsync("eval",
                "document.querySelectorAll('.company-drop-target').forEach(function(e){e.classList.remove('company-drop-target');});");
        }
        catch
        {
            // ไม่ถือเป็นข้อผิดพลาดร้ายแรง หากล้าง Highlight ไม่สำเร็จ
        }
        #endregion
    }
    #endregion
