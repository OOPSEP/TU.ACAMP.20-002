            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting company ID: {Id}", item.Id);
                NotificationService.Notify(NotificationSeverity.Error, "Delete Failed", ex.Message);
            }
        }
        #endregion
    }

