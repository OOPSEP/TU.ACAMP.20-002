    private async Task OnSplitButtonClick(RadzenSplitButtonItem args, TbCompany item)
    {
        #region hide [2026-08-17]
        if (args == null || args.Value == null)
        {
            OnRowDoubleClick(item);
            return;
        }

        switch (args.Value.ToString())
        {
            case "1":
                await OnDuplicate(item);
                break;
            case "2":
                await ConfirmDelete(item);
                break;
            case "3":
                await ConfirmClearFacilities(item);
                break;
            case "4":
                await ConfirmClearTopics(item);
                break;
        }
        #endregion
    }

    private async Task ConfirmClearTopics(TbCompany item)
    {
        #region hide [2026-08-29]
        if (item == null) return;

        var confirmed = await DialogService.Confirm(
            "Are you sure you want to clear all activity topics for this company?",
            "Clear Topics Confirmation",
            new ConfirmOptions { OkButtonText = "Clear Topics", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                var clearedCount = await TopicService.ClearTopicsByTargetAsync(eTopicLevel.Company, item.Id);
                if (clearedCount > 0)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Topics Cleared", $"Successfully cleared {clearedCount} activity topic(s).");
                }
                else
                {
                    NotificationService.Notify(NotificationSeverity.Info, "Notice", "There are no activity topics to clear.");
                }
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error clearing topics for Company ID: {Id}", item.Id);
                NotificationService.Notify(NotificationSeverity.Error, "Action Failed", "Failed to clear activity topics.");
            }
        }
        #endregion
    }

    private async Task OnDuplicate(TbCompany item)
    {
        #region hide [2026-08-17]
        try
        {
            if (item == null) return;

            if (IsCompanyQuotaReached && CurrentSubscription != null)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Quota Exceeded", $"Cannot duplicate: Maximum company limit of {AllowCompanyCount} reached for this subscription ({CurrentSubscription.SubscriptionPlan} Plan).");
                return;
            }

            var dup = await CompanyService.DuplicateAsync(item.Id);
            NotificationService.Notify(NotificationSeverity.Success, "Duplicated", $"Company duplicated as '{dup.Code}'.");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error duplicating company ID: {Id}", item.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Duplicate Failed", ex.Message);
        }
        #endregion
    }

    private async Task ConfirmClearFacilities(TbCompany item)
    {
        #region hide [2026-08-18]
        if (item == null) return;

        var facilityCount = item.Facilities?.Count(f => !f.IsDeleted) ?? 0;
        if (facilityCount == 0)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Notice", "This company has no associated facilities/sites to clear.");
            return;
        }

        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to clear all {facilityCount} associated facility/site(s) from company '{item.Title}' ({item.Code})?\n\nNote: Only facilities without recorded carbon activity data will be removed.",
            "Clear Facilities Confirmation",
            new ConfirmOptions { OkButtonText = "Clear Facilities", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                var clearedCount = await CompanyService.ClearChildFacilitiesAsync(item.Id);
                NotificationService.Notify(NotificationSeverity.Success, "Facilities Cleared", $"Successfully removed {clearedCount} facility/site(s) from '{item.Code}'.");
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error clearing facilities for Company ID: {Id}", item.Id);
                NotificationService.Notify(NotificationSeverity.Warning, "Action Blocked", ex.Message);
            }
        }
        #endregion
    }

    private async Task ConfirmDelete(TbCompany item)
    {
        #region hide [2026-08-17]
        var confirmed = await DialogService.Confirm(
            "Are you sure you want to delete this company?",
            "Delete Company",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
