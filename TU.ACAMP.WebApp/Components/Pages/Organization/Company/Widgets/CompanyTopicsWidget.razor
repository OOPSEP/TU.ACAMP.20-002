@using TU.ACAMP.Domain.Models.Library
@using TU.ACAMP.Domain.Models.Organization
@using TU.ACAMP.WebApp.Constants

<div class="p-4">
    @if (Model.Id == 0)
    {
        <div class="alert alert-info d-flex align-items-center mb-0" role="alert">
            <RadzenIcon Icon="info" Class="me-2 fs-5" />
            <div>
                Carbon emission activity topics and boundaries can be mapped and configured after saving the Company record.
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle1" Class="fw-bold m-0">
                    Carbon Topics & Accounting Boundary (@(TopicsList.Count))
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" Class="text-muted">
                    Emission activity data categories assigned directly to this legal company entity.
                </RadzenText>
            </div>
        </div>

        @if (!TopicsList.Any())
        {
            <div class="p-4 text-center text-muted border rounded bg-light">
                <RadzenIcon Icon="category" Style="font-size: 36px; opacity: 0.5;" Class="mb-2" />
                <div>No activity emission topics directly attached to this company level yet.</div>
            </div>
        }
        else
        {
            <RadzenDataGrid Data="@TopicsList" TItem="TbActivityTopic" AllowPaging="false" AllowSorting="true" AllowColumnResize="true" Style="@GridStyles.Default">
                <Columns>
                    <RadzenDataGridColumn TItem="TbActivityTopic" Title="#" Width="50px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            @(TopicsList.IndexOf(item) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TbActivityTopic" Property="Title" Title="Topic Title / Emission Activity" MinWidth="220px">
                        <Template Context="item">
                            <div class="fw-bold">@item.Title</div>
                            @if (!string.IsNullOrWhiteSpace(item.Remark))
                            {
                                <div class="text-muted small">@item.Remark</div>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TbActivityTopic" Title="Emission Group" Width="180px">
                        <Template Context="item">
                            @if (item.EmissionGroup != null)
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">@item.EmissionGroup.Title</span>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="TbActivityTopic" Title="Recorded Events" Width="130px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <span class="badge bg-info-subtle text-info-emphasis border fw-bold px-2 py-1">
                                @((item.Events?.Count ?? 0)) Records
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    }
</div>

@code {
    #region class properties
    [Parameter, EditorRequired] public TbCompany Model { get; set; } = new();
    [Parameter] public List<TbActivityTopic> TopicsList { get; set; } = new();
    [Parameter] public bool IsReadOnly { get; set; } = false;
    #endregion
}
