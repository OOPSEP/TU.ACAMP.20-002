    #region Drag & Drop Reorder Handlers
    private void OnRowRender(RowRenderEventArgs<TbCompany> args)
    {
        bool canEdit = CanEditCompany(args.Data);
        if (canEdit)
        {
            args.Attributes.Add("draggable", "true");
            args.Attributes.Add("ondragstart", EventCallback.Factory.Create<DragEventArgs>(this, e => OnDragStart(e, args.Data)));
            args.Attributes.Add("ondragover", "event.preventDefault();");
            args.Attributes.Add("ondragenter", "this.classList.add('company-drop-target');");
            args.Attributes.Add("ondragleave", "this.classList.remove('company-drop-target');");
            args.Attributes.Add("ondrop", EventCallback.Factory.Create<DragEventArgs>(this, e => OnDrop(e, args.Data)));
            args.Attributes.Add("style", "cursor: grab;");
            args.Attributes.Add("title", "Drag to reorder within corporate group");
        }
    }

    private void OnDragStart(DragEventArgs args, TbCompany item)
    {
        if (!CanEditCompany(item)) return;
        _draggedCompany = item;
    }

    private async Task OnDrop(DragEventArgs args, TbCompany target)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.querySelectorAll('.company-drop-target').forEach(el => el.classList.remove('company-drop-target'));");

            if (_draggedCompany == null || target == null || _draggedCompany.Id == target.Id)
            {
                _draggedCompany = null;
                return;
            }

            if (_draggedCompany.CorporateId != target.CorporateId)
            {
                NotificationService.Notify(NotificationSeverity.Warning,
                    "Reorder Not Allowed",
                    "Cannot reorder across different corporate groups. Companies can only be reordered within their own corporate group.");
                _draggedCompany = null;
                return;
            }

            if (!CanEditCompany(_draggedCompany) || !CanEditCompany(target))
            {
                NotificationService.Notify(NotificationSeverity.Warning,
                    "Permission Denied",
                    "You do not have permission to reorder one or both of these companies.");
                _draggedCompany = null;
                return;
            }

            int corporateId = target.CorporateId;
            var groupItems = GetCompanyPeers(corporateId);

            int oldIndex = groupItems.FindIndex(c => c.Id == _draggedCompany.Id);
            int newIndex = groupItems.FindIndex(c => c.Id == target.Id);

            if (oldIndex < 0 || newIndex < 0 || oldIndex == newIndex)
            {
                _draggedCompany = null;
                return;
            }

            var moved = groupItems[oldIndex];
            groupItems.RemoveAt(oldIndex);
            groupItems.Insert(newIndex, moved);

            var orderedIds = groupItems.Select(c => c.Id).ToList();
            // [2026-09-14][Gemini] ReorderCompaniesInCorporateAsync accepts orderedCompanyIds and currentUserId
            await CompanyService.ReorderCompaniesInCorporateAsync(orderedIds, _currentUserEmail);

            for (int i = 0; i < groupItems.Count; i++)
            {
                var match = _allItems.FirstOrDefault(c => c.Id == groupItems[i].Id);
                if (match != null) match.OrderId = i + 1;
            }

            ApplyFilter();

            NotificationService.Notify(NotificationSeverity.Success,
                "Order Updated",
                $"Reordered '{moved.Title}' to position #{newIndex + 1}.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error reordering companies via drag-drop.");
            NotificationService.Notify(NotificationSeverity.Error, "Reorder Failed", "An error occurred while saving the new order.");
        }
        finally
        {
            _draggedCompany = null;
        }
    }
    #endregion

    #region Entity Operations (Duplicate, Delete, Clear)
    private async Task OnDuplicate(TbCompany item)
    {
        var confirmed = await DialogService.Confirm(
            $"Duplicate '{item.Title}' ({item.Code})?",
            "Duplicate Company",
            new ConfirmOptions { OkButtonText = "Duplicate", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                // [2026-09-14][Gemini] Call DuplicateAsync on CompanyService
                var duplicated = await CompanyService.DuplicateAsync(item.Id);
                NotificationService.Notify(NotificationSeverity.Success, "Duplicated", $"Company duplicated as '{duplicated.Code}'.");
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error duplicating company.");
                NotificationService.Notify(NotificationSeverity.Error, "Duplicate Failed", ex.Message);
            }
        }
    }

    private async Task OnDelete(TbCompany item)
    {
