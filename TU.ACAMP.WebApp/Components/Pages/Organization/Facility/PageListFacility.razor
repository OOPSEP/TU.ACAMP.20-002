@*
    @page "/organization/facility"
    @page "/organization/facilities"
*@

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.DataProtection
@using System.Security.Claims
@using TU.ACAMP.Domain.Enums
@using TU.ACAMP.Domain.Identity
@using TU.ACAMP.Domain.Models.Organization
@using TU.ACAMP.WebApp.Services.Activity
@using TU.ACAMP.WebApp.Services.Common
@using TU.ACAMP.WebApp.Services.Identity
@using TU.ACAMP.WebApp.Services.Organization
@using TU.ACAMP.WebApp.Components.Pages.Organization.Facility.Widgets

@attribute [Authorize]

@inject FacilityService FacilityService
@inject CompanyService CompanyService
@inject CorporateService CorporateService
@inject ActivityTopicService TopicService
@inject SubscriptionService SubscriptionService
@inject NavigationManager NavigationManager
@inject IDataProtectionProvider DataProtection
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Env
@inject ILogger<PageListFacility> Logger

<PageTitle>Facilities & Operations - ACAMP</PageTitle>

<div class="container-fluid py-3 px-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center mb-1">
                <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                              Size="ButtonSize.Small" Click="@NavigateToCompanyList" Class="me-2" Style="border-radius: 6px;" Title="Back to Companies" />
                <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" Class="m-0 fw-bold" Style="color: var(--rz-text-title-color);">
                    Facilities & Operations Management
                </RadzenText>
            </div>
            <RadzenText TextStyle="TextStyle.Body2" Class="text-muted mt-1 ms-5">
                Manage operational sites, factories, buildings, and physical boundary nodes for carbon emissions tracking.
            </RadzenText>
        </div>
        <div class="d-flex align-items-center gap-2">
            <RadzenButton Text="Back to Companies" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                          Click="@NavigateToCompanyList" Style="border-radius: 8px; font-weight: 600;" />
            @if (_canCreate)
            {
                <RadzenButton Text="Add Facility" Icon="add_circle" ButtonStyle="ButtonStyle.Primary"
                              Click="@NavigateToCreate" Style="border-radius: 8px; font-weight: 600;" />
            }
        </div>
    </div>

    <!-- Filter Toolbar Widget -->
    <FacFilterWidget @bind-SearchText="@_searchText"
                     @bind-SelectedSubscriptionId="@_selectedSubscriptionId"
                     @bind-SelectedCorporateId="@_selectedCorporateId"
                     @bind-SelectedCompanyId="@_selectedCompanyId"
                     @bind-SelectedYear="@_selectedYear"
                     @bind-StartMonth="@_startMonth"
                     @bind-SelectedScopes="@_selectedScopes"
                     @bind-SelectedActivityGroupIds="@_selectedActivityGroupIds"
                     SubscriptionsList="@_subscriptionsList"
                     CorporatesList="@_corporatesList"
                     CompaniesList="@_companiesList"
                     IsAdmin="@_isAdmin"
                     OnFilterChanged="@OnFilterChanged" />

    <!-- Content / Grid Section -->
    @if (_isLoading)
    {
        <div class="py-5 text-center">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <RadzenText Text="Loading facility entities..." TextStyle="TextStyle.Body2" class="text-muted mt-2" />
        </div>
    }
    else
    {
        <RadzenCard Class="shadow-sm p-3" Style="border-radius: 12px; border: 1px solid var(--rz-border-color); background: var(--rz-card-background-color);">
            @if (!_filteredItems.Any())
            {
                <div class="p-5 text-center text-muted">
                    <RadzenIcon Icon="factory" Style="font-size: 48px; opacity: 0.5;" Class="mb-3" />
                    <div>No facility entities found matching the specified filter criteria.</div>
                </div>
            }
            else
            {
                <RadzenDataGrid @ref="_grid"
                                Data="@_filteredItems"
                                TItem="TbFacility"
                                AllowColumnResize="true"
                                AllowPaging="true"
                                PageSize="@_pageSize"
                                PageSizeOptions="@_pageSizeOptions"
                                AllowSorting="true"
                                ColumnWidth="180px"
                                PagerHorizontalAlign="HorizontalAlign.Right"
                                ShowPagingSummary="true"
                                Style="@GridStyles.Default"
                                Page="@OnGridPageChanged"
                                RowRender="@OnRowRender"
                                RowDoubleClick="@(args => OnRowDoubleClick(args.Data))">
                    <Columns>
                        @if (Env.IsDevelopment() || _isAdmin)
                        {
                            <RadzenDataGridColumn TItem="TbFacility" Property="Id" Title="ID" Width="60px" TextAlign="TextAlign.Center" />
                        }

                        <RadzenDataGridColumn TItem="TbFacility" Title="#" Width="50px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                            <Template Context="d">
                                @(_filteredItems.IndexOf(d) + 1)
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="TbFacility" Property="Title" Title="Facility Title / Name" MinWidth="250px">
                            <Template Context="item">
                                <div class="d-flex align-items-center gap-2">
                                    <RadzenIcon Icon="factory" Style="color: var(--rz-primary); font-size: 1.2rem; flex-shrink: 0;" />
                                    <div class="text-truncate" style="max-width: 320px;" title="@item.Title">
                                        <span class="fw-bold text-dark">@item.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(item.Remark))
                                        {
                                            <div class="text-muted small text-truncate" title="@item.Remark">@item.Remark</div>
                                        }
                                    </div>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="TbFacility" Title="Company Entity" Width="200px" Visible="false">
                            <Template Context="item">
                                @if (item.Company != null)
                                {
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge bg-light text-dark border px-1" style="font-size: 0.75rem;">@item.Company.Code</span>
                                        <span class="small text-truncate fw-semibold" title="@item.Company.Title">@item.Company.Title</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="TbFacility" Title="Corporate Group" Width="180px" Visible="false">
                            <Template Context="item">
                                @if (item.Company?.Corporate != null)
                                {
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge bg-secondary-subtle text-secondary border px-1" style="font-size: 0.75rem;">@item.Company.Corporate.Code</span>
                                        <span class="small text-truncate" title="@item.Company.Corporate.Title">@item.Company.Corporate.Title</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="TbFacility" Title="Topics" Width="140px" TextAlign="TextAlign.Center" Sortable="false">
                            <Template Context="item">
                                <RadzenButton Click="@(() => NavigateToTopicList(item))"
                                              ButtonStyle="ButtonStyle.Light"
                                              Variant="Variant.Outlined"
                                              Size="ButtonSize.Small"
                                              Class="text-primary border fw-bold"
                                              Style="display: inline-flex; align-items: center; gap: 4px; border-radius: 6px;">
                                    <RadzenIcon Icon="category" Style="font-size: 15px;" />
                                    <span>@((item.Topics?.Count ?? 0)) Topics</span>
                                </RadzenButton>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="TbFacility" Title="Report" Width="130px" TextAlign="TextAlign.Center" Sortable="false" Visible="false">
                            <Template Context="item">
                                <RadzenButton Click="@(() => NavigateToReportList(item))"
                                              ButtonStyle="ButtonStyle.Light"
                                              Variant="Variant.Outlined"
                                              Size="ButtonSize.Small"
                                              Class="text-info border fw-bold"
                                              Style="display: inline-flex; align-items: center; gap: 4px; border-radius: 6px;"
                                              Title="View Facility CFO Report">
                                    <RadzenIcon Icon="summarize" Style="font-size: 15px;" />
                                    <span>Reports</span>
                                </RadzenButton>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="TbFacility" Title="tCO2e" Width="160px" TextAlign="TextAlign.Right" Sortable="false">
                            <Template Context="item">
                                <RadzenButton Click="@(() => NavigateToAnalytics(item))"
                                              ButtonStyle="ButtonStyle.Success"
                                              Variant="Variant.Flat"
                                              Size="ButtonSize.Small"
                                              Style="border-radius: 6px; font-weight: 700; font-size: 0.85rem;"
                                              Title="View Facility GHG Activity Data Analytics Breakdown">
                                    <RadzenIcon Icon="insights" Style="font-size: 15px;" Class="me-1" />
                                    <span>@GetTotalGhgDisplay(item.Id) t</span>
                                </RadzenButton>
                            </Template>
                        </RadzenDataGridColumn>
 

                        <RadzenDataGridColumn TItem="TbFacility" Title="Actions" Width="130px" TextAlign="TextAlign.Center" Sortable="false" Filterable="false">
                            <Template Context="item">
                                @{
                                    bool canEdit = CanEditFacility(item);
                                }
                                <RadzenSplitButton Icon="@(canEdit ? "edit" : "visibility")"
                                                   Text="@(canEdit ? "Edit" : "View")"
                                                   ButtonStyle="@(canEdit ? ButtonStyle.Primary : ButtonStyle.Secondary)"
                                                   Size="ButtonSize.Small"
                                                   Click="@(args => OnSplitButtonClick(args, item))">
                                    <ChildContent>
                                        @if (canEdit)
                                        {
                                            <RadzenSplitButtonItem Text="Duplicate" Value="1" Icon="content_copy" />
                                            <RadzenSplitButtonItem Text="Clear Topics" Value="3" Icon="playlist_remove" />
                                            <RadzenSplitButtonItem Text="Delete" Value="2" Icon="delete" />
                                        }
                                    </ChildContent>
                                </RadzenSplitButton>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </RadzenCard>
    }
</div>

@code {
    #region class field
    private bool _isLoading = true;
    private bool _isAdmin = false;
    private bool _canCreate = false;

    private int _pageSize = 15;
    private readonly IEnumerable<int> _pageSizeOptions = new int[] { 15, 25, 50, 100 };
    private int _activeGridPageIndex = 0;
    private string _searchText = string.Empty;

    private string _currentUserEmail = string.Empty;
    private HashSet<int> _editableSubscriptionIds = new();
    private HashSet<int> _editableCorporateIds = new();
    private HashSet<int> _editableCompanyIds = new();
    private HashSet<int> _editableFacilityIds = new();

    private List<TbSubscription> _subscriptionsList = new();
    private List<TbCorporate> _corporatesList = new();
    private List<TbCompany> _companiesList = new();

    private int? _selectedSubscriptionId;
    private int? _selectedCorporateId;
    private int? _selectedCompanyId;

    private int _selectedYear = DateTime.UtcNow.Year;
    private int _startMonth = 1;
    private IEnumerable<eTgoScopeNo> _selectedScopes = Enumerable.Empty<eTgoScopeNo>();
    private IEnumerable<int> _selectedActivityGroupIds = Enumerable.Empty<int>();

    private List<TbFacility> _allItems = new();
    private List<TbFacility> _filteredItems = new();
    private Dictionary<int, decimal> _ghgSummary = new();
    private RadzenDataGrid<TbFacility>? _grid;
    private int? _targetFacilityId;
    private int? _highlightFacilityId;
    private int? _pendingGoToPageIndex;
    #endregion

    #region class properties
    [SupplyParameterFromQuery(Name = "nid")]
    public string SecureNewId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "comid")]
    public string SecureComId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "cid")]
    public string SecureCid { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "sid")]
    public string SecureSid { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "gpage")]
    public string SecureGpage { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "yr")]
    public string? SecureYr { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string SecureSearchText { get; set; } = string.Empty;
    #endregion

    #region class methods
    protected override async Task OnInitializedAsync()
    {
        #region hide [2026-08-18]
        _isLoading = true;
        try
        {
            await InitializeUserSessionAsync();
            RestoreStateParameters();

            if (!_selectedSubscriptionId.HasValue && !_isAdmin && _subscriptionsList.Count == 1)
            {
                _selectedSubscriptionId = _subscriptionsList[0].Id;
            }

            UpdateCreatePermission();
            await LoadFilterLookupsAsync();
            await LoadDataAsync();

            if (_highlightFacilityId.HasValue)
            {
                NavigateToSelfState();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Critical error initializing PageListFacility.");
            NotificationService.Notify(NotificationSeverity.Error, "Initialization Error", "Failed to load facility entities.");
        }
        finally
        {
            _isLoading = false;
        }
        #endregion
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isLoading && _grid != null && _pendingGoToPageIndex.HasValue)
        {
            var targetPage = _pendingGoToPageIndex.Value;
            _pendingGoToPageIndex = null;
            if (_grid.CurrentPage != targetPage)
            {
                try
                {
                    await _grid.GoToPage(targetPage);
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error navigating grid to page index {PageIndex}.", targetPage);
                }
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task InitializeUserSessionAsync()
    {
        #region hide [2026-08-18]
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            _currentUserEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? (user.Identity.Name ?? string.Empty);
            _isAdmin = user.IsInRole(SystemRoles.Administrator);
        }

        _editableSubscriptionIds = await SubscriptionService.GetEditableSubscriptionIdsAsync(_currentUserEmail, _isAdmin);
        _subscriptionsList = await SubscriptionService.GetSubscriptionsForUserAsync(_currentUserEmail, _isAdmin, includeInactive: false);
        _editableCorporateIds = await CorporateService.GetEditableCorporateIdsAsync(_currentUserEmail, _isAdmin);
        _editableCompanyIds = await CompanyService.GetEditableCompanyIdsAsync(_currentUserEmail, _isAdmin);
        _editableFacilityIds = await FacilityService.GetEditableFacilityIdsAsync(_currentUserEmail, _isAdmin);
        #endregion
    }

    private void RestoreStateParameters()
    {
        #region hide [2026-08-18]
        var decryptedNewId = DataProtection.UnprotectInt(SecureNewId);
        if (decryptedNewId.HasValue && decryptedNewId.Value > 0)
        {
            _targetFacilityId = decryptedNewId.Value;
        }

        var decryptedComId = DataProtection.UnprotectInt(SecureComId);
        if (decryptedComId.HasValue)
        {
            _selectedCompanyId = decryptedComId.Value;
        }

        var decryptedCid = DataProtection.UnprotectInt(SecureCid);
        if (decryptedCid.HasValue)
        {
            _selectedCorporateId = decryptedCid.Value;
        }

        var decryptedSid = DataProtection.UnprotectInt(SecureSid);
        if (decryptedSid.HasValue)
        {
            _selectedSubscriptionId = decryptedSid.Value;
        }

        var decryptedGpage = DataProtection.UnprotectInt(SecureGpage);
        if (decryptedGpage.HasValue && decryptedGpage.Value >= 0)
        {
            _activeGridPageIndex = decryptedGpage.Value;
        }

        if (!string.IsNullOrWhiteSpace(SecureYr) && int.TryParse(SecureYr, out var yr) && yr > 0)
        {
            _selectedYear = yr;
        }

        var decryptedQ = DataProtection.Unprotect(SecureSearchText);
        if (!string.IsNullOrWhiteSpace(decryptedQ))
        {
            _searchText = decryptedQ;
        }
        #endregion
    }

    private async Task LoadFilterLookupsAsync()
    {
        #region hide [2026-08-18]
        try
        {
            _corporatesList = await CorporateService.GetBySubscriptionIdAsync(
                _selectedSubscriptionId,
                includeCompanies: false,
                includeUsers: false,
                includeInactive: true);

            _companiesList = await CompanyService.GetByCorporateIdAsync(
                _selectedCorporateId,
                _selectedSubscriptionId,
                includeFacilities: false,
                includeInactive: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading filter lookups for Facility page.");
        }
        #endregion
    }

    private void UpdateCreatePermission()
    {
        #region hide [2026-08-18]
        if (_isAdmin)
        {
            _canCreate = true;
            return;
        }

        if (_selectedCompanyId.HasValue)
        {
            _canCreate = _editableCompanyIds.Contains(_selectedCompanyId.Value);
        }
        else if (_selectedCorporateId.HasValue)
        {
            _canCreate = _editableCorporateIds.Contains(_selectedCorporateId.Value);
        }
        else if (_selectedSubscriptionId.HasValue)
        {
            _canCreate = _editableSubscriptionIds.Contains(_selectedSubscriptionId.Value);
        }
        else
        {
            _canCreate = _editableCompanyIds.Count > 0 || _editableCorporateIds.Count > 0 || _editableSubscriptionIds.Count > 0;
        }
        #endregion
    }

    private async Task LoadDataAsync()
    {
        #region hide [2026-08-18]
        try
        {
            _allItems = await FacilityService.GetByContextAsync(
                _selectedSubscriptionId,
                _selectedCorporateId,
                _selectedCompanyId,
                includeTopics: true,
                includeInactive: true);

            _editableFacilityIds = await FacilityService.GetEditableFacilityIdsAsync(
                _currentUserEmail, _isAdmin, _selectedCompanyId, _selectedCorporateId, _selectedSubscriptionId);

            await LoadGhgSummaryAsync();
            ApplyFilter();

            if (_targetFacilityId.HasValue)
            {
                var targetId = _targetFacilityId.Value;
                var targetIndex = _filteredItems.FindIndex(x => x.Id == targetId);
                if (targetIndex >= 0)
                {
                    int effectivePageSize = (_grid != null && _grid.PageSize > 0) ? _grid.PageSize : _pageSize;
                    _activeGridPageIndex = targetIndex / effectivePageSize;
                    _pendingGoToPageIndex = _activeGridPageIndex;
                    _highlightFacilityId = targetId;
                }
                _targetFacilityId = null;
            }
            else if (_activeGridPageIndex > 0)
            {
                _pendingGoToPageIndex = _activeGridPageIndex;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading facility entities.");
            NotificationService.Notify(NotificationSeverity.Error, "Data Load Failed", "Unable to retrieve facility records.");
        }
        #endregion
    }

    private async Task LoadGhgSummaryAsync()
    {
        #region hide [2026-08-21]
        try
        {
            if (_allItems != null && _allItems.Any())
            {
                var ids = _allItems.Select(x => x.Id).ToList();
                _ghgSummary = await FacilityService.GetFacilityGhgSummaryAsync(
                    ids,
                    _selectedYear,
                    _startMonth,
                    _selectedScopes?.ToList(),
                    _selectedActivityGroupIds?.ToList());
            }
            else
            {
                _ghgSummary = new Dictionary<int, decimal>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load GHG summary in PageListFacility");
        }
        #endregion
    }

    private string GetTotalGhgDisplay(int facilityId)
    {
        if (_ghgSummary != null && _ghgSummary.TryGetValue(facilityId, out var val))
        {
            return val.ToString("N2");
        }
        return "0.00";
    }

    private void ApplyFilter()
    {
        #region hide [2026-08-18]
        var query = _allItems.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim().ToLowerInvariant();
            query = query.Where(x =>
                (!string.IsNullOrWhiteSpace(x.Title) && x.Title.ToLower().Contains(term)) ||
                (!string.IsNullOrWhiteSpace(x.Remark) && x.Remark.ToLower().Contains(term)) ||
                (x.Company != null && !string.IsNullOrWhiteSpace(x.Company.Title) && x.Company.Title.ToLower().Contains(term)) ||
                (x.Company != null && !string.IsNullOrWhiteSpace(x.Company.Code) && x.Company.Code.ToLower().Contains(term)));
        }

        _filteredItems = query.ToList();
        #endregion
    }

    private async Task OnFilterChanged()
    {
        #region hide [2026-08-18]
        _activeGridPageIndex = 0;
        _highlightFacilityId = null;
        UpdateCreatePermission();
        await LoadFilterLookupsAsync();
        await LoadDataAsync();
        NavigateToSelfState();
        #endregion
    }

    private void OnGridPageChanged(Radzen.PagerEventArgs args)
    {
        #region hide [2026-08-18]
        _activeGridPageIndex = args.PageIndex;
        _highlightFacilityId = null;
        NavigateToSelfState();
        #endregion
    }

    private void NavigateToSelfState()
    {
        #region hide [2026-08-18]
        var queryParams = new Dictionary<string, object?>();

        if (_selectedCompanyId.HasValue)
            queryParams["comid"] = DataProtection.Protect(_selectedCompanyId.Value);

        if (_selectedCorporateId.HasValue)
            queryParams["cid"] = DataProtection.Protect(_selectedCorporateId.Value);

        if (_selectedSubscriptionId.HasValue)
            queryParams["sid"] = DataProtection.Protect(_selectedSubscriptionId.Value);

        if (_activeGridPageIndex > 0)
            queryParams["gpage"] = DataProtection.Protect(_activeGridPageIndex);

        queryParams["yr"] = _selectedYear.ToString();

        if (!string.IsNullOrWhiteSpace(_searchText))
            queryParams["q"] = DataProtection.Protect(_searchText);

        var url = NavigationManager.GetUriWithQueryParameters("/organization/facility", queryParams);
        NavigationManager.NavigateTo(url, replace: true);
        #endregion
    }

    private bool CanEditFacility(TbFacility item)
    {
        #region hide [2026-08-18]
        if (_isAdmin) return true;
        return _editableFacilityIds.Contains(item.Id) ||
               _editableCompanyIds.Contains(item.CompanyId) ||
               (item.Company != null && _editableCorporateIds.Contains(item.Company.CorporateId)) ||
               (item.Company?.Corporate != null && _editableSubscriptionIds.Contains(item.Company.Corporate.SubscriptionId));
        #endregion
    }

    private void NavigateToAnalytics(TbFacility item)
    {
        var encId = DataProtection.Protect(item.Id);
        var encRet = DataProtection.Protect("/organization/facilities");
        NavigationManager.NavigateTo($"/organization/activity-analytics?id={Uri.EscapeDataString(encId)}&level=3&ret={Uri.EscapeDataString(encRet)}");
    }

    private void NavigateToReportList(TbFacility item)
    {
        var encId = DataProtection.Protect(item.Id);
        var encRet = DataProtection.Protect("/organization/facilities");
        NavigationManager.NavigateTo($"/reports/cfo-reports?id={Uri.EscapeDataString(encId)}&level=3&ret={Uri.EscapeDataString(encRet)}");
    }

    private void NavigateToCreate()
    {
        #region hide [2026-08-18]
        var queryParams = new Dictionary<string, object?>();

        if (_selectedCompanyId.HasValue)
            queryParams["comid"] = DataProtection.Protect(_selectedCompanyId.Value);

        if (_selectedCorporateId.HasValue)
            queryParams["cid"] = DataProtection.Protect(_selectedCorporateId.Value);

        if (_selectedSubscriptionId.HasValue)
            queryParams["sid"] = DataProtection.Protect(_selectedSubscriptionId.Value);

        if (_activeGridPageIndex > 0)
            queryParams["gpage"] = DataProtection.Protect(_activeGridPageIndex);

        if (!string.IsNullOrWhiteSpace(_searchText))
            queryParams["q"] = DataProtection.Protect(_searchText);

        var url = NavigationManager.GetUriWithQueryParameters("/organization/facility/add", queryParams);
        NavigationManager.NavigateTo(url);
        #endregion
    }

    private void OnRowDoubleClick(TbFacility item)
    {
        #region hide [2026-08-18]
        if (item == null) return;
        bool canEdit = CanEditFacility(item);
        var secureId = DataProtection.Protect(item.Id);
        var queryParams = new Dictionary<string, object?>();

        if (_selectedCompanyId.HasValue)
            queryParams["comid"] = DataProtection.Protect(_selectedCompanyId.Value);

        if (_selectedCorporateId.HasValue)
            queryParams["cid"] = DataProtection.Protect(_selectedCorporateId.Value);

        if (_selectedSubscriptionId.HasValue)
            queryParams["sid"] = DataProtection.Protect(_selectedSubscriptionId.Value);

        if (_activeGridPageIndex > 0)
            queryParams["gpage"] = DataProtection.Protect(_activeGridPageIndex);

        if (!string.IsNullOrWhiteSpace(_searchText))
            queryParams["q"] = DataProtection.Protect(_searchText);

        var actionPath = canEdit ? "edit" : "view";
        var url = NavigationManager.GetUriWithQueryParameters($"/organization/facility/{actionPath}/{Uri.EscapeDataString(secureId)}", queryParams);
        NavigationManager.NavigateTo(url);
        #endregion
    }

    private async Task OnSplitButtonClick(RadzenSplitButtonItem args, TbFacility item)
    {
        #region hide [2026-08-18]
        if (args == null || args.Value == null)
        {
            OnRowDoubleClick(item);
            return;
        }

        switch (args.Value.ToString())
        {
            case "1":
                await OnDuplicate(item);
                break;
            case "2":
                await ConfirmDelete(item);
                break;
            case "3":
                await ConfirmClearTopics(item);
                break;
        }
        #endregion
    }

    private async Task ConfirmClearTopics(TbFacility item)
    {
        #region hide [2026-08-29]
        if (item == null) return;

        var confirmed = await DialogService.Confirm(
            "Are you sure you want to clear all activity topics for this facility?",
            "Clear Topics Confirmation",
            new ConfirmOptions { OkButtonText = "Clear Topics", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                var clearedCount = await TopicService.ClearTopicsByTargetAsync(eTopicLevel.Facility, item.Id);
                if (clearedCount > 0)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Topics Cleared", $"Successfully cleared {clearedCount} activity topic(s).");
                }
                else
                {
                    NotificationService.Notify(NotificationSeverity.Info, "Notice", "There are no activity topics to clear.");
                }
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error clearing topics for Facility ID: {Id}", item.Id);
                NotificationService.Notify(NotificationSeverity.Error, "Action Failed", "Failed to clear activity topics.");
            }
        }
        #endregion
    }

    private async Task OnDuplicate(TbFacility item)
    {
        #region hide [2026-08-18]
        try
        {
            if (item == null) return;

            var dup = await FacilityService.DuplicateAsync(item.Id);
            NotificationService.Notify(NotificationSeverity.Success, "Duplicated", $"Facility duplicated as '{dup.Title}'.");
            _targetFacilityId = dup.Id;
            await LoadDataAsync();
            if (_grid != null && _pendingGoToPageIndex.HasValue)
            {
                var targetPage = _pendingGoToPageIndex.Value;
                _pendingGoToPageIndex = null;
                if (_grid.CurrentPage != targetPage)
                {
                    await _grid.GoToPage(targetPage);
                }
            }
            NavigateToSelfState();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error duplicating facility ID: {Id}", item.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Duplicate Failed", ex.Message);
        }
        #endregion
    }

    private async Task ConfirmDelete(TbFacility item)
    {
        #region hide [2026-08-18]
        var confirmed = await DialogService.Confirm(
            "Are you sure you want to delete this facility?",
            "Delete Facility",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                var success = await FacilityService.DeleteAsync(item.Id);
                if (success)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Deleted", $"Facility '{item.Title}' deleted successfully.");
                    await LoadDataAsync();
                    int effectivePageSize = (_grid != null && _grid.PageSize > 0) ? _grid.PageSize : _pageSize;
                    int maxPage = Math.Max(0, (int)Math.Ceiling(_filteredItems.Count / (double)effectivePageSize) - 1);
                    if (_activeGridPageIndex > maxPage)
                    {
                        _activeGridPageIndex = maxPage;
                    }
                    if (_grid != null && _grid.CurrentPage != _activeGridPageIndex)
                    {
                        await _grid.GoToPage(_activeGridPageIndex);
                    }
                    NavigateToSelfState();
                }
                else
                {
                    NotificationService.Notify(NotificationSeverity.Warning, "Warning", "Facility could not be deleted.");
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting facility ID: {Id}", item.Id);
                NotificationService.Notify(NotificationSeverity.Error, "Delete Failed", ex.Message);
            }
        }
        #endregion
    }

    private void NavigateToTopicList(TbFacility item)
    {
        #region hide [2026-08-18]
        var secureFacId = DataProtection.Protect(item.Id);
        NavigationManager.NavigateTo($"/library/activity-topics?facid={Uri.EscapeDataString(secureFacId)}&ptype=Facility");
        #endregion
    }

    private void NavigateToCompanyList()
    {
        var queryParams = new Dictionary<string, object?>();

        if (_selectedCorporateId.HasValue && _selectedCorporateId.Value > 0)
        {
            queryParams["cid"] = DataProtection.Protect(_selectedCorporateId.Value);
        }
        else if (_selectedCompanyId.HasValue && _selectedCompanyId.Value > 0)
        {
            var comp = _companiesList.FirstOrDefault(c => c.Id == _selectedCompanyId.Value);
            if (comp != null && comp.CorporateId > 0)
            {
                queryParams["cid"] = DataProtection.Protect(comp.CorporateId);
            }
        }

        if (_selectedSubscriptionId.HasValue && _selectedSubscriptionId.Value > 0)
        {
            queryParams["sid"] = DataProtection.Protect(_selectedSubscriptionId.Value);
        }

        queryParams["yr"] = _selectedYear.ToString();

        var url = NavigationManager.GetUriWithQueryParameters("/organization/company", queryParams);
        NavigationManager.NavigateTo(url);
    }

    private void OnRowRender(RowRenderEventArgs<TbFacility> args)
    {
        if (_highlightFacilityId.HasValue && args.Data.Id == _highlightFacilityId.Value)
        {
            if (args.Attributes.TryGetValue("style", out var existingStyle) && existingStyle != null)
            {
                args.Attributes["style"] = $"{existingStyle}; background-color: var(--rz-primary-lighter, #e8f0fe) !important; font-weight: 600;";
            }
            else
            {
                args.Attributes["style"] = "background-color: var(--rz-primary-lighter, #e8f0fe) !important; font-weight: 600;";
            }
        }
    }
    #endregion
}
