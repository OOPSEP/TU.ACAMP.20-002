        }

        ApplyDragAttributes(args);
        #endregion
    }

    /// <summary>
    /// ผูก HTML5 Drag Events ให้กับแถวของตาราง (เฉพาะรายการที่มีสิทธิ์แก้ไข)
    /// [v3] ปิดการลาก-วางเมื่อกำลังเรียงลำดับด้วย tCO2e
    /// </summary>
    private void ApplyDragAttributes(RowRenderEventArgs<TbFacility> args)
    {
        #region hide [2026-09-14]
        var item = args.Data;
        if (item == null) return;

        if (_ghgSortDirection.HasValue)
        {
            args.Attributes["title"] = "Clear the tCO2e sort to reorder facilities.";
            return;
        }

        if (!CanEditFacility(item))
        {
            args.Attributes["title"] = "You do not have permission to reorder this facility.";
            return;
        }

        args.Attributes["draggable"] = "true";
        args.Attributes["title"] = "Drag to reorder within the same company.";

        var style = args.Attributes.TryGetValue("style", out var current) && current != null
            ? current.ToString()
            : string.Empty;
        args.Attributes["style"] = string.IsNullOrWhiteSpace(style) ? "cursor: grab;" : $"{style}; cursor: grab;";

        args.Attributes["ondragstart"] = EventCallback.Factory.Create<DragEventArgs>(this, () => _draggedFacility = item);

        args.Attributes["ondragover"] =
            "event.preventDefault();var r=event.target.closest('.rz-data-row');if(r){document.querySelectorAll('.facility-drop-target').forEach(function(e){e.classList.remove('facility-drop-target');});r.classList.add('facility-drop-target');}";

        args.Attributes["ondragleave"] =
            "var r=event.target.closest('.rz-data-row');if(r){r.classList.remove('facility-drop-target');}";

        args.Attributes["ondragend"] =
            "document.querySelectorAll('.facility-drop-target').forEach(function(e){e.classList.remove('facility-drop-target');});";

        args.Attributes["ondrop"] = EventCallback.Factory.Create<DragEventArgs>(this, async () => await OnFacilityRowDropAsync(item));
        #endregion
    }

    /// <summary>
    /// จัดลำดับใหม่เมื่อวางแถว โดยอนุญาตเฉพาะการวางภายในบริษัทเดียวกัน
    /// </summary>
    private async Task OnFacilityRowDropAsync(TbFacility targetItem)
    {
        #region hide [2026-09-14]
        var sourceItem = _draggedFacility;
        _draggedFacility = null;

        try
        {
            await ClearDropHighlightAsync();

            if (_ghgSortDirection.HasValue) return;
            if (sourceItem == null || targetItem == null) return;
            if (sourceItem.Id == targetItem.Id) return;

            if (sourceItem.CompanyId != targetItem.CompanyId)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Reorder Blocked",
                    "Facilities can be reordered only within the same company.");
                return;
            }

            if (!CanEditFacility(sourceItem))
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Permission Denied",
                    "You do not have permission to reorder this facility.");
                return;
            }

            var peers = GetFacilityPeers(sourceItem.CompanyId);
            var fromIdx = peers.FindIndex(f => f.Id == sourceItem.Id);
            var toIdx = peers.FindIndex(f => f.Id == targetItem.Id);
            if (fromIdx < 0 || toIdx < 0 || fromIdx == toIdx) return;

            var moving = peers[fromIdx];
            peers.RemoveAt(fromIdx);

            var insertAt = peers.FindIndex(f => f.Id == targetItem.Id);
            if (insertAt < 0) return;
            if (fromIdx < toIdx) insertAt += 1; // ลากลง = วางต่อท้ายแถวเป้าหมาย
            peers.Insert(insertAt, moving);

            await FacilityService.ReorderFacilitiesInCompanyAsync(peers.Select(f => f.Id).ToList(), _currentUserEmail);

            _highlightFacilityId = sourceItem.Id;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reorder facilities by drag and drop");
            NotificationService.Notify(NotificationSeverity.Error, "Reorder Error", "Failed to reorder items.");
        }
        #endregion
    }

    private async Task ClearDropHighlightAsync()
    {
        #region hide [2026-09-14]
        try
        {
            await JSRuntime.InvokeVoidAsync("eval",
                "document.querySelectorAll('.facility-drop-target').forEach(function(e){e.classList.remove('facility-drop-target');});");
        }
        catch
        {
            // ไม่ถือเป็นข้อผิดพลาดร้ายแรง หากล้าง Highlight ไม่สำเร็จ
        }
        #endregion
    }
    #endregion
}
