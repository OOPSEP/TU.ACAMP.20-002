    private void ApplyFilter()
    {
        #region hide [2026-09-14]
        var query = _allItems.AsEnumerable();

        // [v3] กรองด้วย Corporate / Company ที่เลือกไว้หลายรายการ
        var corporateIds = CorporateIdList;
        if (corporateIds.Count > 0)
        {
            var corpSet = corporateIds.ToHashSet();
            query = query.Where(x => x.Company != null && corpSet.Contains(x.Company.CorporateId));
        }

        var companyIds = CompanyIdList;
        if (companyIds.Count > 0)
        {
            var compSet = companyIds.ToHashSet();
            query = query.Where(x => compSet.Contains(x.CompanyId));
        }

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim().ToLowerInvariant();
            query = query.Where(x =>
                (!string.IsNullOrWhiteSpace(x.Title) && x.Title.ToLower().Contains(term)) ||
                (!string.IsNullOrWhiteSpace(x.Remark) && x.Remark.ToLower().Contains(term)) ||
                (x.Company != null && !string.IsNullOrWhiteSpace(x.Company.Title) && x.Company.Title.ToLower().Contains(term)) ||
                (x.Company != null && !string.IsNullOrWhiteSpace(x.Company.Code) && x.Company.Code.ToLower().Contains(term)));
        }

        _filteredItems = SortForDisplay(query).ToList();
        #endregion
    }

    /// <summary>
    /// ลำดับการแสดงผล: ถ้าผู้ใช้สั่งเรียงด้วย tCO2e ให้ใช้ค่าปล่อยก๊าซเป็นหลัก
    /// มิฉะนั้นใช้ลำดับมาตรฐานของหน้า (จัดกลุ่มตามบริษัท แล้วเรียงตาม OrderId)
    /// </summary>
    private IEnumerable<TbFacility> SortForDisplay(IEnumerable<TbFacility> source)
    {
        #region hide [2026-09-15]
        // [2026-09-15][Claude] การเรียงด้วย tCO2e เป็นหน้าที่ของ DataGrid แล้ว ที่นี่คงไว้เฉพาะลำดับมาตรฐานของหน้า
        return source
            .OrderBy(f => f.Company != null ? f.Company.Code : string.Empty)
            .ThenBy(f => f.CompanyId)
            .ThenBy(f => f.OrderId)
            .ThenBy(f => f.Title);
        #endregion
    }

    /// <summary>ลำดับมาตรฐานของหน้า (ใช้เป็นขอบเขตการจัดลำดับ Drag &amp; Drop เท่านั้น)</summary>
    private static IEnumerable<TbFacility> SortByCompanyOrder(IEnumerable<TbFacility> source)
    {
        return source
            .OrderBy(f => f.Company != null ? f.Company.Code : string.Empty)
            .ThenBy(f => f.CompanyId)
            .ThenBy(f => f.OrderId)
            .ThenBy(f => f.Title);
    }

