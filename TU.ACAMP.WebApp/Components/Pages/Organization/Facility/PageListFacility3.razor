    private Dictionary<string, object?> BuildStateQueryParams(bool includeYear)
    {
        #region hide [2026-09-14]
        var queryParams = new Dictionary<string, object?>();

        var companyIds = CompanyIdList;
        if (companyIds.Count > 0)
            queryParams["comids"] = DataProtection.Protect(string.Join(",", companyIds));

        var corporateIds = CorporateIdList;
        if (corporateIds.Count > 0)
            queryParams["cids"] = DataProtection.Protect(string.Join(",", corporateIds));

        if (_selectedSubscriptionId.HasValue)
            queryParams["sid"] = DataProtection.Protect(_selectedSubscriptionId.Value);

        if (_activeGridPageIndex > 0)
            queryParams["gpage"] = DataProtection.Protect(_activeGridPageIndex);

        if (includeYear)
            queryParams["yr"] = _selectedYear.ToString();

        if (!string.IsNullOrWhiteSpace(_searchText))
            queryParams["q"] = DataProtection.Protect(_searchText);

        return queryParams;
        #endregion
    }

