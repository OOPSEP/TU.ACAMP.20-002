    /// <summary>
    /// ผูก HTML5 Drag Events ให้กับแถวของตาราง (เฉพาะรายการที่มีสิทธิ์แก้ไข)
    /// </summary>
    // [2026-09-15][Claude] จำสถานะว่ากำลังเรียงด้วยคอลัมน์ tCO2e อยู่หรือไม่ เพื่อปิด Drag & Drop ชั่วคราว (ลำดับที่เห็นไม่ตรงกับ OrderId)
    private void OnGridColumnSort(DataGridColumnSortEventArgs<TbCorporate> args)
    {
        #region hide [2026-09-15]
        _isSortedByGhg = args.SortOrder.HasValue
            && string.Equals(args.Column?.Property, nameof(TbCorporate.TotalGhg), StringComparison.Ordinal);
        #endregion
    }

    private void OnRowRender(RowRenderEventArgs<TbCorporate> args)
    {
        #region hide [2026-09-11]
        var item = args.Data;
        if (item == null) return;

        if (_isSortedByGhg)
        {
            args.Attributes["title"] = "Drag & drop is disabled while sorting by tCO2e.";
            return;
        }

        if (!CanEditCorporate(item))
        {
            args.Attributes["title"] = "You do not have permission to reorder this corporate group.";
            return;
        }

        args.Attributes["draggable"] = "true";
        args.Attributes["title"] = "Drag to reorder within the same subscription.";

        var style = args.Attributes.TryGetValue("style", out var current) && current != null
            ? current.ToString()
            : string.Empty;
        args.Attributes["style"] = string.IsNullOrWhiteSpace(style) ? "cursor: grab;" : $"{style}; cursor: grab;";

        args.Attributes["ondragstart"] = EventCallback.Factory.Create<DragEventArgs>(this, () => _draggedCorporate = item);

        args.Attributes["ondragover"] =
            "event.preventDefault();var r=event.target.closest('.rz-data-row');if(r){document.querySelectorAll('.corporate-drop-target').forEach(function(e){e.classList.remove('corporate-drop-target');});r.classList.add('corporate-drop-target');}";

        args.Attributes["ondragleave"] =
            "var r=event.target.closest('.rz-data-row');if(r){r.classList.remove('corporate-drop-target');}";

        args.Attributes["ondragend"] =
            "document.querySelectorAll('.corporate-drop-target').forEach(function(e){e.classList.remove('corporate-drop-target');});";

        args.Attributes["ondrop"] = EventCallback.Factory.Create<DragEventArgs>(this, async () => await OnCorporateRowDropAsync(item));
        #endregion
    }

    /// <summary>
    /// จัดลำดับใหม่เมื่อวางแถว โดยอนุญาตเฉพาะการวางภายใน Subscription เดียวกัน
    /// </summary>
    private async Task OnCorporateRowDropAsync(TbCorporate targetItem)
    {
        #region hide [2026-09-11]
        var sourceItem = _draggedCorporate;
        _draggedCorporate = null;

        try
        {
            await ClearDropHighlightAsync();

            if (sourceItem == null || targetItem == null) return;
            if (sourceItem.Id == targetItem.Id) return;

            if (sourceItem.SubscriptionId != targetItem.SubscriptionId)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Reorder Blocked",
                    "Corporate groups can be reordered only within the same subscription.");
                return;
            }

            if (!CanEditCorporate(sourceItem))
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Permission Denied",
                    "You do not have permission to reorder this corporate group.");
                return;
            }

            var peers = GetCorporatePeers(sourceItem.SubscriptionId);
            var fromIdx = peers.FindIndex(c => c.Id == sourceItem.Id);
            var toIdx = peers.FindIndex(c => c.Id == targetItem.Id);
            if (fromIdx < 0 || toIdx < 0 || fromIdx == toIdx) return;

            var moving = peers[fromIdx];
            peers.RemoveAt(fromIdx);

            var insertAt = peers.FindIndex(c => c.Id == targetItem.Id);
            if (insertAt < 0) return;
            if (fromIdx < toIdx) insertAt += 1; // ลากลง = วางต่อท้ายแถวเป้าหมาย
            peers.Insert(insertAt, moving);

            await CorporateService.ReorderCorporatesInSubscriptionAsync(peers.Select(c => c.Id).ToList(), _currentUserEmail);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reorder corporate groups by drag and drop");
            NotificationService.Notify(NotificationSeverity.Error, "Reorder Error", "Failed to reorder items.");
        }
        #endregion
    }

    private async Task ClearDropHighlightAsync()
    {
        #region hide [2026-09-11]
        try
        {
            await JSRuntime.InvokeVoidAsync("eval",
                "document.querySelectorAll('.corporate-drop-target').forEach(function(e){e.classList.remove('corporate-drop-target');});");
        }
        catch
        {
            // ไม่ถือเป็นข้อผิดพลาดร้ายแรง หากล้าง Highlight ไม่สำเร็จ
        }
        #endregion
    }
    #endregion
