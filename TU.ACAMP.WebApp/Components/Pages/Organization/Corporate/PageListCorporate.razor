    private BadgeStyle GetPlanBadgeStyle(eSubscriptionPlan plan)
    {
        #region hide [2026-08-17]
        return plan switch
        {
            eSubscriptionPlan.Basic => BadgeStyle.Secondary,
            eSubscriptionPlan.Pro => BadgeStyle.Info,
            eSubscriptionPlan.Premium => BadgeStyle.Primary,
            eSubscriptionPlan.Enterprise => BadgeStyle.Success,
            _ => BadgeStyle.Light
        };
        #endregion
    }
    #endregion
