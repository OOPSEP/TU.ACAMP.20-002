            var summarySheet = workbook.Worksheets.Add("Executive Insights");
            summarySheet.ShowGridLines = true;

            // Title Banner
            var titleCell = summarySheet.Cell(1, 1);
            titleCell.Value = "ORGANIZATION GHG ACTIVITY DATA ANALYTICS & INSIGHTS REPORT";
            titleCell.Style.Font.Bold = true;
            titleCell.Style.Font.FontSize = 14;
            titleCell.Style.Font.FontColor = XLColor.White;
            titleCell.Style.Fill.BackgroundColor = XLColor.FromHtml("#0F5132");
            summarySheet.Range(1, 1, 1, 6).Merge();

            // Metadata Block
            summarySheet.Cell(3, 1).Value = "Organization Title:";
            summarySheet.Cell(3, 1).Style.Font.Bold = true;
            summarySheet.Cell(3, 2).Value = _orgTitle;

            summarySheet.Cell(4, 1).Value = "Analytics Level:";
            summarySheet.Cell(4, 1).Style.Font.Bold = true;
            summarySheet.Cell(4, 2).Value = $"{_levelDisplay} Level";

            summarySheet.Cell(5, 1).Value = "Fiscal Month Start:";
            summarySheet.Cell(5, 1).Style.Font.Bold = true;
            summarySheet.Cell(5, 2).Value = _monthsList.FirstOrDefault(m => m.Value == _startMonth)?.Text ?? "January (01)";

            summarySheet.Cell(6, 1).Value = "Report Export Date:";
            summarySheet.Cell(6, 1).Style.Font.Bold = true;
            summarySheet.Cell(6, 2).Value = AppTimeZone.LocalNow.ToString("dd MMMM yyyy HH:mm:ss", CultureInfo.InvariantCulture);

            summarySheet.Cell(7, 1).Value = "Total GHG Footprint:";
            summarySheet.Cell(7, 1).Style.Font.Bold = true;
            summarySheet.Cell(7, 2).Value = (double)(_overallTotalKg / 1000m);
            summarySheet.Cell(7, 2).Style.NumberFormat.Format = "#,##0.00 \"tCO2e\"";
            summarySheet.Cell(7, 2).Style.Font.Bold = true;
            summarySheet.Cell(7, 2).Style.Font.FontColor = XLColor.DarkGreen;

            // Section 1: Scope Emissions Breakdown Table
            summarySheet.Cell(9, 1).Value = "1. Scope Emissions Breakdown Summary";
            summarySheet.Cell(9, 1).Style.Font.Bold = true;
            summarySheet.Cell(9, 1).Style.Font.FontSize = 11;

            var scopeHeaders = new[] { "Scope Category", "Scope Description", "Emissions (kgCO2e)", "Emissions (tCO2e)", "Overall Share (%)" };
            for (int c = 0; c < scopeHeaders.Length; c++)
            {
                var hCell = summarySheet.Cell(10, c + 1);
                hCell.Value = scopeHeaders[c];
                hCell.Style.Font.Bold = true;
                hCell.Style.Font.FontColor = XLColor.White;
                hCell.Style.Fill.BackgroundColor = XLColor.FromHtml("#1E293B");
                hCell.Style.Alignment.Horizontal = c >= 2 ? XLAlignmentHorizontalValues.Right : XLAlignmentHorizontalValues.Left;
            }

            int scopeRow = 11;
            foreach (var sTab in individualScopeTabs)
            {
                summarySheet.Cell(scopeRow, 1).Value = $"Scope {(int)sTab.ScopeNo}";
                summarySheet.Cell(scopeRow, 2).Value = sTab.ScopeName;

                var kgCell = summarySheet.Cell(scopeRow, 3);
                kgCell.Value = (double)sTab.TotalKgCO2e;
                kgCell.Style.NumberFormat.Format = "#,##0.00";

                var tCell = summarySheet.Cell(scopeRow, 4);
                tCell.Value = (double)(sTab.TotalKgCO2e / 1000m);
                tCell.Style.NumberFormat.Format = "#,##0.00";

                var pctCell = summarySheet.Cell(scopeRow, 5);
                pctCell.Value = _overallTotalKg > 0 ? (double)(sTab.TotalKgCO2e / _overallTotalKg) : 0.0;
                pctCell.Style.NumberFormat.Format = "0.0%";

                scopeRow++;
            }

            // Total Scope Row
            summarySheet.Cell(scopeRow, 1).Value = "Total Footprint";
            summarySheet.Cell(scopeRow, 1).Style.Font.Bold = true;
            summarySheet.Cell(scopeRow, 2).Value = "All Scopes Consolidated";
            summarySheet.Cell(scopeRow, 2).Style.Font.Bold = true;

            var totKgCell = summarySheet.Cell(scopeRow, 3);
            totKgCell.Value = (double)_overallTotalKg;
            totKgCell.Style.NumberFormat.Format = "#,##0.00";
            totKgCell.Style.Font.Bold = true;

            var totTCell = summarySheet.Cell(scopeRow, 4);
            totTCell.Value = (double)(_overallTotalKg / 1000m);
            totTCell.Style.NumberFormat.Format = "#,##0.00";
            totTCell.Style.Font.Bold = true;

            var totPctCell = summarySheet.Cell(scopeRow, 5);
            totPctCell.Value = 1.0;
            totPctCell.Style.NumberFormat.Format = "0.0%";
            totPctCell.Style.Font.Bold = true;

            summarySheet.Range(scopeRow, 1, scopeRow, 5).Style.Border.TopBorder = XLBorderStyleValues.Thin;
            summarySheet.Range(scopeRow, 1, scopeRow, 5).Style.Border.BottomBorder = XLBorderStyleValues.Double;

            // Section 2: GHG Hotspots (Pareto: largest groups that together reach the cut-off) [2026-09-24][Claude]
            var exportHotspots = AnalyzeHotspots(allScopesTab.ActivityGroups);
            int hotspotStartRow = scopeRow + 3;
            summarySheet.Cell(hotspotStartRow, 1).Value = $"2. GHG Hotspots - Pareto Analysis (largest activity groups that together make up >= {HotspotCutoffText} of total)";
            summarySheet.Cell(hotspotStartRow, 1).Style.Font.Bold = true;
            summarySheet.Cell(hotspotStartRow, 1).Style.Font.FontSize = 11;

            var hotspotHeaders = new[] { "Rank", "Scope", "Activity Code", "Activity Group Title", "Emissions (tCO2e)", "Overall Share (%)", "Cumulative Share (%)", "Hotspot Status" };
            for (int c = 0; c < hotspotHeaders.Length; c++)
            {
                var hCell = summarySheet.Cell(hotspotStartRow + 1, c + 1);
                hCell.Value = hotspotHeaders[c];
                hCell.Style.Font.Bold = true;
                hCell.Style.Font.FontColor = XLColor.White;
                hCell.Style.Fill.BackgroundColor = XLColor.FromHtml("#991B1B");
                hCell.Style.Alignment.Horizontal = c >= 4 ? XLAlignmentHorizontalValues.Right : XLAlignmentHorizontalValues.Left;
            }

            int hRow = hotspotStartRow + 2;
            int rank = 1;
            var hotspotGroups = allScopesTab.ActivityGroups
                .Where(a => exportHotspots.ContainsKey(a.ActivityGroupId))
                .OrderBy(a => exportHotspots[a.ActivityGroupId].Rank)
                .ToList();
            foreach (var ag in hotspotGroups)
            {
                var hs = exportHotspots[ag.ActivityGroupId];
                summarySheet.Cell(hRow, 1).Value = hs.Rank;
                rank++;
                summarySheet.Cell(hRow, 2).Value = ag.ScopeName;
                summarySheet.Cell(hRow, 3).Value = ag.Code;
                summarySheet.Cell(hRow, 4).Value = ag.Title;

                var tCell = summarySheet.Cell(hRow, 5);
                tCell.Value = (double)(ag.KgCO2e / 1000m);
                tCell.Style.NumberFormat.Format = "#,##0.00";

                var pctCell = summarySheet.Cell(hRow, 6);
                pctCell.Value = (double)(ag.OverallSharePercent / 100m);
                pctCell.Style.NumberFormat.Format = "0.0%";

                var cumCell = summarySheet.Cell(hRow, 7);
                cumCell.Value = (double)(hs.CumulativePercent / 100m);
                cumCell.Style.NumberFormat.Format = "0.0%";

                var statCell = summarySheet.Cell(hRow, 8);
                statCell.Value = $"🔥 HOTSPOT #{hs.Rank}";
                statCell.Style.Font.Bold = true;
                statCell.Style.Font.FontColor = XLColor.DarkRed;
                statCell.Style.Fill.BackgroundColor = XLColor.FromHtml("#FEE2E2");

                hRow++;
            }

            if (rank == 1)
            {
                summarySheet.Cell(hRow, 1).Value = "- No emissions recorded, no hotspot identified -";
                summarySheet.Range(hRow, 1, hRow, 8).Merge();
                summarySheet.Cell(hRow, 1).Style.Font.Italic = true;
            }

            summarySheet.Columns().AdjustToContents();

            // ==========================================
            // SHEET 2: 🗂️ Activity Group Breakdown
            // ==========================================
            var groupSheet = workbook.Worksheets.Add("Activity Group Breakdown");
            groupSheet.ShowGridLines = true;

            var gHeaders = new[] { "#", "Scope Category", "Activity Code", "Activity Group Title", "Emissions (kgCO2e)", "Emissions (tCO2e)", "Scope Share (%)", "Overall Share (%)", "Hotspot Status", "Topics Count" };
            for (int col = 0; col < gHeaders.Length; col++)
            {
                var hCell = groupSheet.Cell(1, col + 1);
                hCell.Value = gHeaders[col];
                hCell.Style.Font.Bold = true;
                hCell.Style.Font.FontColor = XLColor.White;
                hCell.Style.Fill.BackgroundColor = XLColor.FromHtml("#0F5132");
                hCell.Style.Alignment.Horizontal = col >= 4 && col <= 7 ? XLAlignmentHorizontalValues.Right : XLAlignmentHorizontalValues.Left;
            }

            int gRow = 2;
            foreach (var ag in allScopesTab.ActivityGroups)
            {
                bool isHotspot = exportHotspots.TryGetValue(ag.ActivityGroupId, out var groupHs);

                groupSheet.Cell(gRow, 1).Value = gRow - 1;
                groupSheet.Cell(gRow, 2).Value = ag.ScopeName;
                groupSheet.Cell(gRow, 3).Value = ag.Code;
                groupSheet.Cell(gRow, 4).Value = ag.Title;

                var kgCell = groupSheet.Cell(gRow, 5);
                kgCell.Value = (double)ag.KgCO2e;
                kgCell.Style.NumberFormat.Format = "#,##0.00";

                var tCell = groupSheet.Cell(gRow, 6);
                tCell.Value = (double)(ag.KgCO2e / 1000m);
                tCell.Style.NumberFormat.Format = "#,##0.00";

                var scopePctCell = groupSheet.Cell(gRow, 7);
                scopePctCell.Value = (double)(ag.SharePercent / 100m);
                scopePctCell.Style.NumberFormat.Format = "0.0%";

                var overallPctCell = groupSheet.Cell(gRow, 8);
                overallPctCell.Value = (double)(ag.OverallSharePercent / 100m);
                overallPctCell.Style.NumberFormat.Format = "0.0%";

                var statCell = groupSheet.Cell(gRow, 9);
                statCell.Value = isHotspot ? $"🔥 HOTSPOT #{groupHs!.Rank} (Top {HotspotCutoffText})" : "Normal";
                if (isHotspot)
                {
                    statCell.Style.Font.Bold = true;
                    statCell.Style.Font.FontColor = XLColor.DarkRed;
                    statCell.Style.Fill.BackgroundColor = XLColor.FromHtml("#FEE2E2");
                }

                groupSheet.Cell(gRow, 10).Value = ag.Topics?.Count ?? 0;

                gRow++;
            }

            groupSheet.Columns().AdjustToContents();

            // ==========================================
            // SHEET 3: 📌 Detailed Topic & Emission Source Audit Trail
            // ==========================================
            var auditSheet = workbook.Worksheets.Add("Topic & Emission Source Audit");
            auditSheet.ShowGridLines = true;

            var aHeaders = new[] { "#", "Scope Category", "Activity Code", "Activity Group Title", "Topic Title / Activity Item", "Master Emission Source", "Unit", "Recorded Quantity", "EF (kgCO2e/unit)", "Emissions (kgCO2e)", "Emissions (tCO2e)" };
            for (int col = 0; col < aHeaders.Length; col++)
            {
                var hCell = auditSheet.Cell(1, col + 1);
                hCell.Value = aHeaders[col];
                hCell.Style.Font.Bold = true;
                hCell.Style.Font.FontColor = XLColor.White;
                hCell.Style.Fill.BackgroundColor = XLColor.FromHtml("#1E293B");
                hCell.Style.Alignment.Horizontal = col >= 7 ? XLAlignmentHorizontalValues.Right : XLAlignmentHorizontalValues.Left;
            }

            int aRow = 2;
            int auditIndex = 1;
            foreach (var ag in allScopesTab.ActivityGroups)
            {
                foreach (var topic in ag.Topics)
                {
                    auditSheet.Cell(aRow, 1).Value = auditIndex++;
                    auditSheet.Cell(aRow, 2).Value = ag.ScopeName;
                    auditSheet.Cell(aRow, 3).Value = ag.Code;
                    auditSheet.Cell(aRow, 4).Value = ag.Title;
                    auditSheet.Cell(aRow, 5).Value = topic.TopicTitle;
                    auditSheet.Cell(aRow, 6).Value = topic.SourceName;
                    auditSheet.Cell(aRow, 7).Value = topic.UnitName;

                    var qtyCell = auditSheet.Cell(aRow, 8);
                    qtyCell.Value = (double)topic.Quantity;
                    qtyCell.Style.NumberFormat.Format = "#,##0.00";

                    var efCell = auditSheet.Cell(aRow, 9);
                    efCell.Value = (double)topic.EF;
                    efCell.Style.NumberFormat.Format = "0.000000";

                    var kgCell = auditSheet.Cell(aRow, 10);
                    kgCell.Value = (double)topic.KgCO2e;
                    kgCell.Style.NumberFormat.Format = "#,##0.00";

                    var tCell = auditSheet.Cell(aRow, 11);
                    tCell.Value = (double)(topic.KgCO2e / 1000m);
                    tCell.Style.NumberFormat.Format = "#,##0.00";

                    aRow++;
                }
            }

            auditSheet.Columns().AdjustToContents();

            // Save & Download
            using var ms = new MemoryStream();
            workbook.SaveAs(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());

            // [2026-09-21][Gemini] Standard Export Filename: ghg_analytics_{orgTitle}_{date}_{time}.xlsx
            var fileName = ExportFileNameHelper.Generate("ghg_analytics", _orgTitle, fallback: "org");
            await JSRuntime.InvokeVoidAsync("saveAsFile", fileName, base64);
            NotificationService.Notify(NotificationSeverity.Success, "Export Successful", "Detailed GHG Activity Analytics Excel Report exported successfully.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting detailed analytics report to Excel.");
            NotificationService.Notify(NotificationSeverity.Error, "Export Failed", ex.Message);
        }
    }
