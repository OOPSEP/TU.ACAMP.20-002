            var allYearsGroup = _yearGroups.FirstOrDefault(y => y.Year == 0) ?? _yearGroups.First();
            var allScopesTab = allYearsGroup.Scopes.FirstOrDefault(s => s.ScopeNo == 0) ?? allYearsGroup.Scopes.First();
