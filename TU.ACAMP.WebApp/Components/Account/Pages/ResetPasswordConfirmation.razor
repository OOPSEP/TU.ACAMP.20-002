@page "/Account/ResetPasswordConfirmation"

<PageTitle>Password Reset Successful - ACAMP</PageTitle>

<div class="w-full max-w-md mx-auto">
    <!-- Logo & Header -->
    <div class="flex flex-col items-center text-center mb-8">
        <div class="w-28 h-28 mb-4 flex items-center justify-center bg-transparent">
            <img src="images/ACAMP_logo_transparent.png" class="w-full h-full object-contain" alt="ACAMP Logo" onerror="this.src='images/acamp_logo.png';" />
        </div>
        <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Password reset complete</h1>
        <p class="mt-2 text-sm text-gray-500">Your password has been successfully updated.</p>
    </div>

    <!-- Success Card -->
    <div class="bg-white rounded-2xl shadow-xl shadow-gray-200/60 border border-gray-100 p-8 text-center">
        <div class="w-14 h-14 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4 text-emerald-600">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
        </div>
        <p class="text-sm text-gray-600 mb-6">
            You can now sign in with your new password.
        </p>
        <a href="Account/Login"
           class="inline-block w-full py-2.5 px-4 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 focus:ring-4 focus:ring-emerald-200 rounded-xl shadow-lg shadow-emerald-200 transition-all duration-200">
            Sign in now
        </a>
    </div>
</div>
