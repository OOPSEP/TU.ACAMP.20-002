@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Check Your Email - ACAMP</PageTitle>

<div class="w-full max-w-md mx-auto">
    <!-- Logo & Header -->
    <div class="flex flex-col items-center text-center mb-8">
        <div class="w-28 h-28 mb-4 flex items-center justify-center bg-transparent">
            <img src="images/ACAMP_logo_transparent.png" class="w-full h-full object-contain" alt="ACAMP Logo" onerror="this.src='images/acamp_logo.png';" />
        </div>
        <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Check your email</h1>
        <p class="mt-2 text-sm text-gray-500">Password reset instructions sent</p>
    </div>

    <!-- Confirmation Card -->
    <div class="bg-white rounded-2xl shadow-xl shadow-gray-200/60 border border-gray-100 p-8 text-center">
        <div class="w-14 h-14 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4 text-emerald-600">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
        </div>
        <p class="text-sm text-gray-600 mb-6">
            If an account matching your email exists and has been confirmed, we've sent instructions to reset your password. Please check your inbox and spam folder.
        </p>
        <a href="Account/Login"
           class="inline-block w-full py-2.5 px-4 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 focus:ring-4 focus:ring-emerald-200 rounded-xl shadow-lg shadow-emerald-200 transition-all duration-200">
            Back to Sign in
        </a>
    </div>
</div>
