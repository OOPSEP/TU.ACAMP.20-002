@page "/Account/RegisterConfirmation"

@using System.Text
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Hosting
@using TU.ACAMP.WebApp.Data

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IWebHostEnvironment Env

<PageTitle>Register Confirmation - ACAMP</PageTitle>

<div class="w-full max-w-md mx-auto">
    <!-- Logo & Header -->
    <div class="flex flex-col items-center text-center mb-8">
        <div class="w-28 h-28 mb-4 flex items-center justify-center bg-transparent">
            <img src="images/ACAMP_logo_transparent.png" class="w-full h-full object-contain" alt="ACAMP Logo" onerror="this.src='images/acamp_logo.png';" />
        </div>
        <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Registration Successful</h1>
        <p class="mt-2 text-sm text-gray-500">Please confirm your email address to start using the system.</p>
    </div>

    <!-- Main Confirmation Card -->
    <div class="bg-white rounded-2xl shadow-xl shadow-gray-200/60 border border-gray-100 p-8">
        
        <!-- Mail Icon & Notification -->
        <div class="flex flex-col items-center text-center mb-6">
            <div class="w-16 h-16 bg-emerald-50 rounded-2xl flex items-center justify-center mb-4 text-emerald-600 shadow-sm border border-emerald-100">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
            </div>
            
            <h2 class="text-lg font-semibold text-gray-900 mb-1">Check Your Inbox</h2>
            <p class="text-sm text-gray-600">
                A confirmation link has been sent to:
            </p>
            
            <div class="mt-3 px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-800 break-all select-all">
                @(Email ?? "your registered email address")
            </div>
        </div>

        <!-- Important Notice (RequireConfirmedAccount & RequireConfirmedEmail) -->
        <div class="mb-6 p-3.5 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 flex items-start gap-2.5">
            <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <div>
                <span class="font-semibold">Important Notice:</span> You must click the confirmation link in the email before you can log in and use the platform.
            </div>
        </div>

        <!-- Primary Action: Link to Login -->
        <div class="mb-6">
            <a href="Account/Login"
               class="inline-flex items-center justify-center w-full py-2.5 px-4 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 focus:ring-4 focus:ring-emerald-200 rounded-xl shadow-lg shadow-emerald-200 transition-all duration-200 transform hover:-translate-y-0.5 text-center">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
                </svg>
                Proceed to Sign In
            </a>
        </div>

        <!-- Help Section: "Didn't receive email?" -->
        <div class="border-t border-gray-100 pt-5 text-xs text-gray-500 space-y-2">
            <p class="font-semibold text-gray-700">Didn't receive the confirmation email?</p>
            <ul class="list-disc list-inside space-y-1 text-gray-600 pl-1">
                <li>Please check your <strong>Junk Mail</strong> or <strong>Spam</strong> folder.</li>
                <li>
                    If not received, you can
                    <a href="@(NavigationManager.GetUriWithQueryParameters("Account/ResendEmailConfirmation", new Dictionary<string, object?> { ["email"] = Email }))"
                       class="font-medium text-emerald-600 hover:text-emerald-500 underline">
                        request a new confirmation email
                    </a>.
                </li>
                <li>Or contact the system administrator for assistance in activating your account.</li>
            </ul>
        </div>

        @if (Env.IsDevelopment() && !string.IsNullOrEmpty(emailConfirmationLink))
        {
            <div class="mt-6 p-3.5 bg-indigo-50 border border-indigo-200 rounded-xl text-xs text-indigo-900">
                <div class="font-bold flex items-center gap-1 mb-1 text-indigo-700">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    </svg>
                    [Development Only] Mock Link for Testing:
                </div>
                <p class="text-gray-600 mb-1.5">Since the system is in a Development environment, you can click the link below to confirm your email immediately:</p>
                <a href="@emailConfirmationLink" class="text-indigo-600 hover:text-indigo-800 font-semibold underline break-all">
                    Click here to confirm account immediately (Dev Confirmation)
                </a>
            </div>
        }
    </div>

    <!-- Back to Home Link -->
    <div class="mt-6 text-center">
        <a href="" class="text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors duration-200">
            &larr; Back to Home
        </a>
    </div>
</div>

@code {
    #region class fields
    private string? emailConfirmationLink;
    #endregion

    #region class properties
    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }
    #endregion

    #region class methods
    protected override async Task OnInitializedAsync()
    {
        #region hide [2026-08-16]
        if (string.IsNullOrWhiteSpace(Email))
        {
            RedirectManager.RedirectTo("");
            return;
        }

        // Prevent Account Enumeration: if user is not found, display standard message without revealing presence
        var user = await UserManager.FindByEmailAsync(Email);
        if (user is null)
        {
            return;
        }

        // If in Development environment, generate direct confirmation link for testing
        if (Env.IsDevelopment())
        {
            var userId = await UserManager.GetUserIdAsync(user);
            var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
            emailConfirmationLink = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
                new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code, ["returnUrl"] = ReturnUrl });
        }
        #endregion
    }
    #endregion
}
