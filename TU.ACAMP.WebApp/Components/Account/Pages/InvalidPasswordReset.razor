@page "/Account/InvalidPasswordReset"

<PageTitle>Invalid Reset Link - ACAMP</PageTitle>

<div class="w-full max-w-md mx-auto">
    <!-- Logo & Header -->
    <div class="flex flex-col items-center text-center mb-8">
        <div class="w-28 h-28 mb-4 flex items-center justify-center bg-transparent">
            <img src="images/ACAMP_logo_transparent.png" class="w-full h-full object-contain" alt="ACAMP Logo" onerror="this.src='images/acamp_logo.png';" />
        </div>
        <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Invalid reset link</h1>
        <p class="mt-2 text-sm text-gray-500">The password reset link is invalid or expired</p>
    </div>

    <!-- Alert Card -->
    <div class="bg-white rounded-2xl shadow-xl shadow-gray-200/60 border border-gray-100 p-8 text-center">
        <div class="w-14 h-14 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-4 text-amber-600">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>
        <p class="text-sm text-gray-600 mb-6">
            The link you used to reset your password is no longer valid. Please request a new link.
        </p>
        <a href="Account/ForgotPassword"
           class="inline-block w-full py-2.5 px-4 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 focus:ring-4 focus:ring-emerald-200 rounded-xl shadow-lg shadow-emerald-200 transition-all duration-200 mb-3">
            Request new reset link
        </a>
        <a href="Account/Login" class="text-xs text-gray-500 hover:text-gray-700 transition-colors duration-200">
            Back to Sign in
        </a>
    </div>
</div>
