@inherits LayoutComponentBase
@layout TU.ACAMP.WebApp.Components.Layout.MainLayout

<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <!-- Header Title -->
    <div class="mb-8 border-b border-gray-200/80 pb-5">
        <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Account Settings</h1>
        <p class="mt-1.5 text-sm text-gray-500">Manage your profile, password security, and account preferences.</p>
    </div>

    <!-- Navigation & Body Content -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-3">
            <ManageNavMenu />
        </div>
        <div class="lg:col-span-9">
            @Body
        </div>
    </div>
</div>
